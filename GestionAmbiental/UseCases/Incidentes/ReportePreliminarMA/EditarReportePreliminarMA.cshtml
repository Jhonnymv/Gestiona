@section Scripts{
    <script type="text/javascript" src="~/js/UseCases/Incidentes/ReportePreliminar/EditarReportePreliminarMA.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            GetInvolucrados();
            GetAcciones();
            GetCausas();
            if ('@Model.Estado' == "Registrado")
                HabilitarInputs();

            var evidencia = '@Model.Evidencias_Completas';
            console.log("Evidencias Completas",evidencia)
            var html_evidencia = "";
            if (evidencia.length > 0) {
                var evidencia_valores = JSON.parse(evidencia.replace(/&quot;/g, '"'));
                for (var i = 0; i < evidencia_valores.length; i++) {
                    if ($("#Estado").val() == "Registrado")
                        html_evidencia += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + evidencia_valores[i] + "')><a class=\"btn btn-mc-outline me-2\" href=\"/ReportePreliminar/Download?fileName=" + evidencia_valores[i] + "\">Evidencia " +(i+1)+ "</a></p>";
                    else
                        html_evidencia += "<p><a class=\"btn btn-mc-outline me-2\" href=\"/ReportePreliminar/Download?fileName=" + evidencia_valores[i] + "\">Evidencia " + (i + 1) + "</a></p>";
                }

                $("#Evidencias_Lista").html(html_evidencia);
                $("#Evidencias_Completas").val(evidencia_valores);
            }
        });
        function EliminarEvidencia(evidencia) {
            if ($("#Estado").val() == "Registrado")
                if (confirm('¿Está seguro que desea eliminar esta evidencia?'))
                    $.ajax({
                        type: "POST",
                        url: "/ReportePreliminarMA/EliminarEvidencia",
                        data: {
                            IdReporte: $("#Id_Reporte_Preliminar").val(),
                            Evidencia: evidencia
                        },
                        success: (response) => {
                            var evidencia = response.evidencia;
                            var html_evidencia = "";
                            if (evidencia.length > 0) {
                                for (var i = 0; i < evidencia.length; i++) {
                                    html_evidencia += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + evidencia[i] + "')><a class=\"btn btn-mc-outline me-2\" href=\"/ReportePreliminar/Download?fileName=" + evidencia[i] + "\">Evidencia " + (i + 1) + "</a></p>";
                                }

                                $("#Evidencias_Lista").html(html_evidencia);
                                $("#Evidencias_Completas").val(evidencia);
                            }
                        }
                    });
        }

        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminar/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        incidentesStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }

        function GetInvolucrados() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarInvolucrados",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_involucrados tbody').empty()
                    $('#tabla_involucrados tbody').html(response.filas_involucrados)
                    $('#NInvolucrados').val(response.nInvolucrados);
                    dataModulo();
                }
            });
        }
        function GetAcciones() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarAcciones",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_acciones tbody').empty();
                    $('#tabla_acciones tbody').html(response.filas_acciones);
                    $('#NAcciones').val(response.nAcciones);
                    dataModulo();
                }
            });
        }
        function GetCausas() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarCausas",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_causas tbody').empty();
                    $('#tabla_causas tbody').html(response.filas_causas);
                    $('#NCausas').val(response.nCausas);
                    dataModulo();
                }
            });
        }
        $("#boton_guardar_estado").on("click", function () {
            HabilitarInputs();
