@model GestionAmbiental.UseCases.Incidentes.ReportePreliminarMA.EditarReporteModel
@{
    ViewData["Title"] = "EditarReportePreliminarMA";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Editar Reporte Preliminar</h2>
        </div>
    </div>
    <form class="form-group" id="form_editarReporte" asp-action="EditarReportePreliminarMA" asp-controller="ReportePreliminarMA" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="Id_Reporte_Preliminar" value="@Model.Id_Reporte_Preliminar" />
        <input type="hidden" asp-for="Id_Encriptado_Reporte_Preliminar" value="@Model.Id_Encriptado_Reporte_Preliminar" />
        <input type="hidden" asp-for="Opcion" />
        <input type="hidden" asp-for="NInvolucrados" />
        <input type="hidden" asp-for="NAcciones" />
        <input type="hidden" asp-for="NCausas" />
        <input type="hidden" asp-for="Estado" value="@Model.Estado" />
        <!-- DATOS DEL TITULAR MINERO -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">DATOS DEL TITULAR MINERO</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Razón Social</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Marcobre SAC" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>RUC</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="20508972734" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Actividad</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Mineria" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Domicilio Legal</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Jr. Lorenzo Bernini 149, Oficina 301, San Borja - Lima" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Unidad Minera</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Mina Justa" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Num_Trabajadores"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Num_Trabajadores"></span>
                <input type="number" class="form-control" asp-for="Num_Trabajadores" disabled />
            </div>
        </div>
        <!-- DATOS DE LA EMPRESA CONTRATISTA (Llenar esta sección en caso el incidente NO haya sido ocasionado por el titular minero) -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">DATOS DE LA EMPRESA CONTRATISTA (Llenar esta sección en caso el incidente haya sido ocasionado por un contratista)</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Razon_Social_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Razon_Social_Contratista"></span>
                <input type="text" class="form-control" asp-for="Razon_Social_Contratista" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="RUC_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="RUC_Contratista"></span>
                <input type="text" class="form-control" asp-for="RUC_Contratista" maxlength="11" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Actividad_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Actividad_Contratista"></span>
                <input type="text" class="form-control" asp-for="Actividad_Contratista" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Domicilio_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-6 col-lg-6">
                <span class="text-danger" asp-validation-for="Domicilio_Contratista"></span>
                <input type="text" class="form-control" asp-for="Domicilio_Contratista" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Num_Trabajadores_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Num_Trabajadores_Contratista"></span>
                <input type="number" class="form-control" asp-for="Num_Trabajadores_Contratista" disabled />
            </div>
        </div>
        <!-- DATOS DEL INCIDENTE AMBIENTAL -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">DATOS DEL INCIDENTE AMBIENTAL</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Tipo_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Tipo_Incidente"></span>
                <select class="form-control" asp-items="@ViewBag.Tipo_Incidente" asp-for="Id_Tipo_Incidente" disabled></select>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Nivel_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Nivel_Incidente"></span>
                <select class="form-control" asp-items="@ViewBag.Nivel_Incidente" asp-for="Id_Nivel_Incidente" disabled></select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Fecha_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Fecha_Incidente"></span>
                <input type="date" class="form-control" asp-for="Fecha_Incidente" disabled />
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <label asp-for="Hora_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <span class="text-danger" asp-validation-for="Hora_Incidente"></span>
                <input type="time" class="form-control" asp-for="Hora_Incidente" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Producto_Derramado"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Producto_Derramado"></span>
                <input type="text" class="form-control" asp-for="Producto_Derramado" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Cantidad_Derramado"></label>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <span class="text-danger" asp-validation-for="Cantidad_Derramado"></span>
                <input type="number" class="form-control" asp-for="Cantidad_Derramado" disabled />
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <span class="text-danger" asp-validation-for="Id_Unidad_Cantidad_Derramado"></span>
                <select class="form-control" asp-items="@ViewBag.Unidad_Derramado" asp-for="Id_Unidad_Cantidad_Derramado" disabled></select>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Area_Afectada"></label>
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <span class="text-danger" asp-validation-for="Area_Afectada"></span>
                <input type="number" class="form-control" asp-for="Area_Afectada" disabled />
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <span class="text-danger" asp-validation-for="Id_Unidad_Area_Afectada"></span>
                <select class="form-control" asp-items="@ViewBag.Unidad_Area" asp-for="Id_Unidad_Area_Afectada" disabled></select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Lugar_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Lugar_Incidente"></span>
                <input type="text" class="form-control" asp-for="Lugar_Incidente" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Equipo_Involucrado"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Equipo_Involucrado"></span>
                <input type="text" class="form-control" asp-for="Equipo_Involucrado" disabled />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Componente_Ambiental"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Id_Componente_Ambiental"></span>
                <select class="form-control" asp-items="@ViewBag.Componente_Ambiental" asp-for="Id_Componente_Ambiental" disabled></select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Descripcion_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Descripcion_Incidente"></span>
                <textarea class="form-control" asp-for="Descripcion_Incidente" rows="3" maxlength="600" disabled></textarea>
            </div>
        </div>
        <!-- CAUSAS -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">CAUSAS INMEDIATAS DEL INCIDENTE</h5>
            </div>
        </div>
        @if (Model.Estado == "Registrado")
        {
            <div class="row mb-2 justify-content-center">
                <div class="col-sm-12 col-md-10 col-lg-10">
                    <button id="btn_nueva_causa" type="button" class="btn btn-danger">Agregar Causa</button>
                </div>
            </div>
        }
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_causas">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Acto/Condición Subestándar</th>
                            <th>Descripción</th>
                            @if (Model.Estado == "Registrado")
                            {
                                <th></th>
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Otra_Causa_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Otra_Causa_Incidente"></span>
                <textarea class="form-control" asp-for="Otra_Causa_Incidente" maxlength="300" rows="3" disabled></textarea>
            </div>
        </div>
        <!-- DATOS DE LOS INVOLUCRADOS -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">DATOS DE LOS INVOLUCRADOS</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Gerencia_Responsable"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-8">
                <span class="text-danger" asp-validation-for="Id_Gerencia_Responsable"></span>
                <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Id_Gerencia_Responsable" disabled></select>
            </div>
        </div>
        @if (Model.Estado == "Registrado")
        {
            <div class="row mb-2 justify-content-center">
                <div class="col-sm-12 col-md-10 col-lg-10">

                    <button id="btn_nuevo_involucrado" type="button" class="btn btn-danger">Agregar Involucrado</button>

                </div>
            </div>
        }
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_involucrados">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Tipo</th>
                            <th>Nombres y Apellidos</th>
                            <th>Correo Electrónico</th>
                            <th>Celular</th>
                            <th>Puesto de Trabajo</th>
                            <th>Turno</th>
                            @if (Model.Estado == "Registrado")
                            {
                                <th></th>
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- ACCIONES TOMADAS POST INCIDENTE -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">ACCIONES INMEDIATAS</h5>
            </div>
        </div>
        @if (Model.Estado == "Registrado")
        {
            <div class="row mb-2 justify-content-center">
                <div class="col-sm-12 col-md-10 col-lg-10">
                    <button id="btn_nueva_accion" type="button" class="btn btn-danger">Agregar Acción</button>
                </div>
            </div>
        }
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_acciones">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Acción Inmediata</th>
                            <th>Responsable Marcobre</th>
                            <th>Responsable Contratista</th>
                            <th>Fecha</th>
                            <th>Estatus</th>
                            @if (Model.Estado == "Registrado")
                            {
                                <th></th>
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Comentario_Accion"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Comentario_Accion"></span>
                <input type="text" class="form-control" asp-for="Comentario_Accion" disabled />
            </div>
        </div>
        <!-- ACCIONES TOMADAS POST INCIDENTE -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">SEGUIMIENTO</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Supervisor"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Id_Supervisor"></span>
                <select class="form-control" asp-items="@ViewBag.Supervisor" asp-for="Id_Supervisor" disabled></select>
            </div>
        </div>
        <!-- EVIDENCIAS -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">EVIDENCIAS: FOTOGRAFÍAS, PLANOS, DIAGRAMAS, ENTRE OTROS QUE APORTEN INFORMACIÓN SOBRE EL INCIDENTE (DEBEN CONTEMPLAR FECHA, HORA Y GEOREFERENCIA EN UTM DATUM WGS84)</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Evidencias"></label>
            </div>
            @if (Model.Estado == "Registrado")
            {
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
                        <span id="danger_evidencia" class=""></span>
                    </span>
                    <label class="btn btn-primary" for="Evidencias">Seleccione</label>
                    <input type="file" style="visibility:hidden; display:none" asp-for="Evidencias" accept=".jpg,.jpge,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label id="files_name">0 Archivos</label>
                </div>
            }
            <input type="hidden" asp-for="Evidencias_Completas" />
            <div class="col-sm-12 col-md-4 col-lg-4" id="Evidencias_Lista">
            </div>
        </div>
        @if (Model.Estado == "Registrado")
        {
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Investigacion"></label>
                </div>
                <div class="col-sm-12 col-md-10 col-lg-10">
                    <div class="form-check">
                        <input class="form-check-input position-static" type="checkbox" asp-for="Investigacion">
                    </div>
                </div>
            </div>
            <div class="row mb-2 justify-content-end">
                <div class="col-sm-12 col-md-3 col-lg-3">
                    <a asp-action="Resumen" asp-controller="ReportePreliminarMA" class="btn btn-primary">Volver</a>
                    <button id="boton_guardar_estado" type="button" class="btn btn-primary">Guardar Estado</button>
                    <button id="boton_difundir" type="button" class="btn btn-primary">Difundir</button>
                </div>
            </div>
        }
        else
        {
            <div class="row mb-2 justify-content-end">
                <div class="col-sm-12 col-md-3 col-lg-3">
                    <a asp-action="Resumen" asp-controller="ReportePreliminarMA" class="btn btn-primary">Volver</a>
                    <a class="btn btn-danger" asp-controller="DescargarReportePreliminar" asp-action="DescargarReportePreliminar" asp-route-IdReporte="@Model.Id_Reporte_Preliminar">Descargar Excel</a>
                </div>
            </div>
        }
    </form>
</div>
<!-- Modal Nuevo Involucrado-->
<div class="modal fade" id="modal_involucrado" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_involucrado"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_involucrado">
                    Agregar involucrado
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <input type="hidden" id="Id_Involucrado" />
                    <div class="col-sm-12 col-md-12 col-lg-12">
                        <span class="text-danger" id="danger_involucrado"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label>Tipo de Involucrado:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <select class="form-control" id="select_tipo_involucrado">
                            <option value="">--SELECCIONE--</option>
                            <option value="Supervisor Inmediato (Titular Minero)">Supervisor Inmediato (Titular Minero)</option>
                            <option value="Supervisor Inmediato (Contratista)">Supervisor Inmediato (Contratista)</option>
                            <option value="Supervisor Marcobre">Supervisor Marcobre</option>
                            <option value="Otro Involucrado">Otro Involucrado</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label id="label_nobmres_apellidos" style="display:none">Nombres y Apellidos:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios" style="display:none"></select>
                        <input type="text" class="form-control mb-2" id="input_nombres" style="display:none" placeholder="Nombres" />
                        <input type="text" class="form-control" id="input_apellidos" style="display:none" placeholder="Apellidos" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label id="label_correo" style="display:none">Correo Electrónico:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <input type="email" class="form-control" id="input_correo" style="display:none" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label id="label_puesto" style="display:none">Puesto de Trabajo:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <input type="text" class="form-control" id="input_puesto" style="display:none" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label id="label_turno" style="display:none">Turno:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <select class="form-control" id="select_turno" style="display:none">
                            <option value="">--SELECCIONE--</option>
                            <option value="Dia">Día</option>
