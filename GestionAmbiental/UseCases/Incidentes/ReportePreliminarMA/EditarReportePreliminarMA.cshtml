        }
        function EditarAccion() {
            //Agregar Validación y msgs
            var idAccion = $("#id_editar_accion").val();
            var estatus = $("#select_editar_estatus").val();
            var archivo = document.getElementById("file_editar_accion").files;
            if (ValidarEditarAccion()) {
                var formData = new FormData();
                for (var i = 0; i != archivo.length; i++) {
                    formData.append("Evidencia", archivo[i]);
                }
                formData.append("IdAccion", idAccion);
                formData.append("IdReporte", $("#Id_Reporte_Preliminar").val());
                formData.append("Estatus", estatus);
                formData.append("EvidenciasCompletas", $("#Evidencias_Completas").val());
                $.ajax({
                    url: "@Url.Action("EditarAccionDifundido", "ReportePreliminarMA")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            nombresEvidenciasString = response.nombresEvidencias;
                            nombresEvidencias = JSON.parse(response.nombresEvidencias);

                            $("#id_editar_accion").val('');
                            $("#select_editar_estatus").val('');
                            $("#file_editar_accion").val('');
                            $("#modal_editar_accion").modal('hide');
                            CargarEvidencias($("#Estado").val() == "Registrado");
                            GetAcciones();
                        }
                        else {
                            alert("Ocurrió un error al editar la acción")
                        }
                    }
                });
            }
        }
        $("#file_editar_accion").change(function () {
            $("#danger_editar_accion").text("");
            //Validacion del tamaño del archivo
            var maxSize = $("#file_editar_accion").data('max-size');
            var archivos = $("#file_editar_accion").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    $("#danger_editar_accion").text("El  archivo supera el límite permitido de 12MB<br/>");
                    return;
                }
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'jpeg':
                        case 'png':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            $("#danger_editar_accion").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
            }
        });
        function ValidarEditarAccion() {
            var result = true;
            $("#danger_editar_accion").empty();
            if ($("#select_editar_estatus").val() == '') {
                $("#danger_editar_accion").text("Debe seleccionar una opción");
                result = false;
            }
            if ($("#file_editar_accion").val() == '') {
                $("#danger_editar_accion").text("Debe seleccionar una opción");
                result = false;
            }
            return result;
        }

