<!-- Modal Nuevo Involucrado-->
<div class="modal fade" id="modal_involucrado" tabindex="-1" aria-labelledby="titulo_modal_involucrado" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3> Agregar involucrado</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="Id_Involucrado" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_involucrado"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Tipo de Involucrado</label>
                                        <select class="form-control" id="select_tipo_involucrado">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="Supervisor Inmediato (Titular Minero)">Supervisor Inmediato (Titular Minero)</option>
                                            <option value="Supervisor Inmediato (Contratista)">Supervisor Inmediato (Contratista)</option>
                                            <option value="Supervisor Marcobre">Supervisor Marcobre</option>
                                            <option value="Otro Involucrado">Otro Involucrado</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_nobmres_apellidos" style="display:none">Nombres y Apellidos</label>
                                        <select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios" style="display:none"></select>
                                        <input type="text" class="form-control mb-2" id="input_nombres" style="display:none" placeholder="Nombres" />
                                        <input type="text" class="form-control" id="input_apellidos" style="display:none" placeholder="Apellidos" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_correo" style="display:none">Correo Electrónico</label>
                                        <input type="email" class="form-control" id="input_correo" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_puesto" style="display:none">Puesto de Trabajo</label>
                                        <input type="text" class="form-control" id="input_puesto" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_turno" style="display:none">Turno</label>
                                        <select class="form-control" id="select_turno" style="display:none">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="Dia">Día</option>
                                            <option value="Noche">Noche</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_celular" style="display:none">Celular</label>
                                        <input type="text" class="form-control" id="input_celular" maxlength="9" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_involucrado">Guardar</button>
                                        <button type="button" class="btn btn-mc-success" id="btn_editar_involucrado" style="display:none">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Nuevo Acciones Post Incidente-->
<div class="modal fade" id="modal_accion" tabindex="-1" aria-labelledby="titulo_modal_accion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3> Agregar Acción Inmediata</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="Id_Accion" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_accion"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Descripción</label>
                                        <textarea class="form-control" rows="2" maxlength="1000" id="input_descripcion_accion"></textarea>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Responsable Marcobre</label>
                                        <select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios_accion"></select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Responsable Contratista</label>
                                        <input type="text" class="form-control" id="input_contratista_accion" placeholder="Nombres y Apellidos" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Fecha</label>
                                        <input type="date" class="form-control" id="input_fecha_accion" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Estatus</label>
                                        <select class="form-control" id="select_estatus">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="En Proceso">En Proceso</option>
                                            <option value="Cerrado">Cerrado</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_celular" style="display:none">Celular:</label>
                                        <input type="text" class="form-control" id="input_celular" maxlength="9" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_accion">Guardar</button>
                                        <button type="button" class="btn btn-mc-success" id="btn_editar_accion">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Accion Post Difusion-->
<div class="modal fade" id="modal_editar_accion" tabindex="-1" aria-labelledby="titulo_modal_editar_accion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3>Editar Acción</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="id_editar_accion" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_editar_accion"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Estatus</label>
                                        <select class="form-control" id="select_editar_estatus">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="En Proceso">En Proceso</option>
                                            <option value="Cerrado">Cerrado</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Evidencia</label>
                                        <input type="file" class="form-control" id="file_editar_accion" accept=".jpg,.jpeg,.png" data-max-size="12582912">
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_editar_accion" onclick="EditarAccion()">Guardar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Nueva Causas-->
<div class="modal fade" id="modal_causa" tabindex="-1" aria-labelledby="titulo_modal_causa" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3> Agregar Causa del Incidente</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="Id_Causa" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_causa"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Tipo de Causa del Incidente</label>
                                        <select class="form-control" id="select_acto_condicion">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="Acto">Acto Subestándar</option>
                                            <option value="Condicion">Condición Subestándar</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container" id="actos_subestandar" style="display:none">
                                    <div class="col-12">
                                        <label>Acto Subestándar</label>
                                        <select class="form-control" asp-items="@ViewBag.Actos" id="select_actos"></select>
                                    </div>
                                </div>
                                <div class="row input_container" id="condiciones_subestandar" style="display:none">
                                    <div class="col-12">
