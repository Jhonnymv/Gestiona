        function CargarEvidencias(eliminar) {
            if (nombresEvidencias.length > 0) {
                CargarEvidenciasConNombre(nombresEvidencias, "#Evidencias_Lista", "#Evidencias_Completas", eliminar);
            }
            else if (evidencia.length > 0) {
                CargarEvidenciasSinNombre(evidencia_valores, "#Evidencias_Lista", "#Evidencias_Completas", eliminar);
            }
        }
        function EliminarEvidencia(evidencia) {
            let eliminar = $("#Estado").val() == "Registrado"
            if (eliminar)
                if (confirm('¿Está seguro que desea eliminar esta evidencia?'))
                    $.ajax({
                        type: "POST",
                        url: "/ReportePreliminarMA/EliminarEvidencia",
                        data: {
                            IdReporte: $("#Id_Reporte_Preliminar").val(),
                            Evidencia: evidencia
                        },
                        success: (response) => {
                            nombresEvidenciasString = response.nombresEvidencias;
                            nombresEvidencias = JSON.parse(response.nombresEvidencias);
                            CargarEvidencias(eliminar);
                        }
                    });
        }
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminar/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        incidentesStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }

