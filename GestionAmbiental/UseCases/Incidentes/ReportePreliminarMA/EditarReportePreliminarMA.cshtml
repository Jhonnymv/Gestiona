<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Enviando_Correo" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Difundiendo el Reporte Preliminar</label>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" src="~/js/UseCases/Incidentes/ReportePreliminar/EditarReportePreliminarMA.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            GetInvolucrados();
            GetAcciones();
            GetCausas();
            if ('@Model.Estado' == "Registrado")
                HabilitarInputs();

            var evidencia = '@Model.Evidencias_Completas';
            var html_evidencia = "";
            if (evidencia.length > 0) {
                var evidencia_valores = JSON.parse(evidencia.replace(/&quot;/g, '"'));
                for (var i = 0; i < evidencia_valores.length; i++)
                    html_evidencia += "<p><a href=\"/ReportePreliminar/Download?fileName=" + evidencia_valores[i] + "\">Evidencia</a></p>";

                $("#Evidencias_Lista").html(html_evidencia);
                $("#Evidencias_Completas").val(evidencia_valores);
            }
        });
        function GetInvolucrados() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarInvolucrados",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_involucrados tbody').empty()
                    $('#tabla_involucrados tbody').html(response.filas_involucrados)
                    $('#NInvolucrados').val(response.nInvolucrados);
                }
            });
        }
        function GetAcciones() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarAcciones",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_acciones tbody').empty();
                    $('#tabla_acciones tbody').html(response.filas_acciones);
                    $('#NAcciones').val(response.nAcciones);
                }
            });
        }
        function GetCausas() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminarMA/ListarCausas",
                data: {
                    IdReporte: $("#Id_Reporte_Preliminar").val()
                },
                success: (response) => {
                    $('#tabla_causas tbody').empty();
                    $('#tabla_causas tbody').html(response.filas_causas);
                    $('#NCausas').val(response.nCausas);
                }
            });
        }
        $("#boton_guardar_estado").on("click", function () {
            HabilitarInputs();
            $("#Opcion").val("Completar");
            $("#form_editarReporte").submit();
        });
        $("#boton_difundir").on("click", function () {
            HabilitarInputs();
            if (ValidarInputs()) {
                $("#Opcion").val("Difundir");
                $("#Modal_Enviando_Correo").modal("show");
                $("#form_editarReporte").submit();
            }
        });

        function HabilitarInputs() {
            $("#Num_Trabajadores").prop("disabled", false)
            $("#Razon_Social_Contratista").prop("disabled", false)
            $("#RUC_Contratista").prop("disabled", false)
            $("#Actividad_Contratista").prop("disabled", false)
            $("#Domicilio_Contratista").prop("disabled", false)
            $("#Num_Trabajadores_Contratista").prop("disabled", false)
            $("#Id_Tipo_Incidente").prop("disabled", false)
            $("#Id_Nivel_Incidente").prop("disabled", false)
            $("#Fecha_Incidente").prop("disabled", false)
            $("#Hora_Incidente").prop("disabled", false)
            $("#Producto_Derramado").prop("disabled", false)
            $("#Cantidad_Derramado").prop("disabled", false)
            $("#Id_Unidad_Cantidad_Derramado").prop("disabled", false)
            $("#Area_Afectada").prop("disabled", false)
            $("#Id_Unidad_Area_Afectada").prop("disabled", false)
            $("#Lugar_Incidente").prop("disabled", false)
            $("#Equipo_Involucrado").prop("disabled", false)
            $("#Id_Componente_Ambiental").prop("disabled", false)
            $("#Descripcion_Incidente").prop("disabled", false)
            $("#Otra_Causa_Incidente").prop("disabled", false)
            $("#Id_Gerencia_Responsable").prop("disabled", false)
            $("#Comentario_Accion").prop("disabled", false)
            $("#Id_Supervisor").prop("disabled", false)
        }
        function ValidarInputs() {
            var result = true;
            $("[data-valmsg-for='Num_Trabajadores']").html("");
            $("[data-valmsg-for='Num_Trabajadores']").html("");
            $("[data-valmsg-for='Razon_Social_Contratista']").html("");
            $("[data-valmsg-for='RUC_Contratista']").html("");
            $("[data-valmsg-for='Actividad_Contratista']").html("");
            $("[data-valmsg-for='Domicilio_Contratista']").html("");
            $("[data-valmsg-for='Num_Trabajadores_Contratista']").html("");
            $("[data-valmsg-for='Id_Tipo_Incidente']").html("");
            $("[data-valmsg-for='Id_Nivel_Incidente']").html("");
            $("[data-valmsg-for='Fecha_Incidente']").html("");
            $("[data-valmsg-for='Hora_Incidente']").html("");
            $("[data-valmsg-for='Producto_Derramado']").html("");
            $("[data-valmsg-for='Cantidad_Derramado']").html("");
            $("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("");
            $("[data-valmsg-for='Area_Afectada']").html("");
            $("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("");
            $("[data-valmsg-for='Lugar_Incidente']").html("");
            $("[data-valmsg-for='Equipo_Involucrado']").html("");
            $("[data-valmsg-for='Id_Componente_Ambiental']").html("");
            $("[data-valmsg-for='Descripcion_Incidente']").html("");
            $("[data-valmsg-for='Otra_Causa_Incidente']").html("");
            $("[data-valmsg-for='Id_Gerencia_Responsable']").html("");
            $("[data-valmsg-for='Comentario_Accion']").html("");
            $("[data-valmsg-for='Id_Supervisor']").html("");

            if ($("#Num_Trabajadores").val() == "") {
                $("#Num_Trabajadores").focus();
                $("[data-valmsg-for='Num_Trabajadores']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Razon_Social_Contratista").val() != ""
                || $("#RUC_Contratista").val() != ""
                || $("#Actividad_Contratista").val() != ""
                || $("#Domicilio_Contratista").val() != ""
                || $("#Num_Trabajadores_Contratista").val() != "")
            {
                if ($("#Razon_Social_Contratista").val() == "")
                {
                    $("#Razon_Social_Contratista").focus();
                    $("[data-valmsg-for='Razon_Social_Contratista']").html("Debe completar este campo");
                    result = false;
                }
                if ($("#RUC_Contratista").val() == "")
                {
                    $("#RUC_Contratista").focus();
                    $("[data-valmsg-for='RUC_Contratista']").html("Debe completar este campo");
                    result = false;
                }
                if ($("#Actividad_Contratista").val() == "")
                {
                    $("#Actividad_Contratista").focus();
                    $("[data-valmsg-for='Actividad_Contratista']").html("Debe completar este campo");
                    result = false;
                }
                if ($("#Domicilio_Contratista").val() == "")
                {
                    $("#Domicilio_Contratista").focus();
                    $("[data-valmsg-for='Domicilio_Contratista']").html("Debe completar este campo");
                    result = false;
                }
                if ($("#Num_Trabajadores_Contratista").val() == "")
                {
                    $("#Num_Trabajadores_Contratista").focus();
                    $("[data-valmsg-for='Num_Trabajadores_Contratista']").html("Debe completar este campo");
                    result = false;
                }
            }
            if ($("#Id_Tipo_Incidente").val() == 0) {
                $("#Id_Tipo_Incidente").focus();
                $("[data-valmsg-for='Id_Tipo_Incidente']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Id_Nivel_Incidente").val() == 0) {
                $("#Id_Nivel_Incidente").focus();
                $("[data-valmsg-for='Id_Nivel_Incidente']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Fecha_Incidente").val() == "") {
                $("#Fecha_Incidente").focus();
                $("[data-valmsg-for='Fecha_Incidente']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Producto_Derramado").val() == "") {
                $("#Producto_Derramado").focus();
                $("[data-valmsg-for='Producto_Derramado']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Cantidad_Derramado").val() == "") {
                $("#Cantidad_Derramado").focus();
                $("[data-valmsg-for='Cantidad_Derramado']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Id_Unidad_Cantidad_Derramado").val() == 0) {
                $("#Id_Unidad_Cantidad_Derramado").focus();
                $("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Area_Afectada").val() == "") {
                $("#Area_Afectada").focus();
                $("[data-valmsg-for='Area_Afectada']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Id_Unidad_Area_Afectada").val() == 0) {
                $("#Id_Unidad_Area_Afectada").focus();
                $("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Lugar_Incidente").val() == "") {
                $("#Lugar_Incidente").focus();
                $("[data-valmsg-for='Lugar_Incidente']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Lugar_Incidente").val() == "") {
                $("#Lugar_Incidente").focus();
                $("[data-valmsg-for='Equipo_Involucrado']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Id_Componente_Ambiental").val() == 0) {
                $("#Id_Componente_Ambiental").focus();
                $("[data-valmsg-for='Id_Componente_Ambiental']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Descripcion_Incidente").val() == "") {
                $("#Descripcion_Incidente").focus();
                $("[data-valmsg-for='Descripcion_Incidente']").html("Debe completar este campo");
                result = false;
            }
            if ($("#Id_Gerencia_Responsable").val() == 0) {
                $("#Id_Gerencia_Responsable").focus();
                $("[data-valmsg-for='Id_Gerencia_Responsable']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#Id_Supervisor").val() == 0) {
                $("#Id_Supervisor").focus();
                $("[data-valmsg-for='Id_Supervisor']").html("Debe seleccionar una opción");
                result = false;
            }
            if ($("#NCausas").val() == 0) {
                $("#alert_causas").html("Debe agregar causas del incidente");
                result = false;
            }
            if ($("#NInvolucrados").val() == 0) {
                $("#alert_involucrados").html("Debe agregar involucrados en el incidente");
                result = false;
            }
            if ($("#NAcciones").val() == 0) {
                $("#alert_acciones").html("Debe agregar acciones correctivas inmediatas");
                result = false;
            }

            return result;
        }
    </script>
}