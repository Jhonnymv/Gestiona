                            <option value="Acto">Acto Subestándar</option>
                            <option value="Condicion">Condición Subestándar</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2" id="actos_subestandar" style="display:none">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label>Acto Subestándar:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <select class="form-control" asp-items="@ViewBag.Actos" id="select_actos"></select>
                    </div>
                </div>
                <div class="row mb-2" id="condiciones_subestandar" style="display:none">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label>Condición Subestándar:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <select class="form-control" asp-items="@ViewBag.Condiciones" id="select_condiciones"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btn_guardar_causa">Guardar</button>
                <button type="button" class="btn btn-primary" id="btn_editar_causa" style="display:none">Aceptar</button>
            </div>
        </div>
    </div>
</div>

