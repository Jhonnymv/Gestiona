                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_causa">Guardar</button>
                                        <button type="button" class="btn btn-mc-success" id="btn_editar_causa" style="display:none">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
