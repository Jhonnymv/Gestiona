                    <span class="text-danger" id="danger_accion"></span>
                </div>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Id_Accion" />
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label>Descripción:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
                        <textarea class="form-control" rows="2" id="input_descripcion_accion"></textarea>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <label>Responsable Marcobre:</label>
                    </div>
                    <div class="col-sm-6 col-md-8 col-lg-9">
