@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            filtrar(1);
            console.log('@ViewBag.Usuario')
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val(),
                    "id_asesor": $("#filtro_asesores").val(),
                    "id_usuario": $("#filtro_usuarios").val(),
                    "id_gerencia": $("#filtro_gerencia").val(),
                    "usuario_red": '@ViewBag.Usuario'
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_incidentes tbody').empty()
                    $('#tabla_resumen_incidentes tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                /*$('#nRegistros').html(response.nRegistros)*/
                    let r4 = 0;
                    let g4 = 188;
                    let b4 = 228;
                    incidentesStyle(r4, g4, b4);
                }
            });
        }
    </script>
}

