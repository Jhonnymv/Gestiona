@model GestionAmbiental.UseCases.Incidentes.InvestigacionFinal.ImplementarAccionMA.ImplementarAccionMAModel
@{
    ViewData["Title"] = "ImplementarAccionMA";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Implementar Acción</h2>
        </div>
    </div>
    <form class="form-group" id="formImplementarAccion" asp-action="ImplementarAccionMA" asp-controller="ImplementarAccionMAInvestigacion" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="Id_Investigacion_Final" value="@Model.Id_Investigacion_Final" />
        <input type="hidden" asp-for="Id_Encriptado" value="@Model.Id_Encriptado" />
        <input type="hidden" asp-for="Id_Investigacion_Encriptado" value="@Model.Id_Investigacion_Encriptado" />
        <input type="hidden" asp-for="Id_Accion_Incidente_Investigacion" value="@Model.Id_Accion_Incidente_Investigacion" />
        <input type="hidden" asp-for="Estado" value="@Model.Estado" />
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Tipo_Accion"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Tipo_Accion"></span>
                <input type="text" class="form-control" asp-for="Tipo_Accion" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Accion_Inmediata"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Accion_Inmediata"></span>
                <input type="text" class="form-control" asp-for="Accion_Inmediata" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Responsable_Marcobre"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Responsable_Marcobre"></span>
                <input type="text" class="form-control" asp-for="Responsable_Marcobre" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Responsable_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Responsable_Contratista"></span>
                <input type="text" class="form-control" asp-for="Responsable_Contratista" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Fecha"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Fecha"></span>
                <input type="date" class="form-control" asp-for="Fecha" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Estatus"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Estatus"></span>
                <input type="text" class="form-control" asp-for="Estatus" disabled />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Evidencias"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
                    <span id="danger_evidencias" class=""></span>
                </span>
                <label class="btn btn-primary" for="Evidencias">Seleccione</label>
                <input type="file" style="visibility:hidden; display:none" asp-for="Evidencias" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4 align-self-center">
                <label id="files_name" style="margin-bottom:0px">0 Archivos</label>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-4 col-lg-4">
                <label asp-for="Comentarios_Implementacion"></label>
            </div>
            <div class="col-sm-12 col-md-8 col-lg-8">
                <span class="text-danger" asp-validation-for="Comentarios_Implementacion"></span>
                <textarea type="text" class="form-control" asp-for="Comentarios_Implementacion" maxlength="250" rows="3"></textarea>
            </div>
        </div>
        <div class="row mb-2 justify-content-end">
            <div class="col-sm-12 col-md-4 col-lg-3" style="text-align:end">
                <a id="boton_cancelar" class="btn btn-secondary" asp-controller="InvestigacionFinal" asp-action="DetalleInvestigacion" asp-route-IdInvestigacion="@Model.Id_Investigacion_Encriptado">Cancelar</a>
                <button id="boton_implementar" type="button" class="btn btn-primary" onclick="Implementar()">Implementar</button>
            </div>
        </div>
    </form>
</div>

@section Scripts{
    <script type="text/javascript">

        function Implementar() {
            if (ValidarEvidencia()) {
                HabilitarInputs();
                $("#formImplementarAccion").submit();
            }
        }
        function ValidarEvidencia() {
            if ($("#Evidencias").get(0).files.length === 0) {
                $("#danger_evidencias").html("Debe ingresar evidencias<br/>");
                return false;
            }
            return true;
        }
        //Evidencias
        $("#Evidencias").change(function () {
            $("#danger_evidencias").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Evidencias").data('max-size');
            var archivos = $("#Evidencias").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencias").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#danger_evidencias").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
            }
        });
        function HabilitarInputs() {
            $("#Tipo_Accion").prop("disabled", false);
            $("#Accion_Inmediata").prop("disabled", false);
            $("#Responsable_Marcobre").prop("disabled", false);
            $("#Responsable_Contratista").prop("disabled", false);
            $("#Fecha").prop("disabled", false);
            $("#Estatus").prop("disabled", false);
        }
    </script>
}

