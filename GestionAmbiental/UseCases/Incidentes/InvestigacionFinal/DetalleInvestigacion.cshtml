            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Evidencias_Papel"></label>
            </div>
            <input type="hidden" asp-for="Evidencias_Completas_Papel" />
