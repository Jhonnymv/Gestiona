        function AmpliarFechaAccion() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/AmpliarFechaAccion",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val(),
                    IdAccion: $("#idAccionAmpliacion").val(),
                    fecha: $("#nuevaFechaAmpliacion").val()
                },
                success: (response) => {
                    $("#modal_ampliacion").modal("hide");
                    $("#idAccionAmpliacion").val(0);
                    $("#nuevaFechaAmpliacion").val("")

                    $('#tabla_acciones tbody').empty();
                    $('#tabla_acciones tbody').html(response.filas_acciones);
                    var nAcciones = response.nAcciones;
                    var nVerificado = response.nVerificado;
                    var porcentaje = roundNumber((nVerificado * 100 / nAcciones).toString(),2) + "%";
                    $('#progreso_vefirifacion .progress-bar').width(porcentaje);
                    $('#progreso_vefirifacion .percent').text(porcentaje);
                    dataModulo();
                }
            });
        }
        function roundNumber(num, scale) {
            if (!("" + num).includes("e")) {
                return +(Math.round(num + "e+" + scale) + "e-" + scale);
            } else {
                var arr = ("" + num).split("e");
                var sig = ""
                if (+arr[1] + scale > 0) {
                    sig = "+";
                }
                return +(Math.round(+arr[0] + "e" + sig + (+arr[1] + scale)) + "e-" + scale);
            }
    }
        function EliminarAccion(idAccion) {
        if (confirm('¿Está seguro que desea eliminar esta acción?')) {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/EliminarAccion",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val(),
                    IdAccion: idAccion,
                },
                success: (response) => {
                    $('#tabla_acciones_inmediatas tbody').empty();
                    $('#tabla_acciones_inmediatas tbody').html(response.filas_acciones_inmediatas);
                    $('#tabla_acciones_correctivas tbody').empty();
                    $('#tabla_acciones_correctivas tbody').html(response.filas_acciones_correctivas);
                    $('#NAcciones').val(response.nAcciones);
                    dataModulo();
                    GetAccionesVerificacion();
                }
            });
        }
    }
