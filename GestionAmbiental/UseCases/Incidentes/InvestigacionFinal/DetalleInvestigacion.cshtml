                <label asp-for="Evidencias_Partes"></label>
            </div>
            <input type="hidden" asp-for="Evidencias_Completas_Partes" />
            <div class="col-sm-12 col-md-4 col-lg-4" id="Evidencias_Lista_Partes">
            </div>
        </div>

        <div class="row mb-2 justify-content-end">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <a class="btn btn-danger" asp-controller="DescargarInvestigacionFinal" asp-action="DescargarInvestigacion" asp-route-IdInvestigacion="@Model.Id_Investigacion_Final">Descargar Excel</a>
