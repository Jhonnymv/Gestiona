                <span class="text-danger" asp-validation-for="Id_Supervisor"></span>
                <select class="form-control" asp-items="@ViewBag.Supervisor" asp-for="Id_Supervisor"></select>
            </div>
        </div>
        <!-- PROGRESO DE VVERIFICACION -->
        <div class="row mb-2 justify-content-center mb-2">
            <div class="col-sm-12 col-md-10 col-lg-10" style="text-align:center;">
                <h4>Progreso de Verificación de Acciones</h4>
                <div class="progress" style="width:100%; height:25px">
                    <div id="progreso_vefirifacion" class="progress-bar bg-info" role="progressbar" aria-valuenow="0"
                         aria-valuemin="0" aria-valuemax="100" style="width:0%;color: black;font-weight: bold;">
                        0%
                    </div>
                </div>
            </div>
