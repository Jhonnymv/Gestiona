<!-- Modal Ampliar Fecha-->
<div class="modal fade" id="modal_ampliacion" tabindex="-1" aria-labelledby="titulo_modal_ampliacion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3>Ingrese Nueva Fecha para Implementación</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" class="form-control" id="idAccionAmpliacion" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_ampliacion"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Nueva Fecha</label>
                                        <input type="date" class="form-control" id="nuevaFechaAmpliacion" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button" type="button" class="btn btn-mc" onclick="AmpliarFechaAccion()">Guardar</button">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.PermisoAdmin)
{
    <partial name="../InvestigacionFinal/Modales/_ModalInvolucrado.cshtml" />
    <partial name="../InvestigacionFinal/Modales/_ModalProducto.cshtml" />
    <partial name="../InvestigacionFinal/Modales/_ModalAccion.cshtml" />
    <partial name="../InvestigacionFinal/Modales/_ModalCausa.cshtml" />
}
@section Scripts{
    @if (ViewBag.PermisoAdmin)
    {
        <script type="text/javascript" src="~/js/UseCases/Incidentes/InvestigacionFinal/EditarInvestigacionFinal-Involucrados.js"></script>
        <script type="text/javascript" src="~/js/UseCases/Incidentes/InvestigacionFinal/EditarInvestigacionFinal-Productos.js"></script>
        <script type="text/javascript" src="~/js/UseCases/Incidentes/InvestigacionFinal/EditarInvestigacionFinal-Causas.js"></script>
        <script type="text/javascript" src="~/js/UseCases/Incidentes/InvestigacionFinal/EditarInvestigacionFinal-Acciones.js"></script>
        <script type="text/javascript">
            function HabilitarInputs() {
                $(".writeable").prop('disabled', false);
                //$("input").prop('disabled', false);
                //$("select").prop('disabled', false);
                //$("textarea").prop('disabled', false);
            }
            
            function EliminarEvidencia(evidencia, tipo) {
                var admin = '@Html.Raw(ViewBag.PermisoAdmin)';
                if (admin == "True")
                    if (confirm('¿Está seguro que desea eliminar esta evidencia?'))
                        $.ajax({
                            type: "POST",
                            url: "/InvestigacionFinal/EliminarEvidencia",
                            data: {
                                IdInvestigacion: $("#Id_Investigacion_Final").val(),
                                Evidencia: evidencia,
                                Tipo: tipo
                            },
                            success: (response) => {
                                if (response.success) {
                                    nombresEvidenciasString = response.nombresEvidencias;
                                    nombresEvidencias = JSON.parse(response.nombresEvidencias);
                                    CargarEvidencias(admin);
                                } else {
                                    alert("Ocurrió un error");
                                    console.log("Error eliminar: " + response.message);
                                }
                            }
                        });
            }

            //Restrict to integer
            function setInputFilter(textbox, inputFilter) {
                ["input", "keydown", "keyup", "mousedown", "mouseup", "select", "contextmenu", "drop"].forEach(function (event) {
                    textbox.addEventListener(event, function () {
                        if (inputFilter(this.value)) {
                            this.oldValue = this.value;
                            this.oldSelectionStart = this.selectionStart;
                            this.oldSelectionEnd = this.selectionEnd;
                        } else if (this.hasOwnProperty("oldValue")) {
                            this.value = this.oldValue;
                            this.setSelectionRange(this.oldSelectionStart, this.oldSelectionEnd);
                        } else {
                            this.value = "";
                        }
                    });
                });
            }
            setInputFilter(document.getElementById("Coordenada_Este"), function (value) {
                return /^-?\d*$/.test(value);
            });
            setInputFilter(document.getElementById("Coordenada_Norte"), function (value) {
                return /^-?\d*$/.test(value);
            });
            setInputFilter(document.getElementById("ImpactoAmbiental_Cord_Este"), function (value) {
                return /^-?\d*$/.test(value);
            });
            setInputFilter(document.getElementById("ImpactoAmbiental_Cord_Norte"), function (value) {
                return /^-?\d*$/.test(value);
            });

            $("#checkbox_suelo").change(function () {
                var checked = !$("#checkbox_suelo").prop("checked");
                $("#ImpactoAmbiental_Id_Tipo_Suelo").prop("disabled", checked)
                $("#ImpactoAmbiental_Area_Suelo").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Area_Suelo").prop("disabled", checked)
                $("#ImpactoAmbiental_Cantidad_Suelo").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Cantidad_Suelo").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Lugar_Disposicion_Suelo").prop("disabled", checked)
            });
            $("#checkbox_flora").change(function () {
                var checked = !$("#checkbox_flora").prop("checked");
                $("#ImpactoAmbiental_Id_Especie_Flora").prop("disabled", checked)
                $("#ImpactoAmbiental_Unidad_Flora").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Flora").prop("disabled", checked)
                $("#ImpactoAmbiental_Cantidad_Residuo_Flora").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Residuo_Flora").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Lugar_Disposicion_Flora").prop("disabled", checked)
            });
            $("#checkbox_fauna").change(function () {
                var checked = !$("#checkbox_fauna").prop("checked");
                $("#ImpactoAmbiental_Id_Especie_Fauna").prop("disabled", checked)
                $("#ImpactoAmbiental_Unidad_Fauna").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Fauna").prop("disabled", checked)
                $("#ImpactoAmbiental_Cantidad_Residuo_Fauna").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Residuo_Fauna").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Lugar_Disposicion_Fauna").prop("disabled", checked)
            });
            $("#checkbox_agua").change(function () {
                var checked = !$("#checkbox_agua").prop("checked");
                $("#ImpactoAmbiental_Id_Tipo_Agua").prop("disabled", checked)
                $("#ImpactoAmbiental_Volumen_Agua").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Agua").prop("disabled", checked)
                $("#ImpactoAmbiental_Cantidad_Residuo_Agua").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Unidad_Residuo_Agua").prop("disabled", checked)
                $("#ImpactoAmbiental_Id_Lugar_Disposicion_Agua").prop("disabled", checked)
            });
            $("#ImpactoAmbiental_Restos_Arq").change(function () {
                var sino = $("#ImpactoAmbiental_Restos_Arq").val() == "SI" ? true : false;
                $("#ImpactoAmbiental_Cord_Este").prop("disabled", !sino);
                $("#ImpactoAmbiental_Cord_Norte").prop("disabled", !sino);
                $("#ImpactoAmbiental_Nombre_Resto_Arq").prop("disabled", !sino);
            });

            $("#ImpactoAmbiental_Cantidad_Residuo_Flora").on('change', function () {
                ActualizarResiduoSolido();

            });
            $("#ImpactoAmbiental_Cantidad_Residuo_Fauna").on('change', function () {
                ActualizarResiduoSolido();
            });
            $("#ImpactoAmbiental_Cantidad_Residuo_Agua").on('change', function () {
                ActualizarResiduoSolido();
            });
            $("#ImpactoAmbiental_Id_Unidad_Residuo_Flora").on('change', function () {
                var unidad = $("#ImpactoAmbiental_Id_Unidad_Residuo_Flora").val();
                console.log(unidad);
                $("#ImpactoAmbiental_Id_Unidad_Cantidad_RS").val(unidad);
            });
            $("#ImpactoAmbiental_Id_Unidad_Residuo_Fauna").on('change', function () {
                var unidad = $("#ImpactoAmbiental_Id_Unidad_Residuo_Fauna").val();
                console.log(unidad);
                $("#ImpactoAmbiental_Id_Unidad_Cantidad_RS").val(unidad);
            });
            $("#ImpactoAmbiental_Id_Unidad_Residuo_Agua").on('change', function () {
                var unidad = $("#ImpactoAmbiental_Id_Unidad_Residuo_Agua").val();
                console.log(unidad);
                $("#ImpactoAmbiental_Id_Unidad_Cantidad_RS").val(unidad);
            });

            function ActualizarResiduoSolido() {
                var res_flora = $("#ImpactoAmbiental_Cantidad_Residuo_Flora").val();
                var res_fauna = $("#ImpactoAmbiental_Cantidad_Residuo_Fauna").val();
                var res_agua = $("#ImpactoAmbiental_Cantidad_Residuo_Agua").val();

                res_flora = res_flora == "" ? "0" : res_flora;
                res_fauna = res_fauna == "" ? "0" : res_fauna;
                res_agua = res_agua == "" ? "0" : res_agua;

                $("#ImpactoAmbiental_Cantidad_RS").val(parseInt(res_flora) + parseInt(res_fauna) + parseInt(res_agua));
            }
            function checkDataImpactoSuelo() {
                var tipo = $("#ImpactoAmbiental_Id_Tipo_Suelo");
                var area = $("#ImpactoAmbiental_Area_Suelo")
                var unidad_area = $("#ImpactoAmbiental_Id_Unidad_Area_Suelo")
                var cantidad = $("#ImpactoAmbiental_Cantidad_Suelo")
                var unidad_cantidad = $("#ImpactoAmbiental_Id_Unidad_Cantidad_Suelo")
                var lugar = $("#ImpactoAmbiental_Id_Lugar_Disposicion_Suelo")
                if (tipo.val() != 0 ||
                    area.val() != "" ||
                    unidad_area.val() != 0 ||
                    cantidad.val() != "" ||
                    unidad_cantidad.val() != 0 ||
                    lugar.val() != 0) {
                    $("#checkbox_suelo").prop("checked", true);
                    tipo.prop("disabled", false);
                    area.prop("disabled", false);
                    unidad_area.prop("disabled", false);
                    cantidad.prop("disabled", false);
                    unidad_cantidad.prop("disabled", false);
                    lugar.prop("disabled", false);
                }
            }
            function checkDataImpactoFlora() {
                var tipo = $("#ImpactoAmbiental_Id_Especie_Flora");
                var area = $("#ImpactoAmbiental_Unidad_Flora")
                var unidad_area = $("#ImpactoAmbiental_Id_Unidad_Flora")
                var cantidad = $("#ImpactoAmbiental_Cantidad_Residuo_Flora")
                var unidad_cantidad = $("#ImpactoAmbiental_Id_Unidad_Residuo_Flora")
                var lugar = $("#ImpactoAmbiental_Id_Lugar_Disposicion_Flora")
                if (tipo.val() != 0 ||
                    area.val() != "" ||
                    unidad_area.val() != 0 ||
                    cantidad.val() != "" ||
                    unidad_cantidad.val() != 0 ||
                    lugar.val() != 0) {
                    $("#checkbox_flora").prop("checked", true);
                    tipo.prop("disabled", false);
                    area.prop("disabled", false);
                    unidad_area.prop("disabled", false);
                    cantidad.prop("disabled", false);
                    unidad_cantidad.prop("disabled", false);
                    lugar.prop("disabled", false);
                }
            }
            function checkDataImpactoFauna() {
                var tipo = $("#ImpactoAmbiental_Id_Especie_Fauna");
                var area = $("#ImpactoAmbiental_Unidad_Fauna")
                var unidad_area = $("#ImpactoAmbiental_Id_Unidad_Fauna")
                var cantidad = $("#ImpactoAmbiental_Cantidad_Residuo_Fauna")
                var unidad_cantidad = $("#ImpactoAmbiental_Id_Unidad_Residuo_Fauna")
                var lugar = $("#ImpactoAmbiental_Id_Lugar_Disposicion_Fauna")
                if (tipo.val() != 0 ||
                    area.val() != "" ||
                    unidad_area.val() != 0 ||
                    cantidad.val() != "" ||
                    unidad_cantidad.val() != 0 ||
                    lugar.val() != 0) {
                    $("#checkbox_fauna").prop("checked", true);
