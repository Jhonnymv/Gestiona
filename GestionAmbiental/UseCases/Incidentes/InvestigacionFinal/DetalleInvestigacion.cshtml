        function CargarEvidencias(admin) {
        //Papeles
        if (nombresEvidencias.length === 4) {
            for (let i = 0; i < nombresEvidencias.length; i++) {
                if (nombresEvidencias[i].Categoria === "papel") {
                    CargarEvidenciasConNombre("Papel", nombresEvidencias[i].Evidencias, "#Evidencias_Lista_Papel", "#Evidencias_Completas_Papel",admin);
                    break;
                }
            }
        }
        else if (papeles.length > 0) {
            var papeles_valores = JSON.parse(papeles.replace(/&quot;/g, '"'));
            CargarEvidenciasSinNombre("Papel", papeles_valores, "#Evidencias_Lista_Papel", "#Evidencias_Completas_Papel",admin);
        }
        //Personas
        if (nombresEvidencias.length === 4) {
            for (let i = 0; i < nombresEvidencias.length; i++) {
                if (nombresEvidencias[i].Categoria === "persona") {
                    CargarEvidenciasConNombre("Persona", nombresEvidencias[i].Evidencias, "#Evidencias_Lista_Persona", "#Evidencias_Completas_Persona", admin);
                    break;
                }
            }
        }
        else if (personas.length > 0) {
            var personas_valores = JSON.parse(personas.replace(/&quot;/g, '"'));
            CargarEvidenciasSinNombre("Persona", personas_valores, "#Evidencias_Lista_Persona", "#Evidencias_Completas_Persona", admin);
        }
        //Posiciones
        if (nombresEvidencias.length === 4) {
            for (let i = 0; i < nombresEvidencias.length; i++) {
                if (nombresEvidencias[i].Categoria === "posicion") {
                    CargarEvidenciasConNombre("Posicion", nombresEvidencias[i].Evidencias, "#Evidencias_Lista_Posicion", "#Evidencias_Completas_Posicion", admin);
                    break;
                }
            }
        }
        else if (posiciones.length > 0) {
            var posiciones_valores = JSON.parse(posiciones.replace(/&quot;/g, '"'));
            CargarEvidenciasSinNombre("Posicion", posiciones_valores, "#Evidencias_Lista_Posicion", "#Evidencias_Completas_Posicion", admin);
