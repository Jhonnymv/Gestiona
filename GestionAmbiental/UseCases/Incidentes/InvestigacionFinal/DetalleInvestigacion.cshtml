                </table>
            </div>
        </div>
        <!-- SEGUIMINETO Y VERIFICACION -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">SEGUIMIENTO Y VERIFICACIÓN</h5>
            </div>
        </div>
        <div class="row mb-2">
