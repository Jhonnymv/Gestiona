</div>
@section Scripts{ 
    <script type="text/javascript">
        $(document).ready(function () {
            GetInvolucrados();
            GetProductos();
            GetCausas();
            GetAcciones();
            GetAccionesVerificacion();

            var papeles = '@Model.Evidencias_Completas_Papel';
            var personas = '@Model.Evidencias_Completas_Persona';
            var posiciones = '@Model.Evidencias_Completas_Posicion';
            var partes = '@Model.Evidencias_Completas_Partes';
            //Papeles
            if (papeles.length > 0) {
                var papeles_valores = JSON.parse(papeles.replace(/&quot;/g, '"'));
                var html_papeles = "";
                for (var i = 0; i < papeles_valores.length; i++)
                    html_papeles += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + papeles_valores[i] + "&tipo=papel\">Evidencia Papel</a></p>";

                $("#Evidencias_Lista_Papel").html(html_papeles);
                $("#Evidencias_Completas_Papel").val(papeles_valores);
            }
            //Personas
            if (personas.length > 0) {
                var personas_valores = JSON.parse(personas.replace(/&quot;/g, '"'));
                var html_personas = "";
                for (var i = 0; i < personas_valores.length; i++)
                    html_personas += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + personas_valores[i] + "&tipo=persona\">Evidencia Persona</a></p>";

                $("#Evidencias_Lista_Persona").html(html_personas);
                $("#Evidencias_Completas_Persona").val(personas_valores);
            }
            //Posiciones
            if (posiciones.length > 0) {
                var posiciones_valores = JSON.parse(posiciones.replace(/&quot;/g, '"'));
                var html_posiciones = "";
                for (var i = 0; i < posiciones_valores.length; i++)
                    html_posiciones += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + posiciones_valores[i] + "&tipo=posicion\">Evidencia Posición</a></p>";

                $("#Evidencias_Lista_Posicion").html(html_posiciones);
                $("#Evidencias_Completas_Posicion").val(posiciones_valores);
            }
            //Partes
            if (partes.length > 0) {
                var partes_valores = JSON.parse(partes.replace(/&quot;/g, '"'));
                var html_partes = "";
                for (var i = 0; i < partes_valores.length; i++)
                    html_partes += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + partes_valores[i] + "&tipo=parte\">Evidencia Persona</a></p>";

                $("#Evidencias_Lista_Partes").html(html_partes);
                $("#Evidencias_Completas_Partes").val(partes_valores);
            }
        });
        function GetInvolucrados() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/ListarInvolucrados",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val()
                },
                success: (response) => {
                    $('#tabla_involucrados tbody').empty()
                    $('#tabla_involucrados tbody').html(response.filas_involucrados)
                    $('#NInvolucrados').val(response.nInvolucrados);
                }
            });
        }
        function GetProductos() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/ListarProductoDerramado",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val()
                },
                success: (response) => {
                    $('#tabla_productos tbody').empty()
                    $('#tabla_productos tbody').html(response.filas_productos)
                    $('#NInvolucrados').val(response.nProductos);
                }
            });
        }
        function GetCausas() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/ListarCausas",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val()
                },
                success: (response) => {
                    $('#tabla_causas_inmediatas tbody').empty();
                    $('#tabla_causas_inmediatas tbody').html(response.filas_causas_inmediatas);
                    $('#tabla_causas_basicas tbody').empty();
                    $('#tabla_causas_basicas tbody').html(response.filas_causas_basicas);
                    $('#NCausas').val(response.nCausas);
                }
            });
        }
        function GetAcciones() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/ListarAcciones",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val()
                },
                success: (response) => {
                    $('#tabla_acciones_inmediatas tbody').empty();
                    $('#tabla_acciones_inmediatas tbody').html(response.filas_acciones_inmediatas);
                    $('#tabla_acciones_correctivas tbody').empty();
                    $('#tabla_acciones_correctivas tbody').html(response.filas_acciones_correctivas);
                    $('#NAcciones').val(response.nAcciones);
                }
            });
        }
        function GetAccionesVerificacion() {
            $.ajax({
                type: "POST",
                url: "/InvestigacionFinal/ListarAccionesVerificacion",
                data: {
                    IdInvestigacion: $("#Id_Investigacion_Final").val()
                },
                success: (response) => {
                    $('#tabla_acciones tbody').empty();
                    $('#tabla_acciones tbody').html(response.filas_acciones);
                    var nAcciones = response.nAcciones;
                    var nVerificado = response.nVerificado;
                    var porcentaje = (nVerificado * 100 / nAcciones).toString() + "%";
                    $('#progreso_vefirifacion').width(porcentaje);
                    $('#progreso_vefirifacion').text(porcentaje);
                }
            });
        }
    </script>
} 