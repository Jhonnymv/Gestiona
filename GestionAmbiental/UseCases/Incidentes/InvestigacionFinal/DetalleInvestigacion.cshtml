            </div>
        </div>
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_acciones_correctivas">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Acción Tomada</th>
                            <th>Responsable Marcobre</th>
                            <th>Responsable Contratista</th>
                            <th>Fecha</th>
                            <th>Estatus</th>
                        </tr>
                    </thead>
