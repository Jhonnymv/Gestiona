@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {

            checkDataImpactoSuelo();
            checkDataImpactoFlora();
            checkDataImpactoFauna();
            checkDataImpactoAgua();
            checkDataImpactoArqueologico();

            GetInvolucrados();
            GetProductos();
            GetCausas();
            GetAcciones();

            var papeles = '@Model.Evidencias_Completas_Papel';
            var personas = '@Model.Evidencias_Completas_Persona';
            var posiciones = '@Model.Evidencias_Completas_Posicion';
            var partes = '@Model.Evidencias_Completas_Partes';
            //Papeles
            if (papeles.length > 0) {
                var papeles_valores = JSON.parse(papeles.replace(/&quot;/g, '"'));
                var html_papeles = "";
                for (var i = 0; i < papeles_valores.length; i++) {
                    if ($("#Estado").val() == "PendienteInvestigacion")
                        html_papeles += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + papeles_valores[i] + "','Papel')><a href=\"/InvestigacionFinal/Download?fileName=" + papeles_valores[i] + "&tipo=papel\">Evidencia Papel</a> </p>";
                    else
                        html_papeles += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + papeles_valores[i] + "&tipo=papel\">Evidencia Papel</a></p>"
                }
                $("#Evidencias_Lista_Papel").html(html_papeles);
                $("#Evidencias_Completas_Papel").val(papeles_valores);
            }
            //Personas
            if (personas.length > 0) {
                var personas_valores = JSON.parse(personas.replace(/&quot;/g, '"'));
                var html_personas = "";
                for (var i = 0; i < personas_valores.length; i++)
                    if ($("#Estado").val() == "PendienteInvestigacion")
                        html_personas += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + personas_valores[i] + "','Persona')><a href=\"/InvestigacionFinal/Download?fileName=" + personas_valores[i] + "&tipo=persona\">Evidencia Persona</a></p>";
                    else
                        html_personas += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + personas_valores[i] + "&tipo=persona\">Evidencia Persona</a></p>";

                $("#Evidencias_Lista_Persona").html(html_personas);
                $("#Evidencias_Completas_Persona").val(personas_valores);
            }
            //Posiciones
            if (posiciones.length > 0) {
                var posiciones_valores = JSON.parse(posiciones.replace(/&quot;/g, '"'));
                var html_posiciones = "";
                for (var i = 0; i < posiciones_valores.length; i++)
                    if ($("#Estado").val() == "PendienteInvestigacion")
                        html_posiciones += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + posiciones_valores[i] + "','Posicion')><a href=\"/InvestigacionFinal/Download?fileName=" + posiciones_valores[i] + "&tipo=posicion\">Evidencia Posición</a></p>";
                    else
                        html_posiciones += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + posiciones_valores[i] + "&tipo=posicion\">Evidencia Posición</a></p>";

                $("#Evidencias_Lista_Posicion").html(html_posiciones);
                $("#Evidencias_Completas_Posicion").val(posiciones_valores);
            }
            //Partes
            if (partes.length > 0) {
                var partes_valores = JSON.parse(partes.replace(/&quot;/g, '"'));
                var html_partes = "";
                for (var i = 0; i < partes_valores.length; i++)
