        function EliminarEvidencia(evidencia,tipo) {
            if ($("#Estado").val() == "PendienteInvestigacion")
                if (confirm('¿Está seguro que desea eliminar esta evidencia?'))
                    $.ajax({
                        type: "POST",
                        url: "/InvestigacionFinal/EliminarEvidencia",
                        data: {
                            IdInvestigacion: $("#Id_Investigacion_Final").val(),
                            Evidencia: evidencia,
                            Tipo: tipo
                        },
                        success: (response) => {
                            var evidencias = response.evidencia;
                            switch (tipo) {
                                case "Papel":
                                    var html_papeles = "";
                                    for (var i = 0; i < evidencias.length; i++) {
                                        if ($("#Estado").val() == "PendienteInvestigacion")
                                            html_papeles += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + evidencia[i] + "','Papel')><a href=\"/InvestigacionFinal/Download?fileName=" + evidencias[i] + "&tipo=papel\">Evidencia Papel " + (i + 1) +"</a></p>";
                                        else
                                            html_papeles += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + evidencias[i] + "&tipo=papel\">Evidencia Papel " + (i + 1) +"</a></p>"
                                    }
                                    $("#Evidencias_Lista_Papel").html(html_papeles);
                                    $("#Evidencias_Completas_Papel").val(evidencia);
                                    break;
                                case "Parte":
                                    var html_personas = "";
                                    for (var i = 0; i < evidencias.length; i++)
                                        if ($("#Estado").val() == "PendienteInvestigacion")
                                            html_personas += "<p><img class=\"icon-btn\" src=\"../img/icons/cross.png\" onclick=EliminarEvidencia('" + evidencias[i] + "','Persona')><a href=\"/InvestigacionFinal/Download?fileName=" + evidencias[i] + "&tipo=persona\">Evidencia Persona " + (i + 1) +"</a> </p>";
                                        else
                                            html_personas += "<p><a href=\"/InvestigacionFinal/Download?fileName=" + evidencias[i] + "&tipo=persona\">Evidencia Persona " + (i + 1) +"</a></p>";

