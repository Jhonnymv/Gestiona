        //Evidencias Papel
        $("#Evidencias_Papel").change(function () {
                $("#danger_evidencia_papel").html("");
                //Validacion del tamaño del archivo
                var maxSize = $("#Evidencias_Papel").data('max-size');
                var archivos = $("#Evidencias_Papel").get(0).files;

                if (archivos.length > 0) {
                    var fileSize = 0
                    for (var i = 0; i < archivos.length; i++) {
                        fileSize += archivos[i].size;
                    }
                    if (fileSize > maxSize) {
                        this.value = '';
                        var filesname = this.files.length + " Archivos";
                        $("#danger_evidencia_papel").html("El  archivo supera el límite permitido de 8MB<br/>");
                        return;
                    }
                    var filesName = "";
                    for (var i = 0; i < archivos.length; i++) {
                        switch (this.value.match(/\.([^\.]+)$/)[1]) {
                            case 'jpg':
                            case 'JPG':
                            case 'jpeg':
                            case 'JPEG':
                            case 'png':
                            case 'PNG':
                            case 'xls':
                            case 'xlsx':
                            case 'doc':
                            case 'docx':
                            case 'pdf':
                                filesName += archivos[i].name + "<br/>";
                                break;
                            default:
                                this.value = '';
                                var filesname = this.files.length + " Archivos";
                                $("#files_name_papel").text(filesname);
                                $("#danger_evidencia_papel").html("No se admiten este tipo de archivos<br/>");
                                return;
                        }
                    }
                    filesName.length > 0 ? $("#files_name_papel").html(filesName) : null;
                }
            });
