@model GestionAmbiental.UseCases.Incidentes.InvestigacionFinal.EditarInvestigacionModel
@{
    ViewData["Title"] = "EditarInvestigacion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Editar Investigación Final del Incidente Ambiental</h2>
        </div>
    </div>
    <form class="form-group" id="formEditarInvestigacion" asp-action="EditarInvestigacion" asp-controller="InvestigacionFinal" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="Id_Investigacion_Final" value="@Model.Id_Investigacion_Final" />
        <input type="hidden" asp-for="Opcion" />
        <input type="hidden" asp-for="NInvolucrados" />
        <input type="hidden" asp-for="NProductos" />
        <input type="hidden" asp-for="NAcciones" />
        <input type="hidden" asp-for="NCausas" />
        <input type="hidden" asp-for="Estado" value="@Model.Estado" />
        <!-- DATOS DEL TITULAR MINERO -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">DATOS DEL TITULAR MINERO</h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Razón Social</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Marcobre SAC" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>RUC</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="20508972734" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Actividad</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Mineria" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Domicilio Legal</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Jr. Lorenzo Bernini 149, Oficina 301, San Borja - Lima" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Unidad Minera</label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <input type="text" class="form-control" value="Mina Justa" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Num_Trabajadores"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Num_Trabajadores"></span>
                <input type="number" class="form-control" asp-for="Num_Trabajadores" />
            </div>
        </div>
        <!-- DATOS DE LA EMPRESA CONTRATISTA (Llenar esta sección en caso el incidente NO haya sido ocasionado por el titular minero) -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    DATOS DE LA EMPRESA CONTRATISTA O SUBCONTRATISTA
                </h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-12" style="text-align:center; background-color:#e97f7f;">
                <h5 style="color:white;margin:4px;">
                    Contratista (Llenar esta sección en caso el incidente haya sido ocasionado por un subcontratista)
                </h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Razon_Social_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Razon_Social_Contratista"></span>
                <input type="text" class="form-control" asp-for="Razon_Social_Contratista" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="RUC_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="RUC_Contratista"></span>
                <input type="text" class="form-control" asp-for="RUC_Contratista" maxlength="11" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Actividad_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Actividad_Contratista"></span>
                <input type="text" class="form-control" asp-for="Actividad_Contratista" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Domicilio_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-6 col-lg-6">
                <span class="text-danger" asp-validation-for="Domicilio_Contratista"></span>
                <input type="text" class="form-control" asp-for="Domicilio_Contratista" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Num_Trabajadores_Contratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Num_Trabajadores_Contratista"></span>
                <input type="number" class="form-control" asp-for="Num_Trabajadores_Contratista" />
            </div>
        </div>
        <div class="row mb-2" style="background-color:#e97f7f">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    Subcontratista (Llenar esta sección en caso el incidente haya sido ocasionado por la subcontratista)
                </h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Razon_Social_SubContratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Razon_Social_SubContratista"></span>
                <input type="text" class="form-control" asp-for="Razon_Social_SubContratista" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="RUC_SubContratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="RUC_SubContratista"></span>
                <input type="text" class="form-control" asp-for="RUC_SubContratista" maxlength="11" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Actividad_SubContratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Actividad_SubContratista"></span>
                <input type="text" class="form-control" asp-for="Actividad_SubContratista" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Domicilio_SubContratista"></label>
            </div>
            <div class="col-sm-12 col-md-6 col-lg-6">
                <span class="text-danger" asp-validation-for="Domicilio_SubContratista"></span>
                <input type="text" class="form-control" asp-for="Domicilio_SubContratista" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Num_Trabajadores_SubContratista"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Num_Trabajadores_SubContratista"></span>
                <input type="number" class="form-control" asp-for="Num_Trabajadores_SubContratista" />
            </div>
        </div>
        <!-- DATOS DEL INCIDENTE AMBIENTAL -->
        <div class="row mb-2" style="background-color:#2e6793">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">INFORMACIÓN DEL INCIDENTE AMBIENTAL</h5>
            </div>
        </div>
        <div class="row mb-2" style="background-color:#e97f7f">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    Datos del incidente
                </h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Tipo_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Tipo_Incidente"></span>
                <select class="form-control" asp-items="@ViewBag.Tipo_Incidente" asp-for="Id_Tipo_Incidente"></select>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Nivel_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Nivel_Incidente"></span>
                <select class="form-control" asp-items="@ViewBag.Nivel_Incidente" asp-for="Id_Nivel_Incidente"></select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Lugar_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-4 col-lg-4">
                <span class="text-danger" asp-validation-for="Lugar_Incidente"></span>
                <input type="text" class="form-control" asp-for="Lugar_Incidente" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label>Coordenadas UTM DATUM WGS84</label>
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <label asp-for="Coordenada_Este"></label>
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <span class="text-danger" asp-validation-for="Coordenada_Este"></span>
                <input type="text" class="form-control" maxlength="7" asp-for="Coordenada_Este">
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <label asp-for="Coordenada_Norte"></label>
            </div>
            <div class="col-sm-12 col-md-1 col-lg-1">
                <span class="text-danger" asp-validation-for="Coordenada_Norte"></span>
                <input type="text" class="form-control" maxlength="7" asp-for="Coordenada_Norte" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Localidad"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Localidad"></span>
                <input type="text" class="form-control" asp-for="Localidad" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Distrito"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Distrito"></span>
                <input type="text" class="form-control" asp-for="Distrito" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Provincia"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Provincia"></span>
                <input type="text" class="form-control" asp-for="Provincia" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Departamento"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Departamento"></span>
                <input type="text" class="form-control" asp-for="Departamento" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Fecha_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Fecha_Incidente"></span>
                <input type="date" class="form-control" asp-for="Fecha_Incidente" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Hora_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Hora_Incidente"></span>
                <input type="time" class="form-control" asp-for="Hora_Incidente" />
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Fecha_Inicio_Investigacion"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Fecha_Inicio_Investigacion"></span>
                <input type="date" class="form-control" asp-for="Fecha_Inicio_Investigacion" />
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Turno"></label>
            </div>
            <div class="col-sm-12 col-md-2 col-lg-2">
                <span class="text-danger" asp-validation-for="Turno"></span>
                <select class="form-control" asp-for="Turno">
                    <option value="">--SELECCIONE--</option>
                    <option value="Día">Día</option>
                    <option value="Noche">Noche</option>
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Descripcion_Incidente"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Descripcion_Incidente"></span>
                <textarea class="form-control" asp-for="Descripcion_Incidente" maxlength="600" rows="3"></textarea>
            </div>
        </div>
        <!-- DATOS DE LOS INVOLUCRADOS -->
        <div class="row mb-2" style="background-color:#e97f7f">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    Datos de los involucrados
                </h5>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-12 col-md-2 col-lg-2">
                <label asp-for="Id_Gerencia_Responsable"></label>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <span class="text-danger" asp-validation-for="Id_Gerencia_Responsable"></span>
                <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Id_Gerencia_Responsable"></select>
            </div>
        </div>
        @if (Model.Estado == "PendienteInvestigacion")
        {
            <div class="row mb-2 justify-content-center">
                <div class="col-sm-12 col-md-10 col-lg-10">

                    <button id="btn_nuevo_involucrado" type="button" class="btn btn-danger">Agregar Involucrado</button>

                </div>
            </div>
        }
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_involucrados">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Tipo</th>
                            <th>Nombres y Apellidos</th>
                            <th>DNI/Pasaporte</th>
                            <th>Edad</th>
                            <th>Puesto de Trabajo</th>
                            <th>Empresa</th>
                            @if (Model.Estado == "PendienteInvestigacion")
                            {
                                <th></th>
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- DATOS DEL DERRAME -->
        <div class="row mb-2" style="background-color:#e97f7f">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    Datos del derrame o fuga (Llenar esta sección si el incidente ambiental corresponde a un derrame o fuga de un producto)
                </h5>
            </div>
        </div>
        @if (Model.Estado == "PendienteInvestigacion")
        {
            <div class="row mb-2 justify-content-center">
                <div class="col-sm-12 col-md-10 col-lg-10">
                    <button id="btn_nueva_producto" type="button" class="btn btn-danger">Agregar Producto</button>
                </div>
            </div>
        }
        <div class="row mb-2 justify-content-center">
            <div class="col-sm-12 col-md-10 col-lg-10">
                <table class="table" id="tabla_productos">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Producto</th>
                            <th>Tipo de Producto</th>
                            <th>Estado del Producto</th>
                            <th>Cantidad derramada</th>
                            <th>Equipo(s) que originó u originaron el incidente</th>
                            <th>Estado del equipo después del incidente</th>
                            <th>Cantidad producto recuperado</th>
                            <th>Cantidad de producto no recuperado</th>
                            @if (Model.Estado == "PendienteInvestigacion")
                            {
                                <th></th>
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Impactos Ambientales -->
        <div class="row mb-2" style="background-color:#e97f7f">
            <div class="col-12" style="text-align:center">
                <h5 style="color:white;margin:4px;">
                    Impactos Ambientales o daños derivados del incidente
                </h5>
            </div>
        </div>
        <!-- Suelo -->
        <div class="row mb-2 rounded" style="border:solid 1px #2e6793">
            <div class="col-sm-12 col-md-2 col-lg-2 d-flex justify-content-center" style="border-right: solid 1px #2e6793;">
                <div class="form-check align-self-center">
                    <input class="form-check-input position-static mr-1" type="checkbox" id="checkbox_suelo">
                    <label class="form-check-label font-weight-bold">SUELO</label>
                </div>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <div class="row mb-2 mt-2">
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Id_Tipo_Suelo"></label>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Tipo_Suelo"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Tipo_Suelo" asp-items="ViewBag.TiposSuelo" disabled>
                        </select>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Area_Suelo"></label>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Area_Suelo"></span>
                        <input type="number" class="form-control" asp-for="ImpactoAmbiental.Area_Suelo" disabled />
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Unidad_Area_Suelo"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Unidad_Area_Suelo" asp-items="ViewBag.Unidad_Area" disabled>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Cantidad_Suelo"></label>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Cantidad_Suelo"></span>
                        <input type="number" class="form-control" asp-for="ImpactoAmbiental.Cantidad_Suelo" disabled />
                    </div>

                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Unidad_Cantidad_Suelo"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Unidad_Cantidad_Suelo" asp-items="ViewBag.Unidad_Peso" disabled>
                        </select>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Id_Lugar_Disposicion_Suelo"></label>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Lugar_Disposicion_Suelo"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Lugar_Disposicion_Suelo" asp-items="ViewBag.LugaresDisposicion" disabled>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <!-- Fin Suelo -->
        <!-- Flora -->
        <div class="row mb-2 rounded" style="border:solid 1px #2e6793">
            <div class="col-sm-12 col-md-2 col-lg-2 d-flex justify-content-center" style="border-right: solid 1px #2e6793;">
                <div class="form-check align-self-center">
                    <input class="form-check-input position-static mr-1" type="checkbox" id="checkbox_flora">
                    <label class="form-check-label font-weight-bold">FLORA</label>
                </div>
            </div>
            <div class="col-sm-12 col-md-10 col-lg-10">
                <div class="row mb-2 mt-2">
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Id_Especie_Flora"></label>
                    </div>
                    <div class="col-sm-12 col-md-4 col-lg-4">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Especie_Flora"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Especie_Flora" asp-items="ViewBag.TiposFlora" disabled>
                        </select>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <label asp-for="ImpactoAmbiental.Unidad_Flora"></label>
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Unidad_Flora"></span>
                        <input type="number" class="form-control" asp-for="ImpactoAmbiental.Unidad_Flora" disabled />
                    </div>
                    <div class="col-sm-12 col-md-2 col-lg-2">
                        <span class="text-danger" asp-validation-for="ImpactoAmbiental.Id_Unidad_Flora"></span>
                        <select class="form-control" asp-for="ImpactoAmbiental.Id_Unidad_Flora" asp-items="ViewBag.Unidad_Cantidad" disabled>
                        </select>
