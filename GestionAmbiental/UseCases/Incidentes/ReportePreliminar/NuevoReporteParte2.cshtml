                                        <select class="form-control" asp-items="@ViewBag.Actos" id="select_actos"></select>
                                    </div>
                                </div>
                                <div class="row input_container" id="condiciones_subestandar" style="display:none">
                                    <div class="col-12">
                                        <label>Condición Subestándar</label>
                                        <select class="form-control" asp-items="@ViewBag.Condiciones" id="select_condiciones"></select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_causa">Guardar</button>
                                        <button type="button" class="btn btn-mc-success" id="btn_editar_causa" style="display:none">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade mc-modal" id="Modal_Enviando_Correo" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label class="text-white">Notificando al Supervisor de Medio Ambiente</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Guardando Estado-->
<div class="modal fade mc-modal" id="Modal_Guardando_Estado" tabindex="-1" aria-hidden="true" style="display: none;">
