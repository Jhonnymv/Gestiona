@model GestionAmbiental.UseCases.Incidentes.ReportePreliminar.ReporteParte2Model
@{
    ViewData["Title"] = "Nuevo Reporte Incidente Menor";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="incidentes">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title incidentes-opacity-color">
                <h3>Editar Reporte Incidente Menor</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_nuevoReporteParte2" asp-action="NuevoReporteParte2" asp-controller="ReportePreliminar" method="post" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" asp-for="Id_Reporte_Preliminar" value="@Model.Id_Reporte_Preliminar" />
                <input type="hidden" asp-for="Opcion" />
                <input type="hidden" asp-for="NCausas" />
                <input type="hidden" asp-for="NInvolucrados" />
                <input type="hidden" asp-for="NAcciones" />
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center  ">CAUSAS INMEDIATAS DEL INCIDENTE</span>
                    </div>
                    <div class="details-content">
                        <div class="row-center-center col-12">
                            <div class="col-12 col-xl-4">
                                <a class="btn btn-special-action incidentes-color" id="btn_nueva_causa" data-bs-toggle="modal" data-bs-target="">
                                    Agregar Causa
                                </a>
                            </div>
                        </div>
                        <div class="incidentes">
                            <div class="tertiary-content col-12">
                                <div class="table-responsive incidentes-color">
                                    <table class="table" id="tabla_causas">
                                        <thead>
                                            <tr>
                                                <th>Acto/Condición Subestándar</th>
                                                <th>Descripción</th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="100">No hay registros</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Otra_Causa"></label>
                                <span class="text-danger" asp-validation-for="Otra_Causa"></span>
                                <textarea class="form-control" asp-for="Otra_Causa" maxlength="300" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center  ">DATOS DE LOS INVOLUCRADOS</span>
                    </div>
                    <div class="details-content">
                        <div class="row-center-center col-12">
                            <div class="col-12 col-xl-4">
                                <a class="btn btn-special-action incidentes-color" id="btn_nuevo_involucrado" data-bs-toggle="modal" data-bs-target="">
                                    Agregar Involucrado
                                </a>
                            </div>
                        </div>
                        <div class="row-center-center col-12">
                            <div class="col-12 col-xl-4">
                                <span class="text-danger" id="alert_involucrados"></span>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Id_Gerencia_Responsable"></label>
                                <span class="text-danger" asp-validation-for="Id_Gerencia_Responsable"></span>
                                <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Id_Gerencia_Responsable"></select>
                            </div>
                        </div>
                        <div class="incidentes">
                            <div class="tertiary-content col-12">
                                <div class="table-responsive incidentes-color">
                                    <table class="table" id="tabla_involucrados">
                                        <thead>
                                            <tr>
                                                <th>Tipo</th>
                                                <th>Nombres y Apellidos</th>
                                                <th>Correo Electrónico</th>
                                                <th>Celular</th>
                                                <th>Puesto de Trabajo</th>
                                                <th>Turno</th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="100">No hay registros</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center  ">ACCIONES INMEDIATAS</span>
                    </div>
                    <div class="details-content">
                        <div class="row-center-center col-12">
                            <div class="col-12 col-xl-4">
                                <a class="btn btn-special-action incidentes-color" id="btn_nueva_accion" data-bs-toggle="modal" data-bs-target="">
                                    Agregar Acción
                                </a>
                            </div>
                        </div>
                        <div class="row-center-center col-12">
                            <div class="col-12 col-xl-4">
                                <span class="text-danger" id="alert_acciones"></span>
                            </div>
                        </div>
                        <div class="incidentes">
                            <div class="tertiary-content col-12">
                                <div class="table-responsive incidentes-color">
                                    <table class="table" id="tabla_acciones">
                                        <thead>
                                            <tr>
                                                <th>Acción Inmediata</th>
                                                <th>Responsable Marcobre</th>
                                                <th>Responsable Contratista</th>
                                                <th>Fecha</th>
                                                <th>Estatus</th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="100">No hay observaciones</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Comentario_Accion">Comentario</label>
                                <span class="text-danger" asp-validation-for="Comentario_Accion"></span>
                                <input type="text" class="form-control" asp-for="Comentario_Accion" maxlength="250" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center  ">SEGUIMIENTO</span>
                    </div>
                    <div class="details-content">
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-12">
                            <label asp-for="Id_Supervisor">Supervisor de Medio Ambiente encargado del seguimiento</label>
                            <span class="text-danger" asp-validation-for="Id_Supervisor"></span>
                            <select class="form-control" asp-items="@ViewBag.Supervisor" asp-for="Id_Supervisor"></select>
                        </div>
                    </div>
                </div>
                </div>

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center  ">EVIDENCIAS: FOTOGRAFÍAS, PLANOS, DIAGRAMAS, ENTRE OTROS QUE APORTEN INFORMACIÓN SOBRE EL INCIDENTE (DEBEN CONTEMPLAR FECHA, HORA Y GEOREFERENCIA EN UTM DATUM WGS84)</span>
                    </div>
                    <div class="details-content">
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Evidencias">Seleccionar Evidencias</label>
                                <span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
                                    <span id="danger_evidencia" class=""></span>
                                </span>
                                <input type="file" class="form-control" asp-for="Evidencias" accept=".jpg,.jpeg,.png" data-max-size="12000000" multiple>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="button-container">
                        <div></div>
                        <div>
                            <a asp-action="Resumen" asp-controller="ReportePreliminar" class="btn btn-mc-outline-danger">Volver</a>
                            <button id="boton_guardar_estado" type="button" class="btn btn-mc-outline-success">Guardar Estado</button>
                            <button id="boton_completar" type="button" class="btn btn-mc">Completar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Nuevo Involucrado-->
<div class="modal fade" id="modal_involucrado" tabindex="-1" aria-labelledby="titulo_modal_involucrado" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3> Agregar involucrado</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="Id_Involucrado" />
                                    <div class="col-sm-12 col-md-12 col-lg-12">
                                        <span class="text-danger" id="danger_involucrado"></span>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Tipo de Involucrado</label>
                                        <select class="form-control" id="select_tipo_involucrado">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="Supervisor Inmediato (Titular Minero)">Supervisor Inmediato (Titular Minero)</option>
                                            <option value="Supervisor Inmediato (Contratista)">Supervisor Inmediato (Contratista)</option>
                                            <option value="Supervisor Marcobre">Supervisor Marcobre</option>
                                            <option value="Otro Involucrado">Otro Involucrado</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_nobmres_apellidos" style="display:none">Nombres y Apellidos</label>
                                        <select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios" style="display:none"></select>
                                        <input type="text" class="form-control mb-2" id="input_nombres" style="display:none" placeholder="Nombres" />
                                        <input type="text" class="form-control" id="input_apellidos" style="display:none" placeholder="Apellidos" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_correo" style="display:none">Correo Electrónico</label>
                                        <input type="email" class="form-control" id="input_correo" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_puesto" style="display:none">Puesto de Trabajo</label>
                                        <input type="text" class="form-control" id="input_puesto" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_turno" style="display:none">Turno</label>
                                        <select class="form-control" id="select_turno" style="display:none">
                                            <option value="">--SELECCIONE--</option>
                                            <option value="Dia">Día</option>
                                            <option value="Noche">Noche</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label id="label_celular" style="display:none">Celular:</label>
                                        <input type="text" class="form-control" id="input_celular" maxlength="9" style="display:none" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="button" class="btn btn-mc me-2" id="btn_guardar_involucrado">Guardar</button>
                                        <button type="button" class="btn btn-mc-success" id="btn_editar_involucrado" style="display:none">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Nuevo Acciones Post Incidente-->
<div class="modal fade" id="modal_accion" tabindex="-1" aria-labelledby="titulo_modal_accion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-incidentes">
            <div class="modal-content">
                <div class="incidentes">
                    <div class="image-header-container">
                        <div class="header-title incidentes-opacity-color">
                            <h3> Agregar Acción Inmediata</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
