        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript" src="~/js/UseCases/Incidentes/ReportePreliminar/NuevoReporteParte2.js"></script>
    <script type="text/javascript">

        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminar/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        incidentesStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
    </script>
}