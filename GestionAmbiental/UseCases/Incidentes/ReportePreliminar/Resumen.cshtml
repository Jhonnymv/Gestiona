@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminar/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        incidentesStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/ReportePreliminar/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val(),
                    "id_asesor": $("#filtro_asesores").val(),
                    "id_usuario": $("#filtro_usuarios").val(),
                    "id_gerencia": $("#filtro_gerencia").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_reportes tbody').empty();
                    $('#tabla_resumen_reportes tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
    </script>
}
