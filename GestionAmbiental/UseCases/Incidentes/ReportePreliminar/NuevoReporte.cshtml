@model GestionAmbiental.UseCases.Incidentes.ReportePreliminar.ReporteParte1Model
@{
    ViewData["Title"] = "NuevoReporte";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-12 titulo-pagina">
                <h2>Nuevo Reporte Preliminar</h2>
            </div>
        </div>
        <form class="form-group" id="form_nuevoReporte" asp-action="NuevoReporte" asp-controller="ReportePreliminar" method="post" enctype="multipart/form-data" autocomplete="off">
            <input type="hidden" asp-for="Opcion" />
            <!-- DATOS DEL TITULAR MINERO -->
            <div class="row mb-2" style="background-color:#2e6793">
                <div class="col-12" style="text-align:center">
                    <h5 style="color:white;margin:4px;">DATOS DEL TITULAR MINERO</h5>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label>Razón Social</label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <input type="text" class="form-control" value="Marcobre SAC" disabled />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label>RUC</label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <input type="text" class="form-control" value="20508972734" disabled />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label>Actividad</label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <input type="text" class="form-control" value="Mineria" disabled />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label>Domicilio Legal</label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <input type="text" class="form-control" value="Jr. Lorenzo Bernini 149, Oficina 301, San Borja - Lima" disabled />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label>Unidad Minera</label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <input type="text" class="form-control" value="Mina Justa" disabled />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Num_Trabajadores"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Num_Trabajadores"></span>
                    <input type="number" class="form-control" asp-for="Num_Trabajadores" />
                </div>
            </div>
            <!-- DATOS DE LA EMPRESA CONTRATISTA (Llenar esta sección en caso el incidente NO haya sido ocasionado por el titular minero) -->
            <div class="row mb-2" style="background-color:#2e6793">
                <div class="col-12" style="text-align:center">
                    <h5 style="color:white;margin:4px;">DATOS DE LA EMPRESA CONTRATISTA (Llenar esta sección en caso el incidente haya sido ocasionado por un contratista)</h5>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Razon_Social_Contratista"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Razon_Social_Contratista"></span>
                    <input type="text" class="form-control" asp-for="Razon_Social_Contratista" />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="RUC_Contratista"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="RUC_Contratista"></span>
                    <input type="text" class="form-control" asp-for="RUC_Contratista" maxlength="11"/>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Actividad_Contratista"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Actividad_Contratista"></span>
                    <input type="text" class="form-control" asp-for="Actividad_Contratista" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Domicilio_Contratista"></label>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-6">
                    <span class="text-danger" asp-validation-for="Domicilio_Contratista"></span>
                    <input type="text" class="form-control" asp-for="Domicilio_Contratista" />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Num_Trabajadores_Contratista"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Num_Trabajadores_Contratista"></span>
                    <input type="number" class="form-control" asp-for="Num_Trabajadores_Contratista" />
                </div>
            </div>
            <!-- DATOS DEL INCIDENTE AMBIENTAL -->
            <div class="row mb-2" style="background-color:#2e6793">
                <div class="col-12" style="text-align:center">
                    <h5 style="color:white;margin:4px;">DATOS DEL INCIDENTE AMBIENTAL</h5>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Id_Tipo_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-4">
                    <span class="text-danger" asp-validation-for="Id_Tipo_Incidente"></span>
                    <select class="form-control" asp-items="@ViewBag.Tipo_Incidente" asp-for="Id_Tipo_Incidente"></select>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Id_Nivel_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-4">
                    <span class="text-danger" asp-validation-for="Id_Nivel_Incidente"></span>
                    <select class="form-control" asp-items="@ViewBag.Nivel_Incidente" asp-for="Id_Nivel_Incidente"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Fecha_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Fecha_Incidente"></span>
                    <input type="date" class="form-control" asp-for="Fecha_Incidente" />
                </div>
                <div class="col-sm-12 col-md-1 col-lg-1">
                    <label asp-for="Hora_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-1 col-lg-1">
                    <span class="text-danger" asp-validation-for="Hora_Incidente"></span>
                    <input type="time" class="form-control" asp-for="Hora_Incidente" />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Producto_Derramado"></label>
                </div>
                <div class="col-sm-12 col-md-4 col-lg-4">
                    <span class="text-danger" asp-validation-for="Producto_Derramado"></span>
                    <input type="text" class="form-control" asp-for="Producto_Derramado" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Cantidad_Derramado"></label>
                </div>
                <div class="col-sm-12 col-md-3 col-lg-3">
                    <span class="text-danger" asp-validation-for="Cantidad_Derramado"></span>
                    <input type="number" class="form-control" asp-for="Cantidad_Derramado" />
                </div>
                <div class="col-sm-12 col-md-1 col-lg-1">
                    <span class="text-danger" asp-validation-for="Id_Unidad_Cantidad_Derramado"></span>
                    <select class="form-control" asp-items="@ViewBag.Unidad_Derramado" asp-for="Id_Unidad_Cantidad_Derramado"></select>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Area_Afectada"></label>
                </div>
                <div class="col-sm-12 col-md-3 col-lg-3">
                    <span class="text-danger" asp-validation-for="Area_Afectada"></span>
                    <input type="number" class="form-control" asp-for="Area_Afectada" />
                </div>
                <div class="col-sm-12 col-md-1 col-lg-1">
                    <span class="text-danger" asp-validation-for="Id_Unidad_Area_Afectada"></span>
                    <select class="form-control" asp-items="@ViewBag.Unidad_Area" asp-for="Id_Unidad_Area_Afectada"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Lugar_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Lugar_Incidente"></span>
                    <input type="text" class="form-control" asp-for="Lugar_Incidente" />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Equipo_Involucrado"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Equipo_Involucrado"></span>
                    <input type="text" class="form-control" asp-for="Equipo_Involucrado" />
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Id_Componente_Ambiental"></label>
                </div>
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <span class="text-danger" asp-validation-for="Id_Componente_Ambiental"></span>
                    <select class="form-control" asp-items="@ViewBag.Componente_Ambiental" asp-for="Id_Componente_Ambiental"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 col-md-2 col-lg-2">
                    <label asp-for="Descripcion_Incidente"></label>
                </div>
                <div class="col-sm-12 col-md-10 col-lg-10">
                    <span class="text-danger" asp-validation-for="Descripcion_Incidente"></span>
                    <textarea class="form-control" asp-for="Descripcion_Incidente" rows="3" maxlength="600"></textarea>
                </div>
            </div>
            <div class="row mb-2 justify-content-end">
                <div class="col-sm-12 col-md-5 col-lg-3">
                    <a asp-action="Resumen" asp-controller="ReportePreliminar" class="btn btn-primary">Volver</a>
                    <button id="boton_guardar_estado" type="button" class="btn btn-primary">Guardar Estado</button>
                    <button id="boton_siguiente" type="button" class="btn btn-primary">Siguiente</button>
                </div>
            </div>
        </form>
    </div>
@section Scripts{ 
<script type="text/javascript">
    $("#boton_guardar_estado").on("click", function () {
        $("#Opcion").val("Guardar");
        $("#form_nuevoReporte").submit();
    });
    $("#boton_siguiente").on("click", function () {
        resetValidationMessage()
        if (validarInputs()) {
            $("#Opcion").val("Siguiente");
            $("#form_nuevoReporte").submit();
        }
    });
    function validarInputs() {
        if ($("#Num_Trabajadores").val() == "") { $("[data-valmsg-for='Num_Trabajadores']").html("Debe completar este campo"); return false; }
        if ($("#Id_Tipo_Incidente").val() == 0) { $("[data-valmsg-for='Id_Tipo_Incidente']").html("Debe seleccionar una opción"); return false; }
        if ($("#Id_Nivel_Incidente").val() == 0) { $("[data-valmsg-for='Id_Nivel_Incidente']").html("Debe seleccionar una opción"); return false; }
        if ($("#Fecha_Incidente").val() == "") { $("[data-valmsg-for='Fecha_Incidente']").html("Debe completar este campo"); return false;}
        if ($("#Hora_Incidente").val() == "") { $("[data-valmsg-for='Hora_Incidente']").html("Debe completar este campo"); return false; }
        if ($("#Producto_Derramado").val() == "") { $("[data-valmsg-for='Producto_Derramado']").html("Debe completar este campo"); return false; }
        if ($("#Cantidad_Derramado").val() == "") { $("[data-valmsg-for='Cantidad_Derramado']").html("Debe completar este campo"); return false; }
        if ($("#Id_Unidad_Cantidad_Derramado").val() == 0) { $("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("Debe seleccionar una opción"); return false; }
        if ($("#Area_Afectada").val() == "") { $("[data-valmsg-for='Area_Afectada']").html("Debe completar este campo"); return false; }
        if ($("#Id_Unidad_Area_Afectada").val() == 0) { $("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("Debe seleccionar una opción"); return false; }
        if ($("#Lugar_Incidente").val() == "") { $("[data-valmsg-for='Lugar_Incidente']").html("Debe completar este campo"); return false; }
        if ($("#Equipo_Involucrado").val() == "") { $("[data-valmsg-for='Equipo_Involucrado']").html("Debe completar este campo"); return false; }
        if ($("#Id_Componente_Ambiental").val() == 0) { $("[data-valmsg-for='Id_Componente_Ambiental']").html("Debe seleccionar una opción"); return false; }
        if ($("#Descripcion_Incidente").val() == "") { $("[data-valmsg-for='Descripcion_Incidente']").html("Debe completar este campo"); return false; }
        return true;
    }
    function resetValidationMessage() {
        $("[data-valmsg-for='Num_Trabajadores']").html("");
        $("[data-valmsg-for='Id_Tipo_Incidente']").html("");
        $("[data-valmsg-for='Id_Nivel_Incidente']").html("");
        $("[data-valmsg-for='Fecha_Incidente']").html("");
        $("[data-valmsg-for='Hora_Incidente']").html("");
        $("[data-valmsg-for='Producto_Derramado']").html("");
        $("[data-valmsg-for='Cantidad_Derramado']").html("");
        $("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("");
        $("[data-valmsg-for='Area_Afectada']").html("");
        $("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("");
        $("[data-valmsg-for='Lugar_Incidente']").html("");
        $("[data-valmsg-for='Equipo_Involucrado']").html("");
        $("[data-valmsg-for='Id_Componente_Ambiental']").html("");
        $("[data-valmsg-for='Descripcion_Incidente']").html("");
    }
</script>
} 