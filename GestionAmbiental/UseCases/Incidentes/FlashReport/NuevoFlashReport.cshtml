@model GestionAmbiental.UseCases.Incidentes.FlashReport.NuevoFlashReportModel
@{
	ViewData["Title"] = "Nuevo Flash Report";
	Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="incidentes">
	<div class="primary-content col-12">
		<div class="image-header-container">
			<div class="header-title incidentes-opacity-color">
				<h3>Nuevo Flash Report</h3>
				<img src="~/img/logo-white.png" alt="Logo Marcobre">
			</div>
		</div>
		<div class="container pt-4 pb-4">
			<form class="custom-form details-container w-100" id="form_nuevoReporte" asp-action="NuevoFlashReport" asp-controller="FlashReport" method="post" enctype="multipart/form-data" autocomplete="off">
				<input type="hidden" asp-for="Opcion" /
				><input type="hidden" asp-for="Acciones" />
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center text-uppercase">DATOS DEL INCIDENTE AMBIENTAL</span>
					</div>
					<div class="details-content">
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Gerencia">Gerencia</label>
								<span class="text-danger" asp-validation-for="Id_Gerencia"></span>
								<select class="form-control" asp-items="@ViewBag.Gerencia_Incidente" asp-for="Id_Gerencia"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Empresa">Empresa</label>
								<span class="text-danger" asp-validation-for="Id_Empresa"></span>
								<select class="form-control" asp-items="@ViewBag.Empresa_Incidente" asp-for="Id_Empresa"></select>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Lugar">Lugar</label>
								<span class="text-danger" asp-validation-for="Lugar"></span>
								<input type="text" class="form-control" asp-for="Lugar" />
							</div>
							<div class="col-12 col-sm-6 col-lg-6 p-0">
								<div class="row mt-0 mb-0">
									<div class="col-7 mt-0 mb-0">
										<label asp-for="Fecha_Incidente">Fecha</label>
										<span class="text-danger" asp-validation-for="Fecha_Incidente"></span>
										<input type="date" class="form-control" asp-for="Fecha_Incidente" />
									</div>
									<div class="col-5 mt-0 mb-0">
										<label asp-for="Hora_Incidente">Hora (24h)</label>
										<span class="text-danger" asp-validation-for="Hora_Incidente"></span>
										<input type="time" class="form-control" asp-for="Hora_Incidente" />
									</div>
								</div>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Nivel_Incidente">Nivel de Incidente</label>
								<span class="text-danger" asp-validation-for="Nivel_Incidente"></span>
								<select class="form-control" asp-items="@ViewBag.Nivel_Incidente" asp-for="Nivel_Incidente"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Componente_Ambiental">Componente Ambiental Afectado</label>
								<span class="text-danger" asp-validation-for="Id_Componente_Ambiental"></span>
								<select class="form-control" asp-items="@ViewBag.Componente_Ambiental" asp-for="Id_Componente_Ambiental"></select>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Producto_Incidente">Producto Derramado</label>
								<span class="text-danger" asp-validation-for="Id_Producto_Incidente"></span>
								<select class="form-control" asp-items="@ViewBag.Producto_Derramado" asp-for="Id_Producto_Incidente"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6 p-0">
								<div class="row mt-0 mb-0">
									<div class="col-7 mt-0 mb-0">
										<label asp-for="Cantidad_Derramada">Cantidad Derramada</label>
										<span class="text-danger" asp-validation-for="Cantidad_Derramada"></span>
										<input type="number" class="form-control" asp-for="Cantidad_Derramada" />
									</div>
									<div class="col-5 mt-0 mb-0">
										<label asp-for="Id_Unidad_Cantidad_Derramada">Unidad Derramada</label>
										<span class="text-danger" asp-validation-for="Id_Unidad_Cantidad_Derramada"></span>
										<select class="form-control" asp-items="@ViewBag.Unidad_Derramado" asp-for="Id_Unidad_Cantidad_Derramada"></select>
									</div>
								</div>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-12 col-lg-12">
								<label asp-for="Descripcion">Descripción (¿qué ocurrió?)</label>
								<span class="text-danger" asp-validation-for="Descripcion"></span>
								<textarea class="form-control" asp-for="Descripcion" rows="3"></textarea>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Supervisor_Marcobre">Supervisor Marcobre</label>
								<span class="text-danger" asp-validation-for="Id_Supervisor_Marcobre"></span>
								<select class="form-control" asp-items="@ViewBag.Supervisores_Marcobre" asp-for="Id_Supervisor_Marcobre"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Cargo_Supervisor_Marcobre">Cargo Supervisor Marcobre</label>
								<span class="text-danger" asp-validation-for="Cargo_Supervisor_Marcobre"></span>
								<input type="text" class="form-control" asp-for="Cargo_Supervisor_Marcobre" />
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Supervisor_Contratista">Supervisor Contratista</label>
								<span class="text-danger" asp-validation-for="Supervisor_Contratista"></span>
								<input type="text" class="form-control" asp-for="Supervisor_Contratista" />
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Cargo_Supervisor_Contratista">Cargo Supervisor Contratista</label>
								<span class="text-danger" asp-validation-for="Cargo_Supervisor_Contratista"></span>
								<input type="text" class="form-control" asp-for="Cargo_Supervisor_Contratista" />
							</div>
						</div>
					</div>
				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center  ">Registro fotográfico</span>
					</div>
					<div class="details-content">
						<div class="row input_container">
							<div class="col-12 col-sm-12 col-lg-12">
								<label asp-for="Evidencias">Seleccionar Evidencias</label>
								<span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
									<span id="danger_evidencia" class=""></span>
								</span>
								<input type="file" class="form-control" asp-for="Evidencias" accept=".jpg,.jpeg,.png" data-max-size="12000000" multiple>
							</div>
						</div>
					</div>
				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center  ">ACCIONES INMEDIATAS</span>
					</div>
					<div class="details-content">
						<div class="row-center-center col-12">
							<div class="col-12 col-xl-4">
								<a class="btn btn-special-action incidentes-color" id="btn_nueva_accion" data-bs-toggle="modal" data-bs-target="">
									Agregar Acción
								</a>
							</div>
						</div>
						<div class="row-center-center col-12">
							<div class="col-12 col-xl-4">
								<span class="text-danger" id="alert_acciones"></span>
							</div>
						</div>
						<div class="incidentes">
							<div class="tertiary-content col-12">
								<div class="table-responsive incidentes-color">
									<table class="table" id="tabla_acciones">
										<thead>
											<tr>
												<th>Acción Inmediata</th>
												<th>Responsable Marcobre</th>
												<th>Responsable Contratista</th>
												<th>Fecha</th>
												<th>Estatus</th>
												<th></th>
												<th></th>
											</tr>
										</thead>
										<tbody>
											<tr>
												<td colspan="100">No hay acciones</td>
											</tr>
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="button-container">
						<div></div>
						<div>
							<a asp-action="Resumen" asp-controller="FlashReport" class="btn btn-mc-outline-danger">Volver</a>
							<button id="boton_guardar_estado" type="button" class="btn btn-mc-outline-success">Guardar Estado</button>
							<button id="boton_finalizar" type="button" class="btn btn-mc">Finalizar</button>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
<!-- Modal Nuevo Acciones Post Incidente-->
<div class="modal fade" id="modal_accion" tabindex="-1" aria-labelledby="titulo_modal_accion" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-menu modal-incidentes">
			<div class="modal-content">
				<div class="incidentes">
					<div class="image-header-container">
						<div class="header-title incidentes-opacity-color">
							<h3>Agregar/Editar Acción</h3>
							<img src="/img/logo-white.png" alt="Logo Marcobre">
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
					</div>
				</div>
				<form>
					<div class="container pt-4 pb-4">
						<div class="custom-form w-100">
							<div class="detail-container col-12 mb-4">
								<div class="row mb-2">
									<input type="hidden" id="Id_Accion" />
									<div class="col-sm-12 col-md-12 col-lg-12">
										<span class="text-danger" id="danger_accion"></span>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Descripción</label>
										<textarea class="form-control" rows="2" maxlength="1000" id="input_descripcion_accion"></textarea>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Responsable Marcobre</label>
										<select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios_accion"></select>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Responsable Contratista</label>
										<input type="text" class="form-control" id="input_contratista_accion" placeholder="Nombres y Apellidos" />
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Fecha</label>
										<input type="date" class="form-control" id="input_fecha_accion" />
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Estatus</label>
										<select class="form-control" id="select_estatus">
											<option value="">--SELECCIONE--</option>
											<option value="En Proceso">En Proceso</option>
											<option value="Cerrado">Cerrado</option>
										</select>
									</div>
								</div>
								<div class="row input_container">
									<div class="button-container">
										<button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
										<button type="button" class="btn btn-mc me-2" id="btn_guardar_accion">Guardar</button>
										<button type="button" class="btn btn-mc-success" id="btn_editar_accion">Aceptar</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade mc-modal" id="Modal_Enviando_Correo" tabindex="-1" aria-hidden="true" style="display: none;">
	<div class="modal-dialog modal-dialog-centered justify-content-center">
		<div class="mc-modal-image-background col-12">
			<div class="modal-content">
				<div class="modal-body">
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					<div class="col-12 d-flex justify-content-center">
						<div style="width: 150px; height: 35px">
							<div class="spinner">
								<div class="rect1"></div>
								<div class="rect2"></div>
								<div class="rect3"></div>
								<div class="rect4"></div>
								<div class="rect5"></div>
							</div>
						</div>
					</div>
					<div class="col-12 d-flex justify-content-center mt-4">
						<label class="text-white">Notificando al Supervisor de Medio Ambiente</label>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Modal Guardando Estado-->
<div class="modal fade mc-modal" id="Modal_Guardando_Estado" tabindex="-1" aria-hidden="true" style="display: none;">
	<div class="modal-dialog modal-dialog-centered justify-content-center">
		<div class="mc-modal-image-background col-12">
			<div class="modal-content">
				<div class="modal-body">
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					<div class="col-12 d-flex justify-content-center">
						<div style="width: 150px; height: 35px">
							<div class="spinner">
								<div class="rect1"></div>
								<div class="rect2"></div>
								<div class="rect3"></div>
								<div class="rect4"></div>
								<div class="rect5"></div>
							</div>
						</div>
					</div>
					<div class="col-12 d-flex justify-content-center mt-4">
						<label class="text-white">Guardando Estado</label>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script type="text/javascript">
		var lista_acciones = [];
		var lista_usuarios = @Html.Raw(ViewBag.UsuariosJson);
		$("#boton_guardar_estado").on("click", function () {
			$("#Opcion").val("GuardarEstado");
			$("#Acciones").val(JSON.stringify(lista_acciones));
			$("#Modal_Guardando_Estado").modal("show");
			$("#form_nuevoReporte").submit();
		});
		$("#boton_finalizar").on("click", function () {
			resetValidationMessage()
			if (validarInputs()) {
				$("#Opcion").val("Registrar");
				$("#Acciones").val(JSON.stringify(lista_acciones));
				$("#Modal_Enviando_Correo").modal("show");
				$("#form_nuevoReporte").submit();
			}
		});
		function validarInputs() {
			if ($("#Num_Trabajadores").val() == "") { $("[data-valmsg-for='Num_Trabajadores']").html("Debe completar este campo"); return false; }
			if ($("#Id_Tipo_Incidente").val() == 0) { $("[data-valmsg-for='Id_Tipo_Incidente']").html("Debe seleccionar una opción"); return false; }
			if ($("#Id_Nivel_Incidente").val() == 0) { $("[data-valmsg-for='Id_Nivel_Incidente']").html("Debe seleccionar una opción"); return false; }
			if ($("#Fecha_Incidente").val() == "") { $("[data-valmsg-for='Fecha_Incidente']").html("Debe completar este campo"); return false; }
			if ($("#Hora_Incidente").val() == "") { $("[data-valmsg-for='Hora_Incidente']").html("Debe completar este campo"); return false; }
			if ($("#Producto_Derramado").val() == "") { $("[data-valmsg-for='Producto_Derramado']").html("Debe completar este campo"); return false; }
			if ($("#Cantidad_Derramado").val() == "") { $("[data-valmsg-for='Cantidad_Derramado']").html("Debe completar este campo"); return false; }
			if ($("#Id_Unidad_Cantidad_Derramado").val() == 0) { $("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("Debe seleccionar una opción"); return false; }
			if ($("#Area_Afectada").val() == "") { $("[data-valmsg-for='Area_Afectada']").html("Debe completar este campo"); return false; }
			if ($("#Id_Unidad_Area_Afectada").val() == 0) { $("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("Debe seleccionar una opción"); return false; }
			if ($("#Lugar_Incidente").val() == "") { $("[data-valmsg-for='Lugar_Incidente']").html("Debe completar este campo"); return false; }
			if ($("#Equipo_Involucrado").val() == "") { $("[data-valmsg-for='Equipo_Involucrado']").html("Debe completar este campo"); return false; }
			if ($("#Id_Componente_Ambiental").val() == 0) { $("[data-valmsg-for='Id_Componente_Ambiental']").html("Debe seleccionar una opción"); return false; }
			if ($("#Descripcion_Incidente").val() == "") { $("[data-valmsg-for='Descripcion_Incidente']").html("Debe completar este campo"); return false; }
			return true;
		}
		function resetValidationMessage() {
			$("[data-valmsg-for='Num_Trabajadores']").html("");
			$("[data-valmsg-for='Id_Tipo_Incidente']").html("");
			$("[data-valmsg-for='Id_Nivel_Incidente']").html("");
			$("[data-valmsg-for='Fecha_Incidente']").html("");
			$("[data-valmsg-for='Hora_Incidente']").html("");
			$("[data-valmsg-for='Producto_Derramado']").html("");
			$("[data-valmsg-for='Cantidad_Derramado']").html("");
			$("[data-valmsg-for='Id_Unidad_Cantidad_Derramado']").html("");
			$("[data-valmsg-for='Area_Afectada']").html("");
			$("[data-valmsg-for='Id_Unidad_Area_Afectada']").html("");
			$("[data-valmsg-for='Lugar_Incidente']").html("");
			$("[data-valmsg-for='Equipo_Involucrado']").html("");
			$("[data-valmsg-for='Id_Componente_Ambiental']").html("");
			$("[data-valmsg-for='Descripcion_Incidente']").html("");
		}
		//Acciones
		$("#btn_nueva_accion").on("click", function () {
			ResetInputsAccion();
			$("#btn_editar_accion").hide();
			$("#btn_guardar_accion").show();
			$("#modal_accion").modal('show');
		});
		function ResetInputsAccion() {
			$('#input_descripcion_accion').val("");
			$('#select_usuarios_accion').val(0);
			$('#input_contratista_accion').val("");
			$('#input_fecha_accion').val("");
			$('#select_estatus').val("");
		}
		function ValidateInputsAccion() {
			var result = true;
			if ($('#input_descripcion_accion').val() == "" ||
				$('#input_fecha_accion').val() == "" ||
				$('#select_estatus').val() == "")
				result = false;
			if ($('#select_usuarios_accion').val() == 0 &&
				$('#input_contratista_accion').val() == "")
				result = false;
			return result;
		}
		function EditarAccion(idAccion) {
			let accion = lista_acciones.find(ac => ac.IdAccion === parseInt(idAccion));
			$("#Id_Accion").val(idAccion);
			$("#input_descripcion_accion").val(accion.descripcion);
			$('#select_usuarios_accion').val(accion.usuario);
			$('#input_contratista_accion').val(accion.contratista);
			$('#input_fecha_accion').val(accion.fecha);
			$('#select_estatus').val(accion.estado);

			$("#modal_accion").modal('show');
			$("#btn_editar_accion").show();
			$("#btn_guardar_accion").hide();
		}
		function EliminarAccion(indexAccion) {
			if (confirm('¿Está seguro que desea eliminar esta acción?')) {
				lista_acciones = lista_acciones.filter(item => item.IdAccion !== indexAccion)
				$('#tabla_acciones tbody').empty();
				$('#NAcciones').val(lista_acciones.length);
				if (lista_acciones.length > 0) {
					$('#tabla_acciones tbody').html(generarTablaAccionesHtml(lista_acciones));
				}
				else {
					$('#tabla_acciones tbody').html(`<td colspan="100" style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);border-radius: 15px;text-align:center;">No hay acciones</td>`);
				}
			}
		}
		$("#btn_guardar_accion").on("click", function () {
			$("#danger_accion").html("");
			if (validarInputsModalAccion()) {
				var nuevo_item_acciones = {
					IdAccion: lista_acciones.length,
					descripcion: $("#input_descripcion_accion").val(),
					usuario: $('#select_usuarios_accion').val(),
					contratista: $('#input_contratista_accion').val(),
					fecha: $('#input_fecha_accion').val(),
					estado: $('#select_estatus').val()
				};
				lista_acciones.push(nuevo_item_acciones)
				$("#tabla_acciones").show();
				ResetInputsAccion();
				$("#modal_accion").modal('hide');
				$('#tabla_acciones tbody').empty();
				$('#tabla_acciones tbody').html(generarTablaAccionesHtml(lista_acciones));
				$('#NAcciones').val(lista_acciones.length);
			}
		});
		function generarTablaAccionesHtml(acciones) {
			let filas = "";
			acciones.forEach((accion, index) => {
				let usuario = lista_usuarios.find(user => user.IdUsuario === parseInt(accion.usuario));
				filas += `<tr>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.descripcion}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${usuario.NombresApellidos}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.contratista}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.fecha}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.estado}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);"><button type="button" class="btn btn-mc" onclick="EditarAccion(${accion.IdAccion})">Editar</button></td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);"><button type="button" class="btn btn-mc-danger" onclick="EliminarAccion(${accion.IdAccion})">Eliminar</button></td>
						</tr>`;
			});
			return filas;
		}
		$("#btn_editar_accion").on("click", function () {
			var idAccion = $("#Id_Accion").val();
			if (validarInputsModalAccion()) {
				$("#danger_accion").html("");
				let accion = lista_acciones.find(ac => ac.IdAccion === parseInt(idAccion));
				if (accion) {
					// Update the properties of the found action
					accion.descripcion = $("#input_descripcion_accion").val();
					accion.usuario = $('#select_usuarios_accion').val();
					accion.contratista = $('#input_contratista_accion').val();
					accion.fecha = $('#input_fecha_accion').val();
					accion.estado = $('#select_estatus').val();
				}
				$("#tabla_acciones").show();
				ResetInputsAccion();
				$("#modal_accion").modal('hide');
				$('#tabla_acciones tbody').empty();
				$('#tabla_acciones tbody').html(generarTablaAccionesHtml(lista_acciones));
				$('#NAcciones').val(lista_acciones.length);
			}
		});
		function validarInputsModalAccion() {
			if ($("#input_descripcion_accion").val() == "" &&
				$("#select_usuarios_accion").val() == 0 &&
				$("#input_contratista_accion").val() == "" &&
				$("#input_fecha_accion").val() == "" &&
				$("#select_estatus").val() == 0) {
				$("#danger_accion").html("Debe completar todos los campos");
				return false;
			}
			return true;
		}
		$("#Evidencias").change(function () {
			$("#danger_evidencia").html("");
			//Validacion del tamaño del archivo
			var maxSize = $("#Evidencias").data('max-size');
			var archivos = $("#Evidencias").get(0).files;

			if (archivos.length > 0) {
				var fileSize = 0
				for (var i = 0; i < archivos.length; i++) {
					fileSize += archivos[i].size;
				}
				if (fileSize > maxSize) {
					this.value = '';
					var filesname = this.files.length + " Archivos";
					$("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
					return;
				}
				var filesName = "";
				for (var i = 0; i < archivos.length; i++) {
					switch (this.value.match(/\.([^\.]+)$/)[1]) {
						case 'jpg':
						case 'JPG':
						case 'jpeg':
						case 'JPEG':
						case 'png':
						case 'PNG':
							//case 'xls':
							//case 'xlsx':
							//case 'doc':
							//case 'docx':
							//case 'pdf':
							filesName += archivos[i].name + "<br/>";
							break;
						default:
							this.value = '';
							var filesname = this.files.length + " Archivos";
							$("#files_name").text(filesname);
							$("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
							return;
					}
				}
				filesName.length > 0 ? $("#files_name").html(filesName) : null;
			}
		});
	</script>
} 