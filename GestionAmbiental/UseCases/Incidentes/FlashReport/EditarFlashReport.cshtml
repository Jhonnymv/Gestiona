		function generarTablaAccionesHtml(acciones) {
			let filas = "";
			acciones.forEach((accion, index) => {
				let usuario = lista_usuarios.find(user => user.IdUsuario === parseInt(accion.usuario));
				filas += `<tr>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.descripcion}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${usuario.NombresApellidos}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.contratista}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.fecha}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);">${accion.estado}</td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);"><button type="button" class="btn btn-mc" onclick="EditarAccion(${accion.IdAccion})">Editar</button></td>
							<td style="color: rgb(254, 144, 42); background-color: rgba(254, 144, 42, 0.2);"><button type="button" class="btn btn-mc-danger" onclick="EliminarAccion(${accion.IdAccion})">Eliminar</button></td>
						</tr>`;
			});
			return filas;
		}
