@model GestionAmbiental.UseCases.Incidentes.FlashReport.EditarFlashReportModel
@{
	ViewData["Title"] = "Editar Flash Report";
	Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="incidentes">
	<div class="primary-content col-12">
		<div class="image-header-container">
			<div class="header-title incidentes-opacity-color">
				<h3>Editar Flash Report</h3>
				<img src="~/img/logo-white.png" alt="Logo Marcobre">
			</div>
		</div>
		<div class="container pt-4 pb-4">
			<form class="custom-form details-container w-100" id="form_editarReporte" asp-action="EditarFlashReport" asp-controller="FlashReport" method="post" enctype="multipart/form-data" autocomplete="off">
				<input type="hidden" asp-for="Opcion" />
				<input type="hidden" asp-for="Acciones" />
				<input type="hidden" asp-for="Id_Flash_Report" />
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center text-uppercase">DATOS DEL INCIDENTE AMBIENTAL</span>
					</div>
					<div class="details-content">
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Gerencia">Gerencia</label>
								<span class="text-danger" asp-validation-for="Id_Gerencia"></span>
								<select class="form-control" asp-items="@ViewBag.Gerencia_Incidente" asp-for="Id_Gerencia"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Empresa">Nivel de incidente</label>
								<span class="text-danger" asp-validation-for="Id_Empresa"></span>
								<select class="form-control" asp-items="@ViewBag.Empresa_Incidente" asp-for="Id_Empresa"></select>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Lugar">Lugar</label>
								<span class="text-danger" asp-validation-for="Lugar"></span>
								<input type="text" class="form-control" asp-for="Lugar" />
							</div>
							<div class="col-12 col-sm-6 col-lg-6 p-0">
								<div class="row mt-0 mb-0">
									<div class="col-7 mt-0 mb-0">
										<label asp-for="Fecha_Incidente">Fecha</label>
										<span class="text-danger" asp-validation-for="Fecha_Incidente"></span>
										<input type="date" class="form-control" asp-for="Fecha_Incidente" />
									</div>
									<div class="col-5 mt-0 mb-0">
										<label asp-for="Hora_Incidente">Hora (24h)</label>
										<span class="text-danger" asp-validation-for="Hora_Incidente"></span>
										<input type="time" class="form-control" asp-for="Hora_Incidente" />
									</div>
								</div>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Nivel_Incidente">Nivel de Incidente</label>
								<span class="text-danger" asp-validation-for="Nivel_Incidente"></span>
								<select class="form-control" asp-items="@ViewBag.Nivel_Incidente" asp-for="Nivel_Incidente"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Componente_Ambiental_Afectado">Componente Ambiental Afectado</label>
								<span class="text-danger" asp-validation-for="Componente_Ambiental_Afectado"></span>
								<input type="text" class="form-control" asp-for="Componente_Ambiental_Afectado" />
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Producto_Incidente">Producto Derramado</label>
								<span class="text-danger" asp-validation-for="Id_Producto_Incidente"></span>
								<select class="form-control" asp-items="@ViewBag.Producto_Derramado" asp-for="Id_Producto_Incidente"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6 p-0">
								<div class="row mt-0 mb-0">
									<div class="col-7 mt-0 mb-0">
										<label asp-for="Cantidad_Derramada">Cantidad Derramada</label>
										<span class="text-danger" asp-validation-for="Cantidad_Derramada"></span>
										<input type="number" class="form-control" asp-for="Cantidad_Derramada" />
									</div>
									<div class="col-5 mt-0 mb-0">
										<label asp-for="Id_Unidad_Cantidad_Derramada">Unidad Derramada</label>
										<span class="text-danger" asp-validation-for="Id_Unidad_Cantidad_Derramada"></span>
										<select class="form-control" asp-items="@ViewBag.Unidad_Derramado" asp-for="Id_Unidad_Cantidad_Derramada"></select>
									</div>
								</div>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-12 col-lg-12">
								<label asp-for="Descripcion">Descripción (¿qué ocurrió?)</label>
								<span class="text-danger" asp-validation-for="Descripcion"></span>
								<textarea class="form-control" asp-for="Descripcion" rows="3"></textarea>
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Id_Supervisor_Marcobre">Supervisor Marcobre</label>
								<span class="text-danger" asp-validation-for="Id_Supervisor_Marcobre"></span>
								<select class="form-control" asp-items="@ViewBag.Supervisores_Marcobre" asp-for="Id_Supervisor_Marcobre"></select>
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Cargo_Supervisor_Marcobre">Cargo Supervisor Marcobre</label>
								<span class="text-danger" asp-validation-for="Cargo_Supervisor_Marcobre"></span>
								<input type="text" class="form-control" asp-for="Cargo_Supervisor_Marcobre" />
							</div>
						</div>
						<div class="row input_container">
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Supervisor_Contratista">Supervisor Contratista</label>
								<span class="text-danger" asp-validation-for="Supervisor_Contratista"></span>
								<input type="text" class="form-control" asp-for="Supervisor_Contratista" />
							</div>
							<div class="col-12 col-sm-6 col-lg-6">
								<label asp-for="Cargo_Supervisor_Contratista">Cargo Supervisor Contratista</label>
								<span class="text-danger" asp-validation-for="Cargo_Supervisor_Contratista"></span>
								<input type="text" class="form-control" asp-for="Cargo_Supervisor_Contratista" />
							</div>
						</div>
					</div>
				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center  ">Registro fotográfico</span>
					</div>
					<div class="details-content">
						@if (Model.Estado == "Pendiente")
                        {
						<div class="row input_container">
							<div class="col-12 col-sm-12 col-lg-12">
								<label asp-for="Evidencias">Seleccionar Evidencias</label>
								<span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
									<span id="danger_evidencia" class=""></span>
								</span>
								<input type="file" class="form-control" asp-for="Evidencias" accept=".jpg,.jpeg,.png" data-max-size="12000000" multiple>
							</div>
						</div>
						}
						<div class="row input_container">
							<div class="col-12 col-sm-12 col-lg-12">
								<label asp-for="Evidencias_Completas">Evidencias</label>
								<input type="hidden" asp-for="Evidencias_Completas" />
								<div class="col-sm-12 col-md-12 col-lg-12" id="Evidencias_Lista">
								</div>
							</div>
						</div>
					</div>

				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="detail-header">
						<span class="text-white bold text-center  ">ACCIONES INMEDIATAS</span>
					</div>
					<div class="details-content">
						<div class="row-center-center col-12">
							<div class="col-12 col-xl-4">
								<a class="btn btn-special-action incidentes-color" id="btn_nueva_accion" data-bs-toggle="modal" data-bs-target="">
									Agregar Acción
								</a>
							</div>
						</div>
						<div class="row-center-center col-12">
							<div class="col-12 col-xl-4">
								<span class="text-danger" id="alert_acciones"></span>
							</div>
						</div>
						<div class="incidentes">
							<div class="tertiary-content col-12">
								<div class="table-responsive incidentes-color">
									<table class="table" id="tabla_acciones">
										<thead>
											<tr>
												<th>Acción Inmediata</th>
												<th>Responsable Marcobre</th>
												<th>Responsable Contratista</th>
												<th>Fecha</th>
												<th>Estatus</th>
												<th></th>
												<th></th>
											</tr>
										</thead>
										<tbody>
											<tr>
												<td colspan="100">No hay acciones</td>
											</tr>
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="detail-container col-12 col-xl-10 mb-4">
					<div class="button-container">
						<div></div>
						<div>
							<a asp-action="Resumen" asp-controller="FlashReport" class="btn btn-mc-outline-danger">Volver</a>
							<button id="boton_guardar_estado" type="button" class="btn btn-mc-outline-success">Guardar Estado</button>
							<button id="boton_finalizar" type="button" class="btn btn-mc">Finalizar</button>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
<!-- Modal Nuevo Acciones Post Incidente-->
<div class="modal fade" id="modal_accion" tabindex="-1" aria-labelledby="titulo_modal_accion" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-menu modal-incidentes">
			<div class="modal-content">
				<div class="incidentes">
					<div class="image-header-container">
						<div class="header-title incidentes-opacity-color">
							<h3>Agregar/Editar Acción</h3>
							<img src="/img/logo-white.png" alt="Logo Marcobre">
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
					</div>
				</div>
				<form>
					<div class="container pt-4 pb-4">
						<div class="custom-form w-100">
							<div class="detail-container col-12 mb-4">
								<div class="row mb-2">
									<input type="hidden" id="Id_Accion" />
									<div class="col-sm-12 col-md-12 col-lg-12">
										<span class="text-danger" id="danger_accion"></span>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Descripción</label>
										<textarea class="form-control" rows="2" maxlength="1000" id="input_descripcion_accion"></textarea>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Responsable Marcobre</label>
										<select class="form-control" asp-items="@ViewBag.Usuario" id="select_usuarios_accion"></select>
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Responsable Contratista</label>
										<input type="text" class="form-control" id="input_contratista_accion" placeholder="Nombres y Apellidos" />
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Fecha</label>
										<input type="date" class="form-control" id="input_fecha_accion" />
									</div>
								</div>
								<div class="row input_container">
									<div class="col-12">
										<label>Estatus</label>
										<select class="form-control" id="select_estatus">
											<option value="">--SELECCIONE--</option>
											<option value="En Proceso">En Proceso</option>
											<option value="Cerrado">Cerrado</option>
										</select>
									</div>
								</div>
								<div class="row input_container">
									<div class="button-container">
										<button type="button" class="btn btn-mc-outline-danger me-2" data-bs-dismiss="modal">Cancelar</button>
										<button type="button" class="btn btn-mc me-2" id="btn_guardar_accion">Guardar</button>
										<button type="button" class="btn btn-mc-success" id="btn_editar_accion">Aceptar</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script type="text/javascript">
		var nombresEvidencias = @Html.Raw(Model.Evidencias_Nombres);
		var lista_acciones = [];
		$(document).ready(function () {
			var acciones = @Html.Raw(Model.Acciones);
			console.log("acciones ", acciones)
			lista_acciones = acciones.map((accion) => ({
				IdAccion: accion.Id_Accion_Flash_Report,
				descripcion: accion.Descripcion,
				usuario: accion.IdUsuario,
				contratista: accion.Responsable,
				fecha: accion.Fecha.split('T')[0],
				estado: accion.Estatus
			}
			));
			$('#tabla_acciones tbody').empty();
			$('#tabla_acciones tbody').html(generarTablaAccionesHtml(lista_acciones));
			$('#NAcciones').val(lista_acciones.length);
			// GetAcciones();
			// if ('@Model.Estado' == "Pendiente" || '@ViewBag.PermisosAdmin' == 'True')
			// 	HabilitarInputs();

			var evidencia_valores = @Html.Raw(Model.Evidencias_Completas);
			console.log("evidencia_valores", evidencia_valores)
			if (nombresEvidencias.length > 0) {
				CargarEvidenciasConNombre(nombresEvidencias, "#Evidencias_Lista", "#Evidencias_Completas");
			}
			else if (evidencia.length > 0) {
				CargarEvidenciasSinNombre(evidencia_valores, "#Evidencias_Lista", "#Evidencias_Completas");
			}
		});
