            url: "/SGADocumentacion/PropiedadesModulo",
            traditional: true,
            success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        sgaStyle(r, g, b);
                    } else {
