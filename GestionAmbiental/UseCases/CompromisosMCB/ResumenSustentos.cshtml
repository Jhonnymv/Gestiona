                $("#Origen").val(response.data.nomOrigen)
                $("#Tomo").val(response.data.tomo)
                $("#Capitulo").val(response.data.capitulo)
                $("#Seccion").val(response.data.seccion)
                $("#Pagina").val(response.data.pagina)
                $("#Resolucion").val(response.data.resolucion)
