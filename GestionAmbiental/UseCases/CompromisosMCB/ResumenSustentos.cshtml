                if(response.data.evidencia)
                    PrevisualizarEvidencia(response.data.evidencia);
            }
        });
        $('#modal_validar_sustento').modal('show')
    }
    function PrevisualizarEvidencia(fileName){
        $.ajax({
            type:"POST",
            url:"/CompromisosMCB/PreviewFile",
            data:{
                "fileName":fileName,
            },
            traditional:true,
            success:(response)=>{
                if (response.result == "Ok") {
                            rutaArchivo = response.path
                            if (response.extension == ".pdf" ){ 
                                PDFObject.embed(response.path, "#viewPDF");
                                $("#viewPDF").css("height", "500px");
                                $("#viewImage").hide();
                                $("#viewPDF").show();
                            }
                            else if (response.extension == ".jpg"|| response.extension == ".png"|| response.extension == ".jpeg"){
                                $("#viewImage").attr("src", response.path);
                                $("#viewImage").css("width", "100%");
                                $("#viewImage").show();
                                $("#viewPDF").hide();
                            }
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar la evidencia");
                            alert("No se pudo visualizar la evidencia: " + response.message);
                        }
            }
        });
    }
    function dataModulo() {
        $.ajax({
