@model GestionAmbiental.UseCases.CompromisosMCB.CompromisoModel

@{
    ViewData["Title"] = "Compromiso Nuevo Registro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

@section Styles{
            <style>

            </style>
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title compromisos-opacity-color">
                <h3>Nuevo Registro Compromisos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" asp-controller="CompromisosMCB" asp-action="NuevoRegistro" autocomplete="off" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container align-items-start">
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Codigo"></label>
                            <span class="text-danger" asp-validation-for="Codigo"></span>
                            <input type="text" class="form-control" asp-for="Codigo">
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Detalle_compromiso"></label>
                            <span class="text-danger" asp-validation-for="Detalle_compromiso"></span>
                            <textarea class="form-control" asp-for="Detalle_compromiso"></textarea>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Texto_compromiso"></label>
                            <span class="text-danger" asp-validation-for="Texto_compromiso"></span>
                            <textarea class="form-control" asp-for="Texto_compromiso"></textarea>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Id_Origen">Origen</label>
                            <span class="text-danger" asp-validation-for="Id_Origen"></span>
