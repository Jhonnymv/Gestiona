                            <select id="select_Componente" class="form-control" asp-for="Id_Componente" asp-items="@ViewBag.Componentes"></select>
                            @*   <div class="input-group-append">
                            <button class="btn btn-outline-info btn-sm" type="button" id="btnAddComponente">+</button>
                            </div>*@
                            @*</div>*@
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Id_ComponenteAux">Componente Auxiliar </label>
                            <span class="text-danger" asp-validation-for="Id_ComponenteAux"></span>
