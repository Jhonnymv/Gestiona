                                <select id="select_Origen" class="form-control" asp-for="Id_Origen" asp-items="@ViewBag.Origenes"></select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-info btn-sm" type="button" id="btnAddOrigen">+</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <label asp-for="Ano"></label>
                            <span class="text-danger" asp-validation-for="Ano"></span>
                            <input type="text" class="form-control" asp-for="Ano">
