                        <div class="input-group-append">
                        <button class="btn btn-outline-info btn-sm" type="button" id="btnAddGerencia">+</button>
                        </div>
                        </div>
                        </div>



                        <div class="col-12 col-sm-6 col-lg-4">
                        <label asp-for="Id_Responsable2">Responsable 1</label>
                        <span class="text-danger" asp-validation-for="Id_Responsable2"></span>
                        <select class="form-control" asp-for="Id_Responsable2" asp-items="@ViewBag.usuarios"></select>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-4">
                        <label asp-for="Sustentos"></label>
                        <span class="text-danger" asp-validation-for="Sustentos"></span>
                        <textarea class="form-control" asp-for="Sustentos"></textarea>
                        </div>*@

                    </div>
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsDetalle">
                                <a asp-controller="CompromisosMCB" asp-action="ResumenCompromisos" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="submit" class="btn btn-mc-success">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@*modal criterio*@
<div id="modal_add_criterio" class="modal fade" tabindex="-1" aria-labelledby="AddCriterioModal" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-menu modal-compromisos">
            <div class="modal-content">
                <div class="compromisos">
                    <div class="image-header-container">
                        <div class="header-title compromisos-opacity-color">
                            <h3>Agregar Criterio</h3>
                            <img src="~/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form id="formCriterio">
                    <div class="  modal-body custom-form w-100">
                        <div class="row">
                            <did class="col-12">
                                <label for="nameCriterio">Criterio</label>
                                <input type="text" id="nameCriterioAdd" name="nameCriterio" class="form-control" />
                            </did>
                            <did class="col-12">
                                <label for="crieterioDetalleAdd">Descripción del Criterio</label>
                                <textarea id="crieterioDetalleAdd" name="crieterioDetalle" class="form-control"></textarea>
                            </did>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btn_saveCriterio">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
