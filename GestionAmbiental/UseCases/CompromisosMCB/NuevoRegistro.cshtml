@section scripts{
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/selectpicker/js/bootstrap-select.js"></script>
<script src="~/lib/pdfobject/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnAddCriterio").on("click",function(){
            $("#modal_add_criterio").modal("show")
        })
        $("#btn_saveCriterio").on('click',function(){
            $.ajax({
                url:"/CompromisosMCB/saveCriterio",
                method:"GET",
                 data: {
                "nameCriterio": $("#nameCriterioAdd").val(),
                "crieterioDetalle": $("#crieterioDetalleAdd").val()
            },
            traditional: true,
            success: (response) => {
                console.log(response)
                $("#select_Criterio").append("<option value='"+response.id+"'>"+response.value+"</option>")
                $("#nameCriterioAdd").val('')
                $("#crieterioDetalleAdd").val('')
                $("#modal_add_criterio").modal("hide")
            }
            })
        })


        $("#btnAddEtapa").on("click",function(){
            $("#modal_add_Etapa").modal("show")
        })
        $("#btn_saveEtapa").on('click',function(){
            $.ajax({
                url:"/CompromisosMCB/saveEtapa",
                method:"GET",
                 data: {
                "nameEtapa": $("#nameEtapaAdd").val()
            },
            traditional: true,
            success: (response) => {
                console.log(response)
                $("#select_Etapa").append("<option value='"+response.id+"'>"+response.value+"</option>")
                $("#nameEtapaAdd").val('')
                $("#modal_add_Etapa").modal("hide")
            }
            })
        })

        $("#btnAddOrigen").on("click",function(){
            $("#modal_add_Origen").modal("show")
        })
        $("#btn_saveOrigen").on('click',function(){
            $.ajax({
                url:"/CompromisosMCB/saveOrigen",
                method:"GET",
                 data: {
                "nameOrigen": $("#nameOrigenAdd").val()
            },
            traditional: true,
            success: (response) => {
                console.log(response)
                $("#select_Origen").append("<option value='"+response.id+"'>"+response.value+"</option>")
                $("#nameOrigenAdd").val('')
                $("#modal_add_Origen").modal("hide")
            }
