                            <select id="select_ComponenteAux" class="form-control" asp-for="Id_ComponenteAux" asp-items="@ViewBag.ComponentesAux"></select>
                            @*   <div class="input-group-append">
                            <button class="btn btn-outline-info btn-sm" type="button" id="btnAddComponente">+</button>
                            </div>*@
                            @*</div>*@
