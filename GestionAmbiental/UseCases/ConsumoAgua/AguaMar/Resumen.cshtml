@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            filtrar(1);
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/ConsumoAguaMar/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val(),
                    "resolucion": $("#filtro_resolucion").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen tbody').empty()
                    $('#tabla_resumen tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    let r6 = 65;
                    let g6 = 182;
                    let b6 = 230;
                    aguaStyle(r6, g6, b6);
                }
            });
        }
    </script>
}