
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Consumo de Agua de Mar - Resumen</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-3 col-lg-3 mt-1">
            <label>Fecha:</label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mt-1">
            <input type="date" class="form-control" id="filtro_fecha">
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-1 col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-start d-flex align-items-center">
    <div class="col-sm-12 col-md-12 col-lg-12 mt-1">
        <a class="btn btn-danger float-left" asp-action="NuevoRegistro" asp-controller="ConsumoAguaMar"><img src="~/img/icons/edit-icon.png" style="vertical-align:sub"> Nuevo Registro</a>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-md">
        <table class="table" id="tabla_resumen">
            <thead class="thead-mcolor">
                <tr>
                    <th>Id</th>
                    <th>Fuente de Agua</th>
                    <th>Fecha</th>
                    <th>Tiempo de Bombeo (H)</th>
                    <th>Lectura Inicial Flujometro en el día (m3)</th>
                    <th>Lectura Final Flujómetro en el día (m3)</th>
                    <th>Volumen de Agua Bombeado (consumo)</th>
                    <th>Caudal promedio consumido (m3/s)</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {            
            filtrar(1);
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/ConsumoAguaMar/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen tbody').empty()
                    $('#tabla_resumen tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                }
            });
        }
    </script>
}