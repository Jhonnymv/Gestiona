@model GestionAmbiental.UseCases.ConsumoAgua.AguaSubterranea.ConsumoAguaSubterraneaModel
@{
    ViewData["Title"] = "EditarRegistro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Editar Consumo de Agua</h2>
    </div>
</div>

<form class="form-group" id="form_nuevo_avistamiento" asp-action="EditarRegistro" asp-controller="ConsumoAguaSubterranea" method="post" enctype="multipart/form-data" autocomplete="off">
    <div class="row mb-2 align-items-center">
        <input type="hidden" class="form-control" asp-for="Id" value="@Model.Id" />
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="IdResolucion"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="IdResolucion"></span>
            <select asp-for="IdResolucion" class="form-control" asp-items="ViewBag.Resoluciones" value="@Model.IdResolucion" disabled></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="FuenteAgua"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="FuenteAgua"></span>
            <input type="text" class="form-control" asp-for="FuenteAgua" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Fecha"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="Fecha"></span>
            <input type="date" class="form-control" asp-for="Fecha" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="TiempoBombeo"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="TiempoBombeo"></span>
            <input type="number" class="form-control" asp-for="TiempoBombeo" step="0.01" readonly />
        </div>
        @if (ViewBag.Rol.Equals("Admin"))
        {
            <div class="col-sm-12 col-md-6 col-lg-4 mb-2 text-center">
                <button type="button" class="btn btn-link" onclick="AbrirCalculadora()">Calcular Tiempo de Bombeo</button>
            </div>
        }
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="LecturaInicial"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="LecturaInicial"></span>
            <input type="number" class="form-control" asp-for="LecturaInicial" step="0.01" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="LecturaFinal"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="LecturaFinal"></span>
            <input type="number" class="form-control" asp-for="LecturaFinal" step="0.01" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="VolumenAguaBombeado"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="VolumenAguaBombeado"></span>
            <input type="number" class="form-control" asp-for="VolumenAguaBombeado" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="CaudalPromedio"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="CaudalPromedio"></span>
            <input type="number" class="form-control" asp-for="CaudalPromedio" readonly />
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-end">
        <a class="btn btn-secondary mr-2" style="color:white" asp-controller="ConsumoAguaSubterranea" asp-action="Resumen">Cancelar</a>
        @if (ViewBag.Rol.Equals("Admin"))
        {
            <button type="submit" class="btn btn-primary">Guardar</button>
        }
    </div>
</form>
<!-- Modal Calcular Tiempo Bombeo-->
<div class="modal fade" id="modal_calculadora" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_calculadora"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_calculadora">
                    Calcular Tiempo de Bombeo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-lg-4">
                        <label>Tiempo en Minutos:</label>
                    </div>
                    <div class="col-8">
                        <input type="number" class="form-control" id="cal_tiempo_minutos" min="0" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-lg-4">
                        <label>Tiempo en Horas:</label>
                    </div>
                    <div class="col-8">
                        <input type="number" class="form-control" id="cal_tiempo_horas" readonly />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <a class="btn btn-primary" style="color:white" onclick="UtilizarTiempo()">Utilizar Tiempo</a>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var horas = 0;
        var lecturaInicial = 0;
        var lecturaFinal = 0;
        var fuentesAgua = JSON.parse('@Html.Raw(ViewBag.FuentesAgua)');
        var rolUsuario = '@Html.Raw(ViewBag.Rol)';
        var ultimosRegistros = JSON.parse('@Html.Raw(ViewBag.RegistrosResolucion)');
        var tiempoAnterior = 0;

        $(document).ready(function () {
            if (rolUsuario=='Admin') {
                $("#IdResolucion").prop('disabled', false);
                $("#FuenteAgua").prop('readonly', false);
                $("#Fecha").prop('readonly', false);
                $("#TiempoBombeo").prop('readonly', false);
                $("#LecturaInicial").prop('readonly', false);
                $("#LecturaFinal").prop('readonly', false);
            }
        });

        $("#IdResolucion").on('change', function () {
            var resol = $("#IdResolucion").val();
            for (var i = 0; i < fuentesAgua.length; i++) {
                if (fuentesAgua[i].IdResolucionConsumoAgua == resol) {
                    $("#FuenteAgua").val(fuentesAgua[i].Descripcion);
                    break;
                }
            }
            for (var i = 0; i < ultimosRegistros.length; i++) {
                if (ultimosRegistros[i].IdResolucion == resol) {
                    $("#Fecha").val(ultimosRegistros[i].Fecha);
                    $("#LecturaInicial").val(ultimosRegistros[i].LecturaInicial);
                    tiempoAnterior = ultimosRegistros[i].TiempoBombeo
                    return;
                }
            }
        });

        $("#TiempoBombeo, #LecturaInicial, #LecturaFinal").on('change', function () {
            horas = $("#TiempoBombeo").val() != "" ? parseFloat($("#TiempoBombeo").val()) : null;
            lecturaInicial = $("#LecturaInicial").val() != "" ? parseFloat($("#LecturaInicial").val()) : null;
            lecturaFinal = $("#LecturaFinal").val() != "" ? parseFloat($("#LecturaFinal").val()) : null;
            if (horas != null && lecturaInicial != null && lecturaFinal != null) {
                //horas entre 0 y 24
                if (horas != "" && (horas < 0 || horas > 24 - tiempoAnterior)) {
                    horas = 0;
                    $("#TiempoBombeo").val(0)
                    $("#LecturaFinal").val(lecturaInicial);
                    if (tiempoAnterior == 24)
                        alert("La suma del tiempo de bombeo de la fecha " + ($("#Fecha").val()) + " alcanzó las 24 horas");
                    else
                        alert("El tiempo de bombeo no debe ser entre 0 y " + (24 - tiempoAnterior) + " horas");
                }
                if (horas >= 0 && lecturaInicial >= 0 && lecturaFinal >= 0) {
                    if (lecturaFinal >= lecturaInicial) {
                        CalcularVolumenAguaBombeado();
                        CalcularCaudalPromedio();
                    } else {
                        alert("La lectura final debe ser mayor o igual a la inicial");
                    }
                } else {
                    alert("Los valores deben se positivos");
                    if (horas < 0) {
                        $("#TiempoBombeo").val(0);
                        horas = 0;
                    }
                    if (lecturaInicial < 0) {
                        $("#LecturaInicial").val(0);
                        lecturaInicial = 0;
                    }
                    if (lecturaFinal < 0) {
                        $("#LecturaFinal").val(0);
                        lecturaFinal = 0;
                    }
                    CalcularVolumenAguaBombeado();
                    CalcularCaudalPromedio();
                }
            }
        });

        function CalcularVolumenAguaBombeado() {
            var volumen = lecturaFinal - lecturaInicial;
            $("#VolumenAguaBombeado").val(volumen);
        }

        function CalcularCaudalPromedio() {
            var volumen = lecturaFinal - lecturaInicial;
            var segundos = horas * 3600;
            if (segundos > 0)
                $("#CaudalPromedio").val((volumen / segundos).toFixed(2));
            else
                $("#CaudalPromedio").val(0);
        }
        function AbrirCalculadora() {
            $("#modal_calculadora").modal('show');
        }
        function UtilizarTiempo() {
            var tiempo = $("#cal_tiempo_horas").val();
            $("#TiempoBombeo").val(tiempo);
            $("#modal_calculadora").modal('toggle');
        }
        $("#cal_tiempo_minutos").on('change', function () {
            var min = $("#cal_tiempo_minutos").val();
            console.log(min)
            $("#cal_tiempo_horas").val(Math.round((min / 60) * 100) / 100);
        });
    </script>
}