
@{
    ViewData["Title"] = "Resumen Plataforma";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="configuration">
    <div class="mc_container">
        <div class="menu-settings container">
            <ul class="nav nav-pills mb-3 div-scroll-horizontal" id="pills-tabs-configuration" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-sliders-tab" href="#pills-sliders-tab" data-bs-toggle="pill" data-bs-target="#pills-sliders" type="button" role="tab" aria-controls="pills-sliders" aria-selected="true">Sliders</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-general-img-tab" href="#pills-general-img-tab" data-bs-toggle="pill" data-bs-target="#pills-general-img" type="button" role="tab" aria-controls="pills-general-img" aria-selected="false">Imagen Menú Módulos</button>
                </li>
            </ul>

            <div class="tab-content container" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-sliders" role="tabpanel" aria-labelledby="pills-sliders-tab">
                    <form autocomplete="off" class="custom-form w-100">
                        <div class="col-12 col-lg-9">
                            <div class="row input_container">
                                <div class="col-12">
                                    <label for="">Buscar</label>
                                    <input type="text" class="form-control" id="filtro">
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3 row-center-center">
                            <button type="button" class="btn btn-mc" onclick="FiltrarSlides(1)">Filtrar</button>
                        </div>
                    </form>

                    <div class="w-100 row-center-center">
                        <a class="btn btn-mc mb-3" asp-action="AgregarSlide" asp-controller="Configuracion">NUEVO SLIDE</a>
                    </div>

                    <div class="tertiary-content col-12">
                        <div class="table-responsive  mc-color">
                            <table class="table" id="tabla_resumen_modulo">
                                <thead class="">
                                    <tr>
                                        <th>Título</th>
                                        <th>Contenido</th>
                                        <th>Imagen</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>

                        </div>
                        <div class="pagination-container mc-color" id="paginado">
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="pills-general-img" role="tabpanel" aria-labelledby="pills-general-img-tab">
                    Contenido para ver y cambiar la imagen del menú de módulos
                    <form id="form_imagen_modulos" autocomplete="off" class="custom-form w-100">
                        <div class="row input_container align-items-lg-start">
                            <div class="col-12 col-lg-6">
                                <div class="row input_container">
                                    <label for="">Imagen Actual</label>
                                    <img id="imagen_actual_modulos" class="mt-2" style="width:100%;height:auto;" src="#"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="row input_container">
                                    <label for="">Imagen Nueva</label>
                                    <span id="alerta_fotos" class="text-danger"></span>
                                    <img id="previsualizacion" class="mt-2" style="width:100%;height:auto;display:none" />
                                    <input type="file" id="nueva_imagen_modulos" class="form-control mt-2" accept=".jpg,.jpeg,.png" data-max-size="2097152" />
                                </div>
                            </div>
                            <div class="col-12 row-center-center">
                                <button id="botonCargarFoto" type="button" class="btn btn-mc" style="display:none;" onclick="CambiarImagenModulo()">Cargar Foto</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabConfigPlataforma');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('#'+activeTab).click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarSlides(1);
            }
        });
        //Guardar tab activo en local storage
        $('#pills-tabs-configuration .nav-link').click(function () {
            localStorage.setItem('activeTabConfigPlataforma', $(this).attr('id'));
        });
        function FiltrarSlides(pag) {
            $.ajax({
                type: "POST",
                url: "/Configuracion/FiltrarSlides",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $("#filtro").val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_modulo tbody').empty();
                    $('#tabla_resumen_modulo tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                }
            });
        }
        function EliminarSlide(id) {
            if (confirm('¿Esta seguro que desea eliminar este slide?')) {
                $.ajax({
                    type: "POST",
                    url: "/Configuracion/EliminarSlide",
                    data: {
                        Id: id
                    },
                    success: (response) => {
                        if (response.success == true) {
                            FiltrarSlides(1);
                        }
                        else {
                            console.log(response.message);
                        }
                    }
                });
            }
        }
        function preview_image(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('previsualizacion');
                output.src = reader.result;
            }
            try {
                reader.readAsDataURL(event.target.files[0]);
                $("#previsualizacion").show();
                $("#botonCargarFoto").show();
            } catch (error) {
                $("#previsualizacion").hide();
                $("#botonCargarFoto").hide();
            }
        }
        $("#nueva_imagen_modulos").change(function (event) {
            $("#alerta_fotos").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#nueva_imagen_modulos").data('max-size');
            var archivos = $("#nueva_imagen_modulos").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#alerta_fotos").html("El  archivo supera el límite permitido de 2MB<br/>");
                    $("#previsualizacion").hide();
                    $("#botonCargarFoto").hide();
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#alerta_fotos").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
                preview_image(event);
            }
        });
        $("#pills-sliders-tab").click(function () {
            FiltrarSlides(1);
        });
        $("#pills-general-img-tab").click(function () {
            ConsultarImagenModulo();
        });
        function ConsultarImagenModulo() {
            $.ajax({
                type: "GET",
                url: "/Configuracion/ConsultarImagenModulos",                
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        console.log(JSON.parse(response.data));
                        $("#imagen_actual_modulos").attr("src",JSON.parse(response.data).Imagen)
                    } else {
                        console.log(response.message);
                    }
                }
            });
        }
        function CambiarImagenModulo() {
            var formData = new FormData();
                var files = document.getElementById("nueva_imagen_modulos").files;
                for (var i = 0; i != files.length; i++) {
                    formData.append("ImagenNueva", files[i]);
                }
            $.ajax({
                type: "POST",
                url: "/Configuracion/CambiarImagenModulo",     
                data: formData,
                processData: false,
                contentType: false,
                success: (response) => {
                    if (response.success) {
                        location.reload();
                    } else {
                        console.log(response.message);
                    }
                }
            });
        }
    </script>
}