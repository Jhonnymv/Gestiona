
@{
    ViewData["Title"] = "Resumen Plataforma";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="configuration">
    <div class="mc_container">
        <div class="menu-settings container">
            <ul class="nav nav-pills mb-3 div-scroll-horizontal" id="pills-tabs-configuration" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-sliders-tab" data-bs-toggle="pill" data-bs-target="#pills-sliders" type="button" role="tab" aria-controls="pills-sliders" aria-selected="true">Sliders</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-general-img-tab" data-bs-toggle="pill" data-bs-target="#pills-general-img" type="button" role="tab" aria-controls="pills-general-img" aria-selected="false">Imagen General</button>
                </li>
            </ul>

            <div class="tab-content container" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-sliders" role="tabpanel" aria-labelledby="pills-sliders-tab">
                    <form autocomplete="off" class="custom-form w-100">
                        <div class="col-12 col-lg-9">
                            <div class="row input_container">
                                <div class="col-12">
                                    <label for="">Buscar</label>
                                    <input type="text" class="form-control" id="filtro">
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3 row-center-center">
                            <button type="button" class="btn btn-mc" onclick="FiltrarSlides(1)">Filtrar</button>
                        </div>
                    </form>

                    <div class="w-100 row-center-center">
                        <a class="btn btn-mc mb-3" asp-action="AgregarSlide" asp-controller="Configuracion">NUEVO SLIDE</a>
                    </div>

                    <div class="tertiary-content col-12">
                        <div class="table-responsive  mc-color">
                            <table class="table" id="tabla_resumen_modulo">
                                <thead class="">
                                    <tr>
                                        <th>Título</th>
                                        <th>Contenido</th>
                                        <th>Imagen</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>

                        </div>
                        <div class="pagination-container mc-color" id="paginado">
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="pills-general-img" role="tabpanel" aria-labelledby="pills-general-img-tab">
                    Contenido para ver y cambiar la imagen principal
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            FiltrarSlides(1);
        });
        function FiltrarSlides(pag) {
            $.ajax({
                type: "POST",
                url: "/Configuracion/FiltrarSlides",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $("#filtro").val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_modulo tbody').empty();
                    $('#tabla_resumen_modulo tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                }
            });
        }
        function EliminarSlide(id) {
            if (confirm('¿Esta seguro que desea eliminar este slide?')) {
                $.ajax({
                    type: "POST",
                    url: "/Configuracion/EliminarSlide",
                    data: {
                        Id: id
                    },
                    success: (response) => {
                        if (response.success == true) {
                            FiltrarSlides(1);
                        }
                        else {
                            console.log(response.message);
                        }
                    }
                });
            }
        }
    </script>
}