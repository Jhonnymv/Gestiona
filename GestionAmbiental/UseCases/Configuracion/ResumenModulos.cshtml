@section Scripts{
    <script type="text/javascript">
        var propiedades =@Html.Raw(ViewBag.ListaPropiedades);
        var activo = "";
        $(document).ready(function () {
            CargarDatos();
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabGestorContenido');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('#'+activeTab).click();
            }
            //Si no existe, mostrar primer tab
            else {
                $('#pills-tabs-configuration .nav-link')[0].click();
                /*console.log("Si existe");*/
                //FiltrarTarjetas(1);
                //$("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
            }
        });
        //Guardar tab activo en local storage
        $('#pills-tabs-configuration .nav-link').click(function () {
            localStorage.setItem('activeTabGestorContenido', $(this).attr('id'));
        });
        //Cargar datos
        function CargarDatos() {
            for (var i = 0; i < propiedades.length; i++) {
                //var rgb = "rgb(" + propiedades[i].r + "," + propiedades[i].g + "," + propiedades[i].b + ")";
                //console.log(propiedades[i].modulo.toLowerCase() + ": " + rgb);
                /*$("#" + propiedades[i].modulo.toLowerCase() + "-colorPicker").val(parseColor(rgb).hex);*/
                $("#" + propiedades[i].modulo.toLowerCase() + "-r").val(propiedades[i].r);
                $("#" + propiedades[i].modulo.toLowerCase() + "-g").val(propiedades[i].g);
                $("#" + propiedades[i].modulo.toLowerCase() + "-b").val(propiedades[i].b);
                /*$("#" + propiedades[i].modulo.toLowerCase() + "-img").attr("src", propiedades[i].img_url);*/
            }
        }
        //Guardar json propiedades si no cambian imagenes
        function GuardarColores() {
            for (var i = 0; i < propiedades.length; i++) {
                if (activo == propiedades[i].modulo.toLowerCase()) {
                    propiedades[i].r = $("#" + propiedades[i].modulo.toLowerCase() + "-r").val();
                    propiedades[i].g = $("#" + propiedades[i].modulo.toLowerCase() + "-g").val();
                    propiedades[i].b = $("#" + propiedades[i].modulo.toLowerCase() + "-b").val();
                }
            };
            $.ajax({
                type: "POST",
                url: "/Configuracion/GuardarColores",
                data: {
                    "json": JSON.stringify(propiedades)
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        propiedades = JSON.parse(response.propiedades);
                        /*CargarDatos();*/
                    }
                    else {
                        alert("Ocurrió un error: " + response.message);
                    }
                }
            });
        }
        //Guardar formulario propiedades si cambian imagenes
        function GuardarPropiedades() {
            $('#guardarCambiosConfig').modal('show');
            $('#mensajeModalConfig').text('Guardando Cambios');
            var formData = new FormData();
            console.log("anterior propiedades: ", propiedades)
            for (var i = 0; i < propiedades.length; i++) {
                console.log("rgb: ", propiedades[i].modulo," , ", $("#" + propiedades[i].modulo.toLowerCase() + "-r").val(), ",", $("#" + propiedades[i].modulo.toLowerCase() + "-g").val(), ",", $("#" + propiedades[i].modulo.toLowerCase() + "-b").val())
                propiedades[i].r = $("#" + propiedades[i].modulo.toLowerCase() + "-r").val();
                propiedades[i].g = $("#" + propiedades[i].modulo.toLowerCase() + "-g").val();
                propiedades[i].b = $("#" + propiedades[i].modulo.toLowerCase() + "-b").val();
                formData.append("InspectionFile", document.getElementById("inspection-nueva-img").files[0]);
                formData.append("RacFile", document.getElementById("rac-nueva-img").files[0]);
                formData.append("ResiduosFile", document.getElementById("residuos-nueva-img").files[0]);
                formData.append("IncidentesFile", document.getElementById("incidentes-nueva-img").files[0]);
                formData.append("FaunaFile", document.getElementById("fauna-nueva-img").files[0]);
                formData.append("AguaFile", document.getElementById("agua-nueva-img").files[0]);
                formData.append("SGAFile", document.getElementById("sga-nueva-img").files[0]);
                formData.append("TablasFile", document.getElementById("tablas-nueva-img").files[0]);
            };
            formData.append("Json", JSON.stringify(propiedades));
            console.log("nuevo propiedades: ", propiedades)
            $.ajax({
                url: "/GestorContenido/EditarPropiedad",
                method: "post",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        propiedades = JSON.parse(response.propiedades);
                        $('#guardandoCambios').css('display', 'none');
                        $('#mensajeModalConfig').text('Tus Cambios Fueron Guardados!');
                        $('#cambiosGuardados').show();
                        $('#btnAceptarSettings').show();
                        $('#btnCerrarSettings').show();
                        $('#div-settings-button').hide();
                        /*CargarDatos();*/
                    }
                    else {
                        alert("Ocurrió un error: " + response.message);
                    }
                }
            });
        }
        $('input[type="color"]').change(function () {
            $('#div-settings-button').show();
        });

        $('input[type="file"]').change(function () {
            $('#div-settings-button').show();
        });

        /*======================================== VISUAL MODULE SETTINGS ON CHANGE ========================================*/
        /*======================================== VISUAL MODULE SETTINGS ON CHANGE ========================================*/
        /*======================================== VISUAL MODULE SETTINGS ON CHANGE ========================================*/
        function readURL(selector, input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $(selector).css('background-image', 'url(' + e.target.result + ')');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        /*INSPECCIONES*/
        $('#pills-inspections-tab').click(function () {
            activo = "inspection";
        });

        $("#inspection-colorPicker").change(function () {
            var hex = $(this).val();
            const hexToRgb = hex =>
                hex.replace(/^#?([a-f\d])([a-f\d])([a-f\d])$/i
                    , (m, r, g, b) => '#' + r + r + g + g + b + b)
                    .substring(1).match(/.{2}/g)
                    .map(x => parseInt(x, 16));

            let r = hexToRgb(hex)[0];
            let g = hexToRgb(hex)[1];
            let b = hexToRgb(hex)[2];
            $("#inspection-colorPicker").html('rgb (' + r + ', ' + g + ', ' + b + ')')
            inspectionStyle(r, g, b);
            $('#inspection-r').val(r);
            $('#inspection-g').val(g);
            $('#inspection-b').val(b);
            if ($('#inspection-nueva-img').val() !== "") {
                readURL('.inspeccion-image-header-container', $('#inspection-nueva-img').get()[0]);
            }
        });

        $('#inspection-nueva-img').change(function () {
            if ($('#inspection-nueva-img').val() === "") {
                $('.inspeccion-image-header-container').css('background-image', 'none');
                $(this).css('border', '2px solid #FF4D4D');
            }
            else if ($('#inspection-nueva-img').val() !== "") {
                readURL('.inspeccion-image-header-container', this);
                $(this).css('border', '2px solid #27C767');
            }
        });
        /*END INSPECCIONES*/

        /*RAC*/
        $('#pills-rac-tab').click(function () {
            activo = "rac";
        });

        $("#rac-colorPicker").change(function () {
            var hex = $(this).val();
            const hexToRgb = hex =>
                hex.replace(/^#?([a-f\d])([a-f\d])([a-f\d])$/i
                    , (m, r, g, b) => '#' + r + r + g + g + b + b)
                    .substring(1).match(/.{2}/g)
                    .map(x => parseInt(x, 16));

            let r = hexToRgb(hex)[0];
            let g = hexToRgb(hex)[1];
            let b = hexToRgb(hex)[2];
            $("#rac-colorPicker").html('rgb (' + r + ', ' + g + ', ' + b + ')')
            racStyle(r, g, b);
            $('#rac-r').val(r);
            $('#rac-g').val(g);
            $('#rac-b').val(b);
            if ($('#rac-nueva-img').val() !== "") {
                readURL('.rac-image-header-container', $('#rac-nueva-img').get()[0]);
            }
        });

        $('#rac-nueva-img').change(function () {
            if ($('#rac-nueva-img').val() === "") {
                $('.rac-image-header-container').css('background-image', 'none');
                $(this).css('border', '2px solid #FF4D4D');
            }
            else if ($('#rac-nueva-img').val() !== "") {
                readURL('.rac-image-header-container', this);
                $(this).css('border', '2px solid #27C767');
            }
        });
        /*END RAC*/

        /*RESIDUOS*/
        $('#pills-residuos-tab').click(function () {
            activo = "residuos";
        });

        $("#residuos-colorPicker").change(function () {
            var hex = $(this).val();
            const hexToRgb = hex =>
                hex.replace(/^#?([a-f\d])([a-f\d])([a-f\d])$/i
                    , (m, r, g, b) => '#' + r + r + g + g + b + b)
                    .substring(1).match(/.{2}/g)
                    .map(x => parseInt(x, 16));

            let r = hexToRgb(hex)[0];
            let g = hexToRgb(hex)[1];
            let b = hexToRgb(hex)[2];
            $("#residuos-colorPicker").html('rgb (' + r + ', ' + g + ', ' + b + ')')
            residuosStyle(r, g, b);
            $('#residuos-r').val(r);
            $('#residuos-g').val(g);
            $('#residuos-b').val(b);
            if ($('#residuos-nueva-img').val() !== "") {
                readURL('.residuos-image-header-container', $('#residuos-nueva-img').get()[0]);
            }
        });

