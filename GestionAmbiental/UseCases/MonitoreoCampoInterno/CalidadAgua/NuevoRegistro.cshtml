        function ObtenerUbicacion() {
            navigator.permissions.query({ name: 'geolocation' }).then(function(result) {
                if (result.state == 'granted') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'prompt') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'denied') {
                    MostrarModalUbicacion()
                    ImprimirPermisos(result.state);
                }
                result.onchange = function() {
                    console.log("cambio")
                    ImprimirPermisos(result.state);
                }
            });
        }
        function MostrarUbicacion(position) {
            ubicacion.val(position.coords.latitude + " , " + position.coords.longitude);
            $("#inputAltitud").val(position.coords.altitudeAccuracy)
        }

        function MostrarModalUbicacion() {
            $("#modal_ubicacion").modal('show');
        }
        function ImprimirPermisos(state) {
            console.log('Permission ' + state);
