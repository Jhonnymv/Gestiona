                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="number" class="form-control" />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="row input-group">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <br />
                                <span>Oxígeno Disuelto (mg/L)</span>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="number" class="form-control" />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="row input-group">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <br />
                                <span>Turbiedad (NTU)</span>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="number" class="form-control" />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="row input-group">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <br />
                                <span>Cloro (mg/l)</span>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="number" class="form-control" />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

            </form>
            <div class="d-flex justify-content-end button-container pd-t-b-12-37 m-0">
                <button type="submit" class="btn btn-mc-success">Guardar</button>
                <a type="button" class="btn btn-mc-outline-danger">Cancelar</a>
            </div>
        </div>
    </div>
</div>
