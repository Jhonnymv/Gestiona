                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="row input-group">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <br />
                                <span>pH (unid. ph)</span>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="number" class="form-control" />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <span class="text-danger"></span>
                                <input type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="row input-group">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <br />
