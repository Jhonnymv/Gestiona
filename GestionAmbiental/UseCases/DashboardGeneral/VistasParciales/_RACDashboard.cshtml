<div class="rac mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title rac-opacity-color">
                <h3>Dashboard de RAC</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form autocomplete="off" class="custom-form w-100 row">
                <div class="col-12">
                    <div class="col-12 mb-4">
                        <div class="row">
                            <h5 class="text-mc text-center">Filtros para RAC</h5>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label>Área Ejecutora de la Inspección</label>
                                <select class="form-control" id="IdGerenciaRAC" asp-items="@ViewBag.FiltroGerencias"></select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label>Empresa Inspeccionada</label>
                                <select class="form-control" id="IdEmpresaRAC" asp-items="@ViewBag.FiltroEmpresas"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label>Desde</label>
                                <input type="date" class="form-control" id="FInicioRAC" value="@ViewBag.FechaInicio" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label>Hasta</label>
                                <input type="date" class="form-control" id="FFinRAC" value="@ViewBag.FechaFin" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label>Gerencia Inspeccionada</label>
                                <select class="form-control" id="IdGerenciaInspeccionadaRAC" asp-items="@ViewBag.FiltroGerencias"></select>
                            </div>
                        </div>
                         <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label>Asesor MA/SSO</label>
                                <select class="form-control" id="IdAsesorRAC" asp-items="@ViewBag.FiltroAsesor"></select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label>Responsable de Marcobre para levantar Obs.</label>
                                <select class="form-control" id="IdRespLevRAC" asp-items="@ViewBag.FiltroRespLevObs"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label>Estado</label>
                                <select class="form-control" id="EstadoRAC" asp-items="@ViewBag.FiltroEstados"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4 col-xl-4 flex-column">
                    <div class="row-center-center">
                        <button type="button" class="btn btn-mc w-100" onclick="FiltrarRAC()">Filtrar</button>
                    </div>
                    @*<div class="row-center-center">
                        <button type="button" class="btn btn-mc-success w-100" onclick="DescargarObservaciones()">Descargar Observaciones</button>
                    </div>*@
                </div>
            </form>
        </div>
    </div>
</div>
