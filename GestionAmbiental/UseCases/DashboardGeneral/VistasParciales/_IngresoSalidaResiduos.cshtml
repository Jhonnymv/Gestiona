<div class="residuos mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Dashboard de Ingreso/Salida de Residuos Sólidos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form class="custom-form w-100" autocomplete="off" id="ingresoSalidaresiduosDashboard">
                <div class="col-12 col-lg-9">
                    <div class="row">
                        <h5 class="text-mc text-center">Filtros</h5>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label>ACR/CMRS</label>
                            <select class="form-control" id="ACR_CMRS_ISRS" asp-items="@ViewBag.FiltroACR_CMRS"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Ingreso o Salida de Residuos</label>
                            <select class="form-control" id="IngresoSalida_ISRS" asp-items="@ViewBag.FiltroIngresoSalida"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label>Tipo de Residuo</label>
                            <select class="form-control" id="TipoResiduo_ISRS" asp-items="@ViewBag.FiltroTipoResiduo"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Motivo de Ingreso o Salida de Residuos</label>
                            <select class="form-control" id="Motivo_ISRS" asp-items="@ViewBag.FiltroMotivo"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label>Fecha de Inicio (Ingreso o Salida de Residuo)</label>
                            <input type="date" class="form-control" id="FInicio_ISRS" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Fecha de Fin (Ingreso o Salida de Residuo)</label>
                            <input type="date" class="form-control" id="FFin_ISRS" value="@ViewBag.FechaFin" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label>Gerencia de Marcobre que Entrega/Retira el Residuo</label>
                            <select class="form-control" id="Gerencia_ISRS" asp-items="@ViewBag.FiltroGerencias"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label>Empresa que Generó/Retiró el Residuo</label>
                            <select class="form-control" id="Empresa_ISRS" asp-items="@ViewBag.FiltroEmpresas"></select>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-1">
                </div>
                <div class="col-12 col-lg-2">
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc w-100" onclick="FiltrarIngresoSalidaRS()">Filtrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>