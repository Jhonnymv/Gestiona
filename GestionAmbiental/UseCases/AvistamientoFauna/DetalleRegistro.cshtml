@model GestionAmbiental.UseCases.AvistamientoFauna.AvistamientoFaunaModel

@{
    ViewData["Title"] = "DetalleRegistro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Detalle de Registro de Avistamiento de Fauna Silvestre</h2>
    </div>
</div>

<div class="row mb-2">
    <div class="container-fluid d-flex align-items-center flex-column bg-danger">
        <h1 class="masthead-heading text-uppercase text-white text-center mt-5">SI EL ESPÉCIMEN ESTÁ HERIDO LLAMAR A: </h1>
        <h2 class="mb-5"><a class="text-white" href="tel:+51944617411">+51944617411</a></h2>
    </div>
</div>

<input type="hidden" asp-for="IdAvistamientoFauna" value="@Model.IdAvistamientoFauna" />
<div class="row mb-2" style="background-color:#2e6793">
    <div class="col-12" style="text-align:center">
        <h5 style="color:white;margin:4px;">Registro Fotográfico</h5>
        <input type="hidden" asp-for="FotosCargadas" />
    </div>
</div>
<div class="row mb-2 justify-content-center align-items-center" id="imagenes_cargadas">
</div>
<div class="row mb-2" style="background-color:#2e6793">
    <div class="col-12" style="text-align:center">
        <h5 style="color:white;margin:4px;">Datos del Avistamiento</h5>
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="Fecha_Avistamiento"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="Fecha_Avistamiento"></span>
        <input type="text" class="form-control" asp-for="Fecha_Avistamiento" value="@Model.Fecha_Avistamiento" readonly />
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="Hora_Avistamiento"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="Hora_Avistamiento"></span>
        <input type="text" class="form-control" asp-for="Hora_Avistamiento" value="@Model.Hora_Avistamiento" readonly />
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="Ubicacion"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="Ubicacion"></span>
        <input type="text" class="form-control" asp-for="Ubicacion" value="@Model.Ubicacion" readonly />
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="IdNombreComun"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="IdNombreComun"></span>
        <select asp-for="IdNombreComun" class="form-control" asp-items="ViewBag.NombreComun" value="@Model.IdNombreComun" disabled></select>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="Cantidad"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="Cantidad"></span>
        <input type="number" class="form-control" asp-for="Cantidad" value="@Model.Cantidad" readonly />
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="IdTipoAvistamiento"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="IdTipoAvistamiento"></span>
        <select asp-for="IdTipoAvistamiento" class="form-control" asp-items="ViewBag.TipoAvistamiento" value="@Model.IdTipoAvistamiento" disabled></select>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="IdEstadoFauna"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="IdEstadoFauna"></span>
        <select asp-for="IdEstadoFauna" class="form-control" asp-items="ViewBag.EstadoFauna" value="@Model.IdEstadoFauna" disabled></select>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <label asp-for="Lugar_Referencia"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
        <span class="text-danger" asp-validation-for="Lugar_Referencia"></span>
        <input type="text" class="form-control" asp-for="Lugar_Referencia" value="@Model.Lugar_Referencia" readonly />
    </div>
</div>
<div class="row mb-2" style="background-color:#2e6793">
    <div class="col-12" style="text-align:center">
        <h5 style="color:white;margin:4px;">Datos del Reportante</h5>
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <label asp-for="IdEmpresa"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <span class="text-danger" asp-validation-for="IdEmpresa"></span>
        <select asp-for="IdEmpresa" class="form-control" asp-items="ViewBag.Empresa" value="@Model.IdEmpresa" disabled></select>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <label asp-for="Nombres_Apellidos"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <input type="text" class="form-control" asp-for="Nombres_Apellidos" value="@Model.Nombres_Apellidos" readonly />
        <input type="hidden" asp-for="IdUsuario" value="@Model.IdUsuario" />
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <label asp-for="IdAreaTrabajo"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <span class="text-danger" asp-validation-for="IdAreaTrabajo"></span>
        <select asp-for="IdAreaTrabajo" class="form-control" asp-items="ViewBag.AreaTrabajo" value="@Model.IdAreaTrabajo" disabled></select>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <label asp-for="NFotocheck"></label>
    </div>
    <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
        <span class="text-danger" asp-validation-for="NFotocheck"></span>
        <input type="text" class="form-control" asp-for="NFotocheck" value="@Model.NFotocheck" readonly />
    </div>
</div>
@if (Model.Descripcion_Accion != null && Model.Evidencia_Cargada != null)
{
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">Acción Llevada a Cabo en Caso de Fauna Silvestre Herida o Muerta (Llenado por Medio Ambiente)</h5>
        </div>
    </div>

    <div class="row mb-2">
        <div class="col-sm-12 col-md-2 col-lg-2 mb-2">
            <label asp-for="Descripcion_Accion"></label>
        </div>
        <div class="col-sm-12 col-md-10 col-lg-10 mb-2">
            <span class="text-danger" asp-validation-for="Descripcion_Accion"></span>
            <textarea type="text" class="form-control" asp-for="Descripcion_Accion" rows="2" readonly></textarea>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2 mb-2">
            <label asp-for="Evidencia_Cargada"></label>
        </div>
        <input type="hidden" asp-for="Evidencia_Cargada" />
        <div class="col-sm-12 col-md-4 col-lg-4" id="Evidencias_Lista">
        </div>
    </div>
}
<div class="row mb-2 mr-2 d-flex justify-content-end">
    <a class="btn btn-secondary mr-2" style="color:white" asp-controller="AvistamientoFauna" asp-action="Resumen">Volver</a>
</div>
@section Scripts{
    <script type="text/javascript">
    var estado;
        $(document).ready(function () {
            var imagenes = '@Model.FotosCargadas';
            estado = '@Model.Estado'
            if (imagenes.length > 0) {
                var imagenes_json = JSON.parse(imagenes.replace(/&quot;/g, '"'));
                $("#FotosCargadas").val(imagenes_json);
                visualizarImagenesCargadas();
            }
            visualizarEvidencias();
        });
        function visualizarImagenesCargadas() {
            $.ajax({
                type: 'POST',
                url: '/AvistamientoFauna/ObtenerImagenesCargadas',
                data:
                {
                    imagenes: $("#FotosCargadas").val()
                },
                success: function (response) {
                    var fuentes = JSON.parse(response.imagenes);
                    var html_imagenes = "";
                    for (var i = 0; i < fuentes.length; i++) {
                        html_imagenes += "<div class=\"col-lg-3 col-md-4 col-6 mt-2\" id=\""+fuentes[i].Nombre+"\">";
                        html_imagenes += "<img style=\"width:100%; height:auto;\" class=\"card-img-top img-thumbnail\" src=\"";
                        html_imagenes += fuentes[i].Src;
                        html_imagenes += "\">";
                        html_imagenes += "</div>";
                    }
                    $("#imagenes_cargadas").html(html_imagenes);
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
        function visualizarEvidencias() {
            var evidencias = '@Model.Evidencia_Cargada';
            //evidencias
            if (evidencias.length > 0) {
                var evidencias_valores = JSON.parse(evidencias.replace(/&quot;/g, '"'));
                console.log(evidencias_valores)
                var html_evidencias = "";
                for (var i = 0; i < evidencias_valores.length; i++)
                    html_evidencias += "<p><a href=\"/AvistamientoFaunaMA/Download?fileName=" + evidencias_valores[i]+"\">Evidencia "+(i+1)+"</a></p>";

                $("#Evidencias_Lista").html(html_evidencias);
                $("#EvidenciaCargada").val(evidencias_valores);
            }
        }
    </script>
}