@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {            
            var mensaje = '@Html.Raw(ViewBag.Mensaje)';
            var contactos = JSON.parse('@Html.Raw(ViewBag.Contactos)');
            var telefonos = "";
            for (var i = 0; i < contactos.length; i++) {
                telefonos += "<a class=\"text-white\" href=\"tel:" + contactos[i] + "\">" + contactos[i] +"</a><br>";
            }
            $("#mensaje").html(mensaje);
            $("#telefonos").html(telefonos);
            filtrar(1);
            $("#modal_telefonos").modal('show');
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/AvistamientoFauna/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val(),
                    "tipo_fauna": $("#filtro_tipo_fauna").val(),
                    "estado_fauna": $("#filtro_estado_fauna").val(),
                    "lugar_referencia": $("#filtro_lugar_referencia").val(),
                    "usuario_red": '@ViewBag.Usuario'
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen tbody').empty()
                    $('#tabla_resumen tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    let r5 = 8;
                    let g5 = 99;
                    let b5 = 61;
                    faunaStyle(r5, g5, b5);
                }
            });
        }
    </script>
}

