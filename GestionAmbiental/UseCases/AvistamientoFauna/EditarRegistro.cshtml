@model GestionAmbiental.UseCases.AvistamientoFauna.AvistamientoFaunaModel
@{
    ViewData["Title"] = "EditarRegistro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Editar Registro de Avistamiento de Fauna Silvestre</h2>
    </div>
</div>

<div class="row mb-2">
    <div class="container-fluid d-flex align-items-center flex-column bg-danger">
        <h1 class="masthead-heading text-uppercase text-white text-center mt-5">COMUNICATE CON MAP AL: </h1>
        <h2 id="telefonos" class="mb-5"></h2>
    </div>
</div>
<form class="form-group" id="form_nuevo_avistamiento" asp-action="EditarRegistro" asp-controller="AvistamientoFauna" method="post" enctype="multipart/form-data" autocomplete="off">
    <input type="hidden" asp-for="IdAvistamientoFauna" value="@Model.IdAvistamientoFauna" />
    <input type="hidden" asp-for="IdEncriptado" value="@Model.IdEncriptado" />
    <input type="hidden" asp-for="Opcion" />
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">Registro Fotográfico</h5>
            <input type="hidden" asp-for="FotosCargadas" />
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-12 text-center">
            <span class="text-danger field-validation-error" data-valmsg-for="Fotos" data-valmsg-replace="true">
                <span id="alerta_fotos" class=""></span>
            </span>
            <label class="btn btn-primary" for="Fotos"><img src="~/img/icons/camara.png" /></label>
            <input type="file" style="visibility:hidden; display:none" asp-for="Fotos" accept=".jpg,.jpge,.png" data-max-size="8388608" multiple>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-lg-12 text-center">
            <img id="previsualizacion" style="width:30rem;height:auto;max-width:100%;display:none;" />
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <button id="botonCargarFoto" type="button" class="btn btn-primary" onclick="CargarFotos()" style="display:none;"><img src="~/img/icons/guardar.png" /></button>
    </div>
    <div class="row mb-2 justify-content-center align-items-center" id="imagenes_cargadas">
    </div>
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">Datos del Avistamiento</h5>
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Fecha_Avistamiento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="Fecha_Avistamiento"></span>
            <input type="date" class="form-control" asp-for="Fecha_Avistamiento" value="@Model.Fecha_Avistamiento" readonly />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Hora_Avistamiento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="Hora_Avistamiento"></span>
            <input type="time" class="form-control" asp-for="Hora_Avistamiento" value="@Model.Hora_Avistamiento" readonly />
        </div>
        <div class="col-sm-10 col-md-2 col-lg-1 col-10 mb-2">
            <label asp-for="Ubicacion"></label>
        </div>
        <div class="col-sm-2 col-md-1 col-lg-1 col-2 mb-2">
            <div class="d-flex justify-content-center">
                <button type="button" class="btn btn-primary" onclick="ObtenerUbicacion()"><img src="~/img/icons/gps.png" /></button>
            </div>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="Ubicacion"></span>
            <input type="text" class="form-control" asp-for="Ubicacion" value="@Model.Ubicacion" />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="IdNombreComun"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="IdNombreComun"></span>
            <select asp-for="IdNombreComun" class="form-control" asp-items="ViewBag.NombreComun" value="@Model.IdNombreComun"></select>
        </div>
        <div class="col-sm-12 col-md-6 col-lg-4 mb-2">
            <img id="img_referencia" style="width:100%;height:18rem;max-width:100%;display:none" />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Cantidad"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="Cantidad"></span>
            <input type="number" class="form-control" asp-for="Cantidad" value="@Model.Cantidad" />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="IdTipoAvistamiento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="IdTipoAvistamiento"></span>
            <select asp-for="IdTipoAvistamiento" class="form-control" asp-items="ViewBag.TipoAvistamiento" value="@Model.IdTipoAvistamiento"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="IdEstadoFauna"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="IdEstadoFauna"></span>
            <select asp-for="IdEstadoFauna" class="form-control" asp-items="ViewBag.EstadoFauna" value="@Model.IdEstadoFauna"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="IdLugarReferencia"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <span class="text-danger" asp-validation-for="IdLugarReferencia"></span>
            <select asp-for="IdLugarReferencia" class="form-control" asp-items="ViewBag.LugarReferencia" value="@Model.IdLugarReferencia"></select>
        </div>
    </div>
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">Datos del Reportante</h5>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <label asp-for="IdEmpresa"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <span class="text-danger" asp-validation-for="IdEmpresa"></span>
            <select asp-for="IdEmpresa" class="form-control" asp-items="ViewBag.Empresa" value="@Model.IdEmpresa"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <label asp-for="Nombres_Apellidos"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <input type="text" class="form-control" asp-for="Nombres_Apellidos" value="@Model.Nombres_Apellidos" readonly />
            <input type="hidden" asp-for="IdUsuario" value="@Model.IdUsuario" />
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <label asp-for="IdAreaTrabajo"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <span class="text-danger" asp-validation-for="IdAreaTrabajo"></span>
            <select asp-for="IdAreaTrabajo" class="form-control" asp-items="ViewBag.AreaTrabajo" value="@Model.IdAreaTrabajo"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <label asp-for="NFotocheck"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-3 mb-2">
            <span class="text-danger" asp-validation-for="NFotocheck"></span>
            <input type="text" class="form-control" asp-for="NFotocheck" value="@Model.NFotocheck" />
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-end">
        <a class="btn btn-secondary mr-2" style="color:white" asp-controller="AvistamientoFauna" asp-action="Resumen">Cancelar</a>
        <button type="button" class="btn btn-danger mr-2" onclick="eliminarRegistro()">Eliminar</button>
        <button type="button" class="btn btn-primary mr-2" onclick="GuardarEstado()">Guardar Estado</button>
        <button type="button" class="btn btn-primary" onclick="Registrar()">Registrar</button>
    </div>
</form>

<!-- Modal Imagen Referencia-->
<div class="modal fade" id="modal_imagen_referencia" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_imagen_referencia"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-12">
                        <img id="ImagenEspecie" style="width:100%;height:auto" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-center">
                        <label id="NombreEspecie" class="font-weight-bold"></label>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script type="text/javascript">
        var estado;
        var imagenesReferencia = [];
        $(document).ready(function () {
            var contactos = JSON.parse('@Html.Raw(ViewBag.Contactos)');
            var telefonos = "";
            for (var i = 0; i < contactos.length; i++) {
                telefonos += "<a class=\"text-white\" href=\"tel:" + contactos[i] + "\">" + contactos[i] +"</a><br>";
            }
            $("#telefonos").html(telefonos)
            ObtenerImagenesReferencia()
            var imagenes = '@Model.FotosCargadas';
            estado = '@Model.Estado'
            if (imagenes.length > 0) {
                var imagenes_json = JSON.parse(imagenes.replace(/&quot;/g, '"'));
                $("#FotosCargadas").val(imagenes_json);
                visualizarImagenesCargadas();
            }
        });
        function ObtenerUbicacion() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(MostrarUbicacion);
            } else {
                ubicacion.val("");
            }
        }
        function MostrarUbicacion(position) {
            ubicacion.val(position.coords.latitude + " " + position.coords.longitude);
        }
        function visualizarImagenesCargadas() {
            $.ajax({
                type: 'POST',
                url: '/AvistamientoFauna/ObtenerImagenesCargadas',
                data:
                {
                    imagenes: $("#FotosCargadas").val()
                },
                success: function (response) {
                    var fuentes = JSON.parse(response.imagenes);
                    var html_imagenes = "";
                    for (var i = 0; i < fuentes.length; i++) {
                        html_imagenes += "<div class=\"col-lg-3 col-md-4 col-6 mt-2\" id=\""+fuentes[i].Nombre+"\">";
                        html_imagenes += "<div class=\"card\" style=\"width:100%;\">";
                        html_imagenes += "<img style=\"width:100%; height:auto;\" class=\"card-img-top img-thumbnail\" src=\"";
                        html_imagenes += fuentes[i].Src;
                        html_imagenes += "\">";
                        html_imagenes += "<div class=\"card-body text-center\">";
                        html_imagenes += "<button type=\"button\" class=\"btn btn-danger\" onclick=\"eliminarImagen(\'"+fuentes[i].Nombre+"\')\">Eliminar</button>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                    }
                    $("#imagenes_cargadas").html(html_imagenes);
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
        function eliminarImagen(nombreArchivo) {
            if (confirm("¿Está seguro de eliminar esta fotografía?"))
                $.ajax({
                    type: 'POST',
                    url: '/AvistamientoFauna/EliminarImagen',
                    data:
                    {
                        IdAvistamiento: $("#IdAvistamientoFauna").val(),
                        imagen: nombreArchivo
                    },
                    success: function () {
                    eliminarElemento(nombreArchivo);
                    var fotos = $("#FotosCargadas").val();
                    fotos = fotos.replace(nombreArchivo, "");
                    fotos = fotos.replace(",,", ",");
                    $("#FotosCargadas").val(fotos);
                    },
                    error: function () {
                    console.log("No se ha podido obtener la información");
                    }
                });
        }
        function preview_image(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('previsualizacion');
                output.src = reader.result;
            }
            try {
                reader.readAsDataURL(event.target.files[0]);
                $("#previsualizacion").show();
                $("#botonCargarFoto").show();
            } catch (error) {
                $("#previsualizacion").hide();
                $("#botonCargarFoto").hide();
            }
        }
        function ObtenerImagenesReferencia() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/ObtenerImagenesReferencia',
                success: function (response) {
                    for (var i = 0; i < response.ids.length; i++) {
                        var imagen = { id: response.ids[i], nombre: response.nombres[i], src: response.fotos[i] };
                        imagenesReferencia.push(imagen);
                    }
                },
                error: function () {
                    console.log("No se ha podido obtener las imagenes");
                }
            });
        }
        $("#IdNombreComun").on('change', function () {
            var nombreComun = $("#IdNombreComun").val();
            if (nombreComun != 0) {
                for (var i = 0; i < imagenesReferencia.length; i++) {
                    if (imagenesReferencia[i].id == nombreComun) {
                        $("#img_referencia").attr("src", imagenesReferencia[i].src);
                        $("#img_referencia").show();
                        return;
                    }
                }
                $("#img_referencia").hide();
            }
        }); 
        $("#Fotos").change(function (event) {
            $("#alerta_fotos").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Fotos").data('max-size');
            var archivos = $("#Fotos").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#alerta_fotos").html("El  archivo supera el límite permitido de 8MB<br/>");
                    $("#previsualizacion").hide();
                    $("#botonCargarFoto").hide();
                    return;

                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#alerta_fotos").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
                preview_image(event);
            }
        });
        function CargarFotos() {
            var archivos = $("#Fotos").get(0).files;
            $("#Opcion").val("GuardarEstado")

            if (archivos.length > 0) {
                $("#form_nuevo_avistamiento").submit();
            } else {
                alert("Debe cargar una fotografía");
            }

        }
        function eliminarElemento(elementId) {
            var element = document.getElementById(elementId);
            element.parentNode.removeChild(element);
        }
        function eliminarRegistro() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/EliminarRegistro',
                data:
                {
                    IdAvistamiento: $("#IdAvistamientoFauna").val(),
                    imagenes: $("#FotosCargadas").val()
                },
                success: function () {
                    window.location.replace('@Url.Action("Resumen","AvistamientoFauna")');
                }
            });
        }
        function GuardarEstado() {
            $("#Opcion").val("GuardarEstado")
            $("#form_nuevo_avistamiento").submit()
        }
        function Registrar() {
            if (ValidarCampos()) {
                $("#Opcion").val("Registrar")
                $("#form_nuevo_avistamiento").submit()
            } else {
                alert("Existen campos vacios")
            }
        }
        function ValidarCampos() {
            var resultado = true;
            if ($("#Fecha_Avistamiento").val() == "") resultado = false;
            if ($("#FotosCargadas").val() != "" && $("#Fotos").val() != "") resultado = false;
            if ($("#Hora_Avistamiento").val() == "") resultado = false;
            if ($("#Ubicacion").val() == "") resultado = false;
            if ($("#Cantidad").val() == "") resultado = false;
            if ($("#IdNombreComun").val() == "0") resultado = false;
            if ($("#IdTipoFauna").val() == "0") resultado = false;
            if ($("#IdTipoAvistamiento").val() == "0") resultado = false;
            if ($("#IdEstadoFauna").val() == "0") resultado = false;
            if ($("#Lugar_Referencia").val() == "") resultado = false;
            if ($("#Nombres_Apellidos").val() == "") resultado = false;
            /*if ($("#IdEmpresa").val() == "") resultado = false;
            if ($("#IdAreaTrabajo").val() == "") resultado = false;
            if ($("#NFotocheck").val() == "") resultado = false;*/
            return resultado;
        }
    </script>
}



