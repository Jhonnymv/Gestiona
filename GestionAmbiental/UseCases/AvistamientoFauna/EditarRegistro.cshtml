@model GestionAmbiental.UseCases.AvistamientoFauna.AvistamientoFaunaModel
@{
    ViewData["Title"] = "EditarRegistro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="fauna">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title fauna-opacity-color">
                <h3>Editar Registro de Avistamiento de Fauna Silvestre</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <div class="custom-form details-container w-100">
                <form id="form_nuevo_avistamiento" asp-action="EditarRegistro" asp-controller="AvistamientoFauna" method="post" enctype="multipart/form-data" autocomplete="off">
                    <input type="hidden" asp-for="IdAvistamientoFauna" value="@Model.IdAvistamientoFauna" />
                    <input type="hidden" asp-for="IdEncriptado" value="@Model.IdEncriptado" />
                    <input type="hidden" asp-for="Codigo" value="@Model.Codigo" />
                    <input type="hidden" asp-for="Estado" value="@Model.Estado" />
                    <input type="hidden" asp-for="FotosCargadas" />
                    <input type="hidden" asp-for="Opcion" />
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="row input_container">
                            <span class="text-danger field-validation-error" data-valmsg-for="Fotos" data-valmsg-replace="true">
                                <span id="alerta_fotos" class=""></span>
                            </span>
                            <label class="btn fauna-color btn btn-special-action" for="Fotos"><img src="~/img/icons/camara.png" /></label>
                            <input type="file" style="visibility:hidden; display:none" asp-for="Fotos" accept=".jpg,.jpeg,.png" data-max-size="8388608" multiple>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 text-center">
                                <img id="previsualizacion" style="width:30rem;height:auto;max-width:50%;display:none" />
                            </div>
                        </div>
                        <div class="row mb-2 justify-content-center align-items-center" id="imagenes_cargadas">
                        </div>
                        <div class="row">
                            <div class="d-flex justify-content-center">
                                <button type="button" id="botonCargarFoto" class="btn btn-mc" onclick="CargarFotos()" style="display:none;">Subir</button>
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL AVISTAMIENTO</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="Fecha_Avistamiento"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Avistamiento"></span>
                                <input type="date" class="form-control" asp-for="Fecha_Avistamiento" value="@Model.Fecha_Avistamiento" />
                            </div>
                            <div class="col-12 col-sm-3 col-lg-3">
                                <label asp-for="Hora_Avistamiento"></label>
                                <span class="text-danger" asp-validation-for="Hora_Avistamiento"></span>
                                <input type="time" class="form-control" asp-for="Hora_Avistamiento" value="@Model.Hora_Avistamiento" />
                            </div>
                            <div class="col-12 col-sm-5 col-lg-5">
                                <div class="row d-flex align-items-end m-0">
                                    <div class="col-8 p-0 m-0">
                                        <label asp-for="Ubicacion">Ubicación</label>
                                        <span class="text-danger" asp-validation-for="Ubicacion"></span>
                                        <input type="text" class="form-control" asp-for="Ubicacion" />
                                    </div>
                                    <div class="col-4 m-0 d-flex justify-content-end">
                                        <button type="button" class="btn btn-primary" onclick="ObtenerUbicacion()"><img src="~/img/icons/gps.png" /></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdNombreComun"></label>
                                <span class="text-danger" asp-validation-for="IdNombreComun"></span>
                                <select asp-for="IdNombreComun" class="form-control" asp-items="ViewBag.NombreComun" value="@Model.IdNombreComun"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <div id="card_img_referencia" class="card" style="border-radius: 15px; width:auto; display:none; overflow:hidden;">
                                    <img id="img_referencia" style="width:auto; height:10rem; max-width:100%; object-fit:scale-down; border-radius: 15px;" alt="imagen referencia">
                                    <div class="card-body">
                                        <p class="card-text text-center">Imagen de Referencia</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Cantidad">Cantidad</label>
                                <span class="text-danger" asp-validation-for="Cantidad"></span>
                                <input type="number" class="form-control" asp-for="Cantidad" value="1" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdTipoAvistamiento"></label>
                                <span class="text-danger" asp-validation-for="IdTipoAvistamiento"></span>
                                <select asp-for="IdTipoAvistamiento" class="form-control" asp-items="ViewBag.TipoAvistamiento" value="@Model.IdTipoAvistamiento"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdEstadoFauna"></label>
                                <span class="text-danger" asp-validation-for="IdEstadoFauna"></span>
                                <select asp-for="IdEstadoFauna" class="form-control" asp-items="ViewBag.EstadoFauna" value="@Model.IdEstadoFauna"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdLugarReferencia"></label>
                                <span class="text-danger" asp-validation-for="IdLugarReferencia"></span>
                                <select asp-for="IdLugarReferencia" class="form-control" asp-items="ViewBag.LugarReferencia" value="@Model.IdLugarReferencia"></select>
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL REPORTANTE</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdEmpresa"></label>
                                <span class="text-danger" asp-validation-for="IdEmpresa"></span>
                                <select asp-for="IdEmpresa" class="form-control" asp-items="ViewBag.Empresa" value="@Model.IdEmpresa" disabled></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Nombres_Apellidos"></label>
                                <input type="text" class="form-control" asp-for="Nombres_Apellidos" value="@Model.Nombres_Apellidos" readonly />
                                <input type="hidden" asp-for="IdUsuario" value="@Model.IdUsuario" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdAreaTrabajo"></label>
                                <span class="text-danger" asp-validation-for="IdAreaTrabajo"></span>
                                <select asp-for="IdAreaTrabajo" class="form-control" asp-items="ViewBag.AreaTrabajo" value="@Model.IdAreaTrabajo" disabled></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="DNI"></label>
                                <span class="text-danger" asp-validation-for="DNI"></span>
                                <input type="text" class="form-control" asp-for="DNI" value="@Model.DNI" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="row">
                            <div class="button-container">
                                <a class="btn btn-mc-outline-danger mr-2" asp-controller="AvistamientoFauna" asp-action="Resumen">Cancelar</a>
                                @if (ViewBag.Rol == "Admin")
                                {
                                    <button type="button" class="btn btn-mc-success mr-2" onclick="EditarAdmin()">Guardar</button>
                                    <button type="button" class="btn btn-mc-danger mr-2" onclick="eliminarRegistro()">Eliminar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-mc-danger mr-2" onclick="eliminarRegistro()">Eliminar</button>
                                    <button type="button" class="btn btn-mc-outline-success mr-2" onclick="GuardarEstado()">Guardar Estado</button>
                                    <button type="button" class="btn btn-mc-success" onclick="Registrar()">Registrar</button>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ubicación-->
<div class="modal fade mc-modal" id="modal_ubicacion" tabindex="-1" aria-labelledby="titulo_modal_ubicacion" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="mc-modal-image-background">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="col-12 titulo-pagina">
                        <h3 class="text-white text-center mb-4">No se tiene permiso para obtener la ubicación</h3>
                    </div>
                    <div class="col-12">
                        <h4 class="text-white">Para habilitarlos siga los siguientes pasos:</h4>
                        <br>
                        <h5 class="text-white">1. Acceder a las opciones del navegador (<img style="margin: unset; width: unset; filter: invert(1)" src="~/img/icons/options.png" />)</h5>
                        <h5 class="text-white">2. Ingresar a la "Configuración"</h5>
                        <h5 class="text-white">3. Buscar e ingresar a "Ubicación"</h5>
                        <h5 class="text-white">4. Buscar los sitios bloqueados y quitar a Gestiona</h5>
                        <h5 class="text-white">5. Actualizar esta página</h5>
                        <h5 class="text-white">6. Conceder los permisos de ubicación cuando se le solicite</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Guardando-->
<div class="modal fade mc-modal" id="Modal_Guardando" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white">Guardando Registro</label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var temp;
        var estado;
        var imagenesReferencia = [];
        $(document).ready(function () {
            ObtenerImagenesReferencia()
            var imagenes = '@Model.FotosCargadas';
            estado = '@Model.Estado'
            if (imagenes.length > 0) {
                var imagenes_json = JSON.parse(imagenes.replace(/&quot;/g, '"'));
                $("#FotosCargadas").val(imagenes_json);
                visualizarImagenesCargadas();
            }
        });
        function ObtenerUbicacion() {
            navigator.permissions.query({ name: 'geolocation' }).then(function (result) {
                if (result.state == 'granted') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'prompt') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'denied') {
                    MostrarModalUbicacion()
                    ImprimirPermisos(result.state);
                }
                result.onchange = function () {
                    console.log("cambio")
                    ImprimirPermisos(result.state);
                }
            });
        }
        function MostrarModalUbicacion() {
            $("#modal_ubicacion").modal('show');
        }
        function ImprimirPermisos(state) {
            console.log('Permission ' + state);
        }
        function MostrarUbicacion(position) {
            ubicacion.val(position.coords.latitude + " , " + position.coords.longitude);
        }
        function visualizarImagenesCargadas() {
            $.ajax({
                type: 'POST',
                url: '/AvistamientoFauna/ObtenerImagenesCargadas',
                data:
                {
                    imagenes: $("#FotosCargadas").val()
                },
                success: function (response) {
                    temp = response;
                    var fuentes = JSON.parse(response.imagenes);
                    var html_imagenes = "";
                    for (var i = 0; i < fuentes.length; i++) {
                        html_imagenes += "<div class=\"col-lg-3 col-md-4 col-6 mt-2\" id=\""+fuentes[i].Nombre+"\">";
                        html_imagenes += "<div class=\"card\" style=\"width:100%;\">";
                        html_imagenes += "<img style=\"width:100%; height:auto;\" class=\"card-img-top img-thumbnail\" src=\"";
                        html_imagenes += fuentes[i].Src;
                        html_imagenes += "\">";
                        html_imagenes += "<div class=\"card-body text-center\">";
                        html_imagenes += "<button type=\"button\" class=\"btn btn-danger\" onclick=\"eliminarImagen(\'"+fuentes[i].Nombre+"\')\">Eliminar</button>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                    }
                    $("#imagenes_cargadas").html(html_imagenes);
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
        function eliminarImagen(nombreArchivo) {
            if (confirm("¿Está seguro de eliminar esta fotografía?"))
                $.ajax({
                    type: 'POST',
                    url: '/AvistamientoFauna/EliminarImagen',
                    data:
                    {
                        IdAvistamiento: $("#IdAvistamientoFauna").val(),
                        imagen: nombreArchivo
                    },
                    success: function () {
                    eliminarElemento(nombreArchivo);
                    var fotos = $("#FotosCargadas").val();
                    fotos = fotos.replace(nombreArchivo, "");
                    fotos = fotos.replace(",,", ",");
                    $("#FotosCargadas").val(fotos);
                    },
                    error: function () {
                    console.log("No se ha podido obtener la información");
                    }
                });
        }
        function preview_image(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('previsualizacion');
                output.src = reader.result;
            }
            try {
                reader.readAsDataURL(event.target.files[0]);
                $("#previsualizacion").show();
                $("#botonCargarFoto").show();
            } catch (error) {
                $("#previsualizacion").hide();
                $("#botonCargarFoto").hide();
            }
        }
        function ObtenerImagenesReferencia() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/ObtenerImagenesReferencia',
                success: function (response) {
                    for (var i = 0; i < response.ids.length; i++) {
                        var imagen = { id: response.ids[i], nombre: response.nombres[i], src: response.fotos[i] };
                        imagenesReferencia.push(imagen);
                    }
                },
                error: function () {
                    console.log("No se ha podido obtener las imagenes");
                }
            });
        }
        $("#IdNombreComun").on('change', function () {
            var nombreComun = $("#IdNombreComun").val();
            if (nombreComun != 0) {
                for (var i = 0; i < imagenesReferencia.length; i++) {
                    if (imagenesReferencia[i].id == nombreComun) {
                        $("#img_referencia").attr("src", imagenesReferencia[i].src);
                        $("#card_img_referencia").show();
                        return;
                    }
                }
                $("#card_img_referencia").show();
            }
            else {
                $("#card_img_referencia").hide();
            }
        });
        $("#Fotos").change(function (event) {
            $("#alerta_fotos").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Fotos").data('max-size');
            var archivos = $("#Fotos").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#alerta_fotos").html("El  archivo supera el límite permitido de 8MB<br/>");
                    $("#previsualizacion").hide();
                    $("#botonCargarFoto").hide();
                    return;

                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#alerta_fotos").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
                preview_image(event);
            }
        });
        function CargarFotos() {
            var archivos = $("#Fotos").get(0).files;
            $("#Opcion").val("GuardarEstado");

            if (archivos.length > 0) {
                $("#form_nuevo_avistamiento").submit();
            } else {
                alert("Debe cargar una fotografía");
            }

        }
        function eliminarElemento(elementId) {
            var element = document.getElementById(elementId);
            element.parentNode.removeChild(element);
        }
        function eliminarRegistro() {
            if (confirm('¿Está seguro que desea eliminar el registro?')) {
                $.ajax({
                    type: 'GET',
                    url: '/AvistamientoFauna/EliminarRegistro',
                    data:
                    {
                        IdAvistamiento: $("#IdAvistamientoFauna").val(),
                        imagenes: $("#FotosCargadas").val()
                    },
                    success: function () {
                        window.location.replace('@Url.Action("Resumen","AvistamientoFauna")');
                    }
                });
            }
        }
        function GuardarEstado() {
            if ($("#FotosCargadas").val() != "" || $("#Fotos").val() != "") {
                $("#Opcion").val("GuardarEstado")
                $("#Modal_Guardando").modal('show')
                $("#form_nuevo_avistamiento").submit()
            } else {
                alert("Debe cargar una fotografía");
            }
        }
        function EditarAdmin() {
            if ($("#FotosCargadas").val() != "" || $("#Fotos").val() != "") {
                $("#Opcion").val("EditarAdmin")
                $("#Modal_Guardando").modal('show')
                $("#form_nuevo_avistamiento").submit()
            } else {
                alert("Debe cargar una fotografía");
            }
        }
        function Registrar() {
            if (ValidarCampos()) {
                $("#Opcion").val("Registrar")
                $("#Modal_Guardando").modal('show')
                $("#form_nuevo_avistamiento").submit()
            } else {
                alert("Existen campos vacios")
            }
        }
        function ReiniciarTextosValidacion() {
            $("[data-valmsg-for='Fecha_Avistamiento']").html("");
            $("[data-valmsg-for='FotosCargadas']").html("");
            $("[data-valmsg-for='Hora_Avistamiento']").html("");
            $("[data-valmsg-for='Ubicacion']").html("");
            $("[data-valmsg-for='Cantidad']").html("");
            $("[data-valmsg-for='IdNombreComun']").html("");
            $("[data-valmsg-for='IdTipoFauna']").html("");
            $("[data-valmsg-for='IdTipoAvistamiento']").html("");
            $("[data-valmsg-for='IdEstadoFauna']").html("");
            $("[data-valmsg-for='IdLugarReferencia']").html("");
            $("[data-valmsg-for='Nombres_Apellidos']").html("");
        }
        function ValidarCampos() {
            ReiniciarTextosValidacion();
            var resultado = true;
            if ($("#Fecha_Avistamiento").val() == "") {
                resultado = false;
                $("[data-valmsg-for='Fecha_Incidente']").html("Debe completar este campo");
            }
            if ($("#FotosCargadas").val() == "" && $("#Fotos").val() == "") {
                resultado = false;
                $("#alerta_fotos").text("Debe cargar por lo menos una fotografía");
            }
            if ($("#Hora_Avistamiento").val() == "") {
                resultado = false;
                $("[data-valmsg-for='Hora_Avistamiento']").html("Debe completar este campo");
            }
            if ($("#Ubicacion").val() == "") {
                MostrarModalUbicacion(); { resultado = false; }
                $("[data-valmsg-for='Ubicacion']").html("Debe completar este campo");
            }
            if ($("#Cantidad").val() == "") {
                resultado = false;
                $("[data-valmsg-for='Cantidad']").html("Debe completar este campo");
            }
            if ($("#IdNombreComun").val() == "0") {
                resultado = false;
                $("[data-valmsg-for='IdNombreComun']").html("Debe seleccionar una opción");
            }
            if ($("#IdTipoFauna").val() == "0") {
                resultado = false;
                $("[data-valmsg-for='IdTipoFauna']").html("Debe seleccionar una opción");
            }
            if ($("#IdTipoAvistamiento").val() == "0") {
                resultado = false;
                $("[data-valmsg-for='IdTipoAvistamiento']").html("Debe seleccionar una opción");
            }
            if ($("#IdEstadoFauna").val() == "0") {
                resultado = false;
                $("[data-valmsg-for='IdEstadoFauna']").html("Debe seleccionar una opción");
            }
            if ($("#IdLugarReferencia").val() == "0") {
                resultado = false;
                $("[data-valmsg-for='IdLugarReferencia']").html("Debe seleccionar una opción");
            }
            if ($("#Nombres_Apellidos").val() == "") {
                resultado = false;
                $("[data-valmsg-for='Nombres_Apellidos']").html("Debe completar este campo");
            }
            return resultado;
        }
    </script>
}



