@section scripts{
    <script type="text/javascript">
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/AvistamientoFauna/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/AvistamientoFaunaMA/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fecha": $("#filtro_fecha").val(),
                    "tipo_fauna": $("#filtro_tipo_fauna").val(),
                    "estado_fauna": $("#filtro_estado_fauna").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen tbody').empty()
                    $('#tabla_resumen tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                    let r5 = 8;
                    let g5 = 99;
                    let b5 = 61;
                    faunaStyle(r5, g5, b5);
                }
            });
        }
    </script>
}

