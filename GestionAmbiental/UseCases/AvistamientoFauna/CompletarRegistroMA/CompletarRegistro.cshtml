@model GestionAmbiental.UseCases.AvistamientoFauna.AvistamientoFaunaModel

@{
    ViewData["Title"] = "CompletarRegistro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="fauna">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title fauna-opacity-color">
                <h3>Completar Registro de Avistamiento de Fauna Silvestre</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <div class="custom-form details-container w-100">
                <form id="form_completar_avistamiento" asp-action="CompletarRegistro" asp-controller="AvistamientoFaunaMA" method="post" enctype="multipart/form-data" autocomplete="off">
                    <input type="hidden" asp-for="IdAvistamientoFauna" value="@Model.IdAvistamientoFauna" />
                    <input type="hidden" asp-for="FotosCargadas" />
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="row mb-2 justify-content-center align-items-center" id="imagenes_cargadas">
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL AVISTAMIENTO</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="Fecha_Avistamiento"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Avistamiento"></span>
                                <input type="date" class="form-control" asp-for="Fecha_Avistamiento" value="@Model.Fecha_Avistamiento" />
                            </div>
                            <div class="col-12 col-sm-3 col-lg-3">
                                <label asp-for="Hora_Avistamiento"></label>
                                <span class="text-danger" asp-validation-for="Hora_Avistamiento"></span>
                                <input type="time" class="form-control" asp-for="Hora_Avistamiento" value="@Model.Hora_Avistamiento" />
                            </div>
                            <div class="col-12 col-sm-5 col-lg-5">
                                <label asp-for="Ubicacion">Ubicación</label>
                                <span class="text-danger" asp-validation-for="Ubicacion"></span>
                                <input type="text" class="form-control" asp-for="Ubicacion" value="@Model.Ubicacion" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdNombreComun"></label>
                                <span class="text-danger" asp-validation-for="IdNombreComun"></span>
                                <select asp-for="IdNombreComun" class="form-control" asp-items="ViewBag.NombreComun" value="@Model.IdNombreComun"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Cantidad">Cantidad</label>
                                <span class="text-danger" asp-validation-for="Cantidad"></span>
                                <input type="number" class="form-control" asp-for="Cantidad" value="@Model.Cantidad" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdTipoAvistamiento"></label>
                                <span class="text-danger" asp-validation-for="IdTipoAvistamiento"></span>
                                <select asp-for="IdTipoAvistamiento" class="form-control" asp-items="ViewBag.TipoAvistamiento" value="@Model.IdTipoAvistamiento"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdEstadoFauna"></label>
                                <span class="text-danger" asp-validation-for="IdEstadoFauna"></span>
                                <select asp-for="IdEstadoFauna" class="form-control" asp-items="ViewBag.EstadoFauna" value="@Model.IdEstadoFauna"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdLugarReferencia"></label>
                                <span class="text-danger" asp-validation-for="IdLugarReferencia"></span>
                                <select asp-for="IdLugarReferencia" class="form-control" asp-items="ViewBag.LugarReferencia" value="@Model.IdLugarReferencia"></select>
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL REPORTANTE</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdEmpresa"></label>
                                <span class="text-danger" asp-validation-for="IdEmpresa"></span>
                                <select asp-for="IdEmpresa" class="form-control" asp-items="ViewBag.Empresa" value="@Model.IdEmpresa"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Nombres_Apellidos"></label>
                                <input type="text" class="form-control" asp-for="Nombres_Apellidos" value="@Model.Nombres_Apellidos" />
                                <input type="hidden" asp-for="IdUsuario" value="@Model.IdUsuario" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="IdAreaTrabajo"></label>
                                <span class="text-danger" asp-validation-for="IdAreaTrabajo"></span>
                                <select asp-for="IdAreaTrabajo" class="form-control" asp-items="ViewBag.AreaTrabajo" value="@Model.IdAreaTrabajo"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="DNI"></label>
                                <span class="text-danger" asp-validation-for="DNI"></span>
                                <input type="text" class="form-control" asp-for="DNI" value="@Model.DNI" />
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">ACCIÓN LLEVADA A CABO EN CASO DE FAUNA SILVESTRE HERIDA O MUERTA (LLENADO POR MEDIO AMBIENTE)</span>
                        </div>
                        <div class="row input_container align-items-start">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Descripcion_Accion"></label>
                                <span class="text-danger" asp-validation-for="Descripcion_Accion"></span>
                                <textarea type="text" class="form-control" asp-for="Descripcion_Accion" rows="2"></textarea>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Evidencia_Accion"></label>
                                <span class="text-danger field-validation-error" data-valmsg-for="Evidencia_Accion" data-valmsg-replace="true">
                                    <span id="danger_evidencia" class=""></span>
                                </span>
                                @*<label class="btn btn-primary" for="Evidencia_Accion">Adjuntar</label>*@
                                <input class="form-control" type="file" asp-for="Evidencia_Accion" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8388608" multiple>
                            </div>
                        </div>
                    </div>

                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="row">
                            <div class="button-container">
                                <a class="btn btn-mc-outline-danger mr-2" asp-controller="AvistamientoFauna" asp-action="Resumen">Volver</a>
                                <button id="btn_guardar" type="button" class="btn btn-mc-success" onclick="Guardar()">Guardar</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Modal Guardando-->
<div class="modal fade mc-modal" id="Modal_Guardando" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="normal" font-size="none" text-anchor="middle" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white">Guardando Registro</label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
    var estado;
        $(document).ready(function () {
            var imagenes = '@Model.FotosCargadas';
            estado = '@Model.Estado'
            if (imagenes.length > 0) {
                var imagenes_json = JSON.parse(imagenes.replace(/&quot;/g, '"'));
                $("#FotosCargadas").val(imagenes_json);
                visualizarImagenesCargadas();
            }
        });
        function visualizarImagenesCargadas() {
            $.ajax({
                type: 'POST',
                url: '/AvistamientoFauna/ObtenerImagenesCargadas',
                data:
                {
                    imagenes: $("#FotosCargadas").val()
                },
                success: function (response) {
                    var fuentes = JSON.parse(response.imagenes);
                    var html_imagenes = "";
                    for (var i = 0; i < fuentes.length; i++) {
                        html_imagenes += "<div class=\"col-lg-3 col-md-4 col-6 mt-2\" id=\"" + fuentes[i].Nombre + "\">";
                        html_imagenes += "<div class=\"card\" style=\"width:100%;\">";
                        html_imagenes += "<img style=\"width:100%; height:auto;\" class=\"card-img-top img-thumbnail\" src=\"";
                        html_imagenes += fuentes[i].Src;
                        html_imagenes += "\">";
                        html_imagenes += "<div class=\"card-body text-center\">";
                        html_imagenes += "<button type=\"button\" class=\"btn btn-danger\" onclick=\"eliminarImagen(\'" + fuentes[i].Nombre + "\')\">Eliminar</button>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                        html_imagenes += "</div>";
                    }
                    $("#imagenes_cargadas").html(html_imagenes);
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
        function eliminarImagen(nombreArchivo) {
            if (confirm("¿Está seguro de eliminar esta fotografía?"))
                $.ajax({
                    type: 'POST',
                    url: '/AvistamientoFauna/EliminarImagen',
                    data:
                    {
                        IdAvistamiento: $("#IdAvistamientoFauna").val(),
                        imagen: nombreArchivo
                    },
                    success: function () {
                        eliminarElemento(nombreArchivo);
                        var fotos = $("#FotosCargadas").val();
                        fotos = fotos.replace(nombreArchivo, "");
                        fotos = fotos.replace(",,", ",");
                        $("#FotosCargadas").val(fotos);
                    },
                    error: function () {
                        console.log("No se ha podido obtener la información");
                    }
                });
        }
        function eliminarElemento(elementId) {
            var element = document.getElementById(elementId);
            element.parentNode.removeChild(element);
        }
        $("#Evidencia_Accion").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Evidencia_Accion").data('max-size');
            var archivos = $("#Evidencia_Accion").get(0).files;
            var filesName = "";
            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            $("#nombre_archivo").text(filesName);
                            $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#nombre_archivo").html(filesName) : null;
            } else
                $("#nombre_archivo").html("0 Archivos")
        });
        $("#btn_guardar").on("click", function () {
            if ($("#Evidencia_Accion").get(0).files.length > 0 &&
                $("#Descripcion_Accion").val() != "")
            {
                $("#Modal_Guardando").modal('show');
                $("#form_completar_avistamiento").submit();
            } else {
                alert("Debe cargar  la descripción y la evidencia de la acción");
            }
        });
    </script>
}
