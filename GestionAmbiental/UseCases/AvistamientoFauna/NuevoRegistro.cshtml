    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white">Guardando Registro</label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/stepper.js"></script>
    <script type="text/javascript">
        var ubicacion = $("#Ubicacion");
        var imagenesReferencia = [];
        $(document).ready(function () {
            CargarDatos();
        });
        function preview_image(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('previsualizacion');
                output.src = reader.result;
            }
            try {
                reader.readAsDataURL(event.target.files[0]);
                $("#previsualizacion").show();
                $("#botonCargarFoto").show();
            } catch (error) {
                $("#previsualizacion").hide();
                $("#botonCargarFoto").hide();
            }
        }
        function CargarDatos() {
            var fechaActual = new Date();
            $("#Fecha_Avistamiento").val(DarFormatoFecha(fechaActual));
            $("#Hora_Avistamiento").val(DarFormatoHora(fechaActual));
            ObtenerUbicacion();
            ObtenerImagenesReferencia();
        }
        function DarFormatoFecha(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            return [year, month, day].join('-');
        }
        function DarFormatoHora(date) {
            var d = new Date(date),
                hour = '' + (d.getHours() + 1),
                minute = '' + d.getMinutes()

            if (hour.length < 2)
                hour = '0' + hour;
            if (minute.length < 2)
                minute = '0' + minute;

            return [hour, minute].join(':');
        }
        function MostrarUbicacion(position) {
            ubicacion.val(position.coords.latitude + " , " + position.coords.longitude);
        }
        function ObtenerImagenesReferencia() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/ObtenerImagenesReferencia',
                success: function (response) {
                    for (var i = 0; i < response.ids.length; i++) {
                        var imagen = { id: response.ids[i], nombre: response.nombres[i], src: response.fotos[i] };
                        imagenesReferencia.push(imagen);
                    }
                },
                error: function () {
                    console.log("No se ha podido obtener las imagenes");
                }
            });
        }
        $("#IdNombreComun").on('change', function () {
            var nombreComun = $("#IdNombreComun").val();
            if (nombreComun != 0) {
                for (var i = 0; i < imagenesReferencia.length; i++) {
                    if (imagenesReferencia[i].id == nombreComun) {
                        $("#img_referencia").attr("src", imagenesReferencia[i].src);
                        $("#card_img_referencia").show();
                        return;
                    }
                }
                $("#card_img_referencia").show();
            }
            else {
                $("#card_img_referencia").hide();
            }
        });
        //Fotos
        $("#Fotos").change(function (event) {
            $("#alerta_fotos").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Fotos").data('max-size');
            var archivos = $("#Fotos").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#alerta_fotos").html("El  archivo supera el límite permitido de 8MB<br/>");
                    $("#previsualizacion").hide();
                    $("#botonCargarFoto").hide();
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#alerta_fotos").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
                preview_image(event);
            }
        });
        function CargarFotos() {
            var archivos = $("#Fotos").get(0).files;

            if (archivos.length > 0) {
                $("#Opcion").val("GuardarEstado");
                $("#form_nuevo_avistamiento").submit();;
            } else {
                alert("Debe cargar una fotografía");
            }

        }
        function GuardarEstado() {
            if ($("#Fotos").get(0).files.length > 0) {
                $("#Opcion").val("GuardarEstado");
                $("#Modal_Guardando").modal('show');
                $("#form_nuevo_avistamiento").submit();
            } else {
                alert("Debe cargar una fotografía");
            }
        }
        function Registrar() {
            if (ValidarCampos()) {
                $("#Opcion").val("Registrar");
                $("#Modal_Guardando").modal('show');
                $("#form_nuevo_avistamiento").submit();
            } else {
                alert("Existen campos vacios");
            }
        }
        function ValidarCampos() {
            var resultado = true;
            if ($("#Fecha_Avistamiento").val() == "") resultado = false;
            if ($("#FotosCargadas").val() == "") resultado = false;
            if ($("#Fotos").val() == "") resultado = false;
            if ($("#Hora_Avistamiento").val() == "") resultado = false;
            if ($("#Ubicacion").val() == "") { MostrarModalUbicacion(); resultado = false; }
            if ($("#Cantidad").val() == "") resultado = false;
            if ($("#IdNombreComun").val() == "0") resultado = false;
            if ($("#IdTipoFauna").val() == "0") resultado = false;
            if ($("#IdTipoAvistamiento").val() == "0") resultado = false;
            if ($("#IdEstadoFauna").val() == "0") resultado = false;
            if ($("#IdLugarReferencia").val() == "0") resultado = false;
            if ($("#Nombres_Apellidos").val() == "") resultado = false;

            return resultado;
        }
        function ObtenerUbicacion() {
            navigator.permissions.query({ name: 'geolocation' }).then(function (result) {
                if (result.state == 'granted') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'prompt') {
                    ImprimirPermisos(result.state);
                    navigator.geolocation.getCurrentPosition(MostrarUbicacion);
                } else if (result.state == 'denied') {
                    MostrarModalUbicacion()
                    ImprimirPermisos(result.state);
                }
                result.onchange = function () {
                    console.log("cambio")
                    ImprimirPermisos(result.state);
                }
            });
        }
        function MostrarModalUbicacion() {
            $("#modal_ubicacion").modal('show');
        }
        function ImprimirPermisos(state) {
            console.log('Permission ' + state);
        }
    </script>
}

