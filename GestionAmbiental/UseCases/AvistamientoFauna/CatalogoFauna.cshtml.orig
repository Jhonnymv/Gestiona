@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            obtenerCatalogo();
        });
        function obtenerCatalogo() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/CargarCatalogo',
                success: function (response) {
                    $('#catalogItems').html(response.catalogo);
                    let r5 = 8;
                    let g5 = 99;
                    let b5 = 61;
                    faunaStyle(r5, g5, b5);
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
    </script>
}
