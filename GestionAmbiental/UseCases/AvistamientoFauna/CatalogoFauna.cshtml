@{
    ViewData["Title"] = "CatalogoFauna";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Registro de Avistamiento de Fauna Silvestre</h2>
    </div>
</div>
<div class="row mt-4 mb-4">
    <div class="col-12" align="center">
        <a class="btn btn-danger" asp-action="NuevoRegistro" asp-controller="AvistamientoFauna">Nuevo Registro</a>
    </div>
</div>
<div class="row mb-2" style="background-color:#2e6793">
    <div class="col-12" style="text-align:center">
        <h5 style="color:white;margin:4px;">Catálogo de Fauna Silvestre</h5>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div id="accordion">
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            obtenerCatalogo();
        });
        function obtenerCatalogo() {
            $.ajax({
                type: 'GET',
                url: '/AvistamientoFauna/CargarCatalogo',
                success: function (response) {
                    $('#accordion').html(response.catalogo)
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
        }
    </script>
}
