
@{
    ViewData["Title"] = "CatalogoFauna";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Registro de Avistamiento de Fauna Silvestre</h2>
    </div>
</div>
<div class="row mb-2">
    <div class="container-fluid d-flex align-items-center flex-column bg-danger">
        <h1 class="masthead-heading text-uppercase text-white text-center mt-5">SI EL ESPÉCIMEN ESTÁ HERIDO LLAMAR A: </h1>
        <h2 class="mb-5"><a class="text-white" href="tel:+51944617411">+51944617411</a></h2>
    </div>
</div>
<div class="row mt-4 mb-4">
    <div class="col-12" align="center">
        <a class="btn btn-primary" asp-action="NuevoRegistro" asp-controller="AvistamientoFauna">Nuevo Registro</a>
    </div>
</div>
<div class="row mb-2" style="background-color:#2e6793">
    <div class="col-12" style="text-align:center">
        <h5 style="color:white;margin:4px;">Catálogo de Fauna Silvestre</h5>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div id="accordion">
        </div>
    </div>
</div>

    @section Scripts{
        <script type="text/javascript">
            $(document).ready(function () {
                obtenerCatalogo();
            });
            function obtenerCatalogo() {
                $.ajax({
                    type: 'GET',
                    url: '/AvistamientoFauna/CargarCatalogo',
                    success: function (response) {
                        $('#accordion').html(response.catalogo)
                    },
                    error: function () {
                        console.log("No se ha podido obtener la información");
                    }
                });
            }
        </script>
    }
