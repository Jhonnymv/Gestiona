            <div class="content-header">
                <form autocomplete="off" class="custom-form w-100">
                    <div class="col-12 col-lg-9">
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_nombre">Nombre del documento:</label>
                                <select class="form-control" title="Ninguna opción seleccionada" id="filtro_nombre_doc">
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_codigo">Código</label>
                                <select class="form-control" title="Ninguna opción seleccionada" id="filtro_codigo">
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="">Tipo de documento:</label>
                                <select class="form-control" title="Ninguna opción seleccionada" id="filtro_tipo_doc">
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="">Condición:</label>
                                <select class="form-control" title="Ninguna opción seleccionada" id="filtro_condicion">
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 text-center">
                                <button type="button" class="btn btn-mc" onclick="filtrar(1)">Filtrar</button>
                                <a class="btn btn-special-action-outline fauna-color" asp-action="NuevoRegistro" asp-controller="GestionFOCAM">NUEVO REGISTRO</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="secondary-content col-12">
        <div class="table-responsive compromisos-color">
            <table class="table" id="tabla_documentos_gen">
                <thead class="">
                    <tr>
                        <th>Id</th>
                        <th>tipo de documento</th>
                        <th>Código</th>
                        <th>Título</th>
                        <th>Versión</th>
                        <th>Fecha Aprovación</th>
                        <th>Estado</th>
                        <th>Comentarios</th>
                        <th>Fecha tentativa de la nueva versión</th>
                    </tr>
                </thead>

                <tbody>
                </tbody>
            </table>

        </div>
        <div class="pagination-container compromisos-color" id="paginado" aria-label="pagination">
        </div>
    </div>
</div>
@section scripts{
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/selectpicker/js/bootstrap-select.js"></script>
<script src="~/lib/pdfobject/pdfobject.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        filtrar(1)
    });
    function filtrar(pag) {
        $.ajax({
            type: "POST",
            url: "/GestionFOCAM/ListarDocumentos",
            data: {
                "pagina": pag,
                "rpp": 10,
                //"gerencias": $('#filtro_gerencia').val(),
                //"areas": $('#filtro_area').val(),
                //"criterios": $('#filtro_criterio').val(),
                //"estados": $('#filtro_estado').val(),
                //"etapas": $("#filtro_etapa").val()
            },
            traditional: true,
            success: (response) => {
                $('#tabla_documentos_gen tbody').empty()
                $('#tabla_documentos_gen tbody').html(response.data)
                $('#paginado').html(response.paginador)
              
                //dataModulo();
            }
        });
    }
</script>
}