@using GestionAmbiental.Domain.Enum
@model GestionAmbiental.UseCases.RAC.Implementacion.ImplementarRACModel
@{
    ViewData["Title"] = "Implementar Reporte de Acto y Condición Subestándar";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="rac">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title rac-opacity-color">
                <h3>Implementar Reporte de Acto y Condición Subestándar - @ViewBag.Codigo</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <form class="form-group" id="form_implementarRAC" asp-action="ImplementarRAC" asp-controller="ImplementacionRAC" method="post" enctype="multipart/form-data" autocomplete="off">
            <div class="container pt-4 pb-4">
                <div class="custom-form details-container w-100">
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Datos del Personal que Reporta</span>
                        </div>
                        <input type="hidden" asp-for="Id_RAC" value="@Model.Id_RAC" />
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Nombres_Apellidos">Nombres y Apellidos</label>
                                <input type="text" class="form-control" asp-for="Nombres_Apellidos" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Gerencia">Área de Marcobre</label>
                                <input type="text" class="form-control" asp-for="Gerencia" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Empresa">Empresa</label>
                                <input type="text" class="form-control" asp-for="Empresa" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Otra_Empresa">Otra Empresa</label>
                                <input type="text" class="form-control" asp-for="Otra_Empresa" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Descripción de la Observación</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Empresa_Obs">Empresa observada</label>
                                <input type="text" class="form-control" asp-for="Empresa_Obs" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Gerencia_Obs">Gerencia a la que pertenece (Marcobre)</label>
                                <input type="text" class="form-control" asp-for="Gerencia_Obs" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Ubicacion">Ubicación de la observación</label>
                                <input type="text" class="form-control" asp-for="Ubicacion" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6 p-0">
                                <div class="row mt-0 mb-0">
                                    <div class="col-7 mt-0 mb-0">
                                        <label asp-for="Fecha">Fecha</label>
                                        <input type="text" class="form-control" asp-for="Fecha" disabled />
                                    </div>
                                    <div class="col-5 mt-0 mb-0">
                                        <label asp-for="Hora">Hora (24h)</label>
                                        <input type="text" class="form-control" asp-for="Hora" disabled />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="SSO_MA">Observación SSO/MA</label>
                                <input type="text" class="form-control" asp-for="SSO_MA" disabled />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="Clasificacion">Clasificación</label>
                                <input type="text" class="form-control" asp-for="Clasificacion" disabled />
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="NivelRiesgo">Nivel de Riesgo</label>
                                <input type="text" class="form-control" asp-for="NivelRiesgo" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Tipo_Condicion">Tipo</label>
                                <input type="text" class="form-control" asp-for="Tipo_Condicion" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Descripcion_Acto_Cond">Descripción del acto o condición subestándar</label>
                                <textarea class="form-control" asp-for="Descripcion_Acto_Cond" rows="3" maxlength="250" disabled></textarea>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Medida_Control">Medida(s) de control inmediata</label>
                                <textarea class="form-control" asp-for="Medida_Control" rows="3" maxlength="250" disabled></textarea>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-12">
                                <label asp-for="PAC">¿Se planteó una primera acción correctiva?</label>
                                <input type="text" class="form-control" asp-for="PAC" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Responsable_Cierre">Responsable de Marcobre del cierre de la observación</label>
                                <input type="text" class="form-control" asp-for="Responsable_Cierre" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Cierre">Fecha de cierre programada</label>
                                <input type="text" class="form-control" asp-for="Fecha_Cierre" disabled />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Supervisor">Supervisor de SSO/MA (Marcobre) a notificar</label>
                                <input type="text" class="form-control" asp-for="Supervisor" disabled />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Evidencia_Obs"></label>
                                <a asp-action="Download" asp-controller="RegistroRAC" asp-route-fileName="@Model.Evidencia_Obs" class="btn btn-mc-success form-control">Descargar Evidencia</a>
                            </div>
                        </div>
                        <div class="row input_container align-items-start">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Evidencia_Cierre"></label>
                                @if (Model.Estado == EstadosRAC.Registrado.ToString() || Model.Estado == EstadosRAC.Ampliado.ToString() || Model.Estado == EstadosRAC.Rechazado.ToString())
                                {
                                    <span class="text-danger field-validation-error" data-valmsg-for="Evidencia_Cierre" data-valmsg-replace="true">
                                        <span id="danger_evidencia" class=""></span>
                                    </span>
                                    if (ViewBag.Permiso)
                                    {
                                        <input type="file" asp-for="Evidencia_Cierre" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                    }
                                }
                                else
                                {
                                    <a asp-action="Download" asp-controller="ImplementacionRAC" asp-route-fileName="@Model.Evidencia_Cierre_Imp" class="btn btn-mc-success form-control">Descargar Evidencia</a>
                                }
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Comentario_Cierre"></label>
                                @if ((Model.Estado == EstadosRAC.Registrado.ToString() || Model.Estado == EstadosRAC.Ampliado.ToString() || Model.Estado == EstadosRAC.Rechazado.ToString()) && ViewBag.Permiso)
                                {
                                    <span id="danger_comentario" class="text-danger" asp-validation-for="Comentario_Cierre"></span>
                                    <textarea class="form-control" asp-for="Comentario_Cierre" rows="3" maxlength="250"></textarea>
                                }
                                else
                                {
                                    <textarea class="form-control" asp-for="Comentario_Cierre" rows="3" maxlength="250" disabled></textarea>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="button-container">
                            <div></div>
                            <div>
                                <a class="btn btn-mc-danger" style="color:white" asp-controller="ImplementacionRAC" asp-action="Resumen">Cancelar</a>
                                <a class="btn btn-mc-outline-success" asp-controller="DescargarRAC" asp-action="DescargaRAC" asp-route-IdRAC="@Model.IdEncriptado">Descargar Excel</a>
                                @if ((Model.Estado == EstadosRAC.Registrado.ToString() || Model.Estado == EstadosRAC.Ampliado.ToString() || Model.Estado == EstadosRAC.Rechazado.ToString()) && ViewBag.Permiso)
                                {
                                    <button type="button" class="btn btn-mc form-control" onclick="guardar()">Implementar</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
