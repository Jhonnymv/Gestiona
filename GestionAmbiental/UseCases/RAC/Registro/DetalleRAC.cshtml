<!-- Modal Ampliar Fecha-->
<div class="modal fade" id="modal_ampliacion" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_ampliacion"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_ampliacion">
                    Ampliar Fecha de Cierre Programada
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-lg-4">
                        <label>Nueva Fecha:</label>
                    </div>
                    <div class="col-8">
                        <input type="date" class="form-control" id="nuevaFecha" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <a class="btn btn-primary" style="color:white" onclick="EnviarNuevaFecha()">Guardar</a>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            switch ($("#NivelRiesgo").val()) {
                case "Tolerable": $("#NivelRiesgo").css("background-color", "green"); $("#NivelRiesgo").css("color", "white"); break;
                case "Alerta": $("#NivelRiesgo").css("background-color", "yellow"); $("#NivelRiesgo").css("color", "black"); break;
                case "No Aceptable": $("#NivelRiesgo").css("background-color", "red"); $("#NivelRiesgo").css("color", "white"); break;
                case "Bajo": $("#NivelRiesgo").css("background-color", "green"); $("#NivelRiesgo").css("color", "white"); break;
                case "Medio": $("#NivelRiesgo").css("background-color", "yellow"); $("#NivelRiesgo").css("color", "black"); break;
                case "Alto": $("#NivelRiesgo").css("background-color", "red"); $("#NivelRiesgo").css("color", "white"); break;
                default: $("#NivelRiesgo").css("background-color", "white"); $("#NivelRiesgo").css("color", "black"); break;
            }
            $("#NiveRiesgo option").css("color", "black")
        });

        function ampliarInspeccion() {
            $("#modal_ampliacion").modal("show");
        }
        function EnviarNuevaFecha() {
            var fecha = $("#nuevaFecha").val();
            if (fecha != "") {
                $.ajax({
                    async: true,
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("AmpliarFecha", "RegistroRAC"))",
                    data: {
                        "idRAC": $("#IdEncriptado").val(),
                        "fecha": fecha
                    },
                    success: function (data) {
                        console.log("Cambiado")
                        location.reload()
                    }
                });
            } else {
                alert("Debe seleccionar una fecha");
            }
        }
    </script>
}