@model GestionAmbiental.UseCases.RAC.Registro.EditarRACModel
@{
    ViewData["Title"] = "Detalle Reporte de Acto y Condición Subestándar";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="rac">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title rac-opacity-color">
                <h3>Editar de Reporte de Acto y Condición Subestándar - @ViewBag.Codigo</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_editarRAC" asp-action="EditarRAC" asp-controller="RegistroRAC" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center text-uppercase">Datos del Personal que Reporta</span>
                    </div>
                    <input type="hidden" class="form-control" asp-for="IdEncriptado" value="@Model.IdEncriptado" />
                    <input type="hidden" class="form-control" asp-for="Id_RAC" value="@Model.Id_RAC" />
                    <div class="details-content">
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Nombres_Apellidos">Nombres y Apellidos</label>
                                <span class="text-danger" asp-validation-for="Nombres_Apellidos"></span>
                                <input type="text" class="form-control" asp-for="Nombres_Apellidos" value="@ViewBag.NombreUsuario">
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Gerencia">Área de Marcobre</label>
                                <span class="text-danger" asp-validation-for="Id_Gerencia"></span>
                                <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Id_Gerencia"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Empresa">Empresa</label>
                                <span class="text-danger" asp-validation-for="Id_Empresa"></span>
                                <select class="form-control" asp-items="@ViewBag.Empresas" asp-for="Id_Empresa"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Otra_Empresa">Otra Empresa</label>
                                <span class="text-danger field-validation-error" data-valmsg-for="Otra_Empresa" data-valmsg-replace="true">
                                    <span id="danger_empresa" class=""></span>
                                </span>
                                <input type="text" class="form-control" asp-for="Otra_Empresa" disabled />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="detail-header">
                        <span class="text-white bold text-center text-uppercase">Descripción de la Observación</span>
                    </div>
                    <div class="details-content">
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Empresa_Obs">Empresa Observada</label>
                                <span class="text-danger" asp-validation-for="Id_Empresa_Obs"></span>
                                <select class="form-control" asp-items="@ViewBag.Empresas" asp-for="Id_Empresa_Obs"></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Gerencia_Obs">Gerencia a la que Pertenece</label>
                                <span class="text-danger" asp-validation-for="Id_Gerencia_Obs"></span>
                                <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Id_Gerencia_Obs"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Ubicacion">Ubicación de la Observación</label>
                                <span class="text-danger" asp-validation-for="Ubicacion"></span>
                                <input type="text" class="form-control" asp-for="Ubicacion" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6 p-0">
                                <div class="row mt-0 mb-0">
                                    <div class="col-7 mt-0 mb-0">
                                        <label asp-for="Hora">Hora (24h)</label>
                                        <span class="text-danger" asp-validation-for="Hora"></span>
                                        <input type="time" class="form-control" asp-for="Hora">
                                    </div>
                                    <div class="col-5 mt-0 mb-0">
                                        <label asp-for="Fecha">Fecha</label>
                                        <span class="text-danger" asp-validation-for="Fecha"></span>
                                        <input type="date" class="form-control" asp-for="Fecha">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="SSO_MA">Observación SSO/MA</label>
                                <span class="text-danger" asp-validation-for="SSO_MA"></span>
                                <select class="form-control" asp-for="SSO_MA">
                                    <option value="0">--SELECCIONE--</option>
                                    <option value="SSO">SSO</option>
                                    <option value="MA">MA</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="Clasificacion">Clasificación</label>
                                <span class="text-danger" asp-validation-for="Clasificacion"></span>
                                <select class="form-control" asp-for="Clasificacion">
                                    <option value="0">-- SELECCIONE --</option>
                                    <option value="Acto Subestándar">Acto Subestándar</option>
                                    <option value="Condición Subestándar">Condición Subestándar</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 col-lg-4">
                                <label asp-for="NivelRiesgo">Nivel de Riesgo</label>
                                <span class="text-danger" asp-validation-for="NivelRiesgo"></span>
                                <select class="form-control" asp-for="NivelRiesgo">
                                    <option value="0" style="background-color:white; color:black;">--SELECCIONE--</option>
                                    <!--Agregar option por js-->
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Id_Tipo_Condicion">Tipo</label>
                                <span class="text-danger" asp-validation-for="Id_Tipo_Condicion"></span>
                                <input type="hidden" asp-for="Id_Tipo_Condicion" />
                                <select class="form-control Vacio"><option class="Vacio" value="0">--SELECCIONE--</option>
                                </select>
                                <select class="form-control MA-Acto" asp-items="@ViewBag.ActoMA" style="display:none"></select>
                                <select class="form-control MA-Condicion" asp-items="@ViewBag.CondicionMA" style="display:none"></select>
                                <select class="form-control SEG-Acto" asp-items="@ViewBag.ActoSSO" style="display:none"></select>
                                <select class="form-control SEG-Condicion" asp-items="@ViewBag.CondicionSSO" style="display:none"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Descripcion_Acto_Cond">Descripción del Acto o Condición Subestándar</label>
                                <span class="text-danger" asp-validation-for="Descripcion_Acto_Cond"></span>
                                <textarea class="form-control" asp-for="Descripcion_Acto_Cond" rows="3" maxlength="250"></textarea>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <label asp-for="Medida_Control">Medidas de Control Inmediata</label>
                                <span class="text-danger" asp-validation-for="Medida_Control"></span>
                                <textarea class="form-control" asp-for="Medida_Control" rows="3" maxlength="250"></textarea>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-12">
                                <label for="">¿Se Planteó una primera acción correctiva?</label>
                                <span class="text-danger" asp-validation-for="PAC"></span>
                                <select class="form-control" asp-for="PAC">
                                    <option value="0">Seleccionar</option>
                                    <option value="No">No</option>
                                    <option value="Si">Si</option>
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Responsable_Cierre">Responsable de Marcobre del cierre de la observación</label>
                                <span class="text-danger" asp-validation-for="Id_Responsable_Cierre"></span>
                                <select class="form-control" asp-items="@ViewBag.Usuarios" asp-for="Id_Responsable_Cierre">
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Cierre">Fecha de cierre programada</label>
                                <span class="text-danger" asp-validation-for="Fecha_Cierre"></span>
                                @if (Model.Estado != "Vencido")
                                {
                                    <input type="date" class="form-control" asp-for="Fecha_Cierre">
                                }
                                else
                                {
                                    <input style="background-color:red" type="date" class="form-control" asp-for="Fecha_Cierre" />
                                }
                            </div>
                        </div>
                        <div class="row input_container align-items-start">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Supervisor">Supervisor de SSO/MA (Marcobre) a notificar</label>
                                <span class="text-danger" asp-validation-for="Id_Supervisor"></span>
                                <select class="form-control AsesorTemporal" asp-for="Id_Supervisor"><option value="0">--SELECCIONE--</option></select>
                                <select class="form-control AsesorMedioAmbiente" asp-items="@ViewBag.AsesoresMA" asp-for="Id_Supervisor" style="display:none" disabled></select>
                                <select class="form-control AsesorSeguridad" asp-items="@ViewBag.AsesoresSSO" asp-for="Id_Supervisor" style="display:none" disabled></select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Evidencia_Obs_Llena">Evidencia de la Observación</label>
                                <a asp-action="Download" asp-controller="RegistroRAC" asp-route-fileName="@Model.Evidencia_Obs_Llena" class="btn btn-mc-success form-control">

                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
