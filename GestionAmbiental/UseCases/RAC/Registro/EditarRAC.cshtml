        $("#Evidencia_Obs").change(function () {
            $("#danger_evidencia_obs").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Evidencia_Obs").data('max-size');
            if ($("#Evidencia_Obs").get(0).files.length) {
                var fileSize = $("#Evidencia_Obs").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia_obs").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
                case 'PNG':
                case 'xls':
                case 'xlsx':
                case 'doc':
                case 'docx':
                case 'pdf':
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    break;
                default:
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    $("#danger_evidencia_obs").html("No se admiten este tipo de archivos<br/>");
            }
        });
