                                    </svg>
                                    <span>Descargar Evidencia</span>
                                </a>
                            </div>
                        </div>
                        <div class="row input_container align-items-start">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Evidencia_Obs">Reemplazar Evidencia Observación</label>
                                <span class="text-danger field-validation-error" data-valmsg-for="Evidencia_Cierre" data-valmsg-replace="true">
                                    <span id="danger_evidencia_obs" class=""></span>
                                </span>
                                <input type="file" asp-for="Evidencia_Obs" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520">
                            </div>
                        </div>
                        @if (Model.Estado.Equals("Implementado") || Model.Estado.Equals("Aprobado"))
                        {
                            <div class="row input_container align-items-start">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Evidencia_Cierre_Llena"></label>
