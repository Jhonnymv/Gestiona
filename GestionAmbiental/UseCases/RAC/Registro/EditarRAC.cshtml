                $("#NivelRiesgo option[value='Alto']").css({ "background-color": "red", "color": "white" });
                var selectedOption = $("#Clasificacion option:selected").val();
                if (selectedOption == "Acto Subestándar") {
                    $(".Vacio").hide();
                    $(".Vacio").prop('disabled', true);
                    $(".MA-Acto").hide();
                    $(".MA-Acto").prop('disabled', true);
                    $(".MA-Condicion").hide();
                    $(".MA-Condicion").prop('disabled', true);
                    $(".SEG-Acto").show();
                    $(".SEG-Acto").prop('disabled', false);
                    $(".SEG-Acto").val(data.Id_Tipo_Condicion);
                    $(".SEG-Condicion").hide();
                    $(".SEG-Condicion").prop('disabled', true);
                } else if (selectedOption == "Condición Subestándar") {
                    $(".Vacio").hide();
                    $(".Vacio").prop('disabled', true);
                    $(".MA-Acto").hide();
                    $(".MA-Acto").prop('disabled', true);
                    $(".MA-Condicion").hide();
                    $(".MA-Condicion").prop('disabled', true);
                    $(".SEG-Acto").hide();
                    $(".SEG-Acto").prop('disabled', true);
                    $(".SEG-Condicion").show();
                    $(".SEG-Condicion").prop('disabled', false);
                    $(".SEG-Condicion").val(data.Id_Tipo_Condicion);
                }
            }
            $('#NivelRiesgo').val(data.NivelRiesgo);
            $('#Id_Tipo_Condicion').val(data.Id_Tipo_Condicion);
            $('#Id_Supervisor').val(data.Id_Supervisor);
            $('#Id_Responsable_Cierre').val(data.Id_Responsable_Cierre);
            switch ($("#NivelRiesgo").val()) {
                case "Tolerable": $("#NivelRiesgo").css("background-color", "green"); $("#NivelRiesgo").css("color", "white"); break;
                case "Alerta": $("#NivelRiesgo").css("background-color", "yellow"); $("#NivelRiesgo").css("color", "black"); break;
                case "No Aceptable": $("#NivelRiesgo").css("background-color", "red"); $("#NivelRiesgo").css("color", "white"); break;
                case "Bajo": $("#NivelRiesgo").css("background-color", "green"); $("#NivelRiesgo").css("color", "white"); break;
                case "Medio": $("#NivelRiesgo").css("background-color", "yellow"); $("#NivelRiesgo").css("color", "black"); break;
                case "Alto": $("#NivelRiesgo").css("background-color", "red"); $("#NivelRiesgo").css("color", "white"); break;
                default: $("#NivelRiesgo").css("background-color", "white"); $("#NivelRiesgo").css("color", "black"); break;
            }
        }
        $(".MA-Acto").on('change', function () {
            $("#Id_Tipo_Condicion").val($(".MA-Acto").val())
        });
        $(".MA-Condicion").on('change', function () {
            $("#Id_Tipo_Condicion").val($(".MA-Condicion").val())
        });
        $(".SEG-Acto").on('change', function () {
            $("#Id_Tipo_Condicion").val($(".SEG-Acto").val())
        });
        $(".SEG-Condicion").on('change', function () {
            $("#Id_Tipo_Condicion").val($(".SEG-Condicion").val())
        });
    </script>
}