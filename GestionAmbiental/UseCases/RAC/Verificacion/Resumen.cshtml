@section scripts{
    <script type="text/javascript">
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/RegistroRAC/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/VerificacionRAC/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtroFecha": $('#fecha_filtro').val(),
                    "filtroUsuario": $('#usuario_filtro').val(),
                    "filtroCodigo": $('#codigo_filtro').val(),
                    "filtroGerenciaObs": $("#filtro_gerencias_obs").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_rac tbody').empty()
                    $('#tabla_resumen_rac tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    racStyle(r, g, b);
                }
            });
        }
    </script>
}

