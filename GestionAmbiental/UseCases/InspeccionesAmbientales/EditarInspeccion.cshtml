@model GestionAmbiental.UseCases.InspeccionesAmbientales.NuevaInspeccionModel

@{
    ViewData["Title"] = "Editar Inspeccion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Editar Inspección</h2>
        </div>
    </div>
    <form class="form-group" id="form_nuevaInspeccion" asp-action="EditarInspeccion" asp-controller="Inspecciones" method="post" enctype="multipart/form-data" autocomplete="off">

        <input type="hidden" asp-for="Id_Inspeccion_Cabecera" />
        <div class="row mb-2">
            <div class="col-lg-2">
                <label asp-for="Id_Gerencia_Ejecutora"></label>
            </div>

            <div class="col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Gerencia_Ejecutora"></span>
                <select class="form-control" asp-items="@ViewBag.GerenciaMC" asp-for="Id_Gerencia_Ejecutora"></select>
            </div>
            <div class="col-lg-2">
                <label asp-for="Id_Empresa_Contratista"></label>
            </div>
            <div class="col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Empresa_Contratista"></span>
                <select class="form-control" asp-items="@ViewBag.EmpresasMC" asp-for="Id_Empresa_Contratista">
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-lg-2">
                <label asp-for="Lugar_Inspeccionado"></label>
            </div>
            <div class="col-lg-4">
                <input type="text" class="form-control" asp-for="Lugar_Inspeccionado">
            </div>

            <div class="col-lg-2">
                <label asp-for="Tipo_Inspeccion"></label>
            </div>
            <div class="col-lg-4">
                <span class="text-danger" asp-validation-for="Tipo_Inspeccion"></span>
                <select class="form-control" asp-items="@ViewBag.Tipo_Inspeccion" asp-for="Tipo_Inspeccion"></select>
            </div>

        </div>
        <div class="row mb-2">
            <div class="col-lg-2">
                <label asp-for="Id_Responsable_Lugar"></label>
            </div>
            <div class="col-lg-4">
                <span class="text-danger" asp-validation-for="Id_Responsable_Lugar"></span>
                <select class="form-control" asp-items="@ViewBag.Responsables" asp-for="Id_Responsable_Lugar"></select>
            </div>
            <div class="col-lg-1">
                <label asp-for="Hora_Inspeccion"></label>
            </div>
            <div class="col-lg-2">
                <span class="text-danger" asp-validation-for="Hora_Inspeccion"></span>
                <input type="time" class="form-control" asp-for="Hora_Inspeccion">
            </div>
            <div class="col-lg-1">
                <label asp-for="Fecha_Inspeccion"></label>
            </div>
            <div class="col-lg-2">
                <span class="text-danger" asp-validation-for="Fecha_Inspeccion"></span>
                <input type="date" class="form-control" asp-for="Fecha_Inspeccion">
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-lg-2">
                <label asp-for="Responsable_Inspeccion"></label>
            </div>
            <div class="col-lg-4">
                <span class="text-danger" asp-validation-for="Responsable_Inspeccion"></span>
                <input type="text" class="form-control" asp-for="Responsable_Inspeccion">
            </div>
            <div class="col-lg-2">
                <label asp-for="Inspectores"></label>
            </div>
            <div class="col-lg-4">
                <input type="text" class="form-control" asp-for="Inspectores">
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-lg-2">
                <label asp-for="Objetivo"></label>
            </div>
            <div class="col-lg-10">
                <input type="text" class="form-control" asp-for="Objetivo">
            </div>
        </div>
        @if (Model.Estado.Equals("Pendiente"))
        {
            <div class="row mb-2">
                <div class="col-lg-12">
                    <button id="nueva_obs" type="submit" class="btn btn-primary float-right">Agregar Observación</button>
                </div>
            </div>
        }

        @if (ViewBag.nObservacioness > 0)
        {
            @*style="visibility:hidden;display:none"*@
            <div class="row mb-2" id="div_tabla_observaciones">
                <div class="col-lg-12">
                    <table class="table table-modal" id="tabla_observaciones">
                        <thead class="thead-mcolor">
                            <tr>
                                <th>Tipo de Observación</th>
                                <th>Asesor de MAP/SSO</th>
                                <th>Acto/Condición Subestándar Identificada</th>
                                <th>Tipo de Condición/Acto Subestándar</th>
                                <th>Evidencia</th>
                                <th>Nivel de Riesgo del Aspecto Ambiental</th>
                                <th>Acción Preventiva / Correctiva Tomada</th>
                                <th>Responsable Marcobre</th>
                                <th>Responsable Contratista</th>
                                <th>Fecha Programada</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @Html.Raw(ViewBag.ContenidoTabla)
                        </tbody>
                    </table>
                </div>
            </div>
        }

    <div class="buttons d-flex justify-content-end">
        @if (Model.Estado.Equals("Registrado"))
        {
            <a id="volver" type="button" class="btn btn-secondary mr-2" style="color:white;" asp-action="Resumen">Volver</a>
            <a id="descargar" type="button" class="btn btn-danger" style="color:white;" asp-controller="DescargaInspeccion" asp-action="DescargaInspeccion" asp-route-IdCabecera="@Model.Id_Inspeccion_Cabecera">Descargar en Excel</a>
        }
        @if (Model.Estado.Equals("Pendiente"))
        {
            <a id="cancelar" type="button" class="btn btn-secondary mr-2" style="color:white;" asp-action="Resumen">Cancelar</a>
            <button id="guardar_estado" type="submit" class="btn btn-primary">Guardar Estado</button>
            @if (ViewBag.nObservacioness > 0)
            {
                <button id="guardar" onclick="FinalizarRegistro()" class="btn btn-primary ml-2">Finalizar Registro</button>
            }
        }
    </div>
        <input type="hidden" asp-for="opcion" />
        <input type="hidden" asp-for="Estado" />
    </form>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Enviando_Correo" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">            
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Notificando a Responsables</label>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Ampliar Fecha-->
<div class="modal fade" id="modal_ampliacion" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_ampliacion"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_ampliacion">
                    Ampliar Fecha de Observación
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-lg-4">
                        <label>Nueva Fecha:</label>
                    </div>
                    <div class="col-8">
                        <input type="hidden" class="form-control" id="idObserv" />
                        <input type="date" class="form-control" id="nuevaFecha" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <a class="btn btn-primary" style="color:white" onclick="EnviarNuevaFecha()">Guardar</a>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            console.log('@Model.Estado');
           if ('@Model.Estado' != "Pendiente") {                
                //disable inputs
                $('#Id_Gerencia_Ejecutora').prop('disabled', 'disabled');
                $('#Id_Empresa_Contratista').prop('disabled', 'disabled');
                $('#Id_Responsable_Lugar').prop('disabled', 'disabled');
                $('#Id_Responsable_MA').prop('disabled', 'disabled');
                $('#Lugar_Inspeccionado').prop('readonly', 'readonly');
                $('#Inspectores').prop('readonly', 'readonly');
                $('#Hora_Inspeccion').prop('readonly', 'readonly');
                $('#Fecha_Inspeccion').prop('readonly', 'readonly');
                $('#Responsable_Inspeccion').prop('readonly', 'readonly');
                $('#Objetivo').prop('readonly', 'readonly');
                $('#Tipo_Inspeccion').prop('disabled', 'disabled');

            } 

    });        
        $("#guardar").click(function () {
            $("#opcion").val("Guardar");
        });
        $("#guardar_estado").click(function () {
            $("#opcion").val("GuardarEstado");
        });
        $("#nueva_obs").click(function () {
            $("#opcion").val("Observacion");
        });
        function EnviarNuevaFecha() {
            var fecha = $("#nuevaFecha").val();
            var idObservacion = $("#idObserv").val();
            if (fecha != "") {
                $.ajax({
                    async: true,
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("AmpliarFechaObservacion", "Inspecciones"))",
                    data: {
                        "idCabecera": $("#Id_Inspeccion_Cabecera").val(),
                        "idObservacion": idObservacion,
                        "fecha": fecha
                    },
                    success: function (data) {
                        location.reload()
                    }
                });
            } else {
                alert("Debe seleccionar una fecha");
            }
        }
        function ampliarInspeccion(idObservacion) {
            $("#modal_ampliacion").modal("show");
            $("#idObserv").val(idObservacion);
        }
        function FinalizarRegistro() {
            $("#Modal_Enviando_Correo").modal('show')
            $.ajax({
                type: "POST",
                data: $('#form_nuevaInspeccion').serialize(),
                url: "/Inspecciones/EditarInspeccion",
                contentType: "application/json"
            }).success(function () {
                
            });
        }
    </script>
}
