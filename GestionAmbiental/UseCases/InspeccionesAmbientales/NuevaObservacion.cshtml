@model  GestionAmbiental.UseCases.InspeccionesAmbientales.NuevaObservacionModel

@{
    ViewData["Title"] = "NuevaObservacion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-12 titulo-pagina">
                <h2>Nueva Observacion</h2>
            </div>
        </div>
        <form class="form-group" id="form_nuevaInspeccion" asp-action="NuevaObservacion" asp-controller="Inspecciones" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="idCabecera" value="@ViewBag.idCabecera" />
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="CondicionIdentificada"></label>
                    </div>
                    <div class="col-md-8">
                        <input type="text" class="form-control" asp-for="CondicionIdentificada" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="TipoCondicion"></label>
                    </div>
                    <div class="col-md-8">
                        <select class="form-control" asp-for="TipoCondicion" asp-items="@ViewBag.TiposCondicion"></select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="Evidencias"></label>
                    </div>
                    <div class="col-md-8">
                        <label class="btn btn-primary" for="Evidencias">Seleccione</label>
                        <input type="file" style="visibility:hidden; display:none" asp-for="Evidencias" multiple>
                        <label id="files_name">0 Archivos</label>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="NiveRiesgo"></label>
                    </div>
                    <div class="col-md-8">
                        <span class="text-danger" asp-validation-for="NiveRiesgo"></span>
                        <select class="form-control" asp-for="NiveRiesgo">
                            <option value="" style="background-color:white">-- SELECCIONE --</option>
                            <option value="No Aplica" style="background-color:white">No Aplica</option>
                            <option value="Tolerable" style="background-color:green; color:white">Tolerable</option>
                            <option value="Alerta" style="background-color:yellow">Alerta</option>
                            <option value="No Aceptable" style="background-color:red; color:white">No Aceptable</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="AccionTomada"></label>
                    </div>
                    <div class="col-md-8">
                        <input type="text" class="form-control" asp-for="AccionTomada" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="ResponsableMarc"></label>
                    </div>
                    <div class="col-md-8">
                        <span class="text-danger" asp-validation-for="ResponsableMarc"></span>
                        <select class="form-control" asp-items="@ViewBag.Responsables" asp-for="ResponsableMarc"></select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="ResponsableCont"></label>
                    </div>
                    <div class="col-md-8">
                        <input type="text" class="form-control" asp-for="ResponsableCont" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="FechaProgramada"></label>
                    </div>
                    <div class="col-md-8">
                        <input type="date" class="form-control" asp-for="FechaProgramada" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" onclick="guardar()">Agregar</button>
            </div>
        </form>
    </div>
@section scripts{
<script>
    $("#Evidencias").change(function () {
        var filesname = this.files.length + " Archivos";
        $("#files_name").text(filesname);
    });
    $("#NiveRiesgo").change(function () {
        switch ($("#NiveRiesgo").val()) {
            case "Tolerable": $("#NiveRiesgo").css("background-color", "green");$("#NiveRiesgo").css("color", "white"); break;
            case "Alerta":  $("#NiveRiesgo").css("background-color", "yellow");$("#NiveRiesgo").css("color", "black"); break;
            case "No Aceptable":  $("#NiveRiesgo").css("background-color", "red");$("#NiveRiesgo").css("color", "white"); break;
            default:  $("#NiveRiesgo").css("background-color", "white");$("#NiveRiesgo").css("color", "black"); break;
        }
    });
</script>
}