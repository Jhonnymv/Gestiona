</div>
<!-- Modal Enviando Correo-->
<div class="modal fade mc-modal" id="Modal_Enviando_Correo" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white">Notificando a Responsables</label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script src="~/js/stepper.js"></script>
    <script type="text/javascript">

        var listObservaciones = [];
        var img_url = "";
        $(document).ready(function () {
            if ('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) {
                //disable inputs
                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('readonly', false);
                $('#Inspectores').prop('readonly', false);
                $('#Hora_Inspeccion').prop('readonly', false);
                $('#Fecha_Inspeccion').prop('readonly', false);
                $('#Responsable_Inspeccion').prop('readonly', false);
                $('#Objetivo').prop('readonly', false);
                $('#Tipo_Inspeccion').prop('disabled', false);
            }
            dataModulo();
            ConsultarObservaciones();
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        img_url = data.img_url;
                        inspectionStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        $("#guardar").click(function () {
            $("#opcion").val("Guardar");
        });
        $("#guardar_estado").click(function () {
            $("#opcion").val("GuardarEstado");
        });
        $("#nueva_obs").click(function () {
            $("#opcion").val("Observacion");
        });
        $("#eliminar").click(function () {
            if (window.confirm("¿Seguro que desea eliminar esta inspección?")) {
                //disable inputs
                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('disabled', false);
                $('#Inspectores').prop('disabled', false);
                $('#Hora_Inspeccion').prop('disabled', false);
                $('#Fecha_Inspeccion').prop('disabled', false);
                $('#Responsable_Inspeccion').prop('disabled', false);
                $('#Objetivo').prop('disabled', false);
               $('#Tipo_Inspeccion').prop('disabled', false);
                $("#opcion").val("Eliminar");
                $("#form_nuevaInspeccion").submit();
            }
        });
        function EnviarNuevaFecha() {
            var fecha = $("#nuevaFecha").val();
            var idObservacion = $("#idObserv").val();
            if (fecha != "") {
                $.ajax({
                    async: true,
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("AmpliarFechaObservacion", "Inspecciones"))",
                    data: {
                        "idCabecera": $("#EncryptedId").val(),
                        "idObservacion": idObservacion,
                        "fecha": fecha
                    },
                    success: function (data) {
                        location.reload()
                    }
                });
            } else {
                alert("Debe seleccionar una fecha");
