                                            </svg>
                                            <span>Descargar Evidencia</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="row input_container w-100">
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_Nueva_Evidencia"></label>
                                        <span class="text-danger field-validation-error" data-valmsg-for="E_Nueva_Evidencia" data-valmsg-replace="true">
                                            <span id="E_danger_evidencia" class=""></span>
                                        </span>
                                        <input type="file" asp-for="E_Nueva_Evidencia" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                    </div>
                                </div>
                                <div class="row input_container w-100">
                                    <div class="button-container">
                                        <div></div>
                                        <div>
                                            <button class="btn btn-mc-outline-danger m-2" data-bs-dismiss="modal" aria-label="Close">Cerrar</button>
