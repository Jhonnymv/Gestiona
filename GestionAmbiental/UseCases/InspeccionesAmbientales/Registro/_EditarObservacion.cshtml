@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Asesor MAP/SSO
            $('.E_AsesorMedioAmbiente option').each(function () {
                if (this.value == "@Model.E_NivelRiesgo;") {
                    $('.E_AsesorMedioAmbiente').show();
                    $(".E_AsesorMedioAmbiente").val(this.value);
                    $("#E_AsesorSeguridad").val(this.value);
                }
            });
            $('.E_AsesorSeguridad option').each(function () {
                if (this.value == "@Model.E_AsesorSeguridad") {
                    $('.E_AsesorSeguridad').show();
                    $(".E_AsesorSeguridad").val(this.value);
                    $("#E_AsesorSeguridad").val(this.value);
                }
            });
            //Tipos de condición
            $('.E_SEG-Acto option').each(function () {
                if (this.value == "@Model.E_TipoCondicion") {
                    $('.E_SEG-Acto').show();
                    $('.E_SEG-Acto').val("@Model.E_TipoCondicion");
                    $('.E_Vacio').hide();
                    $("#E_TipoCondicion").val('@Model.E_TipoCondicion');
                }
            });
            $('.E_SEG-Condicion option').each(function () {
                if (this.value == "@Model.E_TipoCondicion") {
                    $('.E_SEG-Condicion').show();
                    $('.E_SEG-Condicion').val("@Model.E_TipoCondicion");
                    $('.E_Vacio').hide();
                    $("#E_TipoCondicion").val('@Model.E_TipoCondicion');
                }
            });
            $('.E_MA-Acto option').each(function () {
                if (this.value == "@Model.E_TipoCondicion") {
                    $('.E_MA-Acto').show();
                    $('.E_MA-Acto').val("@Model.E_TipoCondicion");
                    $('.E_Vacio').hide();
                    $("#E_TipoCondicion").val('@Model.E_TipoCondicion');
                }
            });
            $('.E_MA-Condicion option').each(function () {
                if (this.value == "@Model.E_TipoCondicion") {
                    $('.E_MA-Condicion').show();
                    $('.E_MA-Condicion').val("@Model.E_TipoCondicion");
                    $('.E_Vacio').hide();
                    $("#E_TipoCondicion").val('@Model.E_TipoCondicion');
                }
            });
            //Niveles de riesgo
            //Validación de tipo de inspeccion y nivel de riesgo seleccionado
            if (("@Model.E_NivelRiesgo" == "Alto" ||
                "@Model.E_NivelRiesgo" == "Medio" ||
                "@Model.E_NivelRiesgo" == "Bajo" ||
                "@Model.E_NivelRiesgo" == "No Aplica") &&
                "@Model.E_TipoInspeccion" == "SSO")
            {
                $('#E_NivelRiesgo').append(new Option("No Aplica", "No Aplica",false,"@Model.E_NivelRiesgo"=="No Aplica"?true:false));
                $("#E_NivelRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#E_NivelRiesgo').append(new Option("Bajo", "Bajo",false,"@Model.E_NivelRiesgo"=="Bajo"?true:false));
                $("#E_NivelRiesgo option[value='Bajo']").css({"background-color": "green", "color": "white"});
                $('#E_NivelRiesgo').append(new Option("Medio", "Medio",false,"@Model.E_NivelRiesgo"=="Medio"?true:false));
                $("#E_NivelRiesgo option[value='Medio']").css({"background-color": "yellow", "color": "black"});
                $('#E_NivelRiesgo').append(new Option("Alto", "Alto",false,"@Model.E_NivelRiesgo"=="Alto"?true:false));
                $("#E_NivelRiesgo option[value='Alto']").css({"background-color": "red", "color": "white"});
            }

            if (("@Model.E_NivelRiesgo" == "No Aceptable" ||
                "@Model.E_NivelRiesgo" == "Alerta" ||
                "@Model.E_NivelRiesgo" == "Tolerable" ||
                "@Model.E_NivelRiesgo" == "No Aplica") &&
                "@Model.E_TipoInspeccion" == "MAP")
            {
                $('#E_NivelRiesgo').append(new Option("No Aplica", "No Aplica",false,"@Model.E_NivelRiesgo"=="No Aplica"?true:false));
                $("#E_NivelRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#E_NivelRiesgo').append(new Option("Tolerable", "Tolerable",false,"@Model.E_NivelRiesgo"=="Tolerable"?true:false));
                $("#E_NivelRiesgo option[value='Tolerable']").css({"background-color": "green", "color": "white"});
                $('#E_NivelRiesgo').append(new Option("Alerta", "Alerta",false,"@Model.E_NivelRiesgo"=="Alerta"?true:false));
                $("#E_NivelRiesgo option[value='Alerta']").css({"background-color": "yellow", "color": "black"});
                $('#E_NivelRiesgo').append(new Option("No Aceptable", "No Aceptable",false,"@Model.E_NivelRiesgo"=="No Aceptable"?true:false));
                $("#E_NivelRiesgo option[value='No Aceptable']").css({"background-color": "red", "color": "white"});
            }

            ActualizarColorNivelRiesgo();
        });
        $("#E_NivelRiesgo").on('change', function () {
            ActualizarColorNivelRiesgo();
        });
