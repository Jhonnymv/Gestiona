                    break;
                case "No Aceptable": $("#E_NivelRiesgo").css("background-color", "red"); $("#E_NivelRiesgo").css("color", "white"); break;
                case "Bajo": $("#E_NivelRiesgo").css("background-color", "green"); $("#E_NivelRiesgo").css("color", "white"); break;
