@model GestionAmbiental.UseCases.InspeccionesAmbientales.Registro.EditarObservacionModel
<div class="modal fade" tabindex="-1" id="modalEditarObservacion" aria-labelledby="modalEditarObservacion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-inspecciones">
            <div class="modal-content">
                <div class="inspection">
                    <div class="image-header-container"
                         style="background-image: url(&quot;/img/back-inspection.png&quot;);">
                        <div class="header-title inspection-opacity-color">
                            <h3>Editar Observacion</h3><img src="/img/logo-white.png" alt="Logo Marcobre">
                        </div><button type="button" class="btn-close" data-bs-dismiss="modal"
                                      aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <form id="form_editarObservacion" method="post" enctype="multipart/form-data" autocomplete="off">
                        <div class="container pt-4 pb-4">
                            <div class="custom-form details-container w-100">
                                <input type="hidden" asp-for="E_IdCabecera" value="@ViewBag.idCabecera" />
                                <input type="hidden" asp-for="E_IdObservacion" />
                                <div class="message"></div>
                                <div class="row input_container w-100">
                                    <div class="col-12 col-sm-6 col-lg-6">
                                        <label asp-for="E_TipoInspeccion"></label>
                                        <span class="text-danger" asp-validation-for="E_TipoInspeccion"></span>
                                        <select class="form-control" asp-for="E_TipoInspeccion">
                                            <option value="">-- SELECCIONE --</option>
                                            <option value="MAP">MAP</option>
                                            <option value="SSO">SSO</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-6">
                                        <label class="E_AsesorMedioAmbiente" style="display:none">Asesor MAP:</label>
                                        <label class="E_AsesorSeguridad" style="display:none">Asesor SSO:</label>
                                        <span class="text-danger" asp-validation-for="E_AsesorSeguridad"></span>
                                        <input type="hidden" asp-for="E_AsesorSeguridad" style="display:none"/>
                                        <select class="form-control E_AsesorMedioAmbiente" asp-items="@ViewBag.AsesoresMA" style="display:none"></select>
                                        <select class="form-control E_AsesorSeguridad" asp-items="@ViewBag.AsesoresSeguridad" style="display:none"></select>
                                    </div>
                                </div>
                                <div class="row input_container w-100">
                                    <div class="col-12 col-sm-6 col-lg-6">
                                        <label asp-for="E_CondicionIdentificada"></label>
                                        <span class="text-danger" asp-validation-for="E_CondicionIdentificada"></span>
                                        <select class="form-control" asp-for="E_CondicionIdentificada">
                                            <option value="">-- SELECCIONE --</option>
                                            <option value="Acto Subestándar">Acto Subestándar</option>
                                            <option value="Condición Subestándar">Condición Subestándar</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-6">
                                        <label asp-for="E_TipoCondicion"></label>
                                        <span class="text-danger" asp-validation-for="E_TipoCondicion"></span>
                                        <select class="form-control E_Vacio" asp-for="E_TipoCondicion">
                                            <option value="">-- SELECCIONE --</option>
                                        </select>
                                        <select class="form-control E_MA-Acto" asp-for="E_TipoCondicion" asp-items="@ViewBag.TiposActoMA" style="display:none"></select>
                                        <select class="form-control E_MA-Condicion" asp-for="E_TipoCondicion" asp-items="@ViewBag.TiposCondicionMA" style="display:none"></select>
                                        <select class="form-control E_SEG-Acto" asp-for="E_TipoCondicion" asp-items="@ViewBag.TiposActoSEG" style="display:none"></select>
                                        <select class="form-control E_SEG-Condicion" asp-for="E_TipoCondicion" asp-items="@ViewBag.TiposCondicionSEG" style="display:none"></select>
                                    </div>
                                </div>
                                <div class="row input_container w-100">
                                    <div class="col-12 col-sm-6 col-lg-6">
                                        <label asp-for="E_FechaProgramada"></label>
                                        <span class="text-danger" asp-validation-for="E_FechaProgramada"></span>
                                        <input type="date" class="form-control" asp-for="E_FechaProgramada" />
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_NivelRiesgo"></label>
                                        <span class="text-danger" asp-validation-for="E_NivelRiesgo"></span>
                                        <select class="form-control E_Vacio_NR" asp-for="E_NivelRiesgo">
                                            <option value="" style="background-color:white;color:black;">-- SELECCIONE --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container w-100">
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_AccionTomada"></label>
                                        <span class="text-danger" asp-validation-for="E_AccionTomada"></span>
                                        <input type="text" class="form-control" asp-for="E_AccionTomada" maxlength="250" />
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_ResponsableMarc"></label>
                                        <span class="text-danger" asp-validation-for="E_ResponsableMarc"></span>
                                        <select class="form-control" asp-items="@ViewBag.Responsables" asp-for="E_ResponsableMarc"></select>
                                    </div>
                                </div>
                                <div class="row input_container w-100 align-items-start">
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_ResponsableCont"></label>
                                        <span class="text-danger" asp-validation-for="E_ResponsableCont"></span>
                                        <input type="text" class="form-control" asp-for="E_ResponsableCont" />
                                        <small class="form-text text-muted">En caso que la empresa observada sea Marcobre, ingresar "No Aplica".</small>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-6 ">
                                        <label asp-for="E_Evidencia"></label>
                                        @*<input type="hidden" asp-for="E_Evidencia" value="@Model.E_Evidencia[0]" />*@
                                        @*<a asp-action="Download" asp-controller="Inspecciones" asp-route-fileName="@Model.E_Evidencia[0]">Evidencia</a>*@
                                        <input type="hidden" asp-for="E_Evidencia" />
                                        <button type="button" class="btn btn-mc-success form-control" id="E_EvidenciaDescarga" onclick="DescargarEvidenciaObservacion()">
