@model GestionAmbiental.UseCases.InspeccionesAmbientales.Registro.EditarObservacionModel
@{
    ViewData["Title"] = "EditarObservacion";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Editar Observación</h2>
        </div>
    </div>
    <form class="form-group" id="form_nuevaObservacion" asp-action="EditarObservacion" asp-controller="Inspecciones" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="idCabecera" value="@ViewBag.idCabecera" />
        <input type="hidden" asp-for="IdObservacion" value="@Model.IdObservacion"/>
        <div class="modal-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="TipoInspeccion"></span>
                    <select class="form-control" asp-for="TipoInspeccion">
                        <option value="">-- SELECCIONE --</option>
                        <option value="MAP">MAP</option>
                        <option value="SSO">SSO</option>
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="AsesorMedioAmbiente" style="display:none">Asesor MAP:</label>
                    <label class="AsesorSeguridad" style="display:none">Asesor SSO:</label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="Asesor_MA_Seguridad"></span>
                    <input type="hidden" asp-for="Asesor_MA_Seguridad"/>
                    <select class="form-control AsesorMedioAmbiente" asp-items="@ViewBag.AsesoresMA" style="display:none"></select>
                    <select class="form-control AsesorSeguridad" asp-items="@ViewBag.AsesoresSeguridad" style="display:none"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="CondicionIdentificada"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="CondicionIdentificada"></span>
                    <select class="form-control" asp-for="CondicionIdentificada">
                        <option value="">-- SELECCIONE --</option>
                        <option value="Acto Subestándar">Acto Subestándar</option>
                        <option value="Condición Subestándar">Condición Subestándar</option>
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoCondicion"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="TipoCondicion"></span>
                    <input type="hidden" asp-for="TipoCondicion" />
                    <select class="form-control Vacio">
                        <option value="">-- SELECCIONE --</option>
                    </select>
                    <select class="form-control MA-Acto" asp-items="@ViewBag.TiposActoMA" style="display:none"></select>
                    <select class="form-control MA-Condicion" asp-items="@ViewBag.TiposCondicionMA" style="display:none"></select>
                    <select class="form-control SEG-Acto" asp-items="@ViewBag.TiposActoSEG" style="display:none"></select>
                    <select class="form-control SEG-Condicion" asp-items="@ViewBag.TiposCondicionSEG" style="display:none"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Evidencia"></label>
                </div>
                <div class="col-md-8">
                    <input type="hidden" asp-for="Evidencia" value="@Model.Evidencia[0]" />
                    <a asp-action="Download" asp-controller="Inspecciones" asp-route-fileName="@Model.Evidencia[0]">Evidencia</a>                    
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Nueva_Evidencia"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger field-validation-error" data-valmsg-for="Nueva_Evidencia" data-valmsg-replace="true">
                        <span id="danger_evidencia" class=""></span>
                    </span>
                    <label class="btn btn-primary" for="Nueva_Evidencia">Seleccione</label>
                    <input type="file" style="visibility:hidden; display:none" asp-for="Nueva_Evidencia" accept=".jpg,.jpge,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520">
                    <label id="files_name">0 Archivos</label>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="NiveRiesgo"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="NiveRiesgo"></span>
                    <select class="form-control Vacio_NR" asp-for="NiveRiesgo">
                        <option value="" style="background-color:white;color:black;">-- SELECCIONE --</option>
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="AccionTomada"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="AccionTomada"></span>
                    <input type="text" class="form-control" asp-for="AccionTomada" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableMarc"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="ResponsableMarc"></span>
                    <select class="form-control" asp-items="@ViewBag.Responsables" asp-for="ResponsableMarc"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableCont"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="ResponsableCont"></span>
                    <input type="text" class="form-control" asp-for="ResponsableCont" value="@Model.ResponsableCont" />
                    <small class="form-text text-muted">En caso que la empresa observada sea Marcobre, ingresar "No Aplica".</small>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="FechaProgramada"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="FechaProgramada"></span>
                    <input type="date" class="form-control" asp-for="FechaProgramada" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <a type="button" class="btn btn-secondary mr-2" style="color:white;" asp-action="EditarInspeccion" asp-route-IdCabecera="@ViewBag.CabeceraEncriptada">Cancelar</a>
            <button type="submit" class="btn btn-primary">Editar</button>
        </div>
    </form>
</div>
@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Asesor MAP/SSO
            $('.AsesorMedioAmbiente option').each(function () {
                if (this.value == "@Model.Asesor_MA_Seguridad") {
                    $('.AsesorMedioAmbiente').show();                    
                    $(".AsesorMedioAmbiente").val(this.value);
                    $("#Asesor_MA_Seguridad").val(this.value);
                }
            });
            $('.AsesorSeguridad option').each(function () {
                if (this.value == "@Model.Asesor_MA_Seguridad") {
                    $('.AsesorSeguridad').show();       
                    $(".AsesorSeguridad").val(this.value);
                    $("#Asesor_MA_Seguridad").val(this.value);
                }
            });
            //Tipos de condición
            $('.SEG-Acto option').each(function () {
                if (this.value == "@Model.TipoCondicion") {
                    $('.SEG-Acto').show();
                    $('.SEG-Acto').val("@Model.TipoCondicion");
                    $('.Vacio').hide();
                    $("#TipoCondicion").val('@Model.TipoCondicion');
                }
            });
            $('.SEG-Condicion option').each(function () {
                if (this.value == "@Model.TipoCondicion") {
                    $('.SEG-Condicion').show();
                    $('.SEG-Condicion').val("@Model.TipoCondicion");
                    $('.Vacio').hide();
                    $("#TipoCondicion").val('@Model.TipoCondicion');
                }
            });
            $('.MA-Acto option').each(function () {
                if (this.value == "@Model.TipoCondicion") {
                    $('.MA-Acto').show();
                    $('.MA-Acto').val("@Model.TipoCondicion");
                    $('.Vacio').hide();
                    $("#TipoCondicion").val('@Model.TipoCondicion');
                }
            });
            $('.MA-Condicion option').each(function () {
                if (this.value == "@Model.TipoCondicion") {
                    $('.MA-Condicion').show();
                    $('.MA-Condicion').val("@Model.TipoCondicion");
                    $('.Vacio').hide();
                    $("#TipoCondicion").val('@Model.TipoCondicion');
                }
            });
            //Niveles de riesgo
            //Validación de tipo de inspeccion y nivel de riesgo seleccionado
            if (("@Model.NiveRiesgo" == "Alto" ||
                "@Model.NiveRiesgo" == "Medio" ||
                "@Model.NiveRiesgo" == "Bajo" ||
                "@Model.NiveRiesgo" == "No Aplica") &&
                "@Model.TipoInspeccion" == "SSO")
            {
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica",false,"@Model.NiveRiesgo"=="No Aplica"?true:false));
                $("#NiveRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#NiveRiesgo').append(new Option("Bajo", "Bajo",false,"@Model.NiveRiesgo"=="Bajo"?true:false));
                $("#NiveRiesgo option[value='Bajo']").css({"background-color": "green", "color": "white"});
                $('#NiveRiesgo').append(new Option("Medio", "Medio",false,"@Model.NiveRiesgo"=="Medio"?true:false));
                $("#NiveRiesgo option[value='Medio']").css({"background-color": "yellow", "color": "black"});
                $('#NiveRiesgo').append(new Option("Alto", "Alto",false,"@Model.NiveRiesgo"=="Alto"?true:false));
                $("#NiveRiesgo option[value='Alto']").css({"background-color": "red", "color": "white"});
            }

            if (("@Model.NiveRiesgo" == "No Aceptable" ||
                "@Model.NiveRiesgo" == "Alerta" ||
                "@Model.NiveRiesgo" == "Tolerable" ||
                "@Model.NiveRiesgo" == "No Aplica") &&
                "@Model.TipoInspeccion" == "MAP")
            {
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica",false,"@Model.NiveRiesgo"=="No Aplica"?true:false));
                $("#NiveRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#NiveRiesgo').append(new Option("Tolerable", "Tolerable",false,"@Model.NiveRiesgo"=="Tolerable"?true:false));
                $("#NiveRiesgo option[value='Tolerable']").css({"background-color": "green", "color": "white"});
                $('#NiveRiesgo').append(new Option("Alerta", "Alerta",false,"@Model.NiveRiesgo"=="Alerta"?true:false));
                $("#NiveRiesgo option[value='Alerta']").css({"background-color": "yellow", "color": "black"});
                $('#NiveRiesgo').append(new Option("No Aceptable", "No Aceptable",false,"@Model.NiveRiesgo"=="No Aceptable"?true:false));
                $("#NiveRiesgo option[value='No Aceptable']").css({"background-color": "red", "color": "white"});
            }

            ActualizarColorNivelRiesgo();

            console.log('@Model.ResponsableMarc');
        });

        $("#NiveRiesgo").on('change', function () {
            ActualizarColorNivelRiesgo();
        });

        function ActualizarColorNivelRiesgo() {
            switch ($("#NiveRiesgo").val()) {
                case "Tolerable":
                    $("#NiveRiesgo").css("background-color", "green");
                    $("#NiveRiesgo").css("color", "white");
                    break;
                case "Alerta":
                    $("#NiveRiesgo").css("background-color", "yellow"); $("#NiveRiesgo").css("color", "black");
                    break;
                case "No Aceptable": $("#NiveRiesgo").css("background-color", "red"); $("#NiveRiesgo").css("color", "white"); break;
                case "Bajo": $("#NiveRiesgo").css("background-color", "green"); $("#NiveRiesgo").css("color", "white"); break;
                case "Medio": $("#NiveRiesgo").css("background-color", "yellow"); $("#NiveRiesgo").css("color", "black"); break;
                case "Alto": $("#NiveRiesgo").css("background-color", "red"); $("#NiveRiesgo").css("color", "white"); break;
                default: $("#NiveRiesgo").css("background-color", "white"); $("#NiveRiesgo").css("color", "black"); break;
            }
            $("#NiveRiesgo option").css("color", "black");
        }
    </script>
<script type="text/javascript">
    $("#Nueva_Evidencia").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Nueva_Evidencia").data('max-size');
            if ($("#Nueva_Evidencia").get(0).files.length) {
                var fileSize = $("#Nueva_Evidencia").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
                case 'PNG':
                case 'xls':
                case 'xlsx':
                case 'doc':
                case 'docx':
                case 'pdf':
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    break;
                default:
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
                    //$("#modal_archivo").modal('show');
            }
    });
    $("#NiveRiesgo").on('change', function () { 
            switch ($("#NiveRiesgo").val()) {
                case "Tolerable":
                    $("#NiveRiesgo").css("background-color", "green");
                    $("#NiveRiesgo").css("color", "white");
                    break;
                case "Alerta":
                    $("#NiveRiesgo").css("background-color", "yellow"); $("#NiveRiesgo").css("color", "black");
                    break;
                case "No Aceptable": $("#NiveRiesgo").css("background-color", "red"); $("#NiveRiesgo").css("color", "white"); break;
                case "Bajo": $("#NiveRiesgo").css("background-color", "green"); $("#NiveRiesgo").css("color", "white"); break;
                case "Medio": $("#NiveRiesgo").css("background-color", "yellow"); $("#NiveRiesgo").css("color", "black"); break;
                case "Alto": $("#NiveRiesgo").css("background-color", "red"); $("#NiveRiesgo").css("color", "white"); break;
                default: $("#NiveRiesgo").css("background-color", "white"); $("#NiveRiesgo").css("color", "black"); break;
            }
            $("#NiveRiesgo option").css("color", "black")
    });
    $("#TipoInspeccion").on('change', function () {
            if ($("#TipoInspeccion").val() == "MAP") {
                $(".OpcSeguridad").hide();
                $(".OpcSeguridad").prop('disabled', 'disabled');
                $(".OpcMedioAmbiente").show();
                $(".OpcMedioAmbiente").prop('disabled', false);
                //$(".Vacio_NR").hide();
                //$(".Vacio_NR").prop('disabled', 'disabled');
                //Mostrar asesores
                $(".AsesorMedioAmbiente").show();
                $(".AsesorMedioAmbiente").prop('disabled', false);
                $(".AsesorSeguridad").hide();
                $(".AsesorSeguridad").prop('disabled', 'disabled');
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                //Eliminar Niveles SSO                
                $("#NiveRiesgo option[value='No Aplica']").remove();
                $("#NiveRiesgo option[value='Bajo']").remove();
                $("#NiveRiesgo option[value='Medio']").remove();
                $("#NiveRiesgo option[value='Alto']").remove();
                //Agregar opciones a nivel de riesgo
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
                $("#NiveRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#NiveRiesgo').append(new Option("Tolerable", "Tolerable"));
                $("#NiveRiesgo option[value='Tolerable']").css({"background-color": "green", "color": "white"});
                $('#NiveRiesgo').append(new Option("Alerta", "Alerta"));
                $("#NiveRiesgo option[value='Alerta']").css({"background-color": "yellow", "color": "black"});
                $('#NiveRiesgo').append(new Option("No Aceptable", "No Aceptable"));
                $("#NiveRiesgo option[value='No Aceptable']").css({"background-color": "red", "color": "white"});
            } else if ($("#TipoInspeccion").val() == "SSO") {
                $(".OpcMedioAmbiente").hide();
                $(".OpcMedioAmbiente").prop('disabled',  'disabled');
                $(".OpcSeguridad").show();                
                $(".OpcSeguridad").prop('disabled',  false);
                //$(".Vacio_NR").hide();
                //$(".Vacio_NR").prop('disabled', 'disabled');
                //Mostrar asesores seguridad
                $(".AsesorMedioAmbiente").hide();
                $(".AsesorMedioAmbiente").prop('disabled', 'disabled');
                $(".AsesorSeguridad").show();
                $(".AsesorSeguridad").prop('disabled', false);
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                //Eliminar Niveles MAP                
                $("#NiveRiesgo option[value='No Aplica']").remove();
                $("#NiveRiesgo option[value='Tolerable']").remove();
                $("#NiveRiesgo option[value='Alerta']").remove();
                $("#NiveRiesgo option[value='No Aceptable']").remove();
                //Agregar opciones a nivel de riesgo
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
                $("#NiveRiesgo option[value='No Aplica']").css({"background-color": "white", "color": "black"});
                $('#NiveRiesgo').append(new Option("Bajo", "Bajo"));
                $("#NiveRiesgo option[value='Bajo']").css({"background-color": "green", "color": "white"});
                $('#NiveRiesgo').append(new Option("Medio", "Medio"));
                $("#NiveRiesgo option[value='Medio']").css({"background-color": "yellow", "color": "black"});
                $('#NiveRiesgo').append(new Option("Alto", "Alto"));
                $("#NiveRiesgo option[value='Alto']").css({"background-color": "red", "color": "white"});
            } else {
                $(".OpcMedioAmbiente").hide();
                $(".OpcMedioAmbiente").prop('disabled',  'disabled');
                $(".OpcSeguridad").hide();
                $(".OpcSeguridad").prop('disabled',  'disabled');
                $(".Vacio_NR").show();
                $(".Vacio_NR").prop('disabled',  false);
                //Ocultar asesores
                $(".AsesorVacio").show();
                $(".AsesorVacio").prop('disabled', false);
                $(".AsesorMedioAmbiente").hide();
                $(".AsesorMedioAmbiente").prop('disabled', 'disabled');
                $(".AsesorSeguridad").hide();
                $(".AsesorSeguridad").prop('disabled', 'disabled');
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                //Eliminar Niveles MAP                
                $("#NiveRiesgo option[value='No Aplica']").remove();
                $("#NiveRiesgo option[value='Tolerable']").remove();
                $("#NiveRiesgo option[value='Alerta']").remove();
                $("#NiveRiesgo option[value='No Aceptable']").remove();
                //Eliminar Niveles SSO
                $("#NiveRiesgo option[value='No Aplica']").remove();
                $("#NiveRiesgo option[value='Bajo']").remove();
                $("#NiveRiesgo option[value='Medio']").remove();
                $("#NiveRiesgo option[value='Alto']").remove();
            }
            //reiniciar tipo condicion
            $(".Vacio").show();
            $(".Vacio").prop('disabled', false);
            $(".MA-Acto").hide();
            $(".MA-Condicion").hide();
            $(".MA-Acto").prop('disabled', 'disabled');
            $(".MA-Condicion").prop('disabled', 'disabled');
            $(".SEG-Acto").hide();
            $(".SEG-Condicion").hide();
            $(".SEG-Acto").prop('disabled', 'disabled');
            $(".SEG-Condicion").prop('disabled', 'disabled');
            $("#TiposActoMA").val("");
            $("#TiposCondicionMA").val("");
            //reiniciar estilo de nivel de riesgo
            $("#NiveRiesgo").css({"background-color": "white", "color": "black"});
        });
    $("#CondicionIdentificada").on('change', function () {
            var selectedOption = $("#CondicionIdentificada option:selected").val();
            if ($("#TipoInspeccion").val() == "MAP" && selectedOption == "Acto Subestándar") {
                $(".Vacio").hide();
                $(".Vacio").prop('disabled', 'disabled');
                $(".MA-Acto").show();
                $(".MA-Acto").prop('disabled', false);
                $(".MA-Condicion").hide();
                $(".MA-Condicion").prop('disabled', 'disabled');
            } else if ($("#TipoInspeccion").val() == "MAP" && selectedOption == "Condición Subestándar") {
                $(".Vacio").hide();
                $(".Vacio").prop('disabled', 'disabled');
                $(".MA-Acto").hide();
                $(".MA-Acto").prop('disabled', 'disabled');
                $(".MA-Condicion").show();
                $(".MA-Condicion").prop('disabled', false);
            } else if ($("#TipoInspeccion").val() == "SSO" && selectedOption == "Acto Subestándar") {
                $(".Vacio").hide();
                $(".Vacio").prop('disabled', 'disabled');
                $(".SEG-Acto").show();
                $(".SEG-Acto").prop('disabled', false);
                $(".SEG-Condicion").hide();
                $(".SEG-Condicion").prop('disabled', 'disabled');
            } else if ($("#TipoInspeccion").val() == "SSO" && selectedOption == "Condición Subestándar") {
                $(".Vacio").hide();
                $(".Vacio").prop('disabled', 'disabled');
                $(".SEG-Acto").hide();
                $(".SEG-Acto").prop('disabled', 'disabled');
                $(".SEG-Condicion").show();
                $(".SEG-Condicion").prop('disabled', false);
            } else {
                $(".Vacio").show();
                $(".Vacio").prop('disabled', false);
                $(".Vacio").val("");
                $(".MA-Acto").hide();
                $(".MA-Condicion").hide();
                $(".MA-Acto").prop('disabled', 'disabled');
                $(".MA-Condicion").prop('disabled', 'disabled');
                $(".SEG-Acto").hide();
                $(".SEG-Acto").prop('disabled', 'disabled');
                $(".SEG-Condicion").hide();
                $(".SEG-Condicion").prop('disabled', 'disabled');
                $("#TiposActoMA").val("");
                $("#TiposCondicionMA").val("");
            }
    });
    //Validar cambios de tipo condicion
    $(".SEG-Acto").on('change', function () {
        $("#TipoCondicion").val(this.value);
    });
    $(".SEG-Condicion").on('change', function () {
        $("#TipoCondicion").val(this.value);
    });
    $(".MA-Acto").on('change', function () {
        $("#TipoCondicion").val(this.value);
    });
    $(".MA-Condicion").on('change', function () {
        $("#TipoCondicion").val(this.value);
    });
    //Validar cambios de asesores    
    $(".AsesorMedioAmbiente").on('change', function () {
        $("#Asesor_MA_Seguridad").val(this.value);
    });
    $(".AsesorSeguridad").on('change', function () {
        $("#Asesor_MA_Seguridad").val(this.value);
    });
</script>
}