@{
    ViewData["Title"] = "Resumen Inspecciones";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="~/selectpicker/css/bootstrap-select.css">
}
<div class="inspection">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title inspection-opacity-color">
                <h3>Inspecciones - Resumen</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <div class="action-container inspection-color">
                <div class="w-100 row-center-center">
                    <a class="btn btn-special-action-outline inspection-color" asp-action="NuevaInspeccion" asp-controller="Inspecciones">NUEVA INSPECCIÓN</a>
                </div>
                @if (ViewBag.PermisoAdmin)
                {
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-special-action-outline inspection-color" onclick="EliminarVencidos()">ELIMINAR INSPECCIONES VENCIDOS</button>
                    </div>
                }
            </div>
            <form autocomplete="off" class="custom-form" id="form_filtro">
                <div class="col-12 col-lg-9">
                    <div class="row input_container">
                        <div class="col-12 col-md-4">
                            <label>Fecha de Inicio</label>
                            <input id="fecha_inicio_filtro" type="date" class="form-control">
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Fecha de Fin</label>
                            <input id="fecha_fin_filtro" type="date" class="form-control">
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Gerencia Inspeccionada</label>
                            <select id="gerencia_filtro" asp-items="@ViewBag.Gerencias" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-4">
                            <label>Empresa Inspeccionada</label>
                            <select id="empresa_filtro" asp-items="@ViewBag.Empresas" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Registrado Por</label>
                            <select id="registrado_por_filtro" asp-items="@ViewBag.Usuarios" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Estado</label>
                            <select id="estado_filtro" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                                <option data-tokens="Implementacion" value="Implementacion">Pendientes de Implementación</option>
                                <option data-tokens="Verificacion" value="Verificacion">Pendientes de Verificación</option>
                                <option data-tokens="Vencidos" value="Vencidos">Vencidos</option>
                                <option data-tokens="Aprobados" value="Aprobados">Aprobados</option>
                            </select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-4">
                            <label>Responsable del Levantamiento de Observación</label>
                            <select id="responsable_filtro" asp-items="@ViewBag.Usuarios" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Asesor MAP/SSO</label>
                            <select id="asesor_filtro" asp-items="@ViewBag.Asesores" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Código</label>
                            <input id="codigo_filtro" type="text" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-4">
                            <label>Tipo Inspección</label>
                            <select id="tipo_inspeccion_filtro" asp-items="@ViewBag.Tipo_Inspeccion" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label>Tipo Observacion</label>
                            <select id="tipo_observacion_filtro" class="selectpicker form-control" data-live-search="true" title="No se ha seleccionado ninguna opción" multiple>
                                <option value="MAP">MA</option>
                                <option value="SSO">SSO</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-3">
                    <div class="row ms-1 me-1">
                        <button id="btn_filtrar" type="button" class="btn btn-mc" onclick="filtrar(1)">Filtrar</button>
                    </div>
                    <div class="row ms-1 me-1">
                        <button id="btn_reset" type="button" class="btn btn-mc-outline">Limpiar Filtros</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="secondary-content col-12">
        <div class="table-responsive inspection-color">
            <table class="table" id="tabla_resumen_inspecciones">
                <thead class="">
                    <tr>
                        <th>Código</th>
                        @if (ViewBag.PermisoAdmin)
                        {
                            <th>Registrado Por</th>
                        }
                        <th>Área Ejecutora de la Inspección</th>
                        <th>Empresa Inspeccionada</th>
                        <th>Gerencia Inspeccionada</th>
                        <th>Área Inspeccionada</th>
                        <th>Fecha de Inspección</th>
                        <th>N° Observaciones</th>
                        <th>Avance</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
        <div class="pagination-container inspection-color" id="paginado">
        </div>
    </div>
</div>
@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/selectpicker/js/bootstrap-select.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            //Actualizar campos desde localstorage
            var savedData = localStorage.getItem("ResumenInspecciones");

            if(savedData){
                const filtrosData = JSON.parse(savedData);
                $('#fecha_inicio_filtro').val(filtrosData.fechaInicioFiltro);
                $('#fecha_fin_filtro').val(filtrosData.fechaFinFiltro);
                $('#gerencia_filtro').val(filtrosData.gerenciaFiltro);
                $('#empresa_filtro').val(filtrosData.empresaFiltro);
                $('#registrado_por_filtro').val(filtrosData.registradoPorFiltro);
                $('#estado_filtro').val(filtrosData.estadoFiltro);
                $('#responsable_filtro').val(filtrosData.responsableFiltro);
                $("#asesor_filtro").val(filtrosData.asesorFiltro);
                $("#codigo_filtro").val(filtrosData.codigoFiltro);
                $("#tipo_inspeccion_filtro").val(filtrosData.tipo_inspeccion_filtro);
                $("#tipo_observacion_filtro").val(filtrosData.tipo_observacion_filtro);
            }
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        img_url = data.img_url;
                        inspectionStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            var filtros = {
                "fechaInicioFiltro": $('#fecha_inicio_filtro').val(),
                "fechaFinFiltro": $('#fecha_fin_filtro').val(),
                "gerenciaFiltro": $('#gerencia_filtro').val(),
                "empresaFiltro": $('#empresa_filtro').val(),
                "registradoPorFiltro": $('#registrado_por_filtro').val(),
                "estadoFiltro": $('#estado_filtro').val(),
                "responsableFiltro": $('#responsable_filtro').val(),
                "asesorFiltro": $("#asesor_filtro").val(),
                "codigoFiltro": $("#codigo_filtro").val(),
                "tipo_inspeccion_filtro": $("#tipo_inspeccion_filtro").val(),
                "tipo_observacion_filtro": $("#tipo_observacion_filtro").val()
            };
            localStorage.setItem("ResumenInspecciones", JSON.stringify(filtros));

            $.ajax({
                type: "POST",
                url: "/Inspecciones/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "fechaInicioFiltro": $('#fecha_inicio_filtro').val(),
                    "fechaFinFiltro": $('#fecha_fin_filtro').val(),
                    "gerenciaFiltro": $('#gerencia_filtro').val(),
                    "empresaFiltro": $('#empresa_filtro').val(),
                    "registradoPorFiltro": $('#registrado_por_filtro').val(),
                    "estadoFiltro": $('#estado_filtro').val(),
                    "responsableFiltro": $('#responsable_filtro').val(),
                    "asesorFiltro": $("#asesor_filtro").val(),
                    "codigoFiltro": $("#codigo_filtro").val(),
                    "tipo_inspeccion_filtro": $("#tipo_inspeccion_filtro").val(),
                    "tipo_observacion_filtro": $("#tipo_observacion_filtro").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_inspecciones tbody').empty();
                    $('#tabla_resumen_inspecciones tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function EliminarVencidos() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/EliminarVencidos",
                data: {
                    "fechaInicioFiltro": $('#fecha_inicio_filtro').val(),
                    "fechaFinFiltro": $('#fecha_fin_filtro').val()
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        console.log(response.message);
                    } else {
                        console.log(response.message);
                    }
                }
            });
        }
        $("#btn_reset").on('click', function () {
            reset();
        });
        function reset() {
            $("#form_filtro")[0].reset();
            $('.selectpicker').selectpicker('refresh');
            filtrar(1);
        }
    </script>
}
