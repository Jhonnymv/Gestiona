@section scripts{
    <script src="~/js/stepper.js"></script>
    <script type="text/javascript">        
        var listObservaciones = [];
        var img_url = "";
        $(document).ready(function () {
            if ('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) {
                //disable inputs
                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('readonly', false);
                $('#Inspectores').prop('readonly', false);
                $('#Hora_Inspeccion').prop('readonly', false);
                $('#Fecha_Inspeccion').prop('readonly', false);
                $('#Responsable_Inspeccion').prop('readonly', false);
                $('#Objetivo').prop('readonly', false);
                $('#Tipo_Inspeccion').prop('disabled', false);
            }
            dataModulo();
            ConsultarObservaciones();
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        img_url = data.img_url;
                        inspectionStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        $("#guardar").click(function () {
            $("#opcion").val("Guardar");
        });
        $("#guardar_estado").click(function () {
            $("#opcion").val("GuardarEstado");
        });
        $("#nueva_obs").click(function () {
            $("#opcion").val("Observacion");
        });
        $("#eliminar").click(function () {
            if (window.confirm("¿Seguro que desea eliminar esta inspección?")) {
                //disable inputs
                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('disabled', false);
                $('#Inspectores').prop('disabled', false);
                $('#Hora_Inspeccion').prop('disabled', false);
                $('#Fecha_Inspeccion').prop('disabled', false);
                $('#Responsable_Inspeccion').prop('disabled', false);
                $('#Objetivo').prop('disabled', false);
               $('#Tipo_Inspeccion').prop('disabled', false);
                $("#opcion").val("Eliminar");
                $("#form_nuevaInspeccion").submit();
            }
        });
        function EnviarNuevaFecha() {
            var fecha = $("#nuevaFecha").val();
            var idObservacion = $("#idObserv").val();
            if (fecha != "") {
                $.ajax({
                    async: true,
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("AmpliarFechaObservacion", "Inspecciones"))",
                    data: {
                        "idCabecera": $("#EncryptedId").val(),
                        "idObservacion": idObservacion,
                        "fecha": fecha
                    },
                    success: function (data) {
                        location.reload()
                    }
                });
            } else {
                alert("Debe seleccionar una fecha");
            }
        }
        function ampliarInspeccion(idObservacion) {
            $("#modal_ampliacion").modal("show");
            $("#idObserv").val(idObservacion);
        }
        function FinalizarRegistro() {
            $("#Modal_Enviando_Correo").modal('show')
            $.ajax({
                type: "POST",
                data: $('#form_nuevaInspeccion').serialize(),
                url: "/Inspecciones/EditarInspeccion",
                contentType: "application/json"
            }).success(function () {

            });
        }
        function ConsultarObservaciones() {
            $.ajax({
                type: "POST",
                url: "@(Url.Action("ConsultarObservaciones", "Inspecciones"))",
                data: {
                    "IdCabecera": $("#EncryptedId").val(),
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        $('#tabla_resumen tbody').empty();
                        $('#tabla_resumen tbody').html(response.html);
                        listObservaciones = JSON.parse(response.observaciones);
                        dataModulo();
                    } else {
                        console.log(response.message);
                    }
                }
            });
            
        }
    </script>
    @*Scripts partial Nueva Observación*@
    <script>
        $("#Evidencias").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Evidencias").data('max-size');
            if ($("#Evidencias").get(0).files.length) {
                var fileSize = $("#Evidencias").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
