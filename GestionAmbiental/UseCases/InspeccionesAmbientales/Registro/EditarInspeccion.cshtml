                                                </svg>
                                                <span>Descargar Excel</span>
                                            </a>
                                            <button id="eliminar" type="button" class="btn btn-mc-danger">Eliminar Inspección</button>
                                        }
                                        else if (ViewBag.Permiso)
                                        {
                                            <button id="eliminar" type="button" class="btn btn-mc-danger">Eliminar Inspección</button>
