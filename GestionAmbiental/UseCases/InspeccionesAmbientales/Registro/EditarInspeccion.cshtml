    <script>
        $("#Evidencias").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Evidencias").data('max-size');
            if ($("#Evidencias").get(0).files.length) {
                var fileSize = $("#Evidencias").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
                case 'PNG':
                case 'xls':
                case 'xlsx':
                case 'doc':
                case 'docx':
                case 'pdf':
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    break;
                default:
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
                //$("#modal_archivo").modal('show');
            }
        });
        $("#NiveRiesgo").on('change', function () {
            switch ($("#NiveRiesgo").val()) {
                case "Tolerable":
                case "Bajo":
                    $("#NiveRiesgo").css("background-color", "green");
                    $("#NiveRiesgo").css("color", "white");
                    break;
                case "Alerta":
                case "Medio":
                    $("#NiveRiesgo").css("background-color", "yellow");
                    $("#NiveRiesgo").css("color", "black");
                    break;
                case "No Aceptable":
                case "Alto":
                    $("#NiveRiesgo").css("background-color", "red");
                    $("#NiveRiesgo").css("color", "white");
                    break;
                default:
                    $("#NiveRiesgo").css("background-color", "white");
                    $("#NiveRiesgo").css("color", "black");
                    break;
            }
            $("#NiveRiesgo option").css("color", "black")
        });
        function ActualizarNivelRiesgo(TipoInspeccion) {
            if (TipoInspeccion == "MAP") {
                $('#NiveRiesgo').empty().append(new Option("--SELECCIONE--", ""));
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
                $("#NiveRiesgo option[value='No Aplica']").css({ "background-color": "white", "color": "black" });
                $('#NiveRiesgo').append(new Option("Tolerable", "Tolerable"));
                $("#NiveRiesgo option[value='Tolerable']").css({ "background-color": "green", "color": "white" });
                $('#NiveRiesgo').append(new Option("Alerta", "Alerta"));
                $("#NiveRiesgo option[value='Alerta']").css({ "background-color": "yellow", "color": "black" });
                $('#NiveRiesgo').append(new Option("No Aceptable", "No Aceptable"));
                $("#NiveRiesgo option[value='No Aceptable']").css({ "background-color": "red", "color": "white" });
            }
            else if (TipoInspeccion == "SSO") {
                $('#NiveRiesgo').empty().append(new Option("--SELECCIONE--", ""));
                $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
                $("#NiveRiesgo option[value='No Aplica']").css({ "background-color": "white", "color": "black" });
                $('#NiveRiesgo').append(new Option("Bajo", "Bajo"));
                $("#NiveRiesgo option[value='Bajo']").css({ "background-color": "green", "color": "white" });
                $('#NiveRiesgo').append(new Option("Medio", "Medio"));
                $("#NiveRiesgo option[value='Medio']").css({ "background-color": "yellow", "color": "black" });
                $('#NiveRiesgo').append(new Option("Alto", "Alto"));
                $("#NiveRiesgo option[value='Alto']").css({ "background-color": "red", "color": "white" });
            }
            else {
                $('#NiveRiesgo').empty().append(new Option("", "--SELECCIONE--"));
            }
        }
        function CambiarBuenasPracticas(habilitar, tipoInspeccion) {
            if (habilitar) {
                $("#FechaProgramada").prop('disabled', true);
                $("#FechaProgramada").val("");
                $("#NiveRiesgo").prop('disabled', true);
                ActualizarNivelRiesgo(tipoInspeccion);
                $("#NiveRiesgo").css('background-color', '#e9ecef');
                $("#NiveRiesgo").css('color', 'black');
                $("#AccionTomada").prop('disabled', true);
                $("#AccionTomada").val("");
                $("#TipoCondicion").val("");
                TipoCondicionVacio();
                $(".Vacio").prop('disabled', true);
            } else {
                $("#FechaProgramada").prop('disabled', false);
                $("#FechaProgramada").val("");
                $("#NiveRiesgo").prop('disabled', false);
                $("#NiveRiesgo").css('background-color', '#ffffff');
                $("#AccionTomada").prop('disabled', false);
                $("#AccionTomada").val("");
                ActualizarNivelRiesgo(tipoInspeccion);
            }
        }
        function TipoCondicionVacio() {
            $(".Vacio").show();
            $(".Vacio").prop('disabled', false);
            $(".Vacio").val("");
            $(".MA-Acto").hide();
            $(".MA-Condicion").hide();
            $(".MA-Acto").prop('disabled', true);
            $(".MA-Condicion").prop('disabled', true);
            $(".SEG-Acto").hide();
            $(".SEG-Acto").prop('disabled', true);
            $(".SEG-Condicion").hide();
            $(".SEG-Condicion").prop('disabled', true);
        }
        function ReiniciarCondicionesIndentificadas() {
            $(".Vacio").hide();
            $(".Vacio").val("");
            $(".Vacio").prop('disabled', true);
            $(".MA-Condicion").hide();
            $(".MA-Condicion").val("0");
            $(".MA-Condicion").prop('disabled', true);
            $(".MA-Acto").hide();
            $(".MA-Acto").val("0");
            $(".MA-Acto").prop('disabled', true);
            $(".SEG-Condicion").hide();
            $(".SEG-Condicion").val("0");
            $(".SEG-Condicion").prop('disabled', true);
            $(".SEG-Acto").hide();
            $(".SEG-Acto").val("0");
            $(".SEG-Acto").prop('disabled', true);
        }
        $("#Asesores_MA").on('change', function () {
            let asesor = $("#Asesores_MA").val()
            console.log(asesor)
            $("#Asesor_MA_Seguridad").val(asesor)
        })
        $("#Asesores_Seguridad").on('change', function () {
            let asesor = $("#Asesores_Seguridad").val()
            console.log(asesor)
            $("#Asesor_MA_Seguridad").val(asesor)
        })
        $("#TipoInspeccion").on('change', function () {
            if ($("#TipoInspeccion").val() == "MAP") {
                //Mostrar asesores
                $(".AsesorMedioAmbiente").show();
                $(".AsesorMedioAmbiente").prop('disabled', false);
                $(".AsesorSeguridad").hide();
                $(".AsesorSeguridad").prop('disabled', true);
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                //Agregar opciones a nivel de riesgo
                ActualizarNivelRiesgo("MAP");

                $("#Asesor_MA_Seguridad").val($("#Asesores_MA").val())

            } else if ($("#TipoInspeccion").val() == "SSO") {
                //Mostrar asesores seguridad
                $(".AsesorMedioAmbiente").hide();
                $(".AsesorMedioAmbiente").prop('disabled', true);
                $(".AsesorSeguridad").show();
                $(".AsesorSeguridad").prop('disabled', false);
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                //Agregar opciones a nivel de riesgo
                ActualizarNivelRiesgo("SSO");
                $("#Asesor_MA_Seguridad").val($("#Asesores_Seguridad").val())
            } else {
                $(".OpcMedioAmbiente").hide();
                $(".OpcMedioAmbiente").prop('disabled', true);
                $(".OpcSeguridad").hide();
                $(".OpcSeguridad").prop('disabled', true);
                $(".Vacio_NR").show();
                $(".Vacio_NR").prop('disabled', false);
                //Ocultar asesores
                $(".AsesorVacio").show();
                $(".AsesorVacio").prop('disabled', false);
                $(".AsesorMedioAmbiente").hide();
                $(".AsesorMedioAmbiente").prop('disabled', true);
                $(".AsesorSeguridad").hide();
                $(".AsesorSeguridad").prop('disabled', true);
                //reiniciar condicion
                $("#CondicionIdentificada").val("");
                ActualizarNivelRiesgo("Vacio");
            }
            //reiniciar tipo condicion
            $(".Vacio").show();
            $(".Vacio").prop('disabled', false);
            $(".MA-Acto").hide();
            $(".MA-Condicion").hide();
            $(".MA-Acto").prop('disabled', true);
            $(".MA-Condicion").prop('disabled', true);
            $(".SEG-Acto").hide();
            $(".SEG-Condicion").hide();
            $(".SEG-Acto").prop('disabled', true);
            $(".SEG-Condicion").prop('disabled', true);
        });
        $("#CondicionIdentificada").on('change', function () {
            var selectedOption = $("#CondicionIdentificada option:selected").val();
            var tipoInspeccion = $("#TipoInspeccion").val();
            if (tipoInspeccion == "MAP" && selectedOption == "Acto Subestándar") {
                ReiniciarCondicionesIndentificadas();
                $(".MA-Acto").show();
                $(".MA-Acto").prop('disabled', false);
                CambiarBuenasPracticas(false, tipoInspeccion);
            } else if (tipoInspeccion == "MAP" && selectedOption == "Condición Subestándar") {
                ReiniciarCondicionesIndentificadas();
                $(".MA-Condicion").show();
                $(".MA-Condicion").prop('disabled', false);
                CambiarBuenasPracticas(false, tipoInspeccion);
            } else if (tipoInspeccion == "SSO" && selectedOption == "Acto Subestándar") {
                ReiniciarCondicionesIndentificadas();
                $(".SEG-Acto").show();
                $(".SEG-Acto").prop('disabled', false);
                CambiarBuenasPracticas(false, tipoInspeccion);
            } else if (tipoInspeccion == "SSO" && selectedOption == "Condición Subestándar") {
                ReiniciarCondicionesIndentificadas();
                $(".SEG-Condicion").show();
                $(".SEG-Condicion").prop('disabled', false);
                CambiarBuenasPracticas(false, tipoInspeccion);
            } else if (selectedOption == "Buenas Prácticas") {
                ReiniciarCondicionesIndentificadas();
                $(".Vacio").show();
                CambiarBuenasPracticas(true, tipoInspeccion);
            } else {
                TipoCondicionVacio();
                CambiarBuenasPracticas(false, tipoInspeccion);
            }
        });
        function GuardarObservacion() {
            if (ValidarNuevaObservacion()) {
                var formData = new FormData();
                var files = document.getElementById("Evidencias").files;
                for (var i = 0; i != files.length; i++) {
                    formData.append("Evidencias", files[i]);
                }
                formData.append("idCabecera", $("#idCabecera").val());
                formData.append("TipoInspeccion", $("#TipoInspeccion").val());
                formData.append("Asesor_MA_Seguridad", $("#Asesor_MA_Seguridad:not(:disabled)").val());
                formData.append("CondicionIdentificada", $("#CondicionIdentificada").val());
                formData.append("DescripcionActoCondicion", $("#DescripcionActoCondicion").val());
                formData.append("TipoCondicion", $("#TipoCondicion:not(:disabled)").val());
                formData.append("FechaProgramada", $("#FechaProgramada").val());
                formData.append("NiveRiesgo", $("#NiveRiesgo").val());
                formData.append("AccionTomada", $("#AccionTomada").val());
                formData.append("ResponsableMarc", $("#ResponsableMarc").val());
                formData.append("ResponsableMarc2", $("#ResponsableMarc2").val());
                formData.append("ResponsableCont", $("#ResponsableCont").val());
                formData.append("CorreoCont", $("#CorreoCont").val());
                $.ajax({
                    url: "@Url.Action("NuevaObservacion", "Inspecciones")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $('#modalNuevaObservacion').modal('toggle');
                            ConsultarObservaciones();
                            ReiniciarModalObservacion();
                        }
                        else {
                            alert("Ocurrió un error al agregar la observación")
                        }
                    }
                });
            }
        }
        function ReiniciarModalObservacion() {
            $("#TipoInspeccion").val('');
            $(".AsesorMedioAmbiente").val('0');
            $(".AsesorSeguridad").val('0');
            $(".AsesorMedioAmbiente").hide();
            $(".AsesorSeguridad").hide();
            $("#DescripcionActoCondicion").val('');
            $("#CondicionIdentificada").val('');
            $("#TipoCondicion").val('');
            $(".Vacio").val('');
            $(".Vacio").show();
            $(".Vacio").prop('disabled', false);
            $(".MA-Acto").val('0');
            $(".MA-Acto").hide();
            $(".MA-Acto").prop('disabled', true);
            $(".MA-Condicion").val('0');
            $(".MA-Condicion").hide();
            $(".MA-Condicion").prop('disabled', true);
            $(".SEG-Acto").val('0');
            $(".SEG-Acto").hide();
            $(".SEG-Acto").prop('disabled', true);
            $(".SEG-Condicion").val('0');
            $(".SEG-Condicion").hide();
            $(".SEG-Condicion").prop('disabled', true);
            $("#FechaProgramada").val('');
            $("#NiveRiesgo").val('');
            $("#NiveRiesgo").css("background-color", "white");
            $("#NiveRiesgo").css("color", "black");
            $("#AccionTomada").val('');
            $("#ResponsableMarc").val('0');
            $("#ResponsableMarc2").val('0');
            $("#ResponsableCont").val('');
            $("#CorreoCont").val('');
            $("#Evidencias").val('');
            $("#files_name").text('0 Archivos');
            $("#NiveRiesgo").find('option').remove();
            $('#NiveRiesgo').append(new Option("-- SELECCIONE --", ""));
            $("#NiveRiesgo option[value='']").css({ "background-color": "white", "color": "black" });
        }
        function ReiniciarMsgsValidacion() {
            $('span[data-valmsg-for="TipoInspeccion"]').text("");
            $('span[data-valmsg-for="Asesor_MA_Seguridad"]').text("");
            $('span[data-valmsg-for="DescripcionActoCondicion"]').text("");
            $('span[data-valmsg-for="CondicionIdentificada"]').text("");
            $('span[data-valmsg-for="TipoCondicion"]').text("");
            $('span[data-valmsg-for="FechaProgramada"]').text("");
            $('span[data-valmsg-for="NiveRiesgo"]').text("");
            $('span[data-valmsg-for="AccionTomada"]').text("");
            $('span[data-valmsg-for="ResponsableMarc"]').text("");
            $('span[data-valmsg-for="ResponsableCont"]').text("");
        }
        function ValidarNuevaObservacion() {
            var result = true;
            ReiniciarMsgsValidacion();
            if ($("#idCabecera").val() == "") result = false;
            if ($("#TipoInspeccion").val() == "") { result = false; $('span[data-valmsg-for="TipoInspeccion"]').text("Debe seleccionar una opción"); }
            if ($("#Asesor_MA_Seguridad:not(:disabled)").is(":visible") && $("#Asesor_MA_Seguridad:not(:disabled)").val() == "0") {result = false; $('span[data-valmsg-for="Asesor_MA_Seguridad"]').text("Debe seleccionar una opción");}
            if ($("#CondicionIdentificada").val() == "") { result = false; $('span[data-valmsg-for="CondicionIdentificada"]').text("Debe seleccionar una opción"); }
            if ($("#DescripcionActoCondicion").val() == "") { result = false; $('span[data-valmsg-for="DescripcionActoCondicion"]').text("Debe ingresar una descripción"); }
            if ($("#ResponsableMarc").val() == "0") { result = false; $('span[data-valmsg-for="ResponsableMarc"]').text("Debe seleccionar una opción"); }
            if ($("#ResponsableCont").val() == "") { result = false; $('span[data-valmsg-for="ResponsableCont"]').text("Debe completar este campo"); }
            if ($("#CorreoCont").val() == "") { result = false; $('span[data-valmsg-for="CorreoCont"]').text("Debe completar este campo"); }
            if (document.getElementById("Evidencias").files.length == 0) { result = false; $("#danger_evidencia").text("Debe seleccionar un archivo"); }
            if ($("#CondicionIdentificada").val() != "Buenas Prácticas") {
                if ($("#TipoCondicion").val() == "") { result = false; $('span[data-valmsg-for="TipoCondicion"]').text("Debe seleccionar una opción"); }
                if ($("#FechaProgramada").val() == "") { result = false; $('span[data-valmsg-for="FechaProgramada"]').text("Debe ingresar una fecha"); }
                if ($("#NiveRiesgo").val() == "") { result = false; $('span[data-valmsg-for="NiveRiesgo"]').text("Debe seleccionar una opción"); }
                if ($("#AccionTomada").val() == "") { result = false; $('span[data-valmsg-for="AccionTomada"]').text("Debe completar este campo"); }
            }
            return result;
        }
        //Validar cambios de tipo condicion
        $(".SEG-Acto").on('change', function () {
            $("#TipoCondicion").val(this.value);
        });
        $(".SEG-Condicion").on('change', function () {
                $("#TipoCondicion").val(this.value);
            });
        $(".MA-Acto").on('change', function () {
                $("#TipoCondicion").val(this.value);
            });
        $(".MA-Condicion").on('change', function () {
                $("#TipoCondicion").val(this.value);
            });
    </script>
