            //reiniciar tipo condicion
            $(".E_Vacio").show();
            $(".E_Vacio").prop('disabled', false);
            $(".E_MA-Acto").hide();
            $(".E_MA-Condicion").hide();
            $(".E_MA-Acto").prop('disabled', true);
            $(".E_MA-Condicion").prop('disabled', true);
            $(".E_SEG-Acto").hide();
            $(".E_SEG-Condicion").hide();
            $(".E_SEG-Acto").prop('disabled', true);
            $(".E_SEG-Condicion").prop('disabled', true);
            $("#E_TipoCondicion:not(:disabled)").val('');
            $("#E_CondicionIdentificada").val('');
            //reiniciar estilo de nivel de riesgo
            $("#E_NivelRiesgo").css({"background-color": "white", "color": "black"});
        });
        $("#E_CondicionIdentificada").on('change', function () {
            var selectedOption = $("#E_CondicionIdentificada option:selected").val();
            if ($("#E_TipoInspeccion").val() == "MAP" && selectedOption == "Acto Subestándar") {
                $(".E_Vacio").hide();
                $(".E_Vacio").prop('disabled', true);
                $(".E_MA-Acto").show();
                $(".E_MA-Acto").prop('disabled', false);
                $(".E_MA-Condicion").hide();
                $(".E_MA-Condicion").prop('disabled', true);
            } else if ($("#E_TipoInspeccion").val() == "MAP" && selectedOption == "Condición Subestándar") {
                $(".E_Vacio").hide();
                $(".E_Vacio").prop('disabled', true);
                $(".E_MA-Acto").hide();
                $(".E_MA-Acto").prop('disabled', true);
                $(".E_MA-Condicion").show();
                $(".E_MA-Condicion").prop('disabled', false);
            } else if ($("#E_TipoInspeccion").val() == "SSO" && selectedOption == "Acto Subestándar") {
                $(".E_Vacio").hide();
                $(".E_Vacio").prop('disabled', true);
                $(".E_SEG-Acto").show();
                $(".E_SEG-Acto").prop('disabled', false);
                $(".E_SEG-Condicion").hide();
                $(".E_SEG-Condicion").prop('disabled', true);
            } else if ($("#E_TipoInspeccion").val() == "SSO" && selectedOption == "Condición Subestándar") {
                $(".E_Vacio").hide();
                $(".E_Vacio").prop('disabled', true);
                $(".E_SEG-Acto").hide();
                $(".E_SEG-Acto").prop('disabled', true);
                $(".E_SEG-Condicion").show();
                $(".E_SEG-Condicion").prop('disabled', false);
            } else {
                $(".E_Vacio").show();
                $(".E_Vacio").prop('disabled', false);
                $(".E_Vacio").val("");
                $(".E_MA-Acto").hide();
                $(".E_MA-Condicion").hide();
                $(".E_MA-Acto").prop('disabled', true);
                $(".E_MA-Condicion").prop('disabled', true);
                $(".E_SEG-Acto").hide();
                $(".E_SEG-Acto").prop('disabled', true);
                $(".E_SEG-Condicion").hide();
                $(".E_SEG-Condicion").prop('disabled', true);
                $("#E_TiposActoMA").val("");
                $("#E_TiposCondicionMA").val("");
            }
        });
        //Validar cambios de tipo condicion
        $(".E_SEG-Acto").on('change', function () {
        $("#E_TipoCondicion").val(this.value);
    });
        $(".E_SEG-Condicion").on('change', function () {
        $("#E_TipoCondicion").val(this.value);
    });
        $(".E_MA-Acto").on('change', function () {
        $("#E_TipoCondicion").val(this.value);
    });
        $(".E_MA-Condicion").on('change', function () {
        $("#E_TipoCondicion").val(this.value);
    });
        //Validar cambios de asesores
        $(".E_AsesorMedioAmbiente").on('change', function () {
        $("E_#AsesorSeguridad").val(this.value);
    });
        $(".E_AsesorSeguridad").on('change', function () {
