                $(".E_Vacio_NR").prop('disabled',  false);
                //Ocultar asesores
                $(".E_AsesorVacio").show();
                $(".E_AsesorVacio").prop('disabled', false);
                $(".E_AsesorMedioAmbiente").hide();
                $(".E_AsesorMedioAmbiente").prop('disabled', true);
                $(".E_AsesorSeguridad").hide();
                $(".E_AsesorSeguridad").prop('disabled', true);
                //reiniciar condicion
                $("#E_CondicionIdentificada").val("");
                //Eliminar Niveles MAP
                $("#E_NivelRiesgo option[value='No Aplica']").remove();
                $("#E_NivelRiesgo option[value='Tolerable']").remove();
                $("#E_NivelRiesgo option[value='Alerta']").remove();
                $("#E_NivelRiesgo option[value='No Aceptable']").remove();
                //Eliminar Niveles SSO
                $("#E_NivelRiesgo option[value='No Aplica']").remove();
                $("#E_NivelRiesgo option[value='Bajo']").remove();
                $("#E_NivelRiesgo option[value='Medio']").remove();
                $("#E_NivelRiesgo option[value='Alto']").remove();
