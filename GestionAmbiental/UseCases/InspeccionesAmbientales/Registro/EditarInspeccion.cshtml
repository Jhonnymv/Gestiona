@using GestionAmbiental.UseCases.InspeccionesAmbientales.Registro;
@model GestionAmbiental.UseCases.InspeccionesAmbientales.Registro.NuevaInspeccionModel

@{
    ViewData["Title"] = "Editar Inspeccion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/selectpicker/css/bootstrap-select.css">
}
@{
    await Html.RenderPartialAsync("_NuevaObservacion", new NuevaObservacionModel());
    await Html.RenderPartialAsync("_EditarObservacion", new EditarObservacionModel());
}
<div class="inspection">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title inspection-opacity-color">
                <h3>Editar Inspección - @Model.Codigo</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form w-100" id="form_nuevaInspeccion" asp-action="EditarInspeccion" asp-controller="Inspecciones" method="post" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" asp-for="Id_Inspeccion_Cabecera" />
                <input type="hidden" asp-for="EncryptedId" />
                <input type="hidden" asp-for="opcion" />
                <input type="hidden" asp-for="Estado" />
                <div class="form-tabs-mc col-12">
                    <div class="d-flex justify-content-center mt-4 mb-4">
                        <ul class="d-flex justify-content-center  nav nav-pills col-9 col-md-7 div-scroll-horizontal" id="pills-tab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link  col-12 active" id="pills-step1-tab" data-bs-toggle="pill" data-bs-target="#pills-step1" type="button" role="tab" aria-controls="pills-step1" aria-selected="true" disabled>Paso 1</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link col-12" id="pills-step2-tab" data-bs-toggle="pill" data-bs-target="#pills-step2" type="button" role="tab" aria-controls="pills-step2" aria-selected="false" disabled>Observaciones</button>
                            </li>
                        </ul>
                    </div>
                    <div class="tab-content" id="pills-tabContent">
                        <div class="tab-pane fade show active" id="pills-step1" role="tabpanel" aria-labelledby="pills-step1-tab">
                            <div class="message"></div>
                            @* @if (ViewBag.PermisosAdmin)
                            { *@
                            <div class="row input_container" style="display:none">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Area_Formato"></label>
                                    <span class="text-danger" asp-validation-for="Area_Formato"></span>
                                    <select class="form-control" asp-items="@ViewBag.AreasFormato" asp-for="Area_Formato" disabled></select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Codigo_Formato"></label>
                                    <span class="text-danger" asp-validation-for="Codigo_Formato"></span>
                                    <select class="form-control" asp-items="@ViewBag.CodigosFormato" asp-for="Codigo_Formato" disabled></select>
                                </div>
                            </div>
                            @* } *@
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Id_Gerencia_Ejecutora"></label>
                                    <span class="text-danger" asp-validation-for="Id_Gerencia_Ejecutora"></span>
                                    <select class="form-control" asp-items="@ViewBag.GerenciaMC" asp-for="Id_Gerencia_Ejecutora" disabled></select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Id_Empresa_Contratista"></label>
                                    <span class="text-danger" asp-validation-for="Id_Empresa_Contratista"></span>
                                    <select class="form-control" asp-items="@ViewBag.EmpresasMC" asp-for="Id_Empresa_Contratista" disabled>
                                    </select>
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Id_Gerencia_Inspeccionada"></label>
                                    <span class="text-danger" asp-validation-for="Id_Gerencia_Inspeccionada"></span>
                                    <select class="form-control" asp-items="@ViewBag.GerenciaMC" asp-for="Id_Gerencia_Inspeccionada" disabled>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Lugar_Inspeccionado"></label>
                                    <span class="text-danger" asp-validation-for="Lugar_Inspeccionado"></span>
                                    <input type="text" class="form-control" asp-for="Lugar_Inspeccionado" readonly>
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Tipo_Inspeccion"></label>
                                    <span class="text-danger" asp-validation-for="Tipo_Inspeccion"></span>
                                    <select class="form-control" asp-items="@ViewBag.Tipo_Inspeccion" asp-for="Tipo_Inspeccion" disabled></select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Id_Responsable_Lugar"></label>
                                    <span class="text-danger" asp-validation-for="Id_Responsable_Lugar"></span>
                                    <select class="form-control" asp-items="@ViewBag.Responsables" asp-for="Id_Responsable_Lugar" disabled></select>
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6 p-0">
                                    <div class="row mt-0 mb-0">
                                        <div class="col-5 mt-0 mb-0">
                                            <label asp-for="Hora_Inspeccion"></label>
                                            <span class="text-danger" asp-validation-for="Hora_Inspeccion"></span>
                                            <input type="time" class="form-control" asp-for="Hora_Inspeccion" readonly>
                                        </div>
                                        <div class="col-7 mt-0 mb-0">
                                            <label asp-for="Fecha_Inspeccion"></label>
                                            <span class="text-danger" asp-validation-for="Fecha_Inspeccion"></span>
                                            <input type="date" class="form-control" asp-for="Fecha_Inspeccion" readonly>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" class="form-control" asp-for="Responsable_Inspeccion">
                                <div class="col-12 col-sm-6 col-lg-6" id="Responsable_List_Group" disabled style="display:none">
                                    <label asp-for="Responsable_Inspeccion"></label>
                                    <span class="text-danger" asp-validation-for="Responsable_Inspeccion"></span>
                                    <select id="Responsable_Inspeccion_List" name="Responsable_Inspeccion_List" asp-items="@ViewBag.Usuarios" class="selectpicker form-control" data-live-search="true" title="--SELECCIONE--" multiple style="background-color: #e9ecef;opacity:1;" disabled>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6" id="Responsable_Text_Group" style="display:none">
                                    <label asp-for="Responsable_Inspeccion"></label>
                                    <span class="text-danger" asp-validation-for="Responsable_Inspeccion"></span>
                                    <input id="Responsable_Inspeccion_Text" type="text" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6" id="Participantes_Inspeccion_List_Group" disabled>
                                    <label asp-for="Participantes_Inspeccion"></label>
                                    <span class="text-danger" asp-validation-for="Participantes_Inspeccion"></span>
                                    <select id="Participantes_Inspeccion_List" name="Participantes_Inspeccion_List" asp-items="@ViewBag.Usuarios" class="selectpicker form-control" data-live-search="true" title="--SELECCIONE--" multiple style="background-color: #e9ecef;opacity:1;" disabled>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Objetivo"></label>
                                    <span class="text-danger" asp-validation-for="Objetivo"></span>
                                    <input type="text" class="form-control" asp-for="Objetivo" readonly>
                                </div>
                            </div>
                            <div class="row input_container">
                                <input type="hidden" class="form-control" asp-for="Participantes_Inspeccion">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Inspectores"></label>
                                    <span class="text-danger" asp-validation-for="Inspectores"></span>
                                    <input type="text" class="form-control" asp-for="Inspectores" readonly>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6" id="miembros_comite" style="display:none">
                                    <label asp-for="Id_Miembro_Comite"></label>
                                    <span class="text-danger" asp-validation-for="Id_Miembro_Comite"></span>
                                    <select class="form-control" asp-items="@ViewBag.MiembrosComite" asp-for="Id_Miembro_Comite" disabled></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="d-flex justify-content-end">
                                    <button type="button" class="btn btn-mc next-btn">Siguiente</button>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="pills-step2" role="tabpanel" aria-labelledby="pills-step2-tab">
                            @if (ViewBag.Permiso)
                            {
                                <div class="row-center-center col-12">
                                    <div class="col-12 col-xl-4">
                                        <a class="btn btn-special-action inspection-color" id="nueva_obs" data-bs-toggle="modal" data-bs-target="#modalNuevaObservacion">
                                            Agregar Observación
                                        </a>
                                    </div>
                                </div>
                            }
                            <div class="inspection">
                                <div class="tertiary-content col-12">
                                    <div class="table-responsive inspection-color">
                                        <table class="table" id="tabla_resumen">
                                            <thead>
                                                <tr>
                                                    <th colspan="2"></th>
                                                    <th>Estado</th>
                                                    <th>Tipo de Observación</th>
                                                    <th>Asesor de MAP/SSO</th>
                                                    <th>Acto/Condición Subestándar Identificada</th>
                                                    <th>Tipo de Condición/Acto Subestándar</th>
                                                    <th>Descripción del Acto/Condición Subestándar</th>
                                                    <th>Evidencia</th>
                                                    <th>Nivel de Riesgo</th>
                                                    <th>Acción Preventiva / Correctiva Tomada</th>
                                                    <th>Responsable Marcobre 1</th>
                                                    <th>Responsable Marcobre 2</th>
                                                    <th>Responsable Contratista</th>
                                                    <th>Correo Contratista</th>
                                                    <th>Fecha Programada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td colspan="100">No hay observaciones</td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                    <div class="pagination-container inspection-color" id="paginado">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="button-container">
                                    <div>
                                        <button type="button" class="btn btn-mc-outline back-btn">Atrás</button>
                                    </div>
                                    <div>
                                        @if (ViewBag.PermisosAdmin || ViewBag.PermisoMASSO)
                                        {
                                            <button id="guardar_admin" type="button" onclick=" GuardarCambiosAdmin()" class="btn btn-mc-success">Guardar Cambios</button>
                                            if (Model.Estado == "Pendiente")
                                            {
                                                <button id="guardar" type="submit" onclick="FinalizarRegistro()" class="btn btn-mc" disabled>Finalizar Registro</button>                                                
                                            }
                                            <a id="descargar" type="button" class="btn btn-mc-success" style="color:white;" asp-controller="DescargaInspeccion" asp-action="DescargaInspeccionV2" asp-route-IdCabecera="@Model.Id_Inspeccion_Cabecera">
