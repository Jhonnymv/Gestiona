        function ActualizarColorNivelRiesgo() {
            switch ($("#E_NivelRiesgo").val()) {
                case "Tolerable":
                case "Bajo":
                    $("#E_NivelRiesgo").css("background-color", "green");
                    $("#E_NivelRiesgo").css("color", "white");
                    break;
                case "Alerta":
                case "Medio":
                    $("#E_NivelRiesgo").css("background-color", "yellow");
                    $("#E_NivelRiesgo").css("color", "black");
                    break;
                case "No Aceptable":
                case "Alto":
                    $("#E_NivelRiesgo").css("background-color", "red");
                    $("#E_NivelRiesgo").css("color", "white");
                    break;
                default:
                    $("#E_NivelRiesgo").css("background-color", "white");
                    $("#E_NivelRiesgo").css("color", "black");
                    break;
            }
            $("#E_NivelRiesgo option").css("color", "black");
            if ($("#E_NivelRiesgo").is(':disabled')) {
                $("#E_NivelRiesgo").css('background-color', '#e9ecef');
