        function EditarObservacion(IdObservacion) {
            var data;
            listObservaciones.forEach(function (obs) {
                if (obs.IdObservacion == IdObservacion)
                    data = obs;
            });
            ReiniciarModalEditarObs();
            if (data != null) {
                $("#E_IdObservacion").val(data.IdObservacion);
                $("#E_Estado").val(data.Estado);
                $("#E_CambioFechaVencida").val(false);
                $("#E_TipoInspeccion").val(data.TipoInspeccion);
                $("#E_DescripcionActoCondicion").val(data.DescripcionActoCondicion);
                $(".E_Vacio").hide();
                $(".E_Vacio").prop('disabled', true);
                $("#E_AsesorSeguridad").val(data.Asesor);
                if (data.TipoInspeccion == "MAP") {
                    $(".E_AsesorMedioAmbiente").show();
                    $(".E_AsesorMedioAmbiente").val(data.Asesor);
                    $("#E_CondicionIdentificada").val(data.DescripcionCondicion);
                    $("#E_TipoCondicion").val(data.TipoCondicion);
                    if (data.DescripcionCondicion == "Acto Subestándar") {
                        $(".E_MA-Acto").show();
                        $(".E_MA-Acto").prop('disabled', false);
                        $(".E_MA-Acto").val(data.TipoCondicion);
                        $("#E_FechaProgramada").prop('disabled', false);
                        $("#E_NivelRiesgo").prop('disabled', false);
                        $("#E_AccionTomada").prop('disabled', false);
                    }
                    else if (data.DescripcionCondicion == "Condición Subestándar") {
                        $(".E_MA-Condicion").show();
                        $(".E_MA-Condicion").prop('disabled', false);
                        $(".E_MA-Condicion").val(data.TipoCondicion);
                        $("#E_FechaProgramada").prop('disabled', false);
                        $("#E_NivelRiesgo").prop('disabled', false);
                        $("#E_AccionTomada").prop('disabled', false);
                    }
                    else {
                        $(".E_Vacio").show();
                        $(".E_Vacio").prop('disabled', true);
                        $(".E_Vacio").val("");
                        $("#E_FechaProgramada").prop('disabled', true);
                        $("#E_NivelRiesgo").prop('disabled', true);
                        $("#E_AccionTomada").prop('disabled', true);
                    }
                }
                else {
                    $(".E_AsesorSeguridad").show();
                    $(".E_AsesorSeguridad").val(data.Asesor);
                    $("#E_CondicionIdentificada").val(data.DescripcionCondicion);
                    $("#E_TipoCondicion").val(data.TipoCondicion);
                    if (data.DescripcionCondicion == "Acto Subestándar") {
                        $(".E_SEG-Acto").show();
                        $(".E_SEG-Acto").prop('disabled', false);
                        $(".E_SEG-Acto").val(data.TipoCondicion);
                        $("#E_FechaProgramada").prop('disabled', false);
                        $("#E_NivelRiesgo").prop('disabled', false);
                        $("#E_AccionTomada").prop('disabled', false);
                    } else if (data.DescripcionCondicion == "Condición Subestándar") {
                        $(".E_SEG-Condicion").show();
                        $(".E_SEG-Condicion").prop('disabled', false);
                        $(".E_SEG-Condicion").val(data.TipoCondicion);
                        $("#E_FechaProgramada").prop('disabled', false);
                        $("#E_NivelRiesgo").prop('disabled', false);
                        $("#E_AccionTomada").prop('disabled', false);
                    } else {
