@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/selectpicker/js/bootstrap-select.js"></script>
    <script src="~/js/stepper.js"></script>
    <script type="text/javascript">
        var listObservaciones = [];
        var img_url = "";
        $(document).ready(function () {
            if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower())) {
                //disable inputs
                // $('#Codigo_Formato').prop('disabled', false);
                $('#Area_Formato').prop('disabled', false);
                $('#Participantes_Inspeccion').prop('disabled', false);

                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Gerencia_Inspeccionada').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('readonly', false);
                $('#Inspectores').prop('readonly', false);
                $('#Hora_Inspeccion').prop('readonly', false);
                $('#Fecha_Inspeccion').prop('readonly', false);
                $('#Objetivo').prop('readonly', false);
                $('#Tipo_Inspeccion').prop('disabled', false);

            }
            if ($('#Tipo_Inspeccion').val() == "COMITE DE SSO") {
                $("#miembros_comite").css({ 'display': 'block' })
                if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower())) {
                    $('#Id_Miembro_Comite').prop('disabled', false);
                }
            }
            dataModulo();
            ConsultarObservaciones();
            var responsable_inspeccion = $("#Responsable_Inspeccion").val();
            if (isJson(responsable_inspeccion)) {
                $("#Responsable_List_Group").show();
                $("#Responsable_Text_Group").hide();
                $("#Responsable_Inspeccion_List").val(JSON.parse(responsable_inspeccion));
                if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower()))
                    $('#Responsable_Inspeccion_List').prop('disabled', false);
            }
            else {
                $("#Responsable_List_Group").hide();
                $("#Responsable_Text_Group").show();
                $("#Responsable_Inspeccion_Text").val(responsable_inspeccion);
                if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower()))
                    $('#Responsable_Inspeccion_Text').prop('readonly', false);
            }

            var participante_inspeccion = $("#Participantes_Inspeccion").val();
            if (isJson(participante_inspeccion)) {
                // $("#Participantes_Inspeccion_List_Group").show();
                // $("#Participantes_Inspeccion_Text_Group").hide();
                $("#Participantes_Inspeccion_List").val(JSON.parse(participante_inspeccion));
                if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower()))
                    $('#Participantes_Inspeccion_List').prop('disabled', false);
            }
            else {
                // $("#Participantes_Inspeccion_List_Group").hide();
                // $("#Participantes_Inspeccion_Text_Group").show();
                $("#Participantes_Inspeccion_Text").val(participante_inspeccion);
                console.log(('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower()))
                if (('@Model.Estado' == "Pendiente" && @(ViewBag.Permiso.ToString().ToLower())) || @(ViewBag.PermisosAdmin.ToString().ToLower())|| @(ViewBag.PermisoMASSO.ToString().ToLower()))
                    $('#Participantes_Inspeccion_List').prop('disabled', false);
            }
            $('.selectpicker').selectpicker('refresh');
        });
        $("#Area_Formato").change(function () {
            let newValue = $(this).val();
            $('#Codigo_Formato').val(newValue);
        });
        $("#Tipo_Inspeccion").change(function () {
            if ($(this).val() == "COMITE DE SSO") {
                $("#miembros_comite").css({ 'display': 'block' })
                $('#Id_Miembro_Comite').prop('disabled', false);
            }
            else {
                $("#miembros_comite").css({ 'display': 'none' })
                $("#Id_Miembro_Comite").val('0');
                $('#Id_Miembro_Comite').prop('disabled', true);
            }
        });
        function isJson(str) {
            try {
                JSON.parse(str);
            } catch (e) {
                return false;
            }
            return true;
        }
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        img_url = data.img_url;
                        inspectionStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        $("#guardar_estado").click(function () {
            $("#opcion").val("GuardarEstado");
        });
        $("#nueva_obs").click(function () {
            $("#opcion").val("Observacion");
        });
        $("#eliminar").click(function () {
            if (window.confirm("¿Seguro que desea eliminar esta inspección?")) {
                //disable inputs
                // $('#Codigo_Formato').prop('disabled', false);
                $('#Area_Formato').prop('disabled', false);
                $('#Id_Miembro_Comite').prop('disabled', false);
                $('#Participantes_Inspeccion').prop('disabled', false);

                $('#Id_Gerencia_Ejecutora').prop('disabled', false);
                $('#Id_Empresa_Contratista').prop('disabled', false);
                $('#Id_Gerencia_Inspeccionada').prop('disabled', false);
                $('#Id_Responsable_Lugar').prop('disabled', false);
                $('#Id_Responsable_MA').prop('disabled', false);
                $('#Lugar_Inspeccionado').prop('disabled', false);
                $('#Inspectores').prop('disabled', false);
                $('#Hora_Inspeccion').prop('disabled', false);
                $('#Fecha_Inspeccion').prop('disabled', false);
                $('#Responsable_Inspeccion').prop('disabled', false);
                $('#Participantes_Inspeccion').prop('disabled', false);
                $('#Objetivo').prop('disabled', false);
               $('#Tipo_Inspeccion').prop('disabled', false);
                $("#opcion").val("Eliminar");
                $("#form_nuevaInspeccion").submit();
            }
        });
        function EnviarNuevaFecha() {
            var fecha = $("#nuevaFecha").val();
            var idObservacion = $("#idObserv").val();
            if (fecha != "") {
                $.ajax({
                    async: true,
                    cache: false,
                    type: "POST",
                    url: "@(Url.Action("AmpliarFechaObservacion", "Inspecciones"))",
                    data: {
                        "idCabecera": $("#EncryptedId").val(),
                        "idObservacion": idObservacion,
                        "fecha": fecha
                    },
                    success: function (data) {
                        location.reload()
                    }
                });
            } else {
                alert("Debe seleccionar una fecha");
            }
        }
        function ampliarInspeccion(idObservacion) {
            $("#modal_ampliacion").modal("show");
            $("#idObserv").val(idObservacion);
        }
        function FinalizarRegistro() {
            if (listObservaciones.length > 0) {
                $("#opcion").val("Guardar");
                $("#Modal_Enviando_Correo").modal('show');
                $("#mensajeModalConfig").text("Notificando a Responsables")
                $("#form_nuevaInspeccion").submit();
            }
        }
        function GuardarCambiosAdmin() {
            $("#opcion").val("EditarAdmin");
            $("#Modal_Enviando_Correo").modal('show')
            $("#form_nuevaInspeccion").submit();
        }
        function ConsultarObservaciones() {
            $.ajax({
                type: "POST",
                url: "@(Url.Action("ConsultarObservaciones", "Inspecciones"))",
                data: {
