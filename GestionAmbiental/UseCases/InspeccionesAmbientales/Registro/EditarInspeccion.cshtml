        function GuardarEObservacion() {
            if (ValidarEditarObservacion()) {
                var formData = new FormData();
                var files = document.getElementById("E_Nueva_Evidencia").files;
                for (var i = 0; i != files.length; i++) {
                    formData.append("E_Nueva_Evidencia", files[i]);
                }
                formData.append("E_IdCabecera", $("#E_IdCabecera").val());
                formData.append("E_IdObservacion", $("#E_IdObservacion").val());
                formData.append("E_TipoInspeccion", $("#E_TipoInspeccion").val());
                formData.append("E_AsesorSeguridad", $("#E_AsesorSeguridad:not(:disabled)").val());
                formData.append("E_CondicionIdentificada", $("#E_CondicionIdentificada").val());
                formData.append("E_DescripcionActoCondicion", $("#E_DescripcionActoCondicion").val());
                formData.append("E_TipoCondicion", $("#E_TipoCondicion:not(:disabled)").val());
                formData.append("E_FechaProgramada", $("#E_FechaProgramada").val());
                formData.append("E_NivelRiesgo", $("#E_NivelRiesgo").val());
                formData.append("E_AccionTomada", $("#E_AccionTomada").val());
                formData.append("E_ResponsableMarc", $("#E_ResponsableMarc").val());
                formData.append("E_ResponsableMarc2", $("#E_ResponsableMarc2").val());
                formData.append("E_ResponsableCont", $("#E_ResponsableCont").val());
                formData.append("E_CorreoCont", $("#E_CorreoCont").val());
                formData.append("E_Evidencia", $("#E_Evidencia").val());
                formData.append("E_CambioFechaVencida", $("#E_CambioFechaVencida").val());
                $.ajax({
                    url: "@Url.Action("EditarObservacion", "Inspecciones")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            $('#modalEditarObservacion').modal('toggle');
                            ConsultarObservaciones();
                            ReiniciarModalEditarObs();
                        }
                        else {
                            alert("Ocurrió un error al editar la observación")
                        }
                    }
                });
            }
        }
