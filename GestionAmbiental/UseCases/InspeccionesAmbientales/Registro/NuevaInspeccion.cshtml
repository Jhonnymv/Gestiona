    $("#TipoInspeccion").on('change', function () {
        if ($("#TipoInspeccion").val() == "MAP") {
            //Mostrar asesores
            $(".AsesorMedioAmbiente").show();
            $(".AsesorMedioAmbiente").prop('disabled', false);
            $(".AsesorSeguridad").hide();
            $(".AsesorSeguridad").prop('disabled', true);
            //reiniciar condicion
            $("#CondicionIdentificada").val("");
            //Agregar opciones a nivel de riesgo
            ActualizarNivelRiesgo("MAP");

        } else if ($("#TipoInspeccion").val() == "SSO") {
            //Mostrar asesores seguridad
            $(".AsesorMedioAmbiente").hide();
            $(".AsesorMedioAmbiente").prop('disabled', true);
            $(".AsesorSeguridad").show();
            $(".AsesorSeguridad").prop('disabled', false);
            //reiniciar condicion
            $("#CondicionIdentificada").val("");
            //Agregar opciones a nivel de riesgo
            ActualizarNivelRiesgo("SSO");
        } else {
            $(".OpcMedioAmbiente").hide();
            $(".OpcMedioAmbiente").prop('disabled', true);
            $(".OpcSeguridad").hide();
            $(".OpcSeguridad").prop('disabled', true);
            $(".Vacio_NR").show();
            $(".Vacio_NR").prop('disabled', false);
            //Ocultar asesores
            $(".AsesorVacio").show();
            $(".AsesorVacio").prop('disabled', false);
            $(".AsesorMedioAmbiente").hide();
            $(".AsesorMedioAmbiente").prop('disabled', true);
            $(".AsesorSeguridad").hide();
            $(".AsesorSeguridad").prop('disabled', true);
            //reiniciar condicion
            $("#CondicionIdentificada").val("");
            ActualizarNivelRiesgo("Vacio");
        }
        //reiniciar tipo condicion
        $(".Vacio").show();
        $(".Vacio").prop('disabled', false);
        $(".MA-Acto").hide();
        $(".MA-Condicion").hide();
        $(".MA-Acto").prop('disabled', true);
        $(".MA-Condicion").prop('disabled', true);
        $(".SEG-Acto").hide();
        $(".SEG-Condicion").hide();
        $(".SEG-Acto").prop('disabled', true);
        $(".SEG-Condicion").prop('disabled', true);
    });
    $("#CondicionIdentificada").on('change', function () {
        var selectedOption = $("#CondicionIdentificada option:selected").val();
        var tipoInspeccion = $("#TipoInspeccion").val();
        if (tipoInspeccion == "MAP" && selectedOption == "Acto Subestándar") {
            ReiniciarCondicionesIndentificadas();
            $(".MA-Acto").show();
            $(".MA-Acto").prop('disabled', false);
            CambiarBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "MAP" && selectedOption == "Condición Subestándar") {
            ReiniciarCondicionesIndentificadas();
            $(".MA-Condicion").show();
            $(".MA-Condicion").prop('disabled', false);
            CambiarBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "SSO" && selectedOption == "Acto Subestándar") {
            ReiniciarCondicionesIndentificadas();
            $(".SEG-Acto").show();
            $(".SEG-Acto").prop('disabled', false);
            CambiarBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "SSO" && selectedOption == "Condición Subestándar") {
            ReiniciarCondicionesIndentificadas();
            $(".SEG-Condicion").show();
            $(".SEG-Condicion").prop('disabled', false);
            CambiarBuenasPracticas(false, tipoInspeccion);
        } else if (selectedOption == "Buenas Prácticas") {
            ReiniciarCondicionesIndentificadas();
            $(".Vacio").show();
            CambiarBuenasPracticas(true, tipoInspeccion);
        } else {
            TipoCondicionVacio();
            CambiarBuenasPracticas(false, tipoInspeccion);
        }
    });
    function GuardarObservacion() {
        if (ValidarNuevaObservacion()) {
            var formData = new FormData();
            var files = document.getElementById("Evidencias").files;
            for (var i = 0; i != files.length; i++) {
                formData.append("Evidencias", files[i]);
            }
            formData.append("idCabecera", $("#idCabecera").val());
            formData.append("TipoInspeccion", $("#TipoInspeccion").val());
            formData.append("Asesor_MA_Seguridad", $("#Asesor_MA_Seguridad:not(:disabled)").val());
            formData.append("CondicionIdentificada", $("#CondicionIdentificada").val());
            formData.append("DescripcionActoCondicion", $("#DescripcionActoCondicion").val());
            formData.append("TipoCondicion", $("#TipoCondicion:not(:disabled)").val());
            formData.append("FechaProgramada", $("#FechaProgramada").val());
            formData.append("NiveRiesgo", $("#NiveRiesgo").val());
            formData.append("AccionTomada", $("#AccionTomada").val());
            formData.append("ResponsableMarc", $("#ResponsableMarc").val());
            formData.append("ResponsableCont", $("#ResponsableCont").val());
            formData.append("CorreoCont", $("#CorreoCont").val());
            $.ajax({
                url: "@Url.Action("NuevaObservacion", "Inspecciones")",
                method: "post",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        $('#modalNuevaObservacion').modal('toggle');
                        ConsultarObservaciones();
                        ReiniciarModalObservacion();
                    }
                    else {
                        alert("Ocurrió un error al agregar la observación")
                    }
                }
            });
        }
    }
