    function ValidarEditarObservacion() {
        var result = true;
        ReiniciarMsgsValidacionEditar();
        if ($("#E_TipoInspeccion").val() == "") { result = false; $('span[data-valmsg-for="E_TipoInspeccion"]').text("Debe seleccionar una opción"); }
        if ($("#E_AsesorSeguridad:not(:disabled)").is(":visible") && $("#E_AsesorSeguridad:not(:disabled)").val() == "0") {result = false; $('span[data-valmsg-for="E_AsesorSeguridad"]').text("Debe seleccionar una opción");}
        if ($("#E_CondicionIdentificada").val() == "") { result = false; $('span[data-valmsg-for="E_CondicionIdentificada"]').text("Debe seleccionar una opción"); }
        if ($("#E_DescripcionActoCondicion").val() == "") { result = false; $('span[data-valmsg-for="E_DescripcionActoCondicion"]').text("Debe ingresar una descripción"); }
        if ($("#E_ResponsableMarc").val() == "0") { result = false; $('span[data-valmsg-for="E_ResponsableMarc"]').text("Debe seleccionar una opción"); }
        if ($("#E_ResponsableCont").val() == "") { result = false; $('span[data-valmsg-for="E_ResponsableCont"]').text("Debe completar este campo"); }
        if ($("#E_CondicionIdentificada").val() != "Buenas Prácticas") {
            if ($("#E_TipoCondicion").val() == "") { result = false; $('span[data-valmsg-for="E_TipoCondicion"]').text("Debe seleccionar una opción"); }
            if ($("#E_FechaProgramada").val() == "") { result = false; $('span[data-valmsg-for="E_FechaProgramada"]').text("Debe ingresar una fecha"); }
            if ($("#E_NivelRiesgo").val() == "") { result = false; $('span[data-valmsg-for="E_NivelRiesgo"]').text("Debe seleccionar una opción"); }
            if ($("#E_AccionTomada").val() == "") { result = false; $('span[data-valmsg-for="E_AccionTomada"]').text("Debe completar este campo"); }
        }

        return result;
    }
