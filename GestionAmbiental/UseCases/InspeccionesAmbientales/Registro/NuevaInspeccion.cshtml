            $("#E_NivelRiesgo").css('color', 'black');
            $("#E_AccionTomada").prop('disabled', true);
            $("#E_AccionTomada").val("");
            $("#E_TipoCondicion").val("");
            TipoCondicionVacio();
            $(".Vacio").prop('disabled', true)
        } else {
            $("#E_FechaProgramada").prop('disabled', false);
            $("#E_FechaProgramada").val("");
            $("#E_NivelRiesgo").prop('disabled', false);
            $("#E_NivelRiesgo").css('background-color', '#ffffff');
            $("#E_AccionTomada").prop('disabled', false);
            $("#E_AccionTomada").val("");
            ActualizarENivelRiesgo(tipoInspeccion);
        }
    }
    $("#E_Nueva_Evidencia").change(function () {
        $("#danger_evidencia").html("");
        //Validacion del tamaño del archivo
        var maxSize = $("#E_Nueva_Evidencia").data('max-size');
        if ($("#E_Nueva_Evidencia").get(0).files.length) {
            var fileSize = $("#E_Nueva_Evidencia").get(0).files[0].size; // in bytes
            if (fileSize > maxSize) {
                this.value = '';
                var filesname = this.files.length + " Archivos";
                $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
            }
        }
        //Validacion del tipo de archivo
        var ext = this.value.match(/\.([^\.]+)$/)[1];
        switch (ext) {
            case 'jpg':
            case 'JPG':
            case 'jpeg':
            case 'JPEG':
            case 'png':
            case 'PNG':
            case 'xls':
            case 'xlsx':
            case 'doc':
            case 'docx':
            case 'pdf':
                var filesname = this.files.length + " Archivos";
                $("#files_name").text(filesname);
                break;
            default:
                this.value = '';
                var filesname = this.files.length + " Archivos";
                $("#files_name").text(filesname);
                $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
            //$("#modal_archivo").modal('show');
        }
    });
