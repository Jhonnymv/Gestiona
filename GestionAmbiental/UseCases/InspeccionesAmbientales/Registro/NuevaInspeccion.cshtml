    $("#E_CondicionIdentificada").on('change', function () {
        var selectedOption = $("#E_CondicionIdentificada option:selected").val();
        var tipoInspeccion = $("#E_TipoInspeccion").val();
        if (tipoInspeccion == "MAP" && selectedOption == "Acto Subestándar") {
            ReiniciarCondicionesIndentificadasEditar();
            $(".E_MA-Acto").show();
            $(".E_MA-Acto").prop('disabled', false);
            CambiarEBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "MAP" && selectedOption == "Condición Subestándar") {
            ReiniciarCondicionesIndentificadasEditar();
            $(".E_MA-Condicion").show();
            $(".E_MA-Condicion").prop('disabled', false);
            CambiarEBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "SSO" && selectedOption == "Acto Subestándar") {
            ReiniciarCondicionesIndentificadasEditar();
            $(".E_SEG-Acto").show();
            $(".E_SEG-Acto").prop('disabled', false);
            CambiarEBuenasPracticas(false, tipoInspeccion);
        } else if (tipoInspeccion == "SSO" && selectedOption == "Condición Subestándar") {
            ReiniciarCondicionesIndentificadasEditar();
            $(".E_SEG-Condicion").show();
            $(".E_SEG-Condicion").prop('disabled', false);
            CambiarEBuenasPracticas(false, tipoInspeccion);
        } else if (selectedOption == "Buenas Prácticas") {
            ReiniciarCondicionesIndentificadasEditar();
            $(".E_Vacio").show();
            CambiarEBuenasPracticas(true, tipoInspeccion);
        } else {
            OcultarTiposCondicion();
            CambiarBuenasPracticas(false, tipoInspeccion);
        }
    });
