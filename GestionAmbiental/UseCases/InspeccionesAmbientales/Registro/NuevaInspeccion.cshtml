@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/selectpicker/js/bootstrap-select.js"></script>
    <script src="~/js/stepper.js"></script>
    <script>
    var listObservaciones = [];
    function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        img_url = data.img_url;
                        inspectionStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
    $("#guardar_estado").click(function () {
        $("#opcion").val("GuardarEstado");
        $("#Modal_Enviando_Correo").modal('show');
        $("#mensajeModalConfig").text("Guardando Cambios");
            if (listObservaciones.length > 0) {
                $.ajax({
                    type: "POST",
                    url: "/Inspecciones/EditarInspeccionNoSubmit",
                    data: {
                        "Id_Inspeccion_Cabecera": $("#idCabecera").val(),
                        "opcion": $("#opcion").val(),
                        "Id_Gerencia_Ejecutora": $("#Id_Gerencia_Ejecutora").val(),
                        "Id_Gerencia_Inspeccionada": $("#Id_Gerencia_Inspeccionada").val(),
                        "Id_Empresa_Contratista": $("#Id_Empresa_Contratista").val(),
                        "Fecha_Inspeccion": $("#Fecha_Inspeccion").val(),
                        "Hora_Inspeccion": $("#Hora_Inspeccion").val(),
                        "Lugar_Inspeccionado": $("#Lugar_Inspeccionado").val(),
                        "Tipo_Inspeccion": $("#Tipo_Inspeccion").val(),
                        "Id_Responsable_Lugar": $("#Id_Responsable_Lugar").val(),
                        "Responsable_Inspeccion": $("#Responsable_Inspeccion").val(),
                        "Inspectores": $("#Inspectores").val(),
                        "Objetivo": $("#Objetivo").val(),
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.success) {
                            window.location.href = "/Inspecciones/Resumen";
                        } else {
                            console.log(response.message)
                        }
                    }
                });
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Inspecciones/NuevaInspeccion",
                    data: {
                        "opcion": $("#opcion").val(),
                        "Id_Gerencia_Ejecutora": $("#Id_Gerencia_Ejecutora").val(),
                        "Id_Gerencia_Inspeccionada": $("#Id_Gerencia_Inspeccionada").val(),
                        "Id_Empresa_Contratista": $("#Id_Empresa_Contratista").val(),
                        "Fecha_Inspeccion": $("#Fecha_Inspeccion").val(),
                        "Hora_Inspeccion": $("#Hora_Inspeccion").val(),
                        "Lugar_Inspeccionado": $("#Lugar_Inspeccionado").val(),
                        "Tipo_Inspeccion": $("#Tipo_Inspeccion").val(),
                        "Id_Responsable_Lugar": $("#Id_Responsable_Lugar").val(),
                        "Responsable_Inspeccion": $("#Responsable_Inspeccion").val(),
                        "Inspectores": $("#Inspectores").val(),
                        "Objetivo": $("#Objetivo").val(),
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.success) {
                            window.location.href = "/Inspecciones/Resumen";
                        } else {
                            console.log(response.message)
                        }
                    }
                });
            }
        });
    $("#nueva_obs").click(function () {
            if ($("#EncryptedId").val()== "") {
                $("#opcion").val("Observacion");
                $.ajax({
                    type: "POST",
                    url: "/Inspecciones/NuevaInspeccion",
                    data: {
                        "opcion": $("#opcion").val(),
                        "Id_Gerencia_Ejecutora": $("#Id_Gerencia_Ejecutora").val(),
                        "Id_Gerencia_Inspeccionada": $("#Id_Gerencia_Inspeccionada").val(),
                        "Id_Empresa_Contratista": $("#Id_Empresa_Contratista").val(),
                        "Fecha_Inspeccion": $("#Fecha_Inspeccion").val(),
                        "Hora_Inspeccion": $("#Hora_Inspeccion").val(),
                        "Lugar_Inspeccionado": $("#Lugar_Inspeccionado").val(),
                        "Tipo_Inspeccion": $("#Tipo_Inspeccion").val(),
                        "Id_Responsable_Lugar": $("#Id_Responsable_Lugar").val(),
                        "Responsable_Inspeccion": $("#Responsable_Inspeccion").val(),
                        "Inspectores": $("#Inspectores").val(),
                        "Objetivo": $("#Objetivo").val(),
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.success) {
                            $("#EncryptedId").val(response.idEncriptado);
                            $("#Id_Inspeccion_Cabecera").val(response.idCabecera);
                            $("#idCabecera").val(response.idCabecera);
                            $("#E_IdCabecera").val(response.idCabecera);
                            $("#modalNuevaObservacion").modal('show');
                        } else {
                            console.log(response.message)
                        }
                    }
                });
            } else {
                $("#modalNuevaObservacion").modal('show');
            }
        });
    function FinalizarRegistro() {
        if (listObservaciones.length > 0) {
            $("#opcion").val("Guardar");
            $("#Modal_Enviando_Correo").modal('show')
            $("#mensajeModalConfig").text("Notificando a responsables");
            $('#form_nuevaInspeccion').submit()
        }
    }
    function ConsultarObservaciones() {
            $.ajax({
                type: "POST",
                url: "@(Url.Action("ConsultarObservaciones", "Inspecciones"))",
                data: {
                    "IdCabecera": $("#EncryptedId").val(),
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        $('#tabla_resumen tbody').empty();
                        $('#tabla_resumen tbody').html(response.html);
                        listObservaciones = JSON.parse(response.observaciones);
                        if (listObservaciones.length > 0) {
                            $("#guardar").prop('disabled', false);
                        } else {
                            $("#guardar").prop('disabled', true);
                        }
                        dataModulo();
                    } else {
                        console.log(response.message);
                    }
                }
            });
        }
    $("#Responsable_Inspeccion_List").change(function () {
            var data = $("#Responsable_Inspeccion_List").val();
            $("#Responsable_Inspeccion").val(JSON.stringify(data));
        });
    </script>
    @*Scripts partial Nueva Observación*@
    <script>
    $("#Evidencias").change(function () {
        $("#danger_evidencia").html("");
        //Validacion del tamaño del archivo
        var maxSize = $("#Evidencias").data('max-size');
        if ($("#Evidencias").get(0).files.length) {
            var fileSize = $("#Evidencias").get(0).files[0].size; // in bytes
            if (fileSize > maxSize) {
                this.value = '';
                var filesname = this.files.length + " Archivos";
                $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
            }
        }
        //Validacion del tipo de archivo
        var ext = this.value.match(/\.([^\.]+)$/)[1];
        switch (ext) {
            case 'jpg':
            case 'JPG':
            case 'jpeg':
            case 'JPEG':
            case 'png':
            case 'PNG':
            case 'xls':
            case 'xlsx':
            case 'doc':
            case 'docx':
            case 'pdf':
                var filesname = this.files.length + " Archivos";
                $("#files_name").text(filesname);
                break;
            default:
                this.value = '';
                var filesname = this.files.length + " Archivos";
                $("#files_name").text(filesname);
                $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
            //$("#modal_archivo").modal('show');
        }
    });
    $("#NiveRiesgo").on('change', function () {
        switch ($("#NiveRiesgo").val()) {
            case "Tolerable":
            case "Bajo":
                $("#NiveRiesgo").css("background-color", "green");
                $("#NiveRiesgo").css("color", "white");
                break;
            case "Alerta":
            case "Medio":
                $("#NiveRiesgo").css("background-color", "yellow");
                $("#NiveRiesgo").css("color", "black");
                break;
            case "No Aceptable":
            case "Alto":
                $("#NiveRiesgo").css("background-color", "red");
                $("#NiveRiesgo").css("color", "white");
                break;
            default:
                $("#NiveRiesgo").css("background-color", "white");
                $("#NiveRiesgo").css("color", "black");
                break;
        }
        $("#NiveRiesgo option").css("color", "black")
    });
    function ActualizarNivelRiesgo(TipoInspeccion) {
        if (TipoInspeccion == "MAP") {
            $('#NiveRiesgo').empty().append(new Option("--SELECCIONE--", ""));
            $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
            $("#NiveRiesgo option[value='No Aplica']").css({ "background-color": "white", "color": "black" });
            $('#NiveRiesgo').append(new Option("Tolerable", "Tolerable"));
            $("#NiveRiesgo option[value='Tolerable']").css({ "background-color": "green", "color": "white" });
            $('#NiveRiesgo').append(new Option("Alerta", "Alerta"));
            $("#NiveRiesgo option[value='Alerta']").css({ "background-color": "yellow", "color": "black" });
            $('#NiveRiesgo').append(new Option("No Aceptable", "No Aceptable"));
            $("#NiveRiesgo option[value='No Aceptable']").css({ "background-color": "red", "color": "white" });
        }
        else if (TipoInspeccion == "SSO") {
            $('#NiveRiesgo').empty().append(new Option("--SELECCIONE--", ""));
            $('#NiveRiesgo').append(new Option("No Aplica", "No Aplica"));
            $("#NiveRiesgo option[value='No Aplica']").css({ "background-color": "white", "color": "black" });
            $('#NiveRiesgo').append(new Option("Bajo", "Bajo"));
            $("#NiveRiesgo option[value='Bajo']").css({ "background-color": "green", "color": "white" });
            $('#NiveRiesgo').append(new Option("Medio", "Medio"));
            $("#NiveRiesgo option[value='Medio']").css({ "background-color": "yellow", "color": "black" });
            $('#NiveRiesgo').append(new Option("Alto", "Alto"));
            $("#NiveRiesgo option[value='Alto']").css({ "background-color": "red", "color": "white" });
        }
        else {
            $('#NiveRiesgo').empty().append(new Option("", "--SELECCIONE--"));
        }
    }
    function CambiarBuenasPracticas(habilitar, tipoInspeccion) {
        if (habilitar) {
            $("#FechaProgramada").prop('disabled', true);
            $("#FechaProgramada").val("");
            $("#NiveRiesgo").prop('disabled', true);
            ActualizarNivelRiesgo(tipoInspeccion);
            $("#NiveRiesgo").css('background-color', '#e9ecef');
            $("#NiveRiesgo").css('color', 'black');
            $("#AccionTomada").prop('disabled', true);
            $("#AccionTomada").val("");
            $("#TipoCondicion").val("");
            TipoCondicionVacio();
            $(".Vacio").prop('disabled', true);
        } else {
            $("#FechaProgramada").prop('disabled', false);
            $("#FechaProgramada").val("");
            $("#NiveRiesgo").prop('disabled', false);
