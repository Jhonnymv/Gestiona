        $('span[data-valmsg-for="E_FechaProgramada"]').text("");
        $('span[data-valmsg-for="E_NivelRiesgo"]').text("");
        $('span[data-valmsg-for="E_AccionTomada"]').text("");
        $('span[data-valmsg-for="E_ResponsableMarc"]').text("");
        $('span[data-valmsg-for="E_ResponsableCont"]').text("");
