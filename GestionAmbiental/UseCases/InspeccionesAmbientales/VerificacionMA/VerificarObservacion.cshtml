@model GestionAmbiental.UseCases.InspeccionesAmbientales.VerificacionMA.VerificarObservacionMAModel
@{
    ViewData["Title"] = "VerificarObservacion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Verificar Observación</h2>
        </div>
    </div>
    <form class="form-group" id="form_verificarObservacion" asp-action="VerificarObservacion" asp-controller="InspeccionesVerificacionMA" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="idObservacion" />
        <input type="hidden" asp-for="EncryptedId"/>
        <input type="hidden" asp-for="idCabecera" />
        <div class="modal-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoInspeccion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Asesor_MA_Seguridad"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="Asesor_MA_Seguridad" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="CondicionIdentificada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="CondicionIdentificada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoCondicion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoCondicion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Evidencias"></label>
                </div>
                <div class="col-md-8">
                    @for (int i = 0; i < Model.Evidencias.Count; i++)
                    {
                        <a asp-controller="Inspecciones" asp-action="Download" asp-route-fileName="@Model.Evidencias[i]">Evidencia</a>
                    }
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="NiveRiesgo"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="NiveRiesgo" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="AccionTomada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="AccionTomada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableMarc"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableMarc" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableCont"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableCont" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="FechaProgramada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="FechaProgramada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="EvidenciasInspeccion"></label>
                </div>
                <div class="col-md-8">
                    @for (int i = 0; i < Model.EvidenciasInspeccion.Count; i++)
                    {
                        <a asp-controller="InspeccionesImplementacion" asp-action="Download" asp-route-fileName="@Model.EvidenciasInspeccion[i]">Evidencia </a>
                    }
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ComentarioImplementacion"></label>
                </div>
                <div class="col-md-8">
                    <textarea class="form-control" asp-for="ComentarioImplementacion" rows="3" readonly="readonly"></textarea>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ComentarioVerificacionMA"></label>
                </div>
                <div class="col-md-8">
                    <textarea class="form-control" asp-for="ComentarioVerificacionMA" rows="3"></textarea>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="Accion" />
        <div class="modal-footer">
            <button id="rechazar" type="submit" class="btn btn-secondary">Rechazar</button>
            <button id="aprobar" type="submit" class="btn btn-primary">Aprobar</button>
        </div>
    </form>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Enviando_Correo" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Notificando a Responsables</label>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $("#EvidenciasInspeccion").change(function () {
            var filesname = this.files.length + " Archivos";
            $("#files_name").text(filesname);
        });
        $("#rechazar").click(function () {
            $("#Accion").val("Rechazar");          
            $("#Modal_Enviando_Correo").modal('show');
        });
        $("#aprobar").click(function () {
            $("#Accion").val("Aprobar");
        });
    </script>
}