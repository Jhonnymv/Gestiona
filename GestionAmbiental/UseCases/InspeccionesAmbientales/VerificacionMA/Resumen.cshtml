
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Inspecciones - Pendientes de Verificación</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <label>Fecha de Inspección:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="date" class="form-control" id="fecha_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <label>Área Ejecutora de la Inspección:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select id="gerenciaEjecutora_filtro" asp-items="@ViewBag.Filtro" class="form-control"></select>
        </div>
        <div class="col-lg-1 mt-1">
            <label>Buscar Código:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="text" class="form-control" id="codigo_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar()">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2">
    <div class="col-md">
        <table class="table" id="tabla_resumen_inspecciones">
            <thead class="thead-mcolor">
                <tr>
                    <th>Código</th>
                    <th>Área Ejecutora de la Inspección</th>
                    <th>Empresa Inpeccionada</th>
                    <th>Área Inspeccionada</th>
                    <th>Fecha de Inspección</th>
                    <th>N° Observaciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>
@section scripts{
    <script>
    $(document).ready(function () {
            nObservaciones = 0;

            $('#gerenciaEjecutora_filtro').change(function () {
                filtroGerencia = $(this).children("option:selected").val();
                console.log(filtroGerencia)
            });
            $('#codigo_filtro').bind("keyup change", function () {
                filtroCodigo = $(this).val();
                console.log(filtroCodigo)
            });
            $('#fecha_filtro').change(function () {
                filtroFecha = $(this).val();
                console.log(filtroFecha);
            });
            $("#btn_modalNuevaInspeccion").click(function () {
                guardar()
            });

            filtrar(1);

    });
    function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/InspeccionesVerificacionMA/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp":10,
                    "filtroFecha": $('#fecha_filtro').val(),
                    "filtroGerencia": $('#gerenciaEjecutora_filtro').val(),
                    "filtroCodigo": $('#codigo_filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
    }
    </script>
}