@section Scripts{
    <script>
        var img_url;
        var listObservaciones = @Html.Raw(ViewBag.Observaciones);
        function VerificarObservacion(IdObservacion) {
            var data;
            listObservaciones.forEach(function (obs) {
                if (obs.IdObservacion == IdObservacion)
                    data = obs;
            });
            if (data != null) {
                $("#idObs").val(data.IdObservacion);
                $("#TipoInspeccion").val(data.TipoInspeccion);
                $("#AsesorSeguridad").val(data.Asesor);
                $("#CondicionIdentificada").val(data.DescripcionCondicion);
                $("#TipoCondicion").val(data.TipoCondicion);
                $("#FechaProgramada").val(data.FechaProgramada);
                $("#NivelRiesgo").val(data.NivelRiesgo);
                $("#AccionTomada").val(data.Accion);
                $("#ResponsableMarc").val(data.ResponsableMarc);
                $("#ResponsableCont").val(data.ResponsableCont);
                $("#ComentarioImplementacion").val(data.Comentario);
                $("#Evidencia").val(JSON.parse(data.EvidenciasCondicion)[0]);
                $("#EvidenciaDescarga").prop('href', '@Url.Action("Download","Inspecciones")' + '?fileName=' + JSON.parse(data.EvidenciasCondicion)[0]);
                $("#EvidenciasImplementacion").val(JSON.parse(data.EvidenciasImplementacion)[0]);
                $("#EvidenciaImpDescarga").prop('href', '@Url.Action("Download", "InspeccionesImplementacion")' + '?fileName=' + JSON.parse(data.EvidenciasImplementacion)[0]);
                $("#modalVerificarObservacion").modal('show');
            }
        }
        $("#rechazar").click(function () {
            $("#Accion").val("Rechazar");
            $("#Modal_Enviando_Correo").modal('show');
            $("#form_verificarObservacion").submit();
        });
        $("#aprobar").click(function () {
            $("#Accion").val("Aprobar");
            $("#form_verificarObservacion").submit();
        });
        function DescargarEvidenciaObservacion() {
            console.log($("#Evidencia").val());
            window.open('/Inspecciones/Download?fileName=' + $("#Evidencia").val(), '_blank');
        }       
        function DescargarEvidenciaImplementacion() {
            console.log($("#EvidenciasImplementacion").val());
            window.open('/InspeccionesImplementacion/Download?fileName=' + $("#EvidenciasImplementacion").val(), '_blank');
        }       
    </script>
}