@using  GestionAmbiental.UseCases.InspeccionesAmbientales.VerificacionMA;
@{
    ViewData["Title"] = "VerificarInspeccion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@{
    await Html.RenderPartialAsync("_VerificarObservacion", new VerificarObservacionMAModel());
}
<div class="inspection">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title inspection-opacity-color">
                <h3>Verificar Inspección - @ViewBag.Codigo</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <div class="custom-form details-container w-100">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center">DETALLE DE LA INSPECCIÓN</span>
                    </div>
                    <div class="message"></div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Gerencia Ejecutora de la Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Gerencia" readonly="readonly" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Empresa Inspeccionada</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Empresa" readonly="readonly" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Gerencia Inspeccionada</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.GerenciaInspeccionada" readonly="readonly" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Área Inspeccionada</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.AreaInspeccionada" readonly="readonly" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Tipo de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.TipoInspeccion" readonly="readonly" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Responsable del Área Inspeccionada</label>
                            <input type="text" class="form-control" value="@(ViewBag.Cabecera.ResponsableArea.Nombres+" "+ViewBag.Cabecera.ResponsableArea.Apellidos)" readonly="readonly">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Fecha de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.FechaInspeccion" readonly="readonly">
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Lider de la inspección</label>
                            <textarea class="form-control" value="@ViewBag.Cabecera.ResponsableInspeccion" rows="2" readonly>@ViewBag.Cabecera.ResponsableInspeccion</textarea>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Participantes de la Inspección</label>
                            <textarea class="form-control" value="@ViewBag.Cabecera.Participantes_Inspección_Texto" rows="2" readonly>@ViewBag.Cabecera.Participantes_Inspección_Texto</textarea>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Objetivo de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Objetivo" readonly="readonly">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Otros Participantes, en caso aplique</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Participantes" readonly="readonly">
                        </div>
                        @if (ViewBag.MostrarMiembroComite)
                        {
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label>Nombre del Representante(s) de los Trabajadores que participó en la inspección, en caso aplique:</label>
                                <input type="text" class="form-control" value="@ViewBag.Cabecera.Miembro_Comite" readonly="readonly">
                            </div>
                        }
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center">OBSERVACIONES</span>
                    </div>
                    <div class="inspection">
                        <div class="tertiary-content col-12">
                            <div class="table-responsive inspection-color">
                                <table class="table" id="tabla_resumen">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Tipo de Observación</th>
                                            <th>Asesor de MAP/SSO</th>
                                            <th>Acto/Condición Subestándar Identificada</th>
                                            <th>Descripción del Acto/Condición Subestándar</th>
                                            <th>Tipo de Condición/Acto Subestándar</th>
                                            <th>Evidencia</th>
                                            <th>Nivel de Riesgo</th>
                                            <th>Acción Preventiva / Correctiva Tomada</th>
                                            <th>Responsable Marcobre 1</th>
                                            <th>Responsable Marcobre 2</th>
                                            <th>Responsable Contratista</th>
                                            <th>Correo Contratista</th>
                                            <th>Fecha Programada</th>
                                            <th>Evidencia Implementación</th>
                                            <th>Comentario Implementación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ViewBag.NObservaciones != 0)
                                        {
                                            @Html.Raw(ViewBag.ContenidoTabla)
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="100">No hay observaciones</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row">
                        <div class="button-container">
                            <a id="cancelar" class="btn btn-mc-outline-danger" asp-action="Resumen">Volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade mc-modal" id="Modal_Enviando_Correo" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="normal" font-size="none" text-anchor="middle" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white">Notificando a Responsables</label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Previsualizar Imagen-->
<div class="modal fade" tabindex="-1" id="Modal_Previsualizar_Imagen" aria-labelledby="Modal_Previsualizar_ImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-inspecciones">
            <div class="modal-content">
                <div class="inspection">
                    <div class="image-header-container"
                         style="background-image: url(&quot;/img/back-inspection.png&quot;);">
                        <div class="header-title inspection-opacity-color">
                            <h3>Previsualización</h3><img src="/img/logo-white.png" alt="Logo Marcobre">
                        </div><button type="button" class="btn-close" data-bs-dismiss="modal"
                                      aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="col-12 d-flex justify-content-center" id="imagen_cargada">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        var img_url;
        var listObservaciones = @Html.Raw(ViewBag.Observaciones);
        function VerificarObservacion(IdObservacion) {
            var data;
            listObservaciones.forEach(function (obs) {
                if (obs.IdObservacion == IdObservacion)
                    data = obs;
            });
            if (data != null) {
                $("#idObs").val(data.IdObservacion);
                $("#TipoInspeccion").val(data.TipoInspeccion);
                $("#AsesorSeguridad").val(data.Asesor);
                $("#DescripcionActoCondicion").val(data.DescripcionActoCondicion);
                $("#CondicionIdentificada").val(data.DescripcionCondicion);
                $("#TipoCondicion").val(data.TipoCondicion);
                $("#FechaProgramada").val(data.FechaProgramada);
                $("#NivelRiesgo").val(data.NivelRiesgo);
                $("#AccionTomada").val(data.Accion);
                $("#ResponsableMarc").val(data.ResponsableMarc);
                $("#ResponsableMarc2").val(data.ResponsableMarc2);
                $("#ResponsableCont").val(data.ResponsableCont);
                $("#ComentarioImplementacion").val(data.Comentario);
                $("#Evidencia").val(JSON.parse(data.EvidenciasCondicion)[0]);
                $("#EvidenciaDescarga").prop('href', '@Url.Action("Download","Inspecciones")' + '?fileName=' + JSON.parse(data.EvidenciasCondicion)[0]);
                if (data.EvidenciasImplementacion != "null") {
                    $("#EvidenciasImplementacion").val(JSON.parse(data.EvidenciasImplementacion)[0]);
                    $("#EvidenciaImpDescarga").prop('href', '@Url.Action("Download", "InspeccionesImplementacion")' + '?fileName=' + JSON.parse(data.EvidenciasImplementacion)[0]);
                    $("#EvidenciaImpDescarga").show();
                } else {
                    $("#EvidenciaImpDescarga").hide();
                }
                $("#modalVerificarObservacion").modal('show');
            }
        }
        $("#rechazar").click(function () {
            $("#Accion").val("Rechazar");
            $("#Modal_Enviando_Correo").modal('show');
            $("#form_verificarObservacion").submit();
        });
        $("#aprobar").click(function () {
            $("#Accion").val("Aprobar");
            $("#form_verificarObservacion").submit();
        });
        function DescargarEvidenciaObservacion() {
            console.log($("#Evidencia").val());
            window.open('/Inspecciones/Download?fileName=' + $("#Evidencia").val(), '_blank');
        }
        function DescargarEvidenciaImplementacion() {
            console.log($("#EvidenciasImplementacion").val());
            window.open('/InspeccionesImplementacion/Download?fileName=' + $("#EvidenciasImplementacion").val(), '_blank');
        }
        function PrevisualizarImagen(imagen,tipo){
            if(imagen!=null){
                var moduloConsulta = '';
                if(tipo=='reg'){
                    moduloConsulta = 'Inspecciones';
                }else{
                    moduloConsulta = 'InspeccionesImplementacion';
                }

                $.ajax({
                type: 'POST',
                url: '/'+moduloConsulta+'/ObtenerImageneCargada',
                data:
                {
                    imagen: imagen
                },
                success: function (response) {
                    var fuente = JSON.parse(response.imagenes);

                    var html_imagen = "";
                        html_imagen += "<div class=\"col-lg-6 col-md-6 col-6 mt-2\" id=\""+fuente.Nombre+"\">";
                        html_imagen += "<div class=\"card\" style=\"width:100%;\">";
                        if(fuente.EsImagen){
                        html_imagen += "<img style=\"width:100%; height:auto;\" class=\"card-img-top img-thumbnail\" src=\"";
                        html_imagen += fuente.Src;
                        html_imagen += "\">";
                        }
                        html_imagen += "<div class=\"card-body text-center\">";
                        html_imagen += fuente.Nombre;
                        html_imagen += "</div>";
                        html_imagen += "<div class=\"card-body text-center\">";
                        html_imagen += "<a class=\"btn btn-mc\" href=\"/"+moduloConsulta+"/Download?fileName=" + fuente.NombreCarga + "\"><span>Descargar</span></a></p>";
                        html_imagen += "</div>";
                        html_imagen += "</div>";
                        html_imagen += "</div>";
                    $("#imagen_cargada").html(html_imagen);

                $("#Modal_Previsualizar_Imagen").modal('show');
                },
                error: function () {
                    console.log("No se ha podido obtener la información");
                }
            });
            }
        }
    </script>
}