@using  GestionAmbiental.UseCases.InspeccionesAmbientales.VerificacionMA;
@{
    ViewData["Title"] = "VerificarInspeccion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@{
    Html.RenderPartial("_VerificarObservacion", new VerificarObservacionMAModel());
}
<div class="inspection">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title inspection-opacity-color">
                <h3>Verificar Inspección - @ViewBag.Codigo</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <div class="custom-form details-container w-100">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="message"></div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Área Ejecutora de la Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Gerencia" readonly="readonly" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Empresa Inspeccionada</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Empresa" readonly="readonly" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Área Inspeccionada</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.AreaInspeccionada" readonly="readonly" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Tipo de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.TipoInspeccion" readonly="readonly" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Responsable del Área Inspeccionada</label>
                            <input type="text" class="form-control" value="@(ViewBag.Cabecera.ResponsableArea.Nombres+" "+ViewBag.Cabecera.ResponsableArea.Apellidos)" readonly="readonly">
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Fecha de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.FechaInspeccion" readonly="readonly">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Responsable de la Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.ResponsableInspeccion" readonly="readonly">
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Participantes de la Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Participantes" readonly="readonly">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label>Objetivo de Inspección</label>
                            <input type="text" class="form-control" value="@ViewBag.Cabecera.Objetivo" readonly="readonly">
                        </div>
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center">Observaciones</span>
                    </div>
                    <div class="inspection">
                        <div class="tertiary-content col-12">
                            <div class="table-responsive inspection-color">
                                <table class="table" id="tabla_resumen">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Tipo de Observación</th>
                                            <th>Asesor de MAP/SSO</th>
                                            <th>Acto/Condición Subestándar Identificada</th>
                                            <th>Tipo de Condición/Acto Subestándar</th>
                                            <th>Evidencia</th>
                                            <th>Nivel de Riesgo</th>
                                            <th>Acción Preventiva / Correctiva Tomada</th>
                                            <th>Responsable Marcobre</th>
                                            <th>Responsable Contratista</th>
                                            <th>Fecha Programada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ViewBag.NObservaciones != 0)
                                        {
                                            @Html.Raw(ViewBag.ContenidoTabla)
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="100%">No hay observaciones</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row">
                        <div class="button-container">
                            <a id="cancelar" type="button" class="btn btn-mc-outline-danger" asp-action="Resumen">Volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
