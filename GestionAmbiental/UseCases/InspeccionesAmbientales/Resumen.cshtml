<!-- Modal Adjuntar Archivo-->
<div class="modal fade" id="modal_adjuntar" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_adjuntar"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_adjuntar">
                    Adjuntar Foto
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label>Evidencia:</label>
                    </div>
                    <div class="col-8">
                        <label class="btn btn-primary" for="files">Seleccione</label>
                        <input type="file" id="files" style="visibility:hidden" multiple>
                        <label id="files_name">0 Archivos</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal">Adjuntar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">

        $(document).ready(function () {

            $('#gerenciaEjecutora_filtro').change(function () {
                filtroGerencia = $(this).children("option:selected").val();
                console.log(filtroGerencia)
            });
            $('#codigo_filtro').bind("keyup change", function () {
                filtroCodigo = $(this).val();
                console.log(filtroCodigo)
            });
            $('#fecha_filtro').change(function () {
                filtroFecha = $(this).val();
                console.log(filtroFecha);
            });
            $("#btn_modalNuevaInspeccion").click(function () {
                guardar()
            });

            filtrar();

        });
        function filtrar() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/GetTablaResumenFiltrada",
                data: {
                    "filtroFecha": $('#fecha_filtro').val(),
                    "filtroGerencia": $('#gerenciaEjecutora_filtro').val(),
                    "filtroCodigo": $('#codigo_filtro').val()
                },
                traditional: true,
                success: (response) => {
                    console.log("Success" + response.data);
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    /*$('#paginado').html(response.paginador)
                    $('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
        function guardar() {
            var formNuevaInspeccion = $("#form_nuevaInspeccion");
            $.ajax({
                type: "POST",
                traditional: true,
                url: "/Inspecciones/NuevaInspeccion",
                data: {
                    "data": formNuevaInspeccion.serialize(),
                },
                success: (response) => {
                    console.log("Recibido")
                }
            });
        }
    </script>
}
