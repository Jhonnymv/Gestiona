@model  GestionAmbiental.UseCases.InspeccionesAmbientales.NuevaInspeccionModel

@{
    ViewData["Title"] = "Resumen Inspecciones";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Inspecciones - Resumen</h2>
    </div>
</div>
<form>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <label>Fecha de Inspección:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="date" class="form-control" id="fecha_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <label>Gerencia Ejecutora:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select id="gerenciaEjecutora_filtro" asp-items="@ViewBag.Filtro" class="form-control"></select>
        </div>
        <div class="col-lg-1 mt-1">
            <label>Buscar Código:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="text" class="form-control" id="codigo_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar()">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-end">
    <div class="col-lg-2 mt-1">
        <button type="button" class="btn btn-primary float-right" data-toggle="modal"
                data-target="#modal_nuevaInspeccion">
            Nueva Inspección
        </button>
    </div>
</div>
<div class="row mb-2">
    <div class="col-md">
        <table class="table" id="tabla_resumen_inspecciones">
            <thead class="thead-mcolor">
                <tr>
                    <th></th>
                    <th>Código</th>
                    <th>Gerencia Ejecutora Macobre</th>
                    <th>Empresa Contratista Marcobre</th>
                    <th>Gerencia Ejecutora EPCM</th>
                    <th>Empresa Contratista EPCM</th>
                    <th>Lugar Inspeccionado</th>
                    <th>Fecha de Inspección</th>
                    <th>N° Observaciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
