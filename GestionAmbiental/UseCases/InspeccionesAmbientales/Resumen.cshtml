
@{
    ViewData["Title"] = "Resumen Inspecciones";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Inspecciones - Resumen</h2>
    </div>
</div>
<form>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <label>Fecha de Inspección:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="date" class="form-control" id="fecha_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <label>Gerencia Ejecutora:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select id="gerenciaEjecutora_filtro" asp-items="@ViewBag.Filtro" class="form-control"></select>
        </div>
        <div class="col-lg-1 mt-1">
            <label>Buscar Código:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="text" class="form-control" id="codigo_filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar()">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-end">
    <div class="col-lg-2 mt-1">
        <button type="button" class="btn btn-primary float-right" data-toggle="modal"
                data-target="#modal_nuevaInspeccion">
            Nueva Inspección
        </button>
    </div>
</div>
<div class="row mb-2">
    <div class="col-md">
        <table class="table" id="tabla_resumen_inspecciones">
            <thead class="thead-mcolor">
                <tr>
                    <th></th>
                    <th>Código</th>
                    <th>Gerencia Ejecutora Macobre</th>
                    <th>Empresa Contratista Marcobre</th>
                    <th>Gerencia Ejecutora EPCM</th>
                    <th>Empresa Contratista EPCM</th>
                    <th>Lugar Inspeccionado</th>
                    <th>Fecha de Inspección</th>
                    <th>N° Observaciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nueva Inspección-->
<div class="modal fade" id="modal_nuevaInspeccion" tabindex="-1" role="dialog"
     aria-labelledby="titulo_modal_nuevaInspeccion" aria-hidden="true" style="display: none;">


    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <form class="form-group" id="form_nuevaInspeccion">
                <div class="modal-header">
                    <h5 class="modal-title" id="titulo_modal_nuevaInspeccion">
                        Nueva Inspección
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Área:</label>
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" value="Medio ambiente y permisos" name="area" disabled>
                        </div>
                        <div class="col-md-3">
                            <label>Objetivo de la Inspección:</label>
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" name="objetivo">
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Gerencia Ejecutora Marcobre:</label>
                        </div>

                        <div class="col-md-3">
                            <select class="form-control" id="select_gerenciaEjecutora" name="gerenciaEjec" asp-items="@ViewBag.GerenciaMC"></select>
                        </div>
                        <div class="col-md-3">
                            <label>Empresa Contratista Marcobre:</label>
                        </div>
                        <div class="col-md-3">
                            <select class="form-control" id="select_empresaContratista" name="empresaMarc" asp-items="@ViewBag.EmpresasMC">
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Gerencia EPCM:</label>
                        </div>

                        <div class="col-md-3">
                            <select class="form-control" id="select_gerenciaEPCM" name="gerenciaEPCM" asp-items="@ViewBag.GerenciaEPCM">
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Empresa Contratista EPCM:</label>
                        </div>
                        <div class="col-md-3">
                            <select class="form-control" id="select_empresaContratistaEPCM" name="empresaEPCM" asp-items="@ViewBag.EmpresasEPCM">
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Lugar Inspeccionado:</label>
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" name="lugar" id="input_lugarInspeccionado">
                        </div>
                        <div class="col-md-1">Fecha:</div>
                        <div class="col-md-2"><input type="date" class="form-control" id="input_fechaInspeccion" name="fechaInspeccion"></div>
                        <div class="col-md-1">Hora:</div>
                        <div class="col-md-2"><input type="time" class="form-control" id="input_horaInspeccion" name="horaInspeccion"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Responsable Lugar Inspeccionado:</label>
                        </div>
                        <div class="col-md-3">
                            <select class="form-control" id="select_responsableLugar" name="responsableLugar">
                                <option value="0">-- Seleccione --</option>
                                <option value="1">Nombres y Apellidos</option>
                                <option value="2">Nombres y Apellidos</option>
                                <option value="3">Nombres y Apellidos</option>
                                <option value="4">Nombres y Apellidos</option>
                                <option value="5">Nombres y Apellidos</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Responsable Medio Ambiente:</label>
                        </div>
                        <div class="col-md-3">
                            <select class="form-control" id="select_responsableMA" name="responsableMA">
                                <option value="0">-- Seleccione --</option>
                                <option value="1">Nombres y Apellidos</option>
                                <option value="2">Nombres y Apellidos</option>
                                <option value="3">Nombres y Apellidos</option>
                                <option value="4">Nombres y Apellidos</option>
                                <option value="5">Nombres y Apellidos</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-3">
                            <label>Inspector(es):</label>
                        </div>
                        <div class="col-md-9">
                            <input type="text" class="form-control" value="Nombres y Apellidos, Nombres y Apellidos, ..." name="inspectores">
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <table class="table table-modal" id="tabla_modal_inspecciones">
                                <thead class="thead-mcolor">
                                    <tr>
                                        <th>Acto/Condición Subestándar Identificada</th>
                                        <th>Tipo de Condición/Acto Subestándar</th>
                                        <th>Evidencia</th>
                                        <th>Nivel de Riesgo del Aspecto Ambiental</th>
                                        <th>Acción Preventiva / Correctiva Tomada</th>
                                        <th>Responsable Marcobre</th>
                                        <th>Responsable Contratista</th>
                                        <th>Fecha Programada</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <input type="text" class="form-control modal-table-input" id="input_condicionIdentificada_1" name="condicionIdentificada_1">
                                        </td>
                                        <td>
                                            <select class="form-control" id="select_tipoCondicion_1" asp-items="@ViewBag.TiposCondicion" name="tipoCondicion_1">
                                            </select>
                                        </td>
                                        <!--
                                        <td><button type="button" class="btn btn-primary"
                                            data-toggle="modal" data-target="#modal_adjuntar">Adjuntar</button></td>-->
                                        <td>
                                            <input type="hidden" id="input_evidencia_1" name="evidencia_1" />
                                            <div class="modal-table-icon" data-toggle="modal" data-target="#modal_adjuntar">
                                                <img src="~/img/icons/attach-icon.png">
                                            </div>
                                        </td>

                                        <td>
                                            <select class="form-control modal-table-input" id="select_nivelRiesgo_1" name="riesgo_1">
                                                <option value="No Aplica">-- Seleccione --</option>
                                                <option value="Tolerable">Tolerable</option>
                                                <option value="Alerta">Alerta</option>
                                                <option value="No Aceptable">No Aceptable</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control modal-table-input" id="input_accionTomada_1" name="accionTomada_1">
                                        </td>
                                        <td>
                                            <select class="form-control modal-table-input" id="select_responsable_1" name="responsableMarc_1">
                                                <option>-- Seleccione --</option>
                                                <option>Nombres y Apellidos</option>
                                                <option>Nombres y Apellidos</option>
                                                <option>Nombres y Apellidos</option>
                                                <option>Nombres y Apellidos</option>
                                                <option>Nombres y Apellidos</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control modal-table-input" id="input_responsableContratista_1" name="responsableContr_1">
                                        </td>
                                        <td>
                                            <input type="date" class="form-control modal-table-input" id="input_fechaProgramada_1" name="fechaProgramada_1">
                                        </td>
                                        <td>
                                            <div class="modal-table-icon" id="button_Guardar_1"><img src="~/img/icons/add-icon.png"></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btn_modalNuevaInspeccion" onclick="guardar()">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Adjuntar Archivo-->
<div class="modal fade" id="modal_adjuntar" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_adjuntar"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_adjuntar">
                    Adjuntar Foto
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label>Evidencia:</label>
                    </div>
                    <div class="col-8">
                        <label class="btn btn-primary" for="files">Seleccione</label>
                        <input type="file" id="files" style="visibility:hidden" multiple>
                        <label id="files_name">0 Archivos</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal">Adjuntar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript">

        $(document).ready(function () {

            $('#gerenciaEjecutora_filtro').change(function () {
                filtroGerencia = $(this).children("option:selected").val();
                console.log(filtroGerencia)
            });
            $('#codigo_filtro').bind("keyup change", function () {
                filtroCodigo = $(this).val();
                console.log(filtroCodigo)
            });
            $('#fecha_filtro').change(function () {
                filtroFecha = $(this).val();
                console.log(filtroFecha);
            });
            $("#btn_modalNuevaInspeccion").click(function () {
                guardar()
            });

            filtrar();

        });
        function filtrar() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/GetTablaResumenFiltrada",
                data: {
                    "filtroFecha": $('#fecha_filtro').val(),
                    "filtroGerencia": $('#gerenciaEjecutora_filtro').val(),
                    "filtroCodigo": $('#codigo_filtro').val()
                },
                traditional: true,
                success: (response) => {
                    console.log("Success" + response.data);
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    /*$('#paginado').html(response.paginador)
                    $('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
        function guardar() {
            var formNuevaInspeccion = $("#form_nuevaInspeccion");
            $.ajax({
                type: "POST",
                traditional: true,
                url: "/Inspecciones/NuevaInspeccion",
                data: {
                    "data": formNuevaInspeccion.serialize(),
                },
                success: (response) => {
                    console.log("Recibido")
                }
            });
        }
    </script>
}
