<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Enviando_Correo" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Notificando a Responsables</label>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $("#EvidenciasInspeccion").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#EvidenciasInspeccion").data('max-size');
            if ($("#EvidenciasInspeccion").get(0).files.length) {
                var fileSize = $("#EvidenciasInspeccion").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
                case 'PNG':
                case 'xls':
                case 'xlsx':
                case 'doc':
                case 'docx':
                case 'pdf':
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    break;
                default:
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
                //$("#modal_archivo").modal('show');
            }
        });
        function guardar() {
            if ($("#EvidenciasInspeccion").get(0).files.length === 0) {
                $("#danger_evidencia").html("Debe ingresar un archivo como evidencia<br/>");
                return false;
            }
            $("#form_implementaObservacion").submit();            
            $("#Modal_Enviando_Correo").modal('show');
            return true;
        }
    </script>
}