@model GestionAmbiental.UseCases.InspeccionesAmbientales.Implementacion.LevantarObservacionModel

    <div class="modal fade" tabindex="-1" id="modalImplementarObservacion" aria-labelledby="modalImplementarObservacion" aria-hidden="true">
