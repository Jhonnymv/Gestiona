                            </div><button type="button" class="btn-close" data-bs-dismiss="modal"
                                          aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <form id="form_implementarObservacion" asp-action="ImplementarObservacion" asp-controller="InspeccionesImplementacion" method="post" enctype="multipart/form-data" autocomplete="off">
                            <div class="container pt-4 pb-4">
                                <div class="custom-form details-container w-100">
                                    <input type="hidden" asp-for="idCabecera" value="@ViewBag.idCabecera" />
                                    <input type="hidden" asp-for="idObservacion" />
                                    <div class="message"></div>
                                    <div class="row input_container w-100">
                                        <div class="col-12 col-sm-6 col-lg-6">
                                            <label asp-for="TipoInspeccion"></label>
                                            <span class="text-danger" asp-validation-for="TipoInspeccion"></span>
                                            <input type="text" class="form-control" asp-for="TipoInspeccion" readonly />
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6">
                                            <label asp-for="AsesorSeguridad">Asesor:</label>
                                            <input type="text" class="form-control" asp-for="AsesorSeguridad" readonly />
                                        </div>
                                    </div>
                                    <div class="row input_container w-100">
                                        <div class="col-12 col-sm-6 col-lg-6">
                                            <label asp-for="CondicionIdentificada"></label>
                                            <input type="text" class="form-control" asp-for="CondicionIdentificada" readonly />
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6">
                                            <label asp-for="TipoCondicion"></label>
                                            <input type="text" class="form-control" asp-for="TipoCondicion" readonly />
                                        </div>
                                    </div>
                                    <div class="row input_container w-100">
                                        <div class="col-12 col-sm-6 col-lg-6">
                                            <label asp-for="FechaProgramada"></label>
                                            <input type="date" class="form-control" asp-for="FechaProgramada" readonly />
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="NivelRiesgo"></label>
                                            <input type="text" class="form-control" asp-for="NivelRiesgo" readonly />
                                        </div>
                                    </div>
                                    <div class="row input_container w-100">
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="AccionTomada"></label>
                                            <input type="text" class="form-control" asp-for="AccionTomada" readonly />
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="ResponsableMarc"></label>
                                            <input type="text" class="form-control" asp-for="ResponsableMarc" readonly />
                                        </div>
                                    </div>
                                    <div class="row input_container w-100 align-items-start">
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="ResponsableCont"></label>
                                            <input type="text" class="form-control" asp-for="ResponsableCont" readonly />
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="Evidencia"></label>
                                            @*<input type="hidden" asp-for="Evidencia" value="@Model.Evidencia[0]" />*@
                                            @*<a asp-action="Download" asp-controller="Inspecciones" asp-route-fileName="@Model.Evidencia[0]">Evidencia</a>*@
                                            <input type="hidden" asp-for="Evidencia" />
                                            <button type="button" class="btn btn-mc form-control" id="EvidenciaDescarga" onclick="DescargarEvidenciaObservacion()">Descargar</button>
                                        </div>
                                    </div>
                                    <div class="row input_container w-100 align-items-start">
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="EvidenciasInspeccion"></label>
                                            <span class="text-danger field-validation-error" data-valmsg-for="EvidenciasInspeccion" data-valmsg-replace="true">
                                                <span id="danger_evidencia" class=""></span>
                                            </span>
                                            <input type="file" asp-for="EvidenciasInspeccion" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                        </div>
                                        <div class="col-12 col-sm-6 col-lg-6 ">
                                            <label asp-for="Comentario"></label><span class="text-danger" asp-validation-for="Comentario"></span>
                                            <textarea class="form-control" asp-for="Comentario" rows="3"></textarea>
                                        </div>
                                    </div>
                                    <div class="row input_container w-100">
                                        <div class="button-container">
                                            <div></div>
                                            <div>
                                                <button class="btn btn-mc m-2" data-bs-dismiss="modal" aria-label="Close">Cerrar</button>
                                                <button type="button" class="btn btn-mc" onclick="guardar()">Implementar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
