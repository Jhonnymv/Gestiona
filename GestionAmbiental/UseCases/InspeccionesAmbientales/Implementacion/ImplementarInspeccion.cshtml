
@{
    ViewData["Title"] = "ImplementarInspeccion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Implementar Inspección</h2>
        </div>
    </div>
    <form class="form-group" id="form_nuevaInspeccion" asp-action="ImplementarInspeccion" asp-controller="InspeccionesImplementacion" method="post" enctype="multipart/form-data" autocomplete="off">
        <div class="row mb-2">
            <div class="col-md-3">
                <label>Área Ejecutora:</label>
            </div>

            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.GerenEjecMar" readonly="readonly" />
            </div>
            <div class="col-md-3">
                <label>Empresa:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.EmpContratMarc" readonly="readonly" />
            </div>
        </div>
        
        <div class="row mb-2">
            <div class="col-md-3">
                <label>Área Inspeccionada:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.LugarInspec" readonly="readonly" />
            </div>
            <div class="col-md-3">
                <label>Tipo de Inspección:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.Tipo_Inspeccion" readonly="readonly" />
            </div>            
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <label>Responsable del Área Inspeccionada:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@(ViewBag.Cabecera.Responsable_Lugar.Nombres+" "+ViewBag.Cabecera.Responsable_Lugar.Apellidos)" readonly="readonly">
            </div>
            <div class="col-md-3">
                <label>Fecha de Inspección:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.FechaInspec" readonly="readonly">
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <label>Responsable de la Inspección:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.Responsable_Inspeccion" readonly="readonly">
            </div>
            <div class="col-md-3">
                <label>Participantes de la Inspección:</label>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.Inspectores" readonly="readonly">
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-3">
                <label>Objetivo de Inspección:</label>
            </div>
            <div class="col-md-9">
                <input type="text" class="form-control" value="@ViewBag.Cabecera.Objetivo" readonly="readonly">
            </div>
        </div>
        @if (ViewBag.NObservaciones != 0)
        {
            <div class="row mb-2" id="div_tabla_observaciones">
                <div class="col-md-12">
                    <table class="table table-modal" id="tabla_observaciones">
                        <thead class="thead-mcolor">
                            <tr>
                                <th>Tipo de Observación</th>
                                <th>Asesor de Seguridad / Medio Ambiente</th>
                                <th>Acto/Condición Subestándar Identificada</th>
                                <th>Tipo de Condición/Acto Subestándar</th>
                                <th>Evidencia</th>
                                <th>Nivel de Riesgo del Aspecto Ambiental</th>
                                <th>Acción Preventiva / Correctiva Tomada</th>
                                <th>Responsable Marcobre</th>
                                <th>Responsable Contratista</th>
                                <th>Fecha Programada</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @Html.Raw(ViewBag.ContenidoTabla)
                        </tbody>
                    </table>
                </div>
            </div>
        }

    <div class="buttons d-flex justify-content-end">
        <a id="descargar" type="button" class="btn btn-danger mr-2" style="color:white;" asp-controller="DescargaInspeccion" asp-action="DescargaInspeccion" asp-route-IdCabecera="@ViewBag.Cabecera.IdCabecera">Descargar en Excel</a>
        <a id="volver" type="button" class="btn btn-secondary" style="color:white;" asp-action="Resumen">Volver</a>
    </div>
    </form>
</div>