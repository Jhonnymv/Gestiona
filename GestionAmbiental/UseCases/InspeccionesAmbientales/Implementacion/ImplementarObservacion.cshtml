@model GestionAmbiental.UseCases.InspeccionesAmbientales.Implementacion.LevantarObservacionModel
@{
    ViewData["Title"] = "ImplementarObservacion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Implementar Observación</h2>
        </div>
    </div>
    <form class="form-group" id="form_nuevaInspeccion" asp-action="ImplementarObservacion" asp-controller="InspeccionesImplementacion" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="idObservacion"/>
        <input type="hidden" asp-for="idCabecera"/>
        <div class="modal-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoInspeccion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Asesor_MA_Seguridad"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="Asesor_MA_Seguridad" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="CondicionIdentificada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="CondicionIdentificada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoCondicion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoCondicion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Evidencias"></label>
                </div>
                <div class="col-md-8">
                    @for (int i = 0; i < Model.Evidencias.Count; i++)
                    {
                        if (i == 0)
                        {
                            <a asp-controller="InspeccionesVerificacionMA" asp-action="Download" asp-route-path="@Model.Evidencias[i]">Evidencia @(i + 1)</a>
                        }
                        else
                        {
                            <a asp-controller="InspeccionesVerificacionMA" asp-action="Download" asp-route-path="@Model.Evidencias[i]">, Evidencia @(i + 1)</a>
                        }
                    }
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="NiveRiesgo"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="NiveRiesgo" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="AccionTomada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="AccionTomada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableMarc"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableMarc" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableCont"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableCont" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="FechaProgramada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="FechaProgramada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="EvidenciasInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <label class="btn btn-primary" for="EvidenciasInspeccion">Seleccione</label>
                    <input type="file" style="visibility:hidden; display:none" asp-for="EvidenciasInspeccion">
                    <label id="files_name">0 Archivos</label>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Comentario"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="Comentario"></span>
                    <textarea class="form-control" asp-for="Comentario" rows="3"></textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <a class="btn btn-secondary" style="color:white" asp-controller="InspeccionesImplementacion" asp-action="ImplementarInspeccion" asp-route-IdCabecera="@Model.idCabecera" data-dismiss="modal">Cancelar</a>
            <button type="submit" class="btn btn-primary">Implementar</button>
        </div>
    </form>
</div>
@section scripts{
    <script>
        $("#EvidenciasInspeccion").change(function () {
            var filesname = this.files.length + " Archivos";
            $("#files_name").text(filesname);
        });
    </script>
}