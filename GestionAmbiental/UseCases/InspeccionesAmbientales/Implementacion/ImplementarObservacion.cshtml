@model GestionAmbiental.UseCases.InspeccionesAmbientales.Implementacion.LevantarObservacionModel
@{
    ViewData["Title"] = "ImplementarObservacion";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Implementar Observación</h2>
        </div>
    </div>
    <form class="form-group" id="form_implementaObservacion" asp-action="ImplementarObservacion" asp-controller="InspeccionesImplementacion" method="post" enctype="multipart/form-data" autocomplete="off">
        <input type="hidden" asp-for="idObservacion" value="@Model.idObservacion" />
        <input type="hidden" asp-for="EncryptedId"/>
        <input type="hidden" asp-for="idCabecera" />
        <div class="modal-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoInspeccion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Asesor_MA_Seguridad"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="Asesor_MA_Seguridad" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="CondicionIdentificada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="CondicionIdentificada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="TipoCondicion"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="TipoCondicion" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Evidencias"></label>
                </div>
                <div class="col-md-8">
                    @for (int i = 0; i < Model.Evidencias.Count; i++)
                    {
                        <a asp-controller="Inspecciones" asp-action="Download" asp-route-fileName="@Model.Evidencias[i]">Evidencia</a>
                        
                    }
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="NiveRiesgo"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="NiveRiesgo" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="AccionTomada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="AccionTomada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableMarc"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableMarc" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="ResponsableCont"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="ResponsableCont" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="FechaProgramada"></label>
                </div>
                <div class="col-md-8">
                    <input type="text" class="form-control" asp-for="FechaProgramada" readonly="readonly" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="EvidenciasInspeccion"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger field-validation-error" data-valmsg-for="Evidencias" data-valmsg-replace="true">
                        <span id="danger_evidencia" class=""></span>
                    </span>
                    <label class="btn btn-primary" for="EvidenciasInspeccion">Seleccione</label>
                    <input type="file" style="visibility:hidden; display:none" asp-for="EvidenciasInspeccion" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520">
                    <label id="files_name">0 Archivos</label>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Comentario"></label>
                </div>
                <div class="col-md-8">
                    <span class="text-danger" asp-validation-for="Comentario"></span>
                    <textarea class="form-control" asp-for="Comentario" rows="3"></textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <a class="btn btn-secondary" style="color:white" asp-controller="InspeccionesImplementacion" asp-action="ImplementarInspeccion" asp-route-IdCabecera="@ViewBag.IdCabecera" data-dismiss="modal">Cancelar</a>
            <button type="button" class="btn btn-primary" onclick="guardar()">Implementar</button>
        </div>
    </form>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Enviando_Correo" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Notificando a Responsables</label>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $("#EvidenciasInspeccion").change(function () {
            $("#danger_evidencia").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#EvidenciasInspeccion").data('max-size');
            if ($("#EvidenciasInspeccion").get(0).files.length) {
                var fileSize = $("#EvidenciasInspeccion").get(0).files[0].size; // in bytes
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_evidencia").html("El  archivo supera el límite permitido de 8MB<br/>");
                }
            }
            //Validacion del tipo de archivo
            var ext = this.value.match(/\.([^\.]+)$/)[1];
            switch (ext) {
                case 'jpg':
                case 'JPG':
                case 'jpeg':
                case 'JPEG':
                case 'png':
                case 'PNG':
                case 'xls':
                case 'xlsx':
                case 'doc':
                case 'docx':
                case 'pdf':
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    break;
                default:
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#files_name").text(filesname);
                    $("#danger_evidencia").html("No se admiten este tipo de archivos<br/>");
                //$("#modal_archivo").modal('show');
            }
        });
        function guardar() {
            if ($("#EvidenciasInspeccion").get(0).files.length === 0) {
                $("#danger_evidencia").html("Debe ingresar un archivo como evidencia<br/>");
                return false;
            }
            $("#form_implementaObservacion").submit();            
            $("#Modal_Enviando_Correo").modal('show');
            return true;
        }
    </script>
}