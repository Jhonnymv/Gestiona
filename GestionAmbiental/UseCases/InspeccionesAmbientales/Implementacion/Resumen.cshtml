@section scripts{
    <script>
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/Inspecciones/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    console.log(response);
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/InspeccionesImplementacion/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtroFecha": $('#fecha_filtro').val(),
                    "filtroEmpresa": $('#empresaInspec_filtro').val(),
                    "filtroUsuario": $("#registrado_por_filtro").val(),
                    "filtroCodigo": $('#codigo_filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    inspectionStyle(r, g, b);
                }
            });
        }
        function abrir(id) {
            $.ajax({
                type: "POST",
                url: "/InspeccionesImplementacion/ImplementarInspeccion",
                data: {
                    "IdCabecera": id
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
    </script>
}