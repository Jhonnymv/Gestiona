
@{
    ViewData["Title"] = "Pendientes de Implementación";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Inspecciones - Pendientes de Implementación</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Fecha de Inspección:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="date" class="form-control" id="fecha_filtro">
        </div>
        <div class="col-lg-2 mt-1">
            <label>Empresa Inspeccionada:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select id="empresaInspec_filtro" asp-items="@ViewBag.Empresas" class="form-control"></select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Registrado Por:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select id="registrado_por_filtro" asp-items="@ViewBag.Usuarios" class="form-control"></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Buscar Código:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="text" class="form-control" id="codigo_filtro">
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)">Filtrar</button>
        </div>
    </div>
</form>

<div class="inspection">
    <div class="secondary-content col-12">
        <div class="table-responsive inspection-color">
            <table class="table" id="tabla_resumen_inspecciones">
                <thead class="">
                    <tr>
                        <th>Código</th>
                        <th>Área Ejecutora de la Inspección</th>
                        <th>Empresa Inspeccionada</th>
                        <th>Área Inspeccionada</th>
                        <th>Fecha de Inspección</th>
                        <th>N° Observaciones</th>
                    </tr>
                </thead>

                <tbody>
                    
                </tbody>
            </table>

        </div>
        <div class="pagination-container inspection-color">
            <ul class="pagination pagination-sm" id="paginado">
                
            </ul>
        </div>
    </div>
</div>

