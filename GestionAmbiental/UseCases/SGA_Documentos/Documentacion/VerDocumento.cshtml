<!--Modal Preview PDF-->
<div class="modal fade" id="modal_preview_pdf" tabindex="-1" aria-labelledby="titulo_modal_preview_pdf" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
                            <h3>Previsualización</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>                
                <form>
                    <div class="modal-body">
                        <div id="viewPDF">

                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mc-outline-danger me-2" data-dismiss="modal">Volver</button>
                        <button type="button" class="btn btn-mc" id="btn_descargar">Descargar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Registrando-->
<div class="modal fade" id="modal_registrando" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br />
                    <label>Guardando Información</label>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">
        var rutaArchivo = "";
        $(document).ready(function () {
            CargarSecundarios();
            ObtenerPredecesores();
            CargarRevisores();
            CargarAprobadores();
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        sgaStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {
                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
        function ObtenerPredecesores() {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/ConsultarPredecesores",
                data: {
                    "IdDocumento": $("#IdEncriptado").val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty();
                    $('#tabla_documentos tbody').html(response.data);
                    dataModulo();
                }
            });
        }
        function CargarSecundarios() {
            var listSecundarios = @Html.Raw(Model.Secundarios);
            var html = "";
            for(var i = 0; i < listSecundarios.length; i++) {
                html += "<tr>";
                if (listSecundarios[i].Condicion == "Pendiente") {
                    html += "<td><a href=\"/SGAAdministracion/EditarDocumento?IdDocumento=" + listSecundarios[i].IdEncriptado + "\">" + listSecundarios[i].Codigo + "</a></td>";
                } else {
                    html += "<td><a href=\"/SGAAdministracion/VerDocumento?IdDocumento=" + listSecundarios[i].IdEncriptado + "\">" + listSecundarios[i].Codigo + "</a></td>";
                }
                html +="<td>" + listSecundarios[i].TipoDocumento +"</td>" +
                    "<td>" + listSecundarios[i].Nombre +"</td>" +
                    "<td>" + listSecundarios[i].Version +"</td >" +
                    "<td>" + listSecundarios[i].Condicion +"</td >" +
                    "<td><button type=\"button\" class=\"btn btn-mc\" onclick=\"PreviewPDF(\'" + listSecundarios[i].PdfRuta.replace('\\', '\\\\')+"\')\">Visualizar Pdf</button></td >" +
                    "<td><button type=\"button\" class=\"btn btn-mc\" onclick=\"DescargarEditable(\'" + listSecundarios[i].EditableRuta.replace('\\', '-')+"\')\">Descargar Editable</button></td >" +
                    "</tr>";
            }
            $("#tabla_secundarios tbody").html(html);
            dataModulo();
        }
        $("#btn_descargar").on('click', function () {
            if (rutaArchivo == "") {
                //href to
                var ruta = '@Html.Raw(Model.DocPdfRuta.Replace('\\','-'))';
                //Reemplazar parentesis "(" por guión
                ruta = ruta.replace('-', '/');
                window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
            } else {
                //descargar del ROOT

                window.location.replace("/SGADocumentacion/DownloadPreviewFile?path=" + rutaArchivo);
            }
        });
        function DescargarEditable(ruta) {
            ruta = ruta.replace('-', '/');
            window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
        }
        function CargarRevisores() {
            var revisores = JSON.parse('@Html.Raw(Model.Revisores)');
            $("#tabla_revisores tbody").empty();
            var html = LlenarTabla(revisores);
            $("#tabla_revisores tbody").html(html);
        }
        function CargarAprobadores() {
            var aprobadores = JSON.parse('@Html.Raw(Model.Aprobadores)');
            $("#tabla_aprobadores tbody").empty();
            var html = LlenarTabla(aprobadores);
            $("#tabla_aprobadores tbody").html(html);
        }
        function LlenarTabla(lista) {
            var html = "";
