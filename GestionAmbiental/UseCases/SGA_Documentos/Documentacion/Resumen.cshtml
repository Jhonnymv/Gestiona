@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2 id="titulo_pagina">Documentos SGA</h2>
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-12 col-md-3 col-lg-2 text-center">
        <div class="d-flex flex-column" style="width:100%;">
            <div class="p-2" id="btn_sga"><button class="btn btn-danger" style="width:100%;">Documentos SGA</button></div>
            <div class="p-2" id="btn_sgi"><button class="btn btn-primary" style="width:100%;">Documentos SGI</button></div>
            <div class="p-2" id="btn_externos"><button class="btn btn-warning" style="width:100%;">Documentos Externos</button></div>
        </div>
    </div>
    <div class="col-sm-12 col-md-9 col-lg-10 text-center" id="opciones_sga">
        <div class="card-deck text-center justify-content-center">
            <div><p>Política</p><div class="tipoDoc" style="--my-color-var: rgb(0,0,250);" onclick="FiltrarTipo([1])"><p class="texto-tipoDoc">P</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,0,250);"></div></div>
            <div><p>Matrices Base</p><div class="tipoDoc" style="--my-color-var: rgb(0,50,200);" onclick="FiltrarTipo([13])"><p class="texto-tipoDoc">M</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,50,200);"></div></div>
            <div><p>Manuales, Planes y Programas</p><div class="tipoDoc" style="--my-color-var: rgb(0,100,150);" onclick="FiltrarTipo([2,12,11])"><p class="texto-tipoDoc">MP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,100,150);"></div></div>
            <div><p>Procedimientos y Planes</p><div class="tipoDoc" style="--my-color-var: rgb(0,150,100);" onclick="FiltrarTipo([7,12])"><p class="texto-tipoDoc">PR</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,150,100);"></div></div>
            <div><p>Instructivos y Protocolos</p><div class="tipoDoc" style="--my-color-var: rgb(0,200,50);" onclick="FiltrarTipo([9,10])"><p class="texto-tipoDoc">IP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,200,50);"></div></div>
            <div><p>Formatos</p><div class="tipoDoc" style="--my-color-var: rgb(0,250,0);" onclick="FiltrarTipo([14])"><p class="texto-tipoDoc">F</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,250,0);"></div></div>
        </div>
    </div>
    <div class="col-sm-12 col-md-9 col-lg-10 text-center" id="opciones_sgi" style="display:none">
        <div class="card-deck text-center justify-content-center">
            <div><p>Política</p><div class="tipoDoc" style="--my-color-var: rgb(0,0,250);" onclick="FiltrarTipo([1])"><p class="texto-tipoDoc">P</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,0,250);"></div></div>
            <div><p>Manuales y Directrices</p><div class="tipoDoc" style="--my-color-var: rgb(0,50,200);" onclick="FiltrarTipo([13,21])"><p class="texto-tipoDoc">M</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,50,200);"></div></div>
            <div><p>Reglamentos y Estándar de Gestión</p><div class="tipoDoc" style="--my-color-var: rgb(0,100,150);" onclick="FiltrarTipo([2,12,11])"><p class="texto-tipoDoc">MP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,100,150);"></div></div>
            <div><p>Procedimientos y Planes</p><div class="tipoDoc" style="--my-color-var: rgb(0,150,100);" onclick="FiltrarTipo([7,12])"><p class="texto-tipoDoc">PR</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,150,100);"></div></div>
            <div><p>Programas e Instructivos</p><div class="tipoDoc" style="--my-color-var: rgb(0,200,50);" onclick="FiltrarTipo([9,10])"><p class="texto-tipoDoc">IP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,200,50);"></div></div>
            <div><p>Formatos y Plantillas</p><div class="tipoDoc" style="--my-color-var: rgb(0,250,0);" onclick="FiltrarTipo([14,22])"><p class="texto-tipoDoc">F</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,250,0);"></div></div>
        </div>
    </div>
    <div class="col-sm-12 col-md-9 col-lg-10 text-center" id="opciones_externo" style="display:none">
        <div class="card-deck text-center justify-content-center">
            <div><p>Legislación Peruana</p><div class="tipoDoc" style="--my-color-var: rgb(0,0,250);" onclick="FiltrarTipo([23])"><p class="texto-tipoDoc">LP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,0,250);"></div></div>
            <div><p>Norma Técnica Peruana</p><div class="tipoDoc" style="--my-color-var: rgb(0,50,200);" onclick="FiltrarTipo([24])"><p class="texto-tipoDoc">NTP</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,50,200);"></div></div>
            <div><p>Estándares Corporativos</p><div class="tipoDoc" style="--my-color-var: rgb(0,100,150);" onclick="FiltrarTipo([25])"><p class="texto-tipoDoc">EC</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,100,150);"></div></div>
            <div><p>Estándares Internacionales</p><div class="tipoDoc" style="--my-color-var: rgb(0,150,100);" onclick="FiltrarTipo([26])"><p class="texto-tipoDoc">EI</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,150,100);"></div></div>
        </div>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Nombre de Documento:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="text" class="form-control" id="filtro_nombre">
        </div>
        <div class="col-lg-2 mt-1">
            <label>Código:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="text" class="form-control" id="filtro_codigo">
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Tipo de Documento:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="selectpicker form-control" id="filtro_tipoDoc" asp-items="ViewBag.TiposDoc" multiple></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Estado:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_condicion" asp-items="ViewBag.Condiciones"></select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)">Filtrar</button>
        </div>
    </div>
    <div class="row mb-2 justify-content-end">
        <div class="col-sm-12 col-md-6 col-lg-2 mt-1">
            <button id="btn_certificaciones" type="button" class="btn btn-warning float-right" onclick="FiltrarTipo([20])">Certificaciones Ambientales</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-center">
    <div class="col-md">
        <table class="table" id="tabla_documentos">
            <thead class="thead-mcolor">
                <tr>
                    <th>Código</th>
                    <th>Documento</th>
                    <th>Versión / Revisión</th>
                    <th>Fecha de Aprobación</th>
                    <th>Estado</th>
                    <th>Comentarios</th>
                    <th>Fecha Tentativa de la Nueva Versión</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>
<!--Modal Docs Tipo-->
<div class="modal fade" id="modal_docs_tipo" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_docs_tipo"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_docs_tipo">
                    Documentos Filtrados
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form>
                <div class="modal-body">
                    <div class="row mb-2 justify-content-center">
                        <div class="col-md">
                            <input type="hidden" id="tipoDocModal" />
                            <table class="table table-modal" id="tabla_documentos_tipo">
                                <thead class="thead-mcolor">
                                    <tr>
                                        <th>Código</th>
                                        <th>Documento</th>
                                        <th>Versión / Revisión</th>
                                        <th>Fecha de Aprobación</th>
                                        <th>Condición</th>
                                        <th>Comentarios</th>
                                        <th>Fecha Tentativa de la Nueva Versión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <div class="row mb-2 justify-content-center">
                        <nav id="paginado_documentos_tipo" aria-label="pagination">
                        </nav>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
    <script type="text/javascript">
        var categoria = 1;
        var tipos = [];
        var tiposFiltro = [];
        $(document).ready(function () {
            filtrar(1);
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $('#filtro_tipoDoc').val(),
                    "condicion": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty()
                    $('#tabla_documentos tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
        function filtrarModal(pag) {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/GetTablaModalResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $("#filtro_tipoDoc").val(),
                    "condicion": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos_tipo tbody').empty()
                    $('#tabla_documentos_tipo tbody').html(response.data)
                    $('#paginado_documentos_tipo').html(response.paginador)
                    $("#filtro_tipoDoc").val([]);
                }
            });
        }
        $("#btn_sga").on('click', function () {
            $("#opciones_sga").show();
            $("#opciones_sgi").hide();
            $("#opciones_externo").hide();
            //Botones adicionales
            $("#btn_certificaciones").show();
            
            $("#titulo_pagina").text("Documentos SGA");
            categoria = 1;
            filtrar(1);
        });
        $("#btn_sgi").on('click', function () {
            $("#opciones_sgi").show();
            $("#opciones_sga").hide();
            $("#opciones_externo").hide();

            //Botones adicionales
            $("#btn_certificaciones").hide();

            $("#titulo_pagina").text("Documentos SGI");
            categoria = 2;
            filtrar(1);
        });
        $("#btn_externos").on('click', function () {
            $("#opciones_externo").show();
            $("#opciones_sga").hide();
            $("#opciones_sgi").hide();
            //Botones adicionales
            $("#btn_certificaciones").hide();

            $("#titulo_pagina").text("Documentos Externos");
            categoria = 3;
            filtrar(1);
        });
        function FiltrarTipo(tipos) {
            $("#filtro_tipoDoc").val([]);
            $('#filtro_tipoDoc').val(tipos);
            $('#modal_docs_tipo').modal('show');
            $("#tipoDocModal").val(tipos)
            filtrarModal(1);
        }
    </script>
}