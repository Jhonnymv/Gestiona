@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/selectpicker/js/bootstrap-select.js"></script>
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">
        var categoria = 1;
        var tipos = [];
        var tiposFiltro = [];
        $(document).ready(function () {
            //Buscar activo guardado en local storage
            var activeCartegoria = localStorage.getItem('activeDocSGACategoria');
            if (activeCartegoria != null) {
                switch (activeCartegoria) {
                    case "1": $("#pills-docsga-tab").click(); break;
                    case "2": $("#pills-docsig-tab").click(); break;
                    case "3": $("#pills-docext-tab").click(); break;
                };
            }
            //Si no existe, mostrar primer SGA
            else {
                filtrar(1);
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        sgaStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $('#filtro_tipoDoc').val(),
                    "condicion": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty()
                    $('#tabla_documentos tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    dataModulo();
                }
            });
        }
        function filtrarModal(pag) {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/GetTablaModalResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 5,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $("#filtro_tipoDoc").val(),
                    "condicion": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos_tipo tbody').empty()
                    $('#tabla_documentos_tipo tbody').html(response.data)
                    $('#paginado_documentos_tipo').html(response.paginador)
                    $("#filtro_tipoDoc").val([]);
                    dataModulo();
                }
            });
        }
        $("#pills-docsga-tab").on('click', function () {
            $("#opciones_sga").show();
            $("#opciones_sig").hide();
            $("#opciones_externo").hide();
            //Botones adicionales
            $("#btn_certificaciones").show();

            $("#titulo_pagina").text("Documentos SGA");
            localStorage.setItem('activeDocSGACategoria',"1")
            categoria = 1;
            filtrar(1);
        });
        $("#pills-docsig-tab").on('click', function () {
            $("#opciones_sig").show();
            $("#opciones_sga").hide();
            $("#opciones_externo").hide();

            //Botones adicionales
            $("#btn_certificaciones").hide();

            $("#titulo_pagina").text("Documentos SIG");
            localStorage.setItem('activeDocSGACategoria', "2")
            categoria = 2;
            filtrar(1);
        });
        $("#pills-docext-tab").on('click', function () {
            $("#opciones_externo").show();
            $("#opciones_sga").hide();
            $("#opciones_sig").hide();
            //Botones adicionales
            $("#btn_certificaciones").hide();

            $("#titulo_pagina").text("Documentos Externos");
            localStorage.setItem('activeDocSGACategoria', "3")
            categoria = 3;
            filtrar(1);
        });
        function FiltrarTipo(tipos) {
            $("#filtro_tipoDoc").val([]);
            $('#filtro_tipoDoc').val(tipos);
            $('#modal_docs_tipo').modal('show');
            $("#tipoDocModal").val(tipos)
            filtrarModal(1);
        }
        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {
                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
    </script>
}
