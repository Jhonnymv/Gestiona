@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2 id="titulo_pagina">Administracion de Documentos SGA</h2>
    </div>
</div>
<div class="row mb-2">
    <div class="col-sm-12 col-md-3 col-lg-2 text-center">
        <div class="d-flex flex-column" style="width:100%;">
            <div class="p-2" id="btn_sga"><button class="btn btn-danger" style="width:100%;">Documentos SGA</button></div>
            <div class="p-2" id="btn_sgi"><button class="btn btn-primary" style="width:100%;">Documentos SGI</button></div>
            <div class="p-2" id="btn_externos"><button class="btn btn-warning" style="width:100%;">Documentos Externos</button></div>
        </div>
    </div>
    <div class="col-sm-12 col-md-9 col-lg-10 text-center" id="opciones_condicion">
        <div class="card-deck text-center justify-content-center">
            <div><p>Elaboración</p><div class="tipoDoc" style="--my-color-var: rgb(0,0,240);" onclick="FiltrarCondicion([1,2])"><p class="texto-tipoDoc">E</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,0,240);"></div></div>
            <div><p>Revisión</p><div class="tipoDoc" style="--my-color-var: rgb(0,80,160);" onclick="FiltrarCondicion([3])"><p class="texto-tipoDoc">R</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,80,160);"></div></div>
            <div><p>Aprobación</p><div class="tipoDoc" style="--my-color-var: rgb(0,160,80);" onclick="FiltrarCondicion([4,5,6])"><p class="texto-tipoDoc">A</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,160,80);"></div></div>
            <div><p>Obsoleto</p><div class="tipoDoc" style="--my-color-var: rgb(0,240,0);" onclick="FiltrarCondicion([7])"><p class="texto-tipoDoc">O</p></div><div class="tipoDocUnion" style="--my-color-var: rgb(0,240,0);"></div></div>
        </div>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Nombre de Documento:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="text" class="form-control" id="filtro_nombre">
        </div>
        <div class="col-lg-2 mt-1">
            <label>Código:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="text" class="form-control" id="filtro_codigo">
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Tipo de Documento:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="selectpicker form-control" id="filtro_tipoDoc" asp-items="ViewBag.TiposDoc" multiple></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Estado:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="selectpicker form-control" id="filtro_condicion" asp-items="ViewBag.Condiciones" multiple></select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-start">
    <div class="col-md mt-1">
        <a id="btn_cargar_documento" class="btn btn-danger float-left mr-2" asp-action="CargarDocumento" asp-controller="SGAAdministracion" asp-route-IdCategoria="1"><img src="~/img/icons/edit-icon.png" style="vertical-align:sub"> Cargar Documento</a>
        <a id="btn_actualizar_documento" class="btn btn-danger float-left" asp-action="ActualizarDocumento" asp-controller="SGAAdministracion" asp-route-IdCategoria="1"><img src="~/img/icons/edit-icon.png" style="vertical-align:sub"> Actualizar Documento</a>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-12">
        <table class="table" id="tabla_documentos">
            <thead class="thead-mcolor">
                <tr>
                    <th>Código</th>
                    <th>Documento</th>
                    <th>Versión / Revisión</th>
                    <th>Fecha de Aprobación</th>
                    <th>Estado</th>
                    <th>Comentarios</th>
                    <th>Fecha Tentativa de la Nueva Versión</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>

<!--Modal Docs Condicion-->
<div class="modal fade" id="modal_docs_condicion" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_docs_condicion"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_docs_condicion">
                    TITULO
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form>
                <div class="modal-body">
                    <div class="row mb-2 justify-content-center">
                        <div class="col-12">
                            <input type="hidden" id="condicionDocModal" />
                            <table class="table table-modal" id="tabla_documentos_tipo">
                                <thead class="thead-mcolor">
                                    <tr>
                                        <th>Código</th>
                                        <th>Documento</th>
                                        <th>Versión / Revisión</th>
                                        <th>Fecha de Aprobación</th>
                                        <th>Condición</th>
                                        <th>Comentarios</th>
                                        <th>Fecha Tentativa de la Nueva Versión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <div class="row mb-2 justify-content-center">
                        <nav id="paginado_documentos_tipo" aria-label="pagination">
                        </nav>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
    <script type="text/javascript">
        var categoria = 1;
        $("#btn_sga").on('click', function () {
            $("#titulo_pagina").text("Administracion de Documentos SGA");
            $("#btn_cargar_documento").attr('href', '@Url.Action("CargarDocumento", "SGAAdministracion", new { IdCategoria = 1 })')
            $("#btn_actualizar_documento").attr('href', '@Url.Action("ActualizarDocumento", "SGAAdministracion", new { IdCategoria = 1 })')
            categoria = 1;
            filtrar(1);
        });
        $("#btn_sgi").on('click', function () {
            $("#titulo_pagina").text("Administracion de Documentos SGI");
            $("#btn_cargar_documento").attr('href', '@Url.Action("CargarDocumentoSRevision", "SGAAdministracion", new { IdCategoria = 2 })')
            $("#btn_actualizar_documento").attr('href', '@Url.Action("ActualizarDocumentoSRevision", "SGAAdministracion", new { IdCategoria = 2 })')
            categoria = 2;
            filtrar(1);
        });
        $("#btn_externos").on('click', function () {
            $("#titulo_pagina").text("Administracion de Documentos Externos");
            $("#btn_cargar_documento").attr('href', '@Url.Action("CargarDocumentoSRevision", "SGAAdministracion",new { IdCategoria = 3 })')
            $("#btn_actualizar_documento").attr('href', '@Url.Action("ActualizarDocumentoSRevision", "SGAAdministracion",new { IdCategoria = 3 })')
            categoria = 3;
            filtrar(1);
        });
        $(document).ready(function () {
            filtrar(1);
            //cargarOpciones();
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $('#filtro_tipoDoc').val(),
                    "condiciones": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty()
                    $('#tabla_documentos tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
        function filtrarModal(pag) {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/GetTablaModalResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "nombre": $('#filtro_nombre').val(),
                    "categoria": categoria,
                    "tipos": $("#tipoDocModal").val(),
                    "condiciones": $('#filtro_condicion').val(),
                    "codigo": $("#filtro_codigo").val()
                },
                traditional: true,
                success: (response) => {
                    $("#filtro_condicion").val([]);
                    $('#tabla_documentos_tipo tbody').empty()
                    $('#tabla_documentos_tipo tbody').html(response.data)
                    $('#paginado_documentos_tipo').html(response.paginador)
                }
            });
        }
        function cargarOpciones() {
            var azul = 255;
            var verde = 0;
            var variacion = 50;

           tipos = JSON.parse('@Html.Raw(ViewBag.TiposDocJson)');
            var html = "";
            for (var i = 0; i < tipos.length; i++) {
                var palabras = tipos[i].Descripcion.split(' ');
                var iniciales = "";
                for (var j = 0; j < palabras.length; j++) {
                    if (palabras[j].charAt(0) != 'y') {
                        iniciales += palabras[j].charAt(0);
                    }
                }
                html += "<div><p>" + tipos[i].Descripcion+"</p><div class=\"tipoDoc\" style=\"--my-color-var: rgb(0," + verde + "," + azul + ");\" onclick=\"FiltrarTipo(" + tipos[i].IdSGATipoDocumento + ")\"><p class=\"texto-tipoDoc\">" + iniciales + "</p></div><div class=\"tipoDocUnion\" style=\"--my-color-var: rgb(0," + verde + "," + azul + ");\"></div></div>";
                if (verde + variacion <= 255 && azul - variacion > 0) {
                    verde += variacion;
                    azul -= variacion;
                }
            }
            $("#opcionesTipoDoc").html(html)
        }
        function FiltrarCondicion(condiciones) {
            $("#filtro_condicion").val([]);
            $('#filtro_condicion').val(condiciones);
            $('#modal_docs_condicion').modal('show');
            $("#condicionDocModal").val(condiciones)
            filtrarModal(1);
        }
    </script>
}