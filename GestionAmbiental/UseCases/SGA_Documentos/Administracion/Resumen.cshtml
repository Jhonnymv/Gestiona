@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="~/selectpicker/css/bootstrap-select.css">
    @*<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">*@
}
<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3><span id="titulo_pagina">Administracion de Documentos SGA</span></h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="tabs-mc">
            <ul class="nav nav-pills mt-3 div-scroll-horizontal" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-docsga-tab" data-bs-toggle="pill" data-bs-target="#pills-docsga" type="button" role="tab" aria-controls="pills-docsga" aria-selected="true">Documentos SGA</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-docsig-tab" data-bs-toggle="pill" data-bs-target="#pills-docsig" type="button" role="tab" aria-controls="pills-docsig" aria-selected="false">Documentos SIG</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-docext-tab" data-bs-toggle="pill" data-bs-target="#pills-docext" type="button" role="tab" aria-controls="pills-ext" aria-selected="false">Documentos Externos</button>
                </li>
            </ul>
            <div class="content-header">
                <div class="action-container sga-color row-center-center">
                    <div class="w-100 row-center-center">
                        <a id="btn_cargar_documento" class="btn btn-special-action-outline sga-color" asp-action="CargarDocumento" asp-controller="SGAAdministracion" asp-route-IdCategoria="1">CARGAR DOCUMENTO</a>
                    </div>
                    <div class="w-100 row-center-center">
                        <a id="btn_actualizar_documento" class="btn btn-special-action-outline sga-color" asp-action="ActualizarDocumento" asp-controller="SGAAdministracion" asp-route-IdCategoria="1">ACTUALIZAR DOCUMENTO</a>
                    </div>
                    <div class="w-100 row-center-center">
                        <button type="button" id="btn_certificaciones" class="btn btn-special-action-outline sga-color" onclick="FiltrarTipo([20])">CERTIFICACIONES AMBIENTALES</button>
                    </div>
                </div>
                <form autocomplete="off" class="custom-form">
                    <div class="col-12 col-lg-9">
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_nombre">Nombre de Documento</label>
                                <input type="text" class="form-control" id="filtro_nombre">
                            </div>
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_codigo">Código</label>
                                <input type="text" class="form-control" id="filtro_codigo">
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="">Tipo de Documento</label>
                                <select class="selectpicker form-control" id="filtro_tipoDoc" asp-items="ViewBag.TiposDoc" multiple>
                                </select>
                            </div>
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="">Estado</label>
                                <select class="selectpicker form-control" id="filtro_condicion" asp-items="ViewBag.Condiciones" multiple>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3 row-center-center">
                        <button type="button" class="btn btn-mc" onclick="filtrar(1)">Filtrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="secondary-content filters-mc col-12">
        <div class="filter-mc-title">
            <span>FILTROS ADICIONALES</span>
        </div>
