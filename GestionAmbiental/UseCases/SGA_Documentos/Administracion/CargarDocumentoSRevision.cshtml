@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Cargar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3>Cargar Documento @ViewBag.CategoriaDoc</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_registrar_documento" asp-controller="SGAAdministracion" asp-action="CargarDocumentoSRevision" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Datos del Documento</span>
                    </div>
                    <input type="hidden" asp-for="IdCategoria" value="@ViewBag.IdCategoria" />
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdSGATipoDocumento"></label>
                            <span class="text-danger" asp-validation-for="IdSGATipoDocumento"></span>
                            <select asp-for="IdSGATipoDocumento" class="form-control" asp-items="ViewBag.TiposDoc"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdElaboradoPor"></label>
                            <span class="text-danger" asp-validation-for="IdElaboradoPor"></span>
                            <select asp-for="IdElaboradoPor" class="form-control" asp-items="ViewBag.Usuarios"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocVersion"></label>
                            <span class="text-danger" asp-validation-for="DocVersion"></span>
                            <input type="text" asp-for="DocVersion" class="form-control" value="1">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocNombre"></label>
                            <span class="text-danger" asp-validation-for="DocNombre"></span>
                            <input type="text" asp-for="DocNombre" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocCodigo"></label>
                            <span class="text-danger" asp-validation-for="DocCodigo"></span>
                            <input type="text" asp-for="DocCodigo" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label> Fecha del Documento</label>
                            <span class="text-danger" asp-validation-for="FechaAprobacion"></span>
                            <input type="date" asp-for="FechaAprobacion" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container align-items-start">
                        @if (ViewBag.IdCategoria != 3)
                        {
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="FechaTentativa"></label>
                                <span class="text-danger" asp-validation-for="FechaTentativa"></span>
                                <input type="date" asp-for="FechaTentativa" class="form-control">
                            </div>
                        }
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Comentario"></label>
                            <span class="text-danger" asp-validation-for="Comentario"></span>
                            <textarea asp-for="Comentario" class="form-control" maxlength="500"></textarea>
                            <div class="text-right">
                                <span id="contadorComentario">0</span>
                                <span>/ 500</span>
                            </div>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoPdf"></label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoPdf" data-valmsg-replace="true">
                                <span id="danger_documento_pdf" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoPdf" class="form-control" accept=".pdf" data-max-size="8971520">
                        </div>
                        @if (ViewBag.IdCategoria != 3)
                        {
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="DocumentoEditable"></label>
                                <span class="text-danger field-validation-error" data-valmsg-for="DocumentoEditable" data-valmsg-replace="true">
                                    <span id="danger_documento_editable" class=""></span>
                                </span>
                                <input type="file" asp-for="DocumentoEditable" class="form-control" accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx" data-max-size="8971520">
                            </div>
                        }
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <a class="btn btn-mc-outline-success" id="btn_descargar_plantilla" href="#" style="display:none">Descargar Plantilla</a>
                        </div>
                    </div>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="row input_container justify-content-center">
                        <div class="col-8">
                            <div class="alert alert-danger" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Error)</div>
                        </div>
                    </div>
                }
                <input type="hidden" asp-for="Opcion" />
                <div class="row">
                    <div class="button-container">
                        <div class="me-2">
                            <a class="btn btn-mc-outline-danger w-100" asp-controller="SGAAdministracion" asp-action="Resumen">Cancelar</a>
                        </div>
                        @if (ViewBag.DocPrincipal == null)
                        {
                            <div class="me-2">
                                <button type="button" class="btn btn-mc-outline-success w-100" id="btn_guardar_estado">Guardar Estado</button>
                            </div>
                        }
                        <div class="me-2">
                            <button type="button" class="btn btn-mc w-100" id="btn_registrar">Registrar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!--Modal Preview PDF-->
<div class="modal fade" id="modal_preview_pdf" tabindex="-1" aria-labelledby="titulo_modal_preview_pdf" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
                            <h3>Previsualización</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="modal-body">
                        <div id="viewPDF">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mc-outline-danger me-2" data-dismiss="modal">Volver</button>
                        <button type="button" class="btn btn-mc" id="btn_descargar">Descargar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">
        @*var listAprobadores = [];
        var listRevisores = [];*@
                var IdPrimerUsuario;
        var listTipoDocRuta = [];

        $(document).ready(function () {
            IdPrimerUsuario = $("#select_usuario").val();
        @*$("#Revisores").val(JSON.stringify(listRevisores));
            $("#Aprobadores").val(JSON.stringify(listAprobadores));*@
                listTipoDocRuta = @Html.Raw(ViewBag.TiposDocRuta);
            $("#input_fecha_limite").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
            $("#Fecha_Tentativa").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
        });
        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {
                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
        $("#DocumentoPdf").change(function () {
            $("#danger_documento_pdf").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoPdf").data('max-size');
            var archivos = $("#DocumentoPdf").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_pdf").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_pdf").text(filesname);
                            $("#danger_documento_pdf").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_pdf").html(filesName) : null;
            }
        });
        $("#DocumentoEditable").change(function () {
            $("#danger_documento_editable").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoEditable").data('max-size');
            var archivos = $("#DocumentoEditable").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_editable").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'ppt':
                        case 'pptx':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_editable").text(filesname);
                            $("#danger_documento_editable").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_editable").html(filesName) : null;
            }
        });
        function ValidarDatosModal() {
            var tipo = $("#select_tipo_revision").val();
            var orden = $("#input_orden_revision").val();
            var idUsuario = $("#select_usuario").val();
            var fecha = $("#input_fecha_limite").val();

            if (tipo != '0' && orden != "" && idUsuario != '0' && fecha != "")
                return true;
            return false;
        }
        $("#IdSGATipoDocumento").on("change", function () {
            $("#btn_descargar_plantilla").hide();
            var id = $("#IdSGATipoDocumento").val();
            console.log("IdSelect", id);
            console.log("---------------------------------");
            for (var i = 0; i < listTipoDocRuta.length; i++) {
                console.log("Id", listTipoDocRuta[i].Id);
                if (id == listTipoDocRuta[i].Id && listTipoDocRuta[i].Ruta != 0) {
                    $("#btn_descargar_plantilla").attr("href", "@Url.Action("DescargarPlantilla", "SGAAdministracion")" + "?IdCategoriaTipo=" + id);
                    $("#btn_descargar_plantilla").show();
                    return;
                }
            }
        });
        $("#btn_guardar_estado").on("click", function () {
            $("#Opcion").val("GuardarEstado");
            $("#form_registrar_documento").submit();
        });
        $("#btn_registrar").on("click", function () {
            $("#Opcion").val("Registrar");
            $("#form_registrar_documento").submit()
        });
        $('#Comentario').keyup(function () {
            var characterCount = $(this).val().length;
            $('#contadorComentario').text(characterCount);
        });
    </script>

}