<!--Modal Preview PDF-->
<div class="modal fade" id="modal_preview_pdf" tabindex="-1" aria-labelledby="titulo_modal_preview_pdf" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
                            <h3>Previsualización</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="modal-body">
                        <div id="viewPDF">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mc-outline-danger me-2" data-dismiss="modal">Volver</button>
                        <button type="button" class="btn btn-mc" id="btn_descargar">Descargar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">
        var IdPrimerUsuario;

        $(document).ready(function () {
            ObtenerPredecesores();
            IdPrimerUsuario = $("#select_usuario").val();
            $("#input_fecha_limite").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
            $("#Fecha_Tentativa").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
        });

        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {
                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
        $("#DocumentoPdf").change(function () {
            $("#danger_documento_pdf").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoPdf").data('max-size');
            var archivos = $("#DocumentoPdf").get(0).files;
            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_pdf").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_pdf").text(filesname);
                            $("#danger_documento_pdf").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_pdf").html(filesName) : null;
            }
        });
        $("#DocumentoEditable").change(function () {
            $("#danger_documento_editable").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoEditable").data('max-size');
            var archivos = $("#DocumentoEditable").get(0).files;
            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_editable").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'ppt':
                        case 'pptx':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_editable").text(filesname);
                            $("#danger_documento_editable").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_editable").html(filesName) : null;
            }
        });
        function DescargarEditable(ruta) {
            ruta = ruta.replace('-', '/');
            window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
        }
        function ObtenerPredecesores() {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/ConsultarPredecesores",
                data: {
                    "IdDocumento": $("#IdEncriptado").val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty()
                    $('#tabla_documentos tbody').html(response.data)
                }
            });
        }
        $("#btn_guardar_estado").on("click", function () {
            if (ValidarDatos()) {
                $("#Opcion").val("GuardarEstado");
                $("#form_editar_documento").submit();
            }
        });
        $("#btn_registrar").on("click", function () {
            if (ValidarDatos()) {
                $("#Opcion").val("Registrar");
                $("#form_editar_documento").submit();
            }
        });
        //Validacion para guardar estado, registrar o agregar formato
        function ValidarDatos() {
            var tipo = $("#IdSGATipoDocumento").val();
            var version = $("#DocVersion").val();
            var nombre = $("#DocNombre").val();
            var codigo = $("#DocCodigo").val();
            var documento = $("#Documento").val();
            var documentoRuta = $("#DocumentoRuta").val();

            $('span[data-valmsg-for="IdSGATipoDocumento"]').text("");
            $('span[data-valmsg-for="DocVersion"]').text("");
            $('span[data-valmsg-for="DocNombre"]').text("");
            $('span[data-valmsg-for="DocCodigo"]').text("");
            $('span[data-valmsg-for="Documento"]').text("");

            if (tipo != '0' && version != "" && nombre != "" && (documento != "" || documentoRuta != ""))
                return true;
            else {
                if (tipo == '0')
                    $('span[data-valmsg-for="IdSGATipoDocumento"]').text("Este campo es requerido");
                if (version == "")
                    $('span[data-valmsg-for="DocVersion"]').text("Este campo es requerido");
                if (nombre == "")
                    $('span[data-valmsg-for="DocNombre"]').text("Este campo es requerido");
                if (codigo == "")
                    $('span[data-valmsg-for="DocCodigo"]').text("Este campo es requerido");
                if (documento == "" && documentoRuta == "")
                    $('span[data-valmsg-for="Documento"]').text("Este campo es requerido");

                return false;
            }
        }
        function LlenarTabla(tipo, lista) {
            var html = "";
            for (var i = 0; i < lista.length; i++) {
                html += "<tr>" +
                    "<td style = \"width: 20%\" ><input class=\"form-control\" type=\"number\" style=\"width:50px\"  value=\"" + lista[i].Orden + "\" readonly/></td>" +
                    "<td style = \"width: 50%\" ><input class=\"form-control\" type=\"text\" style=\"width:300px\" value=\"" + lista[i].UsuarioNombre + "\" readonly/></td>" +
                    "<td style=\"width: 20%\"><input class=\"form-control\" type=\"date\" value=\"" + lista[i].Fecha + "\" readonly/></td>" +
                    "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn btn-primary\" onclick=\"EditarRevisor(" + tipo + "," + lista[i].Orden + ")\"><img src=\"/img/icons/edit-icon.png\"/></button></td >" +
                    "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn\" onclick=\"EliminarRevisor(" + tipo + "," + lista[i].Orden + ")\"><img src=\"/img/icons/cross.png\"/></button></td >" +
                    "</tr>";
            }
            return html;
        }
        $("#btn_descargar").on('click', function () {
            if (rutaArchivo == "") {
                //href to
                var ruta = '@Html.Raw(Model.DocEditableRuta.Replace('\\','-'))';
                //Reemplazar parentesis "(" por guión
                ruta = ruta.replace('-', '/');
                window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
            } else {
                //descargar del ROOT
                window.location.replace("/SGADocumentacion/DownloadPreviewFile?path=" + rutaArchivo);
            }
        });
        $('#Comentario').keyup(function () {
            var characterCount = $(this).val().length;
            $('#contadorComentario').text(characterCount);
        });
    </script>
}