@section Scripts{
    <script type="text/javascript">
        var listDocumentosP = [];
            listSecundariosEditable = @Html.Raw(ViewBag.PublicadosEditable);
        $(document).ready(function () {
            listDocumentosP = @Html.Raw(ViewBag.DocumentosPublicados);
        });
        function DescargarEditable(ruta) {
            ruta = ruta.replace('-', '/');
            window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
        }
        $("#IdSGATipoDocumento").change(function () {
            //Limpiar opciones de predecesores (nombre)
            $('#DocPredecesor').empty();
            //Contador para que se asigne el nombre, codigo y version una sola vez (la primera opcion agregada)
            var count = 0;
            var categoriaTipo = $("#IdSGATipoDocumento").val();
            for (var i = 0; i < listDocumentosP.length; i++) {
                if (categoriaTipo == listDocumentosP[i].IdSGACategoriaTipo) {
                    //Actualizar a las opciones de predecesores (nombre)
                    $('#DocPredecesor').append(new Option(listDocumentosP[i].DocNombre, listDocumentosP[i].IdSGADocumento));
                    //Si es la primera opcion agregada actualiza nombre, codigo y version
                    if (count == 0) {
                        $('#DocNombre').val(listDocumentosP[i].DocNombre);
                        $('#DocCodigo').val(listDocumentosP[i].DocCodigo);
                        $('#DocVersion').val((listDocumentosP[i].DocVersion + 1));
                        count++;
                    }
                }
            }
            var IdDoc = $("#DocPredecesor").val();
            //Limpiar boton descargar editable
            $("#btnDescargarEditable").empty();
            if (IdDoc != null)
                for (var i = 0; i < listSecundariosEditable.length; i++)
                    if (listSecundariosEditable[i].Id == IdDoc) {
                        $("#btnDescargarEditable").html(listSecundariosEditable[i].Button);
                        break;
                    }
        });
        $("#DocPredecesor").change(function () {
            var IdDoc = $("#DocPredecesor").val();
            //Limpiar boton descargar editable
            $("#btnDescargarEditable").empty();
            if (IdDoc != null)
                for (var i = 0; i < listSecundariosEditable.length; i++)
                    if (listSecundariosEditable[i].Id == IdDoc) {
                        $("#btnDescargarEditable").html(listSecundariosEditable[i].Button);
                        break;
                    }
            for (var i = 0; i < listDocumentosP.length; i++) {
                if (IdDoc == listDocumentosP[i].IdSGADocumento) {
                    $('#DocNombre').val(listDocumentosP[i].DocNombre);
                    $('#DocCodigo').val(listDocumentosP[i].DocCodigo);
                    $('#DocVersion').val((listDocumentosP[i].DocVersion + 1));
                    return;
                }
            }
        });
        $("#DocumentoPdf").change(function () {
            $("#danger_documento_pdf").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoPdf").data('max-size');
            var archivos = $("#DocumentoPdf").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_pdf").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_pdf").text(filesname);
                            $("#danger_documento_pdf").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_pdf").html(filesName) : null;
            }
        });
        $("#DocumentoEditable").change(function () {
            $("#danger_documento_editable").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoEditable").data('max-size');
            var archivos = $("#DocumentoEditable").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_editable").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'ppt':
                        case 'pptx':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_editable").text(filesname);
                            $("#danger_documento_editable").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_editable").html(filesName) : null;
            }
        });
        $("#btn_guardar_estado").on("click", function () {
            $("#Opcion").val("GuardarEstado");
            $("#form_registrar_documento").submit();
        });
        $("#btn_registrar").on("click", function () {
            $("#Opcion").val("Registrar");
            $("#form_registrar_documento").submit()
        });

        $('#Comentario').keyup(function () {
            var characterCount = $(this).val().length;
            $('#contadorComentario').text(characterCount);
        });
    </script>

}