@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Actualizar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3>Actualizar Documento @ViewBag.CategoriaDoc</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_registrar_documento" asp-controller="SGAAdministracion" asp-action="CargarDocumentoSRevision" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Datos del Documento</span>
                    </div>
                    <input asp-for="DocPrincipal" type="hidden" value="@ViewBag.DocPrincipal" />
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdSGATipoDocumento"></label>
                            <span class="text-danger" asp-validation-for="IdSGATipoDocumento"></span>
                            <select asp-for="IdSGATipoDocumento" class="form-control" asp-items="ViewBag.TiposDoc"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocVersion"></label>
                            <span class="text-danger" asp-validation-for="DocVersion"></span>
                            <input type="number" asp-for="DocVersion" class="form-control" value="1">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocNombre"></label>
                            <span class="text-danger" asp-validation-for="DocNombre"></span>
                            <input type="hidden" asp-for="DocNombre" class="form-control">
                            <select asp-for="DocPredecesor" class="form-control"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocCodigo"></label>
                            <span class="text-danger" asp-validation-for="DocCodigo"></span>
                            <input type="text" asp-for="DocCodigo" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="row input_container align-items-start">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Comentario"></label>
                            <span class="text-danger" asp-validation-for="Comentario"></span>
                            <textarea asp-for="Comentario" class="form-control" maxlength="500"></textarea>
                            <div class="text-right">
                                <span id="contadorComentario">0</span>
                                <span>/ 500</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaAprobacion"></label>
                            <span class="text-danger" asp-validation-for="FechaAprobacion"></span>
                            <input type="date" asp-for="FechaAprobacion" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaTentativa"></label>
                            <span class="text-danger" asp-validation-for="FechaTentativa"></span>
                            <input type="date" asp-for="FechaTentativa" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label>Documento Editable Versión Anterior:</label>
                            <div class="col-sm-12 col-md-9 col-lg-4 mb-2" id="btnDescargarEditable">
                            </div>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoPdf"></label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoPdf" data-valmsg-replace="true">
                                <span id="danger_documento_pdf" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoPdf" class="form-control" accept=".pdf" data-max-size="8971520">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoEditable"></label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoEditable" data-valmsg-replace="true">
                                <span id="danger_documento_editable" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoEditable" class="form-control" accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx" data-max-size="8971520">
                        </div>
                    </div>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="row input_container justify-content-center">
                        <div class="col-8">
                            <div class="alert alert-danger" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Error)</div>
                        </div>
                    </div>
                }
                <input type="hidden" asp-for="Opcion" />
                <div class="row">
                    <div class="button-container">
                        <div class="me-2">
                            <a class="btn btn-mc-outline-danger w-100" asp-controller="SGAAdministracion" asp-action="Resumen">Cancelar</a>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc w-100" id="btn_guardar_estado">Guardar Estado</button>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc-success w-100" id="btn_registrar">Registrar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
