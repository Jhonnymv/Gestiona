@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Registrar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3>Detalles del Documento @ViewBag.CategoriaDoc</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <div class="custom-form details-container w-100">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Datos del Documento</span>
                    </div>
                    <input type="hidden" asp-for="IdEncriptado" value="@Model.IdEncriptado" />
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdSGATipoDocumento"></label>
                            <select asp-for="IdSGATipoDocumento" class="form-control" asp-items="ViewBag.TiposDoc" disabled></select>
                        </div>
                        @if (ViewBag.CategoriaDoc == "Externos")
                        {
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="ElaboradoPorString"></label>
                                <input type="text" asp-for="ElaboradoPorString" class="form-control" readonly>
                            </div>
                        }
                        @if (ViewBag.CategoriaDoc != "Externos")
                        {
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="IdElaboradoPor"></label>
                                <select asp-for="IdElaboradoPor" class="form-control" asp-items="ViewBag.Usuarios" disabled></select>
                            </div>
                        }
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocVersion"></label>
                            <input type="text" asp-for="DocVersion" class="form-control" readonly>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocNombre"></label>
                            <input type="text" asp-for="DocNombre" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocCodigo"></label>
                            <input type="text" asp-for="DocCodigo" class="form-control" readonly>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaAprobacion"></label>
                            <input type="text" asp-for="FechaAprobacion" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="row input_container">
                        @if (ViewBag.CategoriaDoc != "Externos")
                        {
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="FechaTentativa"></label>
                                <input type="text" asp-for="FechaTentativa" class="form-control" readonly>
                            </div>
                        }
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Condicion"></label>
                            <select asp-for="Condicion" class="form-control" asp-items="ViewBag.Condiciones" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Comentario"></label>
                            <textarea asp-for="Comentario" class="form-control" readonly></textarea>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoPdf"></label>
                            <button class="btn btn-mc form-control" type="button" onclick="this.disabled = true; PreviewPDF('@Model.DocPdfRuta.Replace("\\", "\\\\")');this.disabled=false;">Visualizar PDF</button>
                        </div>
                    </div>
                    @if (ViewBag.CategoriaDoc == "SGA")
                    {
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="DocumentoEditable"></label>
                                <button class="btn btn-mc form-control" type="button" onclick="DescargarEditable('@Model.DocEditableRuta.Replace('\\', '-')')">Descargar Editable</button>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.Secundarios.Length > 2)
                {
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Formatos</span>
                        </div>
                        <div class="row input_container">
                            <div class="table-responsive sga-color">
                                <table class="table" id="tabla_secundarios">
                                    <thead class="">
                                        <tr>
                                            <th>Código</th>
                                            <th>Tipo de Documento</th>
                                            <th>Nombre</th>
                                            <th>Versión</th>
                                            <th>Condición</th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Revisores.Length > 2 || Model.Aprobadores.Length > 2)
                {
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Revisores y Aprobadores</span>
                        </div>
                        <div class="row input_container">
                            <div class="table-responsive sga-color">
                                <input type="hidden" asp-for="Revisores" />
                                <table class="table" id="tabla_revisores">
                                    <thead class="">
                                        <tr>
                                            <th>Usuario</th>
                                            <th>Fecha de Revisión</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="table-responsive sga-color">
                                <input type="hidden" asp-for="Aprobadores" />
                                <table class="table" id="tabla_aprobadores">
                                    <thead class="">
                                        <tr>
                                            <th>Usuario</th>
                                            <th>Fecha de Aprobación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Versiones Anteriores</span>
                    </div>
                    <div class="row input_container">
                        <div class="table-responsive sga-color">
                            <table class="table" id="tabla_documentos">
                                <thead class="">
                                    <tr>
                                        <th>Código</th>
                                        <th>Documento</th>
                                        <th>Versión / Revisión</th>
                                        <th>Fecha de Aprobación</th>
                                        @if (ViewBag.CategoriaDoc != "Externos")
                                        {
                                            <th>Condición</th>
                                        }
                                        <th>Comentarios</th>
                                        @if (ViewBag.CategoriaDoc != "Externos")
                                        {
                                            <th>Fecha Tentativa de la Nueva Versión</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="button-container">
                        <div>
                            @if (ViewBag.CategoriaDoc != "Externos")
                            {
                                <a class="btn btn-mc-outline-success" href="/SGAAdministracion/EditarDocumento?IdDocumento=@Model.IdEncriptado&IdCategoria=@ViewBag.IdCategoryDoc">Editar</a>
                            }
                            @if (ViewBag.CategoriaDoc == "Externos")
                            {
                                <a class="btn btn-mc-outline-success" href="/SGAAdministracion/EditarDocumentoSRevision?IdDocumento=@Model.IdEncriptado&IdCategoria=@ViewBag.IdCategoryDoc">Editar</a>
                            }
                        </div>
                        <div>
                            <a class="btn btn-mc-outline-danger" asp-controller="SGAAdministracion" asp-action="Resumen">Volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

