@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Registrar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Detalles del Documento</h2>
    </div>
</div>
<form class="form-group" id="form_registrar_documento" method="post" enctype="multipart/form-data" autocomplete="off">
    <input type="hidden" asp-for="Id_Encriptado" value="@Model.Id_Encriptado" />
    <div class="row mb-2 align-items-center">
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Id_SGA_Tipo_Documento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Id_SGA_Tipo_Documento"></span>
            <select asp-for="Id_SGA_Tipo_Documento" class="form-control" asp-items="ViewBag.TiposDoc" disabled></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Version"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Version"></span>
            <input type="number" asp-for="Doc_Version" class="form-control" readonly>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Nombre"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Nombre"></span>
            <input type="text" asp-for="Doc_Nombre" class="form-control" readonly>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Fecha_Tentativa"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Fecha_Tentativa"></span>
            <input type="text" asp-for="Fecha_Tentativa" class="form-control" readonly>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Codigo"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Codigo"></span>
            <input type="text" asp-for="Doc_Codigo" class="form-control" readonly>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Condicion"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Condicion"></span>
            <select asp-for="Condicion" class="form-control" asp-items="ViewBag.Condiciones" disabled></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Comentario"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Comentario"></span>
            <textarea asp-for="Comentario" class="form-control" readonly></textarea>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Documento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <button class="btn btn-primary" type="button" onclick="PreviewPDF('@Model.DocumentoRuta.Replace("\\","\\\\")')">Visualizar</button>
        </div>
    </div>
    @if (Model.Secundarios.Length > 2)
    {
        <div class="row mb-2">
            <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
                <h2>Documentos Relacionados</h2>
            </div>
        </div>
        <div class="row mb-2 align-items-center">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <table class="table" id="tabla_secundarios">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Código</th>
                            <th>Tipo de Documento</th>
                            <th>Nombre</th>
                            <th>Versión / Revisión</th>
                            <th>Condición</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (Model.Revisores.Length > 2)
    {
        <div class="row mb-2 mr-2">
            <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
                <h2>Revisores</h2>
            </div>
        </div>
        <div class="row mb-2 mr-2 d-flex justify-content-center">
            <div class="col-sm-12 col-md-12 col-lg-12 mb-2">
                <input type="hidden" asp-for="Revisores" />
                <table class="table" id="tabla_revisores">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Orden</th>
                            <th>Usuario</th>
                            <th>Fecha Limite</th>
                            <th></th>
                            @*if(permiso)
                                <th></th>
                                <th></th>
                            *@
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (Model.Aprobadores.Length > 2)
    {
        <div class="row mb-2 mr-2">
            <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
                <h2>Aprobadores</h2>
            </div>
        </div>
        <div class="row mb-2 mr-2 d-flex justify-content-center">
            <div class="col-sm-12 col-md-12 col-lg-12 mb-2">
                <input type="hidden" asp-for="Aprobadores" />
                <table class="table" id="tabla_aprobadores">
                    <thead class="thead-mcolor">
                        <tr>
                            <th>Orden</th>
                            <th>Usuario</th>
                            <th>Fecha Limite</th>
                            <th></th>
                            @*if(permiso)
                                <th></th>
                                <th></th>
                            *@
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    }
    <div class="row mb-2">
        <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
            <h2>Versiones Anteriores</h2>
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <div class="col-sm-12 col-md-12 col-lg-12">
            <table class="table" id="tabla_documentos">
                <thead class="thead-mcolor">
                    <tr>
                        <th>Código</th>
                        <th>Documento</th>
                        <th>Versión / Revisión</th>
                        <th>Fecha de Aprobación</th>
                        <th>Condición</th>
                        <th>Comentarios</th>
                        <th>Fecha Tentativa de la Nueva Versión</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-end">
        <a class="btn btn-secondary mr-2" style="color:white" asp-controller="SGAAdministracion" asp-action="Resumen">Volver</a>
    </div>
</form>
<!-- Modal Ampliar Fecha-->
<div class="modal fade" id="modal_ampliacion" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_ampliacion"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_ampliacion">
                    Ampliar Fecha Límite
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-2">

                    <div class="col-4">
                        <label>Nueva Fecha:</label>
                    </div>
                    <div class="col-8">
                        <input type="hidden" class="form-control" id="idRevisionAmpliar" />
                        <input type="date" class="form-control" id="nuevaFecha" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <a class="btn btn-primary" style="color:white" onclick="EnviarNuevaFecha()">Guardar</a>
            </div>
        </div>
    </div>
</div>
<!--Modal Preview PDF-->
<div class="modal fade" id="modal_preview_pdf" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_preview_pdf"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo_modal_preview_pdf">
                    Previsualización
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form>
                <div class="modal-body">
                    <div id="viewPDF">

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Volver</button>
                    <button type="button" class="btn btn-primary" id="btn_descargar">Descargar</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            CargarSecundarios();
            ObtenerPredecesores();
            CargarRevisores();
            CargarAprobadores();
            $("#nuevaFecha").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
        });

        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {

                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
        function ObtenerPredecesores() {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/ConsultarPredecesores",
                data: {
                    "IdDocumento": $("#Id_Encriptado").val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_documentos tbody').empty()
                    $('#tabla_documentos tbody').html(response.data)
                }
            });
        }
        function CargarSecundarios() {
            var listSecundarios = @Html.Raw(Model.Secundarios);
            var html = "";
            for(var i = 0; i < listSecundarios.length; i++) {
                html += "<tr>";
                if (listSecundarios[i].Condicion == "Pendiente") {
                    html += "<td><a href=\"/SGAAdministracion/EditarDocumento?IdDocumento=" + listSecundarios[i].IdEncriptado + "\">" + listSecundarios[i].Codigo + "</a></td>";
                } else {
                    html += "<td><a href=\"/SGAAdministracion/VerDocumento?IdDocumento=" + listSecundarios[i].IdEncriptado + "\">" + listSecundarios[i].Codigo + "</a></td>";
                }
                html +="<td>" + listSecundarios[i].TipoDocumento +"</td>" +
                    "<td>" + listSecundarios[i].Nombre +"</td>" +
                    "<td>" + listSecundarios[i].Version +"</td >" +
                    "<td>" + listSecundarios[i].Condicion +"</td >" +
                    "<td><button type=\"button\" class=\"btn btn-primary\" onclick=\"PreviewPDF(\'" + listSecundarios[i].Ruta.replace('\\', '\\\\')+"\')\">Visualizar</button></td >" +
                    "</tr>";
            }
            console.log(html)
            $("#tabla_secundarios tbody").html(html);
        }
        function CargarRevisores() {
            var revisores = JSON.parse('@Html.Raw(Model.Revisores)');
            $("#tabla_revisores tbody").empty();
            var html = LlenarTabla(revisores);
            $("#tabla_revisores tbody").html(html);
        }
        function CargarAprobadores() {
            var aprobadores = JSON.parse('@Html.Raw(Model.Aprobadores)');
            $("#tabla_aprobadores tbody").empty();
            var html = LlenarTabla(aprobadores);
            $("#tabla_aprobadores tbody").html(html);
        }
        function LlenarTabla(lista) {
            var html = "";
            for (var i = 0; i < lista.length; i++) {
                html += "<tr>" +
                    "<td style = \"width: 20%\" ><input class=\"form-control\" type=\"number\" value=\"" + lista[i].Orden + "\" readonly/></td>" +
                    "<td style = \"width: 50%\" ><input class=\"form-control\" type=\"text\" value=\"" + lista[i].UsuarioNombre + "\" readonly/></td>" +
                    "<td style=\"width: 20%\"><input class=\"form-control\" type=\"date\" value=\"" + lista[i].Fecha + "\" readonly/></td>";
                if (lista[i].Estado == "Vencido" && lista[i].Permiso)
                    html += "<td style=\"width: 10%\"><button type=\"button\" class=\"btn btn-primary\" onclick=\"AmpliarFecha(\'" + lista[i].Id + "\')\">Ampliar</button></td>";
                else
                    html += "<td style=\"width: 10%\"></td>";

                html +=   "</tr>";
            }
            return html;
        }
        $("#btn_descargar").on('click', function () {
            if (rutaArchivo == "") {
                //href to
                var ruta = '@Html.Raw(Model.DocumentoRuta.Replace('\\','-'))';
                //Reemplazar parentesis "(" por guión
                ruta = ruta.replace('-', '/');
                window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
            } else {
                //descargar del ROOT
                window.location.replace("/SGADocumentacion/DownloadPreviewFile?path=" + rutaArchivo);
            }
        });
        function AmpliarFecha(Id) {
            $("#modal_ampliacion").modal("show");
            $("#idRevisionAmpliar").val(Id);
        }
        function EnviarNuevaFecha() {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/AmpliarFecha",
                data: {
                    "IdRevision": $("#idRevisionAmpliar").val(),
                    "NuevaFecha": $("#nuevaFecha").val()
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        location.reload();
                    } else {
                        console.log(response.error);
                    }
                }
            });
        }
    </script>
}