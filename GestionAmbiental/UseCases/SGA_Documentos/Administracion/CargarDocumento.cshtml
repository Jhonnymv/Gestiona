@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Cargar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3>Cargar Documento @ViewBag.CategoriaDoc</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_registrar_documento" asp-controller="SGAAdministracion" asp-action="CargarDocumento" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Datos del Documento</span>
                    </div>
                    <input type="hidden" asp-for="IdCategoria" value="@ViewBag.IdCategoria" />
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdSGATipoDocumento"></label>
                            <span class="text-danger" asp-validation-for="IdSGATipoDocumento"></span>
                            <select asp-for="IdSGATipoDocumento" class="form-control" asp-items="ViewBag.TiposDoc"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdElaboradoPor"></label>
                            <span class="text-danger" asp-validation-for="IdElaboradoPor"></span>
                            <select asp-for="IdElaboradoPor" class="form-control" asp-items="ViewBag.Usuarios"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocVersion"></label>
                            <span class="text-danger" asp-validation-for="DocVersion"></span>
                            <input type="text" asp-for="DocVersion" class="form-control" value="1">
                            <div class="text-right">
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocNombre"></label>
                            <span class="text-danger" asp-validation-for="DocNombre"></span>
                            <input type="text" asp-for="DocNombre" class="form-control">
                            <div class="text-right">
                                <span id="contadorNombre">0</span>
                                <span>/ 255</span>
                            </div>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocCodigo"></label>
                            <span class="text-danger" asp-validation-for="DocCodigo"></span>
                            <input type="text" asp-for="DocCodigo" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaAprobacion"></label>
                            <span class="text-danger" asp-validation-for="FechaAprobacion"></span>
                            <input type="date" asp-for="FechaAprobacion" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container align-items-start">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaTentativa"></label>
                            <span class="text-danger" asp-validation-for="FechaTentativa"></span>
                            <input type="date" asp-for="FechaTentativa" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Comentario"></label>
                            <span class="text-danger" asp-validation-for="Comentario"></span>
                            <textarea asp-for="Comentario" class="form-control" maxlength="500"></textarea>
                            <div class="text-right">
                                <span id="contadorComentario">0</span>
                                <span>/ 500</span>
                            </div>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoPdf"></label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoPdf" data-valmsg-replace="true">
                                <span id="danger_documento_pdf" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoPdf" class="form-control" accept=".pdf" data-max-size="8971520">
                        </div>
                    
                            <div class="col-12 col-sm-12 col-lg-6">
                                <label asp-for="DocumentoEditable"></label>
                                <span class="text-danger field-validation-error" data-valmsg-for="DocumentoEditable" data-valmsg-replace="true">
                                    <span id="danger_documento_editable" class=""></span>
                                </span>
                                <input type="file" asp-for="DocumentoEditable" class="form-control" accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx" data-max-size="8971520">
                            </div>
                       
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <a class="btn btn-mc-outline-success" id="btn_descargar_plantilla" href="#" style="display:none">Descargar Plantilla</a>
                        </div>
                    </div>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="row input_container justify-content-center">
                        <div class="col-8">
                            <div class="alert alert-danger" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Error)</div>
                        </div>
                    </div>
                }
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Formatos</span>
                    </div>

                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <button type="button" class="btn btn-mc w-100" id="btn_cargar_formato">Cargar Formato (Opcional)</button>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <button type="button" class="btn btn-mc w-100" id="btn_agregar_formato">Agregar Formato Existente (Opcional)</button>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="table-responsive sga-color">
                            <input type="hidden" asp-for="Secundarios" />
                            <table class="table" id="tabla_secundarios">
                                <thead class="">
                                    <tr>
                                        <th>Código</th>
                                        <th>Tipo de Documento</th>
                                        <th>Nombre</th>
                                        <th>Versión</th>
                                        <th>Condición</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="100">Sin Datos</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Revisores y Aprobadores</span>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 text-center">
                            <button type="button" class="btn btn-mc mr-2" id="btn_agregar_revision">Agregar Revisor/ Aprobador</button>
                        </div>
                    </div>
                    <div class="row input_container">
                        <span class="text-danger" id="danger_revisores"></span>
                    </div>
                    <div class="row input_container mb-2">
                        <div class="table-responsive sga-color">
                            <input type="hidden" asp-for="Revisores" />
                            <table class="table" id="tabla_revisores">
                                <thead class="">
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Fecha de Revisión</th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="100">Sin Datos</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row input_container">
                        <span class="text-danger" id="danger_aprobadores"></span>
                    </div>
                    <div class="row input_container">
                        <div class="table-responsive sga-color">
                            <input type="hidden" asp-for="Aprobadores" />
                            <table class="table" id="tabla_aprobadores">
                                <thead class="">
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Fecha de Aprobación</th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td colspan="100">Sin Datos</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <input type="hidden" asp-for="Opcion" />
                <div class="row">
                    <div class="button-container">
                        <div class="me-2">
                            <a class="btn btn-mc-outline-danger w-100" asp-controller="SGAAdministracion" asp-action="Resumen">Cancelar</a>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc-outline-success w-100" id="btn_guardar_estado">Guardar Estado</button>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc w-100" id="btn_registrar">Registrar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@*Modal Revisión*@
<div class="modal fade" id="modal_revision" tabindex="-1" aria-labelledby="titulo_modal_revision" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
                            <h3 id="titulo_modal_revision">Agregar Revisor/Aprobador</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="container pt-4 pb-4">
                        <div class="custom-form w-100">
                            <div class="detail-container col-12 mb-4">
                                <div class="row mb-2">
                                    <input type="hidden" id="Id_Revision" />
                                    <input type="hidden" id="input_orden_revision" value="1" />
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Tipo de Usuario:</label>
                                        <span class="text-danger" id="danger_modal_tipo"></span>
                                        <select class="form-control" id="select_tipo_revision" asp-items="@ViewBag.TiposRevision">
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Responsable:</label>
                                        <span class="text-danger" id="danger_modal_responsable"></span>
                                        <select class="form-control" id="select_usuario" asp-items="@ViewBag.Usuarios">
                                        </select>
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="col-12">
                                        <label>Fecha Revisión/Aprobación:</label>
                                        <span class="text-danger" id="danger_modal_fecha"></span>
                                        <input type="date" class="form-control" id="input_fecha_limite" />
                                    </div>
                                </div>
                                <div class="row input_container">
                                    <div class="button-container">
                                        <div class="me-2">
                                            <button type="button" class="btn btn-mc-danger" data-dismiss="modal">Cancelar</button>
                                        </div>
                                        <div class="me-2">
                                            <button type="button" class="btn btn-mc" id="btn_editar_revisor">Editar</button>
                                        </div>
                                        <div class="me-2">
                                            <button type="button" class="btn btn-mc-success" id="btn_confirmar_revisor">Agregar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!--Modal Preview PDF-->
<div class="modal fade" id="modal_preview_pdf" tabindex="-1" aria-labelledby="titulo_modal_preview_pdf" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
                            <h3>Previsualización</h3>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <form>
                    <div class="modal-body">
                        <div id="viewPDF">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-mc-outline-danger me-2" data-dismiss="modal">Volver</button>
