@section Scripts{
    <script src="~/lib/pdfobject/pdfobject.min.js"></script>
    <script type="text/javascript">
        var listAprobadores = [];
        var listRevisores = [];
        var listSecundarios = [];
        var listSecundariosHtml = [];
        var IdPrimerUsuario;
        var listTipoDocRuta = @Html.Raw(ViewBag.TiposDocRuta);

        $(document).ready(function () {
            IdPrimerUsuario = $("#select_usuario").val();
            ConsultarPublicados();
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/SGADocumentacion/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        sgaStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function ConsultarPublicados() {
            $.ajax({
                type: "POST",
                url: "/SGAAdministracion/ConsultarPublicados",
                data: {
                    "IdCategoria": $("#IdCategoria").val()
                },
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        listSecundariosHtml = JSON.parse(response.publicadosHtml);
                    } else {
                        console.log(response.message);
                    }
                }
            });
        }
        function PreviewPDF(ruta) {
            if (PDFObject.supportsPDFs) {
                $.ajax({
                    type: "POST",
                    url: "/SGADocumentacion/PreviewFile",
                    data: {
                        "fileName": ruta,
                    },
                    traditional: true,
                    success: (response) => {
                        if (response.result == "Ok") {
                            PDFObject.embed(response.path, "#viewPDF");
                            rutaArchivo = response.path
                            $("#modal_preview_pdf").modal("show");
                            if (response.extension == ".pdf")
                                $("#viewPDF").css("height", "800px");
                            else {
                                $("#viewPDF").html("<h2>No se pudo previsualizar el archivo</h2>")
                            }

                        } else {
                            alert("No se pudo visualizar el archivo: " + response.message);
                            $("#modal_preview_pdf").modal("show");
                        }
                    }
                });
            } else {
                alert("El navegador no es compatible con la previsualización del documento")
            }
        }
        function DescargarEditable(ruta) {
            ruta = ruta.replace('-', '/');
            window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
        }
        $("#DocumentoPdf").change(function () {
            $("#danger_documento_pdf").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoPdf").data('max-size');
            var archivos = $("#DocumentoPdf").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_pdf").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_pdf").text(filesname);
                            $("#danger_documento_pdf").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_pdf").html(filesName) : null;
            }
        });
        $("#DocumentoEditable").change(function () {
            $("#danger_documento_editable").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#DocumentoEditable").data('max-size');
            var archivos = $("#DocumentoEditable").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_documento_editable").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'ppt':
                        case 'pptx':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name_editable").text(filesname);
                            $("#danger_documento_editable").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name_editable").html(filesName) : null;
            }
        });
        $("#IdSGATipoDocumento").on("change", function () {
            $("#btn_descargar_plantilla").hide();
            var id = $("#IdSGATipoDocumento").val();
            for (var i = 0; i < listTipoDocRuta.length; i++) {
                if (id == listTipoDocRuta[i].Id && listTipoDocRuta[i].Ruta != 0) {
                    $("#btn_descargar_plantilla").attr("href", "@Url.Action("DescargarPlantilla", "SGAAdministracion")" + "?IdCategoriaTipo=" + id);
                    $("#btn_descargar_plantilla").show();
                    return;
                }
            }
        });
        $("#btn_guardar_estado").on("click", function () {
            if (ValidarDatos()) {
                $("#Opcion").val("GuardarEstado");
                $("#modal_registrando").modal('show');
                $("#mensajeModalConfig").text("Guardando Informacion")
                $("#form_registrar_documento").submit();
            }
        });
        $("#btn_registrar").on("click", function () {
            if (ValidarDatos() @*&& ValidarDatosRevisores()*@) {
            $("#Opcion").val("Registrar");
            $("#modal_registrando").modal('show');
            $("#mensajeModalConfig").text("Guardando Informacion")
            $("#form_registrar_documento").submit();
        }
