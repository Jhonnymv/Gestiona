        $("#Documento_Formato_Editable").change(function () {
            $("#danger_documento_formato_editable").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Documento_Formato_Editable").data('max-size');
            var archivos = $("#Documento_Formato_Editable").get(0).files;

