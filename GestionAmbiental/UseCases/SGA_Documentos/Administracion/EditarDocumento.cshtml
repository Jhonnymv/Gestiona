        function CargarSecundarios() {
            var htmlData = @Html.Raw(ViewBag.SecundariosData);
            var html = "";
            if (htmlData.length > 0) {
                for (var i = 0; i < htmlData.length; i++) {
                    listSecundarios.push(htmlData[i].Id);
                    html += "<tr iddoc=\"" + htmlData[i].Id + "\">";
                    if (htmlData[i].Condicion == "Pendiente") {
                        html += "<td><a href=\"/SGAAdministracion/EditarDocumento?IdDocumento=" + htmlData[i].IdEncriptado + "&IdCategoria=" + "@Model.IdCategoria" + "\">" + htmlData[i].Codigo + "</a></td>";
                    } else {
                        html += "<td><a href=\"/SGAAdministracion/VerDocumento?IdDocumento=" + htmlData[i].IdEncriptado + "\">" + htmlData[i].Codigo + "</a></td>";
                    }
                    html += "<td>" + htmlData[i].TipoDocumento + "</td>" +
                        "<td>" + htmlData[i].Nombre + "</td>" +
                        "<td>" + htmlData[i].Version + "</td >" +
                        "<td>" + htmlData[i].Condicion + "</td >" +
                        "<td><button type=\"button\" class=\"btn btn-primary\" onclick=\"PreviewPDF(\'" + htmlData[i].RutaPdf.replace('\\', '\\\\') + "\')\">Visualizar Pdf</button></td >" +
                        "<td><button type=\"button\" class=\"btn btn-primary\" onclick=\"DescargarEditable(\'" + htmlData[i].RutaEditable.replace('\\', '-') + "\')\">Descargar Editable</button></td >" +
                        "<td><button type=\"button\" class=\"btn btn-danger\" onclick=\"EliminarSecundario(" + htmlData[i].Id + ")\">Eliminar</button></td>" +
                        "</tr>";
                }
            } else {
                html += "<tr><td colspan=\"100%\">Sin Datos</td></tr>"
            }
            $("#tabla_secundarios tbody").html(html);
            dataModulo();
        }
