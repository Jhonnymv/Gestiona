@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Editar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="sga">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title sga-opacity-color">
                <h3>Editar Documento @ViewBag.CategoriaDoc</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" id="form_editar_documento" asp-controller="SGAAdministracion" asp-action="EditarDocumento" method="post" enctype="multipart/form-data" autocomplete="off">

                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Datos del Documento</span>
                    </div>
                    <input type="hidden" asp-for="IdEncriptado" value="@Model.IdEncriptado" />
                    <input type="hidden" asp-for="IdSGADocumento" value="@Model.IdSGADocumento" />
                    <input type="hidden" asp-for="IdCategoria" value="@Model.IdCategoria" />
                    <input type="hidden" asp-for="DocPredecesor" value="@Model.DocPredecesor" />
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdSGATipoDocumento"></label>
                            <span class="text-danger" asp-validation-for="IdSGATipoDocumento"></span>
                            <select asp-for="IdSGATipoDocumento" class="form-control" asp-items="ViewBag.TiposDoc"></select>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="IdElaboradoPor"></label>
                            <select asp-for="IdElaboradoPor" class="form-control" asp-items="ViewBag.Usuarios"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocVersion"></label>
                            <span class="text-danger" asp-validation-for="DocVersion"></span>
                            <input type="number" asp-for="DocVersion" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocNombre"></label>
                            <span class="text-danger" asp-validation-for="DocNombre"></span>
                            <input type="text" asp-for="DocNombre" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocCodigo"></label>
                            <span class="text-danger" asp-validation-for="DocCodigo"></span>
                            <input type="text" asp-for="DocCodigo" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaAprobacion"></label>
                            <span class="text-danger" asp-validation-for="FechaAprobacion"></span>
                            <input type="date" asp-for="FechaAprobacion" class="form-control">
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="FechaTentativa"></label>
                            <span class="text-danger" asp-validation-for="FechaTentativa"></span>
                            <input type="date" asp-for="FechaTentativa" class="form-control">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Condicion"></label>
                            <span class="text-danger" asp-validation-for="Condicion"></span>
                            <select asp-for="Condicion" class="form-control" asp-items="ViewBag.Condiciones" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container align-items-start">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="Comentario"></label>
                            <span class="text-danger" asp-validation-for="Comentario"></span>
                            <textarea asp-for="Comentario" class="form-control" maxlength="500"></textarea>
                            <div class="text-right">
                                <span id="contadorComentario">0</span>
                                <span>/ 500</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoPdf"></label>
                            <button class="btn btn-mc form-control" type="button" onclick="this.disabled = true; PreviewPDF('@Model.DocPdfRuta.Replace("\\", "\\\\")');this.disabled=false;">Visualizar PDF</button>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label>Reemplazar Documento Pdf</label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoPdf" data-valmsg-replace="true">
                                <span id="danger_documento_pdf" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoPdf" class="form-control" accept=".pdf" data-max-size="8971520">
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label asp-for="DocumentoEditable"></label>
                            <button class="btn btn-mc form-control" type="button" onclick="DescargarEditable('@Model.DocEditableRuta.Replace('\\', '-')')">Descargar Editable</button>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <label>Reemplazar Documento Editable</label>
                            <span class="text-danger field-validation-error" data-valmsg-for="DocumentoEditable" data-valmsg-replace="true">
                                <span id="danger_documento_editable" class=""></span>
                            </span>
                            <input type="file" asp-for="DocumentoEditable" class="form-control" accept=".doc,.docx,.xls,.xlsx,.ppt,.pptx" data-max-size="8971520">
                        </div>
                    </div>
                    <input type="hidden" asp-for="DocPdfRuta" value="@Model.DocPdfRuta" />
                    <input type="hidden" asp-for="DocEditableRuta" value="@Model.DocEditableRuta" />
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="row input_container justify-content-center">
                        <div class="col-8">
                            <div class="alert alert-danger" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Error)</div>
                        </div>
                    </div>
                }
                <div class="col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-6">
                            <button type="button" class="btn btn-mc w-100" id="btn_cargar_formato">Cargar Formato (Opcional)</button>
                        </div>
                        <div class="col-12 col-sm-12 col-lg-6">
                            <button type="button" class="btn btn-mc w-100" id="btn_agregar_formato">Agregar Formato Existente (Opcional)</button>
                        </div>
                    </div>
                </div>
                @if (Model.Secundarios.Length > 2 || Model.IdCategoria.Equals(1))
                {
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Formatos</span>
                        </div>
                        <div class="row input_container">
                            <div class="table-responsive sga-color">
                                <input type="hidden" asp-for="Secundarios" />
                                <table class="table" id="tabla_secundarios">
                                    <thead class="">
                                        <tr>
                                            <th>Código</th>
                                            <th>Tipo de Documento</th>
                                            <th>Nombre</th>
                                            <th>Versión</th>
                                            <th>Condición</th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td colspan="100%">Sin Datos</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.IdCategoria.Equals(1))
                {
                    <div class="detail-container col-12 col-xl-10 mb-4">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center text-uppercase">Revisores y Aprobadores</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 text-center">
                                <button type="button" class="btn btn-mc mr-2" id="btn_agregar_revision">Agregar Revisor/ Aprobador</button>
                            </div>
                        </div>
                        <div class="row input_container">
                            <span class="text-danger" id="danger_revisores"></span>
                        </div>
                        <div class="row input_container mb-2">
                            <div class="table-responsive sga-color">
                                <input type="hidden" asp-for="Revisores" />
                                <table class="table" id="tabla_revisores">
                                    <thead class="">
                                        <tr>
                                            <th>Usuario</th>
                                            <th>Fecha de Revisión</th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td colspan="100%">Sin Datos</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row input_container">
                            <span class="text-danger" id="danger_aprobadores"></span>
                        </div>
                        <div class="row input_container">
                            <div class="table-responsive sga-color">
                                <input type="hidden" asp-for="Aprobadores" />
                                <table class="table" id="tabla_aprobadores">
                                    <thead class="">
                                        <tr>
                                            <th>Usuario</th>
                                            <th>Fecha de Aprobación</th>
                                            <th></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="d-flex justify-content-center">
                        <span class="text-mc bold text-center text-uppercase">Versiones Anteriores</span>
                    </div>
                    <div class="row input_container">
                        <div class="table-responsive sga-color">
                            <table class="table" id="tabla_documentos">
                                <thead class="">
                                    <tr>
                                        <th>Código</th>
                                        <th>Documento</th>
                                        <th>Versión / Revisión</th>
                                        <th>Fecha de Aprobación</th>
                                        <th>Condición</th>
                                        <th>Comentarios</th>
                                        <th>Fecha Tentativa de la Nueva Versión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <input type="hidden" asp-for="Opcion" />
                <div class="row">
                    <div class="button-container">
                        <div class="me-2">
                            <a class="btn btn-mc-outline-danger w-100" asp-controller="SGAAdministracion" asp-action="Resumen">Cancelar</a>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc w-100" id="btn_guardar_estado">Guardar Estado</button>
                        </div>
                        <div class="me-2">
                            <button type="button" class="btn btn-mc-success w-100" id="btn_registrar">Registrar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

