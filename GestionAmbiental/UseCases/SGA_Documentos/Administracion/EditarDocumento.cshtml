<!--Modal Revisión-->
<div class="modal fade" id="modal_revision" tabindex="-1" aria-labelledby="titulo_modal_revision" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-menu modal-sga">
            <div class="modal-content">
                <div class="sga">
                    <div class="image-header-container">
                        <div class="header-title sga-opacity-color">
