        $("#btn_agregar_formato").on("click", function () {
            $("#modal_agregar_formato").modal('show');
        });
        $("#btn_cargar_formato").on("click", function () {
            $("#modal_formato").modal('show');
        });
        function AgregarFormato() {
            var seleccionado = parseInt($("#Id_Formato_Publicado").val());
            for (var i = 0; i < listSecundariosHtml.length; i++) {
                if (seleccionado == listSecundariosHtml[i].Id) {
                    $('#modal_agregar_formato').modal('toggle');
                    listSecundarios.push(parseInt(seleccionado));
                    $('#tabla_secundarios tbody').append(listSecundariosHtml[i].Html);
                    dataModulo();
                    $('#Id_Formato_Publicado option').each(function () {
                        if ($(this).val() == seleccionado) {
                            $(this).remove();
                        }
                    });
                    $('#Secundarios').val(JSON.stringify(listSecundarios));
                    return;
                }
            }
        }
        function GuardarFormato() {
            var tipoDoc = $("#Id_Tipo_Documento_Formato").val();
            var fechaTentativa = $("#Fecha_Tentativa_Formato").val();
            var fechaAprobacion = $("#Fecha_Aprobacion_Formato").val();
            var nombreFormato = $("#Doc_Nombre_Formato").val();
            var versionFormato = $("#Doc_Version_Formato").val();
            var elaborador = $("#Id_Elaborado_Por").val();
            var formatoPdf = document.getElementById("Documento_Formato_Pdf").files;
            var formatoEditable = document.getElementById("Documento_Formato_Editable").files;
            var comentarioFormato = $("#Comentario_Formato").val();
            if (ValidarNuevoFormato(tipoDoc, fechaTentativa, fechaAprobacion, nombreFormato, versionFormato, formatoPdf, formatoEditable, comentarioFormato, elaborador)) {
                var formData = new FormData();
                var filesPdf = document.getElementById("Documento_Formato_Pdf").files;
                for (var i = 0; i != filesPdf.length; i++) {
                    formData.append("Documento_Formato_Pdf", filesPdf[i]);
                }
                var filesEditable = document.getElementById("Documento_Formato_Editable").files;
                for (var i = 0; i != filesEditable.length; i++) {
                    formData.append("Documento_Formato_Editable", filesEditable[i]);
                }
                formData.append("Id_Tipo_Documento_Formato", tipoDoc);
                formData.append("Fecha_Tentativa", fechaTentativa);
                formData.append("Fecha_Aprobacion", fechaAprobacion);
                formData.append("Doc_Nombre_Formato", nombreFormato);
                formData.append("Doc_Version_Formato", versionFormato);
                formData.append("Id_Elaborado_Por", elaborador);
                formData.append("Documento_Formato_Pdf", $("#Documento_Formato_Pdf").val());
                formData.append("Documento_Formato_Editable", $("#Documento_Formato_Editable").val());
                formData.append("Comentario_Formato", comentarioFormato);
                $.ajax({
                    url: "@Url.Action("CargarFormato", "SGAAdministracion")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            listSecundarios.push(response.idDoc);
                            $('#tabla_secundarios tbody').append(response.html);
                            $('#modal_formato').modal('toggle');
                            $('#Secundarios').val(JSON.stringify(listSecundarios));
                            ReiniciarModalFormato();
                            dataModulo();
                        }
                        else {
                            alert("Ocurrió un error al cargar el formato")
                        }
                    }
                });
            }
        }
        function ValidarNuevoFormato(tipoDoc, fechaTentativa, fechaAprobacion, nombreFormato, versionFormato, formatoPdf, formatoEditable, comentarioFormato, elaborador) {
            var result = true;
            $("#Id_Tipo_Documento_Formato_Msg").text("");
            $("#Fecha_Tentativa_Formato_Msg").text("");
            $("#Fecha_Aprobacion_Formato_Msg").text("");
            $("#Id_Elaborado_Por_Msg").text("");
            $("#Doc_Nombre_Formato_Msg").text("");
            $("#Doc_Version_Formato_Msg").text("");
            $("#danger_documento_formato_pdf").text("");
            $("#danger_documento_formato_editable").text("");
            $("#Comentario_Formato_Msg").text("");
            if (tipoDoc == "0") {
                result = false;
                $("#Id_Tipo_Documento_Formato_Msg").text("Debe seleccionar una opción");
            }
            if (elaborador == "0") {
                result = false;
                $("#Id_Elaborado_Por_Msg").text("Debe seleccionar una opción");
            }
            if (fechaTentativa == "") {
                result = false;
                $("#Fecha_Tentativa_Formato_Msg").text("Debe completar este campo");
            }
            if (fechaAprobacion == "") {
                result = false;
                $("#Fecha_Aprobacion_Formato_Msg").text("Debe completar este campo");
            }
            if (nombreFormato == "") {
                result = false;
                $("#Doc_Nombre_Formato_Msg").text("Debe completar este campo");
            }
            if (versionFormato == "") {
                result = false;
                $("#Doc_Version_Formato_Msg").text("Debe completar este campo");
            }
            if (formatoPdf.length == 0) {
                result = false;
                $("#danger_documento_formato_pdf").text("Debe cargar un archivo");
            }
            if (formatoEditable.length == 0) {
                result = false;
                $("#danger_documento_formato_editable").text("Debe cargar un archivo");
            }
            if (comentarioFormato == "") {
                result = false;
                $("#Comentario_Formato_Msg").text("Debe completar este campo");
            }
            return result;
        }
        function ReiniciarModalFormato() {
            $("#Id_Tipo_Documento_Formato").val('0');
            $("#Id_Elaborado_Por").val('0');
            $("#Fecha_Tentativa_Formato").val('');
            $("#Fecha_Aprobación_Formato").val('');
            $("#Doc_Nombre_Formato").val('');
            $("#Doc_Version_Formato").val(parseFloat(1.0).toFixed(2));
            $("#Comentario_Formato").val('');
            $("#Documento_Formato_Pdf").val('');
            $("#Documento_Formato_Editable").val('');
        }
        function EliminarSecundario(id) {
            var trToFind = "#tabla_secundarios tbody tr[iddoc=" + id + "]";
            $(trToFind).remove();
            quitarItemArray(listSecundarios, id);
            $('#Secundarios').val(JSON.stringify(listSecundarios));
        }
        function quitarItemArray(arr, value) {
            var index = arr.indexOf(value);
            if (index > -1) {
                arr.splice(index, 1);
            }
            return arr;
        }

        //Script Revisores
        $("#btn_agregar_revision").on("click", function () {
            $("#btn_editar_revisor").hide();
            $("#btn_confirmar_revisor").show();
            $("#modal_revision").modal('show');
        });
        $("#select_tipo_revision").on("change", function () {
            if ($(this).val() == 1) {
                $("#input_orden_revision").val(listRevisores.length + 1);
            }
            else if ($(this).val() == 2) {
                $("#input_orden_revision").val(listAprobadores.length + 1);
            }
        });
        $("#btn_confirmar_revisor").on("click", function () {
            //Guardar Datos y redireccionar a Editar
            if (ValidarDatosModal()) {
                var tipo = $("#select_tipo_revision").val();

                var revisor = {
                    Orden: parseInt($("#input_orden_revision").val()),
                    Usuario: parseInt($("#select_usuario").val()),
                    UsuarioNombre: $("#select_usuario").find("option:selected").text(),
                    Fecha: $("#input_fecha_limite").val()
                };

                tipo == '1' ? listRevisores.push(revisor) : listAprobadores.push(revisor);

                $("#select_tipo_revision").val(0);
                $("#select_usuario").val(IdPrimerUsuario);
                $("#input_fecha_limite").val("");
                $("#modal_revision").modal('toggle');

                //Cargar datos a tablas y reemplazar valor del modelo (Revisores o Aprobadores en JSON)
                if (tipo == '1') {
                    $("#tabla_revisores tbody").empty();
                    var html = LlenarTabla(tipo, listRevisores);
                    $("#tabla_revisores tbody").html(html);
                    $("#Revisores").val(JSON.stringify(listRevisores));
                    dataModulo();

                } else if (tipo == '2') {
                    $("#tabla_aprobadores tbody").empty();
                    var html = LlenarTabla(tipo, listAprobadores);
                    $("#tabla_aprobadores tbody").html(html);
                    $("#Aprobadores").val(JSON.stringify(listAprobadores));
                    dataModulo();
                }
            }
        });
        $("#btn_editar_revisor").on("click", function () {
            //Guardar Datos y redireccionar a Editar
            if (ValidarDatosModal()) {
                var tipo = $("#select_tipo_revision").val();
                var orden = parseInt($("#input_orden_revision").val())
                var revisor = {
                    Orden: orden,
                    Usuario: parseInt($("#select_usuario").val()),
                    UsuarioNombre: $("#select_usuario").find("option:selected").text(),
                    Fecha: $("#input_fecha_limite").val()
                };
                if (tipo == '1') {
                    listRevisores[orden - 1] = revisor;
                }
                else if (tipo == '2') {
                    listAprobadores[orden - 1] = revisor;
                }

                $("#select_tipo_revision").val(0);
                $("#select_usuario").val(IdPrimerUsuario);
                $("#input_fecha_limite").val("");
                $("#modal_revision").modal('toggle');
                $("#btn_editar_revisor").hide();

                //Cargar datos a tablas y reemplazar valor del modelo (Revisores o Aprobadores en JSON)
                if (tipo == '1') {
                    $("#tabla_revisores tbody").empty();
                    var html = LlenarTabla(tipo, listRevisores);
                    $("#tabla_revisores tbody").html(html);
                    $("#Revisores").val(JSON.stringify(listRevisores));
                    dataModulo();

                } else if (tipo == '2') {
                    $("#tabla_aprobadores tbody").empty();
                    var html = LlenarTabla(tipo, listAprobadores);
                    $("#tabla_aprobadores tbody").html(html);
                    $("#Aprobadores").val(JSON.stringify(listAprobadores));
                    dataModulo();
                }
            }
        });
        //Validacion para el modal de revisores
        function ValidarDatosModal() {
            var tipo = $("#select_tipo_revision").val();
            var orden = $("#input_orden_revision").val();
            var idUsuario = $("#select_usuario").val();
            var fecha = $("#input_fecha_limite").val();

            $("#danger_modal_tipo").text("");
            $("#danger_modal_responsable").text("");
            $("#danger_modal_fecha").text("");

            if (tipo != '0' && orden != "" && idUsuario != '0' && fecha != "")
                return true;
            else {
                if (tipo == '0') {
                    $("#danger_modal_tipo").text("Debe seleccionar un tipo de revisión");
                }
                if (idUsuario == '0') {
                    $("#danger_modal_responsable").text("Debe seleccionar a un responsable");
                }
                if (fecha == "") {
                    $("#danger_modal_fecha").text("Debe seleccionar una fecha");
                }
            }
            return false;
        }
        function CargarRevisores() {
            listRevisores = JSON.parse('@Html.Raw(Model.Revisores)');
            $("#tabla_revisores tbody").empty();
            var html = LlenarTabla(1, listRevisores);
            $("#tabla_revisores tbody").html(html);
        }
        function CargarAprobadores() {
            listAprobadores = JSON.parse('@Html.Raw(Model.Aprobadores)');
            $("#tabla_aprobadores tbody").empty();
            var html = LlenarTabla(2, listAprobadores);
            $("#tabla_aprobadores tbody").html(html);
        }
        function EditarRevisor(tipo, orden) {
            $("#btn_editar_revisor").show();
            $("#btn_confirmar_revisor").hide();
            $("#modal_revision").modal('show');

            $("#select_tipo_revision").val(tipo);
            if (tipo == 1) {
                $("#input_orden_revision").val(listRevisores[orden - 1].Orden)
                $("#select_usuario").val(listRevisores[orden - 1].Usuario);
                $("#input_fecha_limite").val(listRevisores[orden - 1].Fecha);
            }
            else if (tipo == 2) {
                $("#input_orden_revision").val(listAprobadores[orden - 1].Orden)
                $("#select_usuario").val(listAprobadores[orden - 1].Usuario);
                $("#input_fecha_limite").val(listAprobadores[orden - 1].Fecha);
            }
        }
        function EliminarRevisor(tipo, orden) {
            if (tipo == 1) {
                for (var i = 0; i < listRevisores.length; i++) {
                    if (listRevisores[i].Orden > orden)
                        listRevisores[i].Orden -= 1;
                }

                //Cargar datos a tablas y reemplazar valor del modelo (Revisores o Aprobadores en JSON)
                listRevisores.splice(orden - 1, 1);
                $("#tabla_revisores tbody").empty();
                var html = LlenarTabla(tipo, listRevisores);
                $("#tabla_revisores tbody").html(html);
                $("#Revisores").val(JSON.stringify(listRevisores));
                dataModulo();

            }
            else if (tipo == 2) {
                for (var i = 0; i < listAprobadores.length; i++) {
                    if (listAprobadores[i].Orden > orden)
                        listAprobadores[i].Orden -= 1;
                }

                //Cargar datos a tablas y reemplazar valor del modelo (Revisores o Aprobadores en JSON)
                listAprobadores.splice(orden - 1, 1);
                $("#tabla_aprobadores tbody").empty();
                var html = LlenarTabla(tipo, listAprobadores);
                $("#tabla_aprobadores tbody").html(html);
                $("#Aprobadores").val(JSON.stringify(listAprobadores));
                dataModulo();
            }
        }
        function LlenarTabla(tipo, lista) {
            var html = "";
            if (lista.length > 0) {
                for (var i = 0; i < lista.length; i++) {
                    html += "<tr>" +
                    @*"<td style = \"width: 20%\" ><input class=\"form-control\" type=\"number\" style=\"width:50px\"  value=\"" + lista[i].Orden + "\" readonly/></td>" +*@
                        "<td style = \"width: 50%\" ><input class=\"form-control text-center\" type=\"text\" value=\"" + lista[i].UsuarioNombre + "\" readonly/></td>" +
                        "<td style=\"width: 20%\"><input class=\"form-control text-center\" type=\"date\" value=\"" + lista[i].Fecha + "\" readonly/></td>" +
                        "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn btn-primary\" onclick=\"EditarRevisor(" + tipo + "," + lista[i].Orden + ")\"><img src=\"/img/icons/edit-icon.png\"/></button></td >" +
                        "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn\" onclick=\"EliminarRevisor(" + tipo + "," + lista[i].Orden + ")\"><img src=\"/img/icons/cross.png\"/></button></td >" +
                        "</tr>";
                }
            } else {
                html += "<tr><td colspan=\"100%\">Sin Datos</td></tr>";
            }
            return html;
        }
        $('#Comentario').keyup(function () {
            var characterCount = $(this).val().length;
            $('#contadorComentario').text(characterCount);
        });
        $('#Comentario_Formato').keyup(function () {
            var characterCount = $(this).val().length;
            $('#contadorComentarioFormato').text(characterCount);
        });
