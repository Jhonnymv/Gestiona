                var ruta = '@Html.Raw(Model.DocPdfRuta.Replace('\\','-'))';
                //Reemplazar parentesis "(" por guión
                ruta = ruta.replace('-', '/');
                window.location.replace("/SGADocumentacion/Download?fileName=" + ruta);
            } else {
                //descargar del ROOT
                window.location.replace("/SGADocumentacion/DownloadPreviewFile?path=" + rutaArchivo);
            }
        });
        //Validacion para guardar estado, registrar o agregar formato
        function ValidarDatos() {
            var tipo = $("#IdSGATipoDocumento").val();
            var elaborador = $("#IdElaboradoPor").val();
            var version = $("#DocVersion").val();
            var codigo = $("#DocCodigo").val();
            var nombre = $("#DocNombre").val();
            var fechaAprobacion = $("#FechaAprobacion").val();
            var fechaTentativa = $("#FechaTentativa").val();
            var comentario = $("#Comentario").val();
            var documentoPdf = $("#DocumentoPdf").val();
            var documentoEditable = $("#DocumentoEditable").val();

            $('span[data-valmsg-for="IdSGATipoDocumento"]').text("");
            $('span[data-valmsg-for="IdElaboradoPor"]').text("");
            $('span[data-valmsg-for="DocVersion"]').text("");
            $('span[data-valmsg-for="DocCodigo"]').text("");
            $('span[data-valmsg-for="DocNombre"]').text("");
            $('span[data-valmsg-for="FechaAprobacion"]').text("");
            $('span[data-valmsg-for="FechaTentativa"]').text("");
            $('span[data-valmsg-for="Comentario"]').text("");
            $('span[data-valmsg-for="DocumentoPdf"]').text("");
            $('span[data-valmsg-for="DocumentoEditable"]').text("");

            if (tipo != '0' && elaborador != '0' && version != "" && nombre != "" && documentoPdf != "" && fechaAprobacion != "" && fechaTentativa != "" && comentario != "" && documentoEditable != "" && codigo != "" && !listCodigos.includes(codigo))
                return true;
            else {
                if (tipo == '0')
                    $('span[data-valmsg-for="IdSGATipoDocumento"]').text("Debe seleccionar una opción");
                if (elaborador == '0')
                    $('span[data-valmsg-for="IdElaboradoPor"]').text("Debe seleccionar una opción");
                if (version == "")
                    $('span[data-valmsg-for="DocVersion"]').text("Este campo es requerido");
                if (nombre == "")
                    $('span[data-valmsg-for="DocNombre"]').text("Este campo es requerido");
                if (codigo == "")
                    $('span[data-valmsg-for="DocCodigo"]').text("Este campo es requerido");
                if (fechaAprobacion == "")
                    $('span[data-valmsg-for="FechaAprobacion"]').text("Este campo es requerido");
                if (fechaTentativa == "")
                    $('span[data-valmsg-for="FechaTentativa"]').text("Este campo es requerido");
                if (comentario == "")
                    $('span[data-valmsg-for="Comentario"]').text("Este campo es requerido");
                if (listCodigos.includes(codigo))
                    $('span[data-valmsg-for="DocCodigo"]').text("El código ingresado ya fue utilizado");
                if (documentoPdf == "")
                    $('span[data-valmsg-for="DocumentoPdf"]').text("Debe cargar un archivo");
                if (documentoEditable == "")
                    $('span[data-valmsg-for="DocumentoEditable"]').text("Debe cargar un archivo");
                return false;
            }
        }
        //Scripts del Partial
        $("#Documento_Formato_Pdf").change(function () {
