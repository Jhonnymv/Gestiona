@model GestionAmbiental.UseCases.SGA_Documentos.SGADocumentoModel
@{
    ViewData["Title"] = "Registrar Documento";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Nuevo Documento</h2>
    </div>
</div>
<form class="form-group" id="form_registrar_documento" asp-action="RegistrarDocumento" asp-controller="SGADocumentos" method="post" enctype="multipart/form-data" autocomplete="off">
    <div class="row mb-2 align-items-center">
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Id_SGA_Tipo_Documento"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Id_SGA_Tipo_Documento"></span>
            <select asp-for="Id_SGA_Tipo_Documento" class="form-control" asp-items="ViewBag.TiposDoc"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Version"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Version"></span>
            <input type="number" asp-for="Doc_Version" class="form-control" step=".01">
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Nombre"></label>
        </div>
        <div class="col-sm-12 col-md-9 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Nombre"></span>
            <input type="text" asp-for="Doc_Nombre" class="form-control">
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Doc_Predecesor"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Doc_Predecesor"></span>
            <select asp-for="Doc_Predecesor" class="form-control" asp-items="ViewBag.Predecesores"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Condicion"></label>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Condicion"></span>
            <select asp-for="Condicion" class="form-control" asp-items="ViewBag.Condiciones"></select>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Comentario"></label>
        </div>
        <div class="col-sm-12 col-md-6 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Comentario"></span>
            <textarea asp-for="Comentario" class="form-control"></textarea>
        </div>
        <div class="col-sm-12 col-md-3 col-lg-2 mb-2">
            <label asp-for="Documento"></label>
        </div>
        <div class="col-sm-12 col-md-6 col-lg-4 mb-2">
            <span class="text-danger field-validation-error" data-valmsg-for="Documento" data-valmsg-replace="true">
                <span id="danger_documento" class=""></span>
            </span>
            <label class="btn btn-primary" for="Documento">Seleccione</label>
            <input type="file" style="visibility:hidden; display:none" asp-for="Documento" accept=".pdf" data-max-size="8971520">
        </div>
    </div>
    <div class="row mb-2 mr-2">
        <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
            <h2>Revisores</h2>
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-center">
        <div class="col-sm-12 col-md-9 col-lg-6 mb-2">
            <table class="table" id="tabla_revisores">
                <thead class="thead-mcolor">
                    <tr>
                        <th>Orden</th>
                        <th>Usuario</th>
                        <th>Fecha Limite</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="Revisor1">
                        <td style="width: 20%"><input class="form-control" type="number" id="ordenRevisor1" value="1" /></td>
                        <td style="width: 50%"><select class="form-control" id="usuarioRevisor1"></select></td>
                        <td style="width: 20%"><input class="form-control" type="date" id="fechaRevisor1" /></td>
                        <td style="width: 10%"></td>
                    </tr>
                    <tr id="NuevaFilaRevisor">
                        <td style="width: 100%" colspan="4"><button type="button" id="btnAgregarAprobador" class="btn btn-outline-primary" style="width: 100%" onclick="AgregarFilaRevisor(2)">Nueva Fila</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row mb-2 mr-2">
        <div class="col-sm-12 col-md-12 col-lg-12 mb-2 text-center">
            <h2>Aprobadores</h2>
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-center">
        <div class="col-sm-12 col-md-9 col-lg-6 mb-2">
            <table class="table" id="tabla_aprobadores">
                <thead class="thead-mcolor">
                    <tr>
                        <th>Orden</th>
                        <th>Usuario</th>
                        <th>Fecha Limite</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>                   
                    <tr id="Aprobador1">
                        <td style="width: 20%"><input class="form-control" type="number" id="ordenAprobador1" value="1" /></td>
                        <td style="width: 50%"><select class="form-control" id="usuarioAprobador1"></select></td>
                        <td style="width: 30%"><input class="form-control" type="date" id="fechaAprobador1" /></td>
                        <td style="width: 10%"></td>
                    </tr>
                    <tr id="NuevaFilaAprobador">
                        <td style="width: 100%" colspan="4"><button type="button" id="btnAgregarAprobador" class="btn btn-outline-primary" style="width: 100%" onclick="AgregarFilaAprobador(2)">Nueva Fila</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row mb-2 mr-2 d-flex justify-content-end">
        <a class="btn btn-secondary mr-2" style="color:white" asp-controller="SGADocumentos" asp-action="Resumen">Cancelar</a>
        <button type="submit" class="btn btn-primary mr-2">Registrar</button>
    </div>
</form>

@section Scripts{ 
    <script type="text/javascript">
        //Validar que el orden no se repita
        //Validar como minimo 1 revisor y aprobador

        var usuarios = JSON.parse('@Html.Raw(ViewBag.Usuarios)')
        var optionsUsuario = usuarios.map(function (val, ind) {
            return $("<option></option>").val(val.Value).html(val.Text);
        });
        var filasAprobador = 1;
        var idsfilasAprobador = 1;
        var filasRevisor = 1;
        var idsfilasRevisor = 1;


        $(document).ready(function () {
            $('#usuarioAprobador1,#usuarioRevisor1').append(optionsUsuario);
            $("#fechaAprobador1,#fechaRevisor1").prop("min", '@Html.Raw(ViewBag.FechaHoy)');
        });

        function filaValida(fila) {
            var orden = fila.find("#orden").val();
            var idUsuario = fila.find("#usuarioAprobador,#usuarioRevisor").val();
            var fecha = fila.find("#fecha").val();

            if (orden != "" && idUsuario != '0' && fecha != "")
                return true;
            return false;
        }

        function AgregarFilaRevisor(fila) {
            //Copiar el boton agregar
            var nuevaFila = "<tr id=\"NuevaFilaRevisor\">" +
                "<td style=\"width: 100%\" colspan=\"4\"><button type=\"button\" id=\"btnAgregarRevisor\" class=\"btn btn-outline-primary\" style=\"width: 100%\" onclick=\"AgregarFilaRevisor(" + (fila + 1)+")\">Nueva Fila</button></td>"+
                            "</tr>";
            //Eliminar boton
            $('#tabla_revisores tr:last').remove();

            var data = "<tr id=\"Revisor" + fila + "\">" +
                "<td style = \"width: 20%\" ><input class=\"form-control\" type=\"number\" id=\"ordenRevisor"+fila+"\" value=\"" + fila + "\"/></td>" +
                "<td style=\"width: 50%\"><select class=\"form-control\" id=\"usuarioRevisor" + fila +"\"></select></td>" +
                "<td style=\"width: 20%\"><input class=\"form-control\" type=\"date\" id=\"fechaRevisor" + fila +"\"/></td>" +
                "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn\" onclick=\"EliminarRevisor("+fila+")\"><img src=\"/img/icons/cross.png\"/></button></td >" +
                "</tr>";

            //crear nueva lista de usuarios
            var opciones =  usuarios.map(function (val, ind) {
                return $("<option></option>").val(val.Value).html(val.Text);
            });

            var usuarioRevisor = "#usuarioRevisor" + fila;
            var fechaRevisor = "#fechaRevisor" + fila;

            $("#tabla_revisores tbody").append(data + nuevaFila);

            $(usuarioRevisor).append(opciones);

            $(fechaRevisor).prop("min", '@Html.Raw(ViewBag.FechaHoy)');

            filasRevisor += 1;
            idsfilasRevisor += 1;
        }
        function AgregarFilaAprobador(fila) {
            //Copiar el boton agregar
            var nuevaFila = "<tr id=\"NuevaFilaAprobador\">" +
                "<td style=\"width: 100%\" colspan=\"4\"><button type=\"button\" id=\"btnAgregarAprobador\" class=\"btn btn-outline-primary\" style=\"width: 100%\" onclick=\"AgregarFilaAprobador(" + (fila + 1)+")\">Nueva Fila</button></td>"+
                            "</tr>";
            //Eliminar boton
            $('#tabla_aprobadores tr:last').remove();

            var data = "<tr id=\"Aprobador" + fila + "\">" +
                "<td style = \"width: 20%\" ><input class=\"form-control\" type=\"number\" id=\"ordenAprobador" + fila + "\" value=\"" + (filasAprobador+1) + "\"/></td>" +
                "<td style=\"width: 50%\"><select class=\"form-control\" id=\"usuarioAprobador" + fila +"\"></select></td>" +
                "<td style=\"width: 20%\"><input class=\"form-control\" type=\"date\" id=\"fechaAprobador" + fila +"\"/></td>" +
                "<td style = \"width: 10%\"> <button type=\"button\" class=\"btn\" onclick=\"EliminarAprobador("+fila+")\"><img src=\"/img/icons/cross.png\"/></button></td >" +
                "</tr>";

            //crear nueva lista de usuarios
            var opciones =  usuarios.map(function (val, ind) {
                return $("<option></option>").val(val.Value).html(val.Text);
            });

            var usuarioAprobador = "#usuarioAprobador" + fila;
            var fechaAprobador = "#fechaAprobador" + fila;

            $("#tabla_aprobadores tbody").append(data + nuevaFila);

            $(usuarioAprobador).append(opciones);
            $(fechaAprobador).prop("min", '@Html.Raw(ViewBag.FechaHoy)');

            filasAprobador += 1;
            idsfilasAprobador += 1;
        }

        function EliminarRevisor(fila) {
            var fila = "#Revisor" + fila;
            $(fila).remove();
            filasRevisor -= 1;
        }
        function EliminarAprobador(fila) {

            console.log("-------------ELIMINAR NUEVA FILA"+fila+ "------")
            //Copiar el boton agregar
            var nuevaFila = "<tr id=\"NuevaFilaAprobador\">" +
                "<td style=\"width: 100%\" colspan=\"4\"><button type=\"button\" id=\"btnAgregarAprobador\" class=\"btn btn-outline-primary\" style=\"width: 100%\" onclick=\"AgregarFilaAprobador(" + (idsfilasAprobador+1) + ")\">Nueva Fila</button></td>" +
                "</tr>";
            //Eliminar boton
            $('#tabla_aprobadores tr:last').remove();
            $("#tabla_aprobadores tbody").append(nuevaFila);

            var filaNombre = "#Aprobador" + fila;
            console.log("filaNombre", filaNombre)
            
            //todos los N Orden mayores a la fila debe restar 1
            //1. Identificar cada fila y su orden
            //2. Identificar la fila q sera eliminada
            //3. Restar 1 a los ordenes superiores al de la fila eliminada


            console.log("fila < filasAprobador", fila < filasAprobador)
            if (fila < filasAprobador) {
                for (var i = fila+1; i <= idsfilasAprobador; i++) {
                    console.log("i", i)

                    var orden = "#ordenAprobador" + i;
                    console.log("orden", orden)
                    if ($(orden)[0] != null) {
                        console.log("EXISTE")
                        var valorOrden = $(orden).val();
                        console.log("orden anterior", valorOrden)
                        $(orden).val(valorOrden - 1);

                        console.log("orden nuevo", $(orden).val())
                    }
                }
            }

            $(filaNombre).remove();
            filasAprobador -= 1;
        }
    </script>

}