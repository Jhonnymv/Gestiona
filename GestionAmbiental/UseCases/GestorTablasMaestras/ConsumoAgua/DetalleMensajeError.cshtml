@model GestionAmbiental.UseCases.GestorTablasMaestras.ConsumoAgua.Model.MensajeErrorModel
@{
    ViewData["Title"] = "DetalleMensajeError";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Mensaje de Error</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorConsumoAgua" asp-action="EditarMensajeError">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label>El mensaje debe mantener las palabras ARG1, ARG2 o ARG3, si las tiene, que serán remplazadas por valores</label>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Tipo"></label>
                        <span class="text-danger" asp-validation-for="Tipo"></span>
                        <input type="text" class="form-control" asp-for="Tipo" readonly>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Mensaje"></label>
                        <span class="text-danger" asp-validation-for="Mensaje"></span>
                        <input type="text" class="form-control" asp-for="Mensaje" readonly>
                    </div>
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsEditar" style="display:none">
                                <button type="button" class="btn btn-mc-outline-danger mr-2" id="btnCancelar" disabled>Cancelar</button>
                                <button type="submit" class="btn btn-mc-success" id="btnGuardar" disabled>Guardar</button>
                            </div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorConsumoAgua" asp-action="Resumen" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="button" class="btn btn-mc-success" id="btnEditar">Editar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
