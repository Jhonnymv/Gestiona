@model GestionAmbiental.UseCases.GestorTablasMaestras.ConsumoAgua.Model.CargaExcelModel
@{
    ViewData["Title"] = "CargaDataExcel";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Cargar Datos de Excel</h2>
    </div>
</div>
<form class="form-group" id="form_nuevo_avistamiento" asp-action="CargaDataExcel" asp-controller="GestorConsumoAgua" method="post" enctype="multipart/form-data" autocomplete="off">
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="ColumnaInicio"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="ColumnaInicio"></span>
            <input type="number" class="form-control" asp-for="ColumnaInicio" value="2" />
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="FilaInicio"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="FilaInicio"></span>
            <input type="number" class="form-control" asp-for="FilaInicio" value="8" />
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="Pagina"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Pagina"></span>
            <input type="text" class="form-control" asp-for="Pagina" />
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="IdResolucion"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="IdResolucion"></span>
            <select asp-for="IdResolucion" class="form-control" asp-items="ViewBag.Actividades"></select>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="Resolucion"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger" asp-validation-for="Resolucion"></span>
            <input type="text" class="form-control" asp-for="Resolucion" readonly/>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label asp-for="Excel"></label>
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <span class="text-danger field-validation-error" data-valmsg-for="Excel" data-valmsg-replace="true">
                <span id="danger_excel" class="" asp-validation-for="Excel"></span>
            </span>
            <label class="btn btn-primary" for="Excel">Seleccione</label>
            <input type="file" style="visibility:hidden; display:none" asp-for="Excel" accept=".xls, .xlsx">
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
        </div>
        <div class="col-sm-12 col-md-5 col-lg-4 mb-2">
            <label id="files_name">No se ha seleccionado ningun archivo</label>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-12">
            @if (ViewBag.Result != null)
            {
                @if (ViewBag.Result == "Success")
                {
                    <div class="alert alert-success" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Message)</div>
                }
                else
                {
                    <div class="alert alert-danger" role="alert" style="text-align:center;">@Html.Raw(ViewBag.Message.Replace("\n", "<br/>"))</div>
                }
            }
        </div>
    </div>
    <div class="row justify-content-center">
        <button type="submit" class="btn btn-primary">Registrar</button>
    </div>
</form>

@section Scripts{
    <script type="text/javascript">
        var resolucionesAct = JSON.parse('@Html.Raw(ViewBag.ResolucionesAct)');
        $("#Excel").change(function () {
            $("#danger_excel").html("");
            //Validacion del tamaño del archivo
            var archivos = $("#Excel").get(0).files;

            if (archivos.length > 0) {
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'xls':
                        case 'xlsx':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#files_name").text(filesname);
                            $("#danger_excel").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#files_name").html(filesName) : null;
            }
        });
        $("#IdResolucion").on('change', function () {
            var resol = $("#IdResolucion").val();
            for (var i = 0; i < resolucionesAct.length; i++) {
                if (resolucionesAct[i].IdResolucionConsumoAgua == resol) {
                    $("#Resolucion").val(resolucionesAct[i].Resolucion);
                    return;
                }
            }
        });
    </script>
}