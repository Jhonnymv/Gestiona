@model GestionAmbiental.UseCases.GestorTablasMaestras.ConsumoAgua.Model.ResolucionConsumoAguaModel
@{
    ViewData["Title"] = "DetalleResolucionConsumoAgua";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Información de Resolucion de Consumo de Agua</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorConsumoAgua" asp-action="EditarResolucionConsumoAgua">
                <input type="hidden" asp-for="IdResolucionConsumoAgua">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label asp-for="Resolucion"></label>
                        <span class="text-danger" asp-validation-for="Resolucion"></span>
                        <input type="text" class="form-control" asp-for="Resolucion" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="IdFuenteAgua"></label>
                        <span class="text-danger" asp-validation-for="IdFuenteAgua"></span>
                        <select class="form-control" asp-for="IdFuenteAgua" asp-items="ViewBag.FuentesAgua" disabled>
                        </select>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Anio"></label>
                        <span class="text-danger" asp-validation-for="Anio"></span>
                        <input type="text" class="form-control" asp-for="Anio" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="FechaVencimiento"></label>
                        <span class="text-danger" asp-validation-for="FechaVencimiento"></span>
                        <input type="date" class="form-control" asp-for="FechaVencimiento" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Caudal"></label>
                        <span class="text-danger" asp-validation-for="Caudal"></span>
                        <input type="number" class="form-control" asp-for="Caudal" step="0.01" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="TipoUso"></label>
                        <span class="text-danger" asp-validation-for="TipoUso"></span>
                        <input type="text" class="form-control" asp-for="TipoUso" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="ClaseDerecho"></label>
                        <span class="text-danger" asp-validation-for="ClaseDerecho"></span>
                        <input type="text" class="form-control" asp-for="ClaseDerecho" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="VolumenOtorgado"></label>
                        <span class="text-danger" asp-validation-for="VolumenOtorgado"></span>
                        <input type="number" class="form-control" asp-for="VolumenOtorgado" step="0.01" maxlength="10" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Actividad"></label>
                        <span class="text-danger" asp-validation-for="Actividad"></span>
                        <input type="text" class="form-control" asp-for="Actividad" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="LimiteDiario"></label>
                        <span class="text-danger" asp-validation-for="LimiteDiario"></span>
                        <input type="number" class="form-control" asp-for="LimiteDiario" step="0.01" maxlength="10" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="LimiteSemanal"></label>
                        <span class="text-danger" asp-validation-for="LimiteSemanal"></span>
                        <input type="number" class="form-control" asp-for="LimiteSemanal" step="0.01" maxlength="10" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="LimiteMensual"></label>
                        <span class="text-danger" asp-validation-for="LimiteMensual"></span>
                        <input type="number" class="form-control" asp-for="LimiteMensual" step="0.01" maxlength="10" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Estado"></label>
                        <span class="text-danger" asp-validation-for="Estado"></span>
                        <select class="form-control" asp-for="Estado" disabled>
                            <option value="">--SELECCIONE--</option>
                            <option value="ACT">ACT</option>
                            <option value="INA">INA</option>
                        </select>
                    </div>
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsEditar" style="display:none">
                                <button type="button" class="btn btn-mc-outline-danger mr-2" id="btnCancelar" disabled>Cancelar</button>
                                <button type="submit" class="btn btn-mc-success" id="btnGuardar" disabled>Guardar</button>
                            </div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorConsumoAgua" asp-action="Resumen" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="button" class="btn btn-mc-success" id="btnEditar">Editar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            $("#Resolucion").prop('disabled', false);
            $("#IdFuenteAgua").prop('disabled', false);
            $("#Anio").prop('disabled', false);
            $("#FechaVencimiento").prop('disabled', false);
            $("#Caudal").prop('disabled', false);
            $("#TipoUso").prop('disabled', false);
            $("#ClaseDerecho").prop('disabled', false);
            $("#VolumenOtorgado").prop('disabled', false);
            $("#LimiteDiario").prop('disabled', false);
            $("#LimiteSemanal").prop('disabled', false);
            $("#LimiteMensual").prop('disabled', false);
            $("#Actividad").prop('disabled', false);
            $("#Estado").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            $("#Resolucion").prop('disabled', true);
            $("#IdFuenteAgua").prop('disabled', true);
            $("#Anio").prop('disabled', true);
            $("#FechaVencimiento").prop('disabled', true);
            $("#Caudal").prop('disabled', true);
            $("#TipoUso").prop('disabled', true);
            $("#ClaseDerecho").prop('disabled', true);
            $("#VolumenOtorgado").prop('disabled', true);
            $("#LimiteDiario").prop('disabled', true);
            $("#LimiteSemanal").prop('disabled', true);
            $("#LimiteMensual").prop('disabled', true);
            $("#Actividad").prop('disabled', true);
            $("#Estado").prop('disabled', true);
        });
        $("#VolumenOtorgado").keyup(function () {
            var maxlength = $("#VolumenOtorgado").attr('maxLength') - 2
            var valor = $("#VolumenOtorgado").val();
            if (valor.length >= maxlength) {
                $("#VolumenOtorgado").val(parseFloat(valor.slice(0, maxlength)).toFixed(2))
            }
        });
        $("#LimiteDiario").keyup(function () {
            var maxlength = $("#LimiteDiario").attr('maxLength') - 2
            var valor = $("#LimiteDiario").val();
            if (valor.length >= maxlength) {
                $("#LimiteDiario").val(parseFloat(valor.slice(0, maxlength)).toFixed(2))
            }
        });
        $("#LimiteSemanal").keyup(function () {
            var maxlength = $("#LimiteSemanal").attr('maxLength') - 2
            var valor = $("#LimiteSemanal").val();
            if (valor.length >= maxlength) {
                $("#LimiteSemanal").val(parseFloat(valor.slice(0, maxlength)).toFixed(2))
            }
        });
        $("#LimiteMensual").keyup(function () {
            var maxlength = $("#LimiteMensual").attr('maxLength') - 2
            var valor = $("#LimiteMensual").val();
            if (valor.length >= maxlength) {
                $("#LimiteMensual").val(parseFloat(valor.slice(0, maxlength)).toFixed(2))
            }
        });
    </script>
}
