@model GestionAmbiental.UseCases.GestorTablasMaestras.ConsumoAgua.Model.ResolucionConsumoAguaModel
@{
    ViewData["Title"] = "DetalleResolucionConsumoAgua";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Información de Resolucion de Consumo de Agua</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorConsumoAgua" asp-action="EditarResolucionConsumoAgua">
            <input type="hidden" asp-for="IdResolucionConsumoAgua">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Resolucion"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Resolucion"></span>
                    <input type="text" class="form-control" asp-for="Resolucion" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="IdFuenteAgua"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="IdFuenteAgua"></span>
                    <select class="form-control" asp-for="IdFuenteAgua" asp-items="ViewBag.FuentesAgua" disabled>
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Anio"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Anio"></span>
                    <input type="text" class="form-control" asp-for="Anio" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="TipoUso"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="TipoUso"></span>
                    <input type="text" class="form-control" asp-for="TipoUso" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="ClaseDerecho"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="ClaseDerecho"></span>
                    <input type="text" class="form-control" asp-for="ClaseDerecho" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="VolumenOtorgado"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="VolumenOtorgado"></span>
                    <input type="number" class="form-control" asp-for="VolumenOtorgado" step="0.01" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Actividad"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Actividad"></span>
                    <input type="text" class="form-control" asp-for="Actividad" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="LimiteDiario"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="LimiteDiario"></span>
                    <input type="number" class="form-control" asp-for="LimiteDiario" step="0.01" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="LimiteSemanal"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="LimiteSemanal"></span>
                    <input type="number" class="form-control" asp-for="LimiteSemanal" step="0.01" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="LimiteMensual"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="LimiteMensual"></span>
                    <input type="number" class="form-control" asp-for="LimiteMensual" step="0.01" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Estado"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Estado"></span>
                    <select class="form-control" asp-for="Estado" disabled>
                        <option value="">--SELECCIONE--</option>
                        <option value="ACT">ACT</option>
                        <option value="INA">INA</option>
                    </select>
                </div>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorConsumoAgua" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <script>
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            $("#Resolucion").prop('disabled', false);
            $("#IdFuenteAgua").prop('disabled', false);
            $("#Anio").prop('disabled', false);
            $("#TipoUso").prop('disabled', false);
            $("#ClaseDerecho").prop('disabled', false);
            $("#VolumenOtorgado").prop('disabled', false);
            $("#LimiteDiario").prop('disabled', false);
            $("#LimiteSemanal").prop('disabled', false);
            $("#LimiteMensual").prop('disabled', false);
            $("#Actividad").prop('disabled', false);
            $("#Estado").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            $("#Resolucion").prop('disabled', true);
            $("#IdFuenteAgua").prop('disabled', true);
            $("#Anio").prop('disabled', true);
            $("#TipoUso").prop('disabled', true);
            $("#ClaseDerecho").prop('disabled', true);
            $("#VolumenOtorgado").prop('disabled', true);
            $("#LimiteDiario").prop('disabled', true);
            $("#LimiteSemanal").prop('disabled', true);
            $("#LimiteMensual").prop('disabled', true);
            $("#Actividad").prop('disabled', true);
            $("#Estado").prop('disabled', true);
        });
    </script>
}
