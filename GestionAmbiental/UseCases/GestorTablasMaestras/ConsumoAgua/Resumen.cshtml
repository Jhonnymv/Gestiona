@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabConsumoAgua');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarResolucionConsumoAgua(1);
                $("#btn_agregar").prop("href", "/GestorConsumoAgua/AgregarResolucionConsumoAgua");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabConsumoAgua', $(e.target).attr('href'));
        });
        $("#btn_enviar").on('click', function (e) {
            if ($("#Resoluciones").hasClass("active")) {
                FiltrarResolucionConsumoAgua(1);
            }
            if ($("#Fuentes_Agua").hasClass("active")) {
                FiltrarFuenteAgua(1);
            }
            if ($("#Origenes_Agua").hasClass("active")) {
                FiltrarOrigenAgua(1);
            }
            if ($("#Usuarios").hasClass("active")) {
                FiltrarUsuario(1);
            }
            if ($("#Mensajes").hasClass("active")) {
                FiltrarMensajeError(1);
            }
        });
        $("#Resoluciones").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorConsumoAgua/AgregarResolucionConsumoAgua");
            FiltrarResolucionConsumoAgua(1);
        });
        $("#Fuentes_Agua").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorConsumoAgua/AgregarFuenteAgua");
            FiltrarFuenteAgua(1);
        });
        $("#Origenes_Agua").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorConsumoAgua/AgregarOrigenAgua");
            FiltrarOrigenAgua(1);
        });

        $("#Usuarios").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorConsumoAgua/AgregarUsuario");
            FiltrarUsuario(1);
        });
        $("#Mensajes").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            FiltrarMensajeError();
        });

        function FiltrarResolucionConsumoAgua(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorConsumoAgua/FiltrarResolucionConsumoAgua",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarFuenteAgua(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorConsumoAgua/FiltrarFuenteAgua",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarOrigenAgua(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorConsumoAgua/FiltrarOrigenAgua",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarMensajeError() {
            $.ajax({
                type: "POST",
                url: "/GestorConsumoAgua/FiltrarMensajeError",
                data: {
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarUsuario(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorConsumoAgua/FiltrarUsuario",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }

    </script>
}



