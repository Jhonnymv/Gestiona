@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Tablas Maestras - Inspecciones</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>

        <div class="tabs-mc">
            <ul class="nav nav-pills mt-3 div-scroll-horizontal" id="listItems" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" type="button" id="TipoInspeccion" href="#TipoInspeccion" data-bs-toggle="pill" aria-selected="true">Tipo de Inspección</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="MiembroComite" href="#MiembroComite" data-bs-toggle="pill" aria-selected="true">Miembros Comite </a>
                </li>
            </ul>

            <div class="content-header">
                <div class="action-container tablas-color row-center-center">
                    <div class="w-100 row-center-center">
                        <a class="btn btn-special-action-outline tablas-color" id="btn_agregar">Agregar</a>
                    </div>
                </div>
                <form autocomplete="off" class="custom-form">
                    <div class="col-12 col-lg-9">
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_nombre">Buscar</label>
                                <input type="text" class="form-control" id="filtro">
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3 row-center-center">
                        <button type="button" class="btn btn-mc" id="btn_enviar">Buscar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="secondary-content col-12">
        <div class="table-responsive tablas-color" id="tab_content">
        </div>
        <div class="pagination-container tablas-color" id="paginado" aria-label="pagination">
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabInspecciones');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarTipoInspeccion(1);
                $("#btn_agregar").prop("href", "/GestorInspecciones/AgregarTipoInspeccion");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabInspecciones', $(e.target).attr('href'));
        });
        $("#btnenviar").on('click', function (e) {
            if ($("#TipoInspeccion").hasClass("active")) {
                FiltrarTipoInspeccion(1);
            }
            if ($("#NombreComun").hasClass("active")) {
                FiltrarMiembroComite(1);
            }
        });
        $("#TipoInspeccion").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorInspecciones/AgregarTipoInspeccion");
            $("#opcion_editar_mensaje").hide();
            FiltrarTipoInspeccion(1);
        });
        $("#MiembroComite").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorInspecciones/AgregarMiembroComite");
            $("#opcion_editar_mensaje").hide();
            FiltrarMiembroComite(1);
        });

        function FiltrarTipoInspeccion(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorInspecciones/FiltrarTipoInspeccion",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarMiembroComite(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorInspecciones/FiltrarMiembroComite",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
    </script>
}

