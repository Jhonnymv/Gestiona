@model GestionAmbiental.UseCases.GestorTablasMaestras.SGA_Documentos.Model.CategoriaTipoModel
@{
    ViewData["Title"] = "DetalleCategoriaTipo";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Detalle del Tipo de Documento de Categoría</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorSGADocumentos" asp-action="EditarCategoriaTipo">
            <input type="hidden" class="form-control" asp-for="IdSGACategoriaTipo">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="IdCategoriaDocumento"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="IdCategoriaDocumento"></span>
                    <select type="text" class="form-control" asp-for="IdCategoriaDocumento" asp-items="ViewBag.CategoriasDoc" disabled></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="IdTipoDocumento"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="IdTipoDocumento"></span>
                    <select type="text" class="form-control" asp-for="IdTipoDocumento" asp-items="ViewBag.TiposDoc" disabled></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Estado"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Estado"></span>
                    <select class="form-control" asp-for="Estado" disabled>
                        <option value="">--SELECCIONE--</option>
                        <option value="ACT">ACT</option>
                        <option value="INA">INA</option>
                    </select>
                </div>
            </div>
            <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorSGADocumentos" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>

@section scripts{
    <script>
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            $("#IdCategoriaDocumento").prop('disabled', false);
            $("#IdTipoDocumento").prop('disabled', false);
            $("#Estado").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            $("#IdCategoriaDocumento").prop('disabled', true);
            $("#IdTipoDocumento").prop('disabled', true);
            $("#Estado").prop('disabled', true);
        });
    </script>
}

