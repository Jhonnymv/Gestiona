@model GestionAmbiental.UseCases.GestorTablasMaestras.SGA_Documentos.Model.CategoriaTipoModel 
@{
    ViewData["Title"] = "AgregarCategoriaTipo";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Agregar Tipo de Documento a Categoría</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorSGADocumentos" asp-action="AgregarCategoriaTipo">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="IdCategoriaDocumento"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="IdCategoriaDocumento"></span>
                    <select type="text" class="form-control" asp-for="IdCategoriaDocumento" asp-items="ViewBag.CategoriasDoc"></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="IdTipoDocumento"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="IdTipoDocumento"></span>
                    <select type="text" class="form-control" asp-for="IdTipoDocumento" asp-items="ViewBag.TiposDoc"></select>
                </div>
            </div>
            <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorSGADocumentos" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>



