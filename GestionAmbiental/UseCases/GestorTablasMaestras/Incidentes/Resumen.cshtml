@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabIncidentes1');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltarFactorCausa(1);
                $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarFactorCausa");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabIncidentes1', $(e.target).attr('href'));
        });
        $("#btn_enviar").on('click', function (e) {
            if ($("#FactorCausa").hasClass("active")) {
                FiltarFactorCausa(1);
            }
            if ($("#Lugar").hasClass("active")) {
                FiltrarLugarDiposicion(1);
            }
            if ($("#Componente").hasClass("active")) {
                FiltarComponenteAmbiental(1);
            }
            if ($("#EstadoEquipo").hasClass("active")) {
                FiltrarEstadoEquipo(1);
            }
            if ($("#TipoProducto").hasClass("active")) {
                FiltrarTipoProducto(1);
            }
            if ($("#Producto").hasClass("active")) {
                FiltrarProductoIncidente(1);
            }
            if ($("#Unidades").hasClass("active")) {
                FiltrarUnidadMedida(1);
            }
            if ($("#Usuarios").hasClass("active")) {
                FiltrarUsuario(1);
            }
        });

        $("#FactorCausa").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarFactorCausa");
            FiltarFactorCausa(1);
        });
        $("#Lugar").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarLugarDiposicion");
            FiltrarLugarDiposicion(1);
        });
        $("#Componente").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarComponenteAmbiental");
            FiltarComponenteAmbiental(1);
        });
        $("#EstadoEquipo").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarEstadoEquipo");
            FiltrarEstadoEquipo(1);
        });
        $("#TipoProducto").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarTipoProducto");
            FiltrarTipoProducto(1);
        });
        $("#Producto").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarProductoIncidente");
            FiltrarProductoIncidente(1);
