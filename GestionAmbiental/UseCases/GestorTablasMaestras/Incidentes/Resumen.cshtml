            FiltrarUsuario(1);
        });

        function FiltarFactorCausa(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorIncidentes/FiltrarFactorCausa",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
