@section Scripts{
    <script type="text/javascript">
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabIncidentes2');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarTipoSuelo(1);
                $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarTipoSuelo");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabIncidentes2', $(e.target).attr('href'));
        });
        $("#btn_enviar").on('click', function (e) {
            if ($("#Suelo").hasClass("active")) {
                FiltrarTipoSuelo(1);
            }
            if ($("#Flora").hasClass("active")) {
                FiltrarEspecieFlora(1);
            }
            if ($("#Fauna").hasClass("active")) {
                FiltrarEspecieFauna(1);
            }
            if ($("#Agua").hasClass("active")) {
                FiltrarTipoAgua(1);
            }
        });

        $("#Suelo").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarTipoSuelo");
            FiltrarTipoSuelo(1);
        });
        $("#Flora").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarEspecieFlora");
            FiltrarEspecieFlora(1);
        });
        $("#Fauna").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarEspecieFauna");
            FiltrarEspecieFauna(1);
        });
        $("#Agua").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorIncidentes/AgregarTipoAgua");
            FiltrarTipoAgua(1);
        });

        function FiltrarTipoSuelo(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorIncidentes/FiltrarTipoSuelo",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarEspecieFlora(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorIncidentes/FiltrarEspecieFlora",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarTipoAgua(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorIncidentes/FiltrarTipoAgua",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarEspecieFauna(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorIncidentes/FiltrarEspecieFauna",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
    </script>
}

