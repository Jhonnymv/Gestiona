@model GestionAmbiental.UseCases.GestorTablasMaestras.Empresa_Gerencia_TipoCondicion.GerenciaModel
@{
    ViewData["Title"] = "AgregarGerencia";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Agregar Gerencia</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form w-100" autocomplete="off" asp-controller="GestorEGTC" asp-action="AgregarGerencia">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container justify-content-center">
                        <label asp-for="Descripcion">Gerencia</label>
                        <span class="text-danger" asp-validation-for="Descripcion"></span>
                        <input type="text" class="form-control" asp-for="Descripcion">
                    </div>
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsDetalle">
                                <a type="button" class="btn btn-mc-outline-danger" asp-controller="GestorEGTC" asp-action="Resumen" id="btnCancelar">Cancelar</a>
                                <button class="btn btn-mc-success" type="submit" id="btnGuardar">Registrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

