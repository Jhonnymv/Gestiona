@section scripts{
    <script>
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabEmpresaGerenciaTipoCondicion');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarEmpresa(1);
                $("#btn_agregar").prop("href", "/GestorEGTC/AgregarEmpresa");
                $("#Empresa").click();
                /*$("#Empresa").addClass("active");*/
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabEmpresaGerenciaTipoCondicion', $(e.target).attr('href'));
        });
        $("#Empresa").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorEGTC/AgregarEmpresa");
            FiltrarEmpresa(1);
        });
        $("#Gerencia").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorEGTC/AgregarGerencia");
            FiltrarGerencia(1);
        });
        $("#TipoCondicion").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorEGTC/AgregarTipoCondicion");
            FiltrarTipoCondicion(1);
        });
        $("#btn_enviar").on('click', function (e) {
            if ($("#Empresa").hasClass("active")) {
                FiltrarEmpresa(1);
            }
            if ($("#Gerencia").hasClass("active")) {
                FiltrarGerencia(1);
            }
            if ($("#TipoCondicion").hasClass("active")) {
                FiltrarTipoCondicion(1);
            }
        });
        function FiltrarEmpresa(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorEGTC/FiltrarEmpresa",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarGerencia(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorEGTC/FiltrarGerencia",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarTipoCondicion(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorEGTC/FiltrarTipoCondicion",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
    </script>
}

