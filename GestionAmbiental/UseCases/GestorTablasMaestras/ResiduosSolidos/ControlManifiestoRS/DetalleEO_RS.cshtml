@model GestionAmbiental.UseCases.GestorTablasMaestras.ResiduosSolidos.ControlManifiestoRS.EO_RSModel
@{
    ViewData["Title"] = "DetalleEO_RS";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Información de EO-RS</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorManifiestoRS" asp-action="EditarEO_RS">
            <input type="hidden" asp-for="Id_EO_RS">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Razon_Social"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Razon_Social"></span>
                    <input type="text" class="form-control" asp-for="Razon_Social" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Registro"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Registro"></span>
                    <input type="text" class="form-control" asp-for="Registro" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Fecha_Vencimiento_Registro"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro"></span>
                    <input type="date" class="form-control" asp-for="Fecha_Vencimiento_Registro" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Estado"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Estado"></span>
                    <select class="form-control" asp-for="Estado" disabled>
                        <option value="">--SELECCIONE--</option>
                        <option value="ACT">Activo</option>
                        <option value="INA">Inactivo</option>
                    </select>
                </div>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorManifiestoRS" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <script>
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            $("#Razon_Social").prop('disabled', false);
            $("#Registro").prop('disabled', false);
            $("#Fecha_Vencimiento_Registro").prop('disabled', false);
            $("#Estado").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            $("#Razon_Social").prop('disabled', true);
            $("#Registro").prop('disabled', true);
            $("#Fecha_Vencimiento_Registro").prop('disabled', true);
            $("#Estado").prop('disabled', true);
        });
    </script>
}


