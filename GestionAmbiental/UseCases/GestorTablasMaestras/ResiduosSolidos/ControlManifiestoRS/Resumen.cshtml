@section Scripts{
    <script type="text/javascript">
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabManifiestosRS');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FIltrarEO_RS(1);
                $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarEO_RS");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabManifiestosRS', $(e.target).attr('href'));
        });
        $("#EO-RS").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarEO_RS");
            FIltrarEO_RS(1);
        });
        $("#Conductor").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarConductor");
            FiltrarConductor(1);
        });
        $("#Vehiculo").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarVehiculo");
            FiltrarVehiculo(1);
        });
        $("#Usuarios").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarUsuario");
            FiltrarUsuarios(1);
        });

        function FIltrarEO_RS(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorManifiestoRS/FIltrarEO_RS",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarConductor(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorManifiestoRS/FiltrarConductor",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarUsuarios(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorManifiestoRS/FiltrarUsuario",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
        function FiltrarVehiculo(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorManifiestoRS/FiltrarVehiculo",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
    </script>
}
