
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="card text-center">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="listItems">
            <li class="nav-item">
                <a class="nav-link active" id="EO-RS">EO-RS</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Conductor">Conductores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Vehiculo">Vehiculos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Usuarios">Usuarios a Notificar</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="row mb-2 justify-content-center">
            <div class="col-4 col-sm-4 col-md-2 col-lg-2 mt-1">
                <label>Buscar:</label>
            </div>
            <div class="col-4 col-sm-4 col-md-3 col-lg-3 mt-1">
                <input type="text" class="form-control" id="filtro">
            </div>
            <div class="col-4 col-sm-4 col-md-2 col-lg-3 mt-1">
                <button class="btn btn-primary">Enviar</button>
            </div>
        </div>
        <div class="row justify-content-start mt-2 mb-2">
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <a class="btn btn-danger" id="btn_agregar">Agregar</a>
            </div>
        </div>
        <div class="row" id="tab_content">
        </div>
        <div class="row justify-content-center" id="paginado">
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
    $(document).ready(function () {
        FIltrarEO_RS(1);
        $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarEO_RS");
    });

    $("#EO-RS").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarEO_RS");
        FIltrarEO_RS(1);
    });
    $("#Conductor").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarConductor");
        FiltrarConductor(1);
    });
    $("#Vehiculo").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarVehiculo");
        FiltrarVehiculo(1);
    });
    $("#Usuarios").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorManifiestoRS/AgregarUsuario");
        FiltrarUsuarios(1);
    });

    function FIltrarEO_RS(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorManifiestoRS/FIltrarEO_RS",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty()
                $('#tab_content').html(response.tabla)
                $('#paginado').html(response.paginador)
                /*$('#nRegistros').html(response.nRegistros)*/
            }
        });
    }
    function FiltrarConductor(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorManifiestoRS/FiltrarConductor",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty()
                $('#tab_content').html(response.tabla)
                $('#paginado').html(response.paginador)
                /*$('#nRegistros').html(response.nRegistros)*/
            }
        });
    }
    function FiltrarUsuarios(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorManifiestoRS/FiltrarUsuario",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty()
                $('#tab_content').html(response.tabla)
                $('#paginado').html(response.paginador)
                /*$('#nRegistros').html(response.nRegistros)*/
            }
        });
    }
    function FiltrarVehiculo(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorManifiestoRS/FiltrarVehiculo",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty()
                $('#tab_content').html(response.tabla)
                $('#paginado').html(response.paginador)
                /*$('#nRegistros').html(response.nRegistros)*/
            }
        });
    }
    </script>
}
