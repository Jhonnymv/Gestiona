@model GestionAmbiental.UseCases.GestorTablasMaestras.ResiduosSolidos.ControlManifiestoRS.ConductorModel
@{
    ViewData["Title"] = "AgregarConductor";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Agregar Conductor</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorManifiestoRS" asp-action="AgregarConductor">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label asp-for="Nombres"></label>
                        <span class="text-danger" asp-validation-for="Nombres"></span>
                        <input type="text" class="form-control" asp-for="Nombres" maxlength="100">
                    </div>
                    <div class="row input_container">
                        <label asp-for="Apellidos"></label>
                        <span class="text-danger" asp-validation-for="Apellidos"></span>
                        <input type="text" class="form-control" asp-for="Apellidos" maxlength="100">
                    </div>
                    <div class="row input_container">
                        <label asp-for="NLicencia"></label>
                        <span class="text-danger" asp-validation-for="NLicencia"></span>
                        <input type="text" class="form-control" asp-for="NLicencia" maxlength="10">
                    </div>
                    <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorManifiestoRS" asp-action="Resumen" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="submit" class="btn btn-mc-success">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
