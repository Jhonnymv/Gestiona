@section Scripts{ 
<script type="text/javascript">
    $(document).ready(function () {
        //Buscar tab activo guardado en local storage
        var activeTab = localStorage.getItem('activeTabIngresoSalidaRS');
        //Si existe el objeto en local storage mostrar
        if (activeTab) {
            $('.nav-pills a[href="' + activeTab + '"]').click();
        }
        //Si no existe, mostrar primer tab
        else {
            FiltrarACR_CMRS(1);
            $("#btn_agregar").prop("href", "/GestorIngresoSalidaRS/AgregarACR_CMRS");
        }
    });
    function dataModulo() {
        $.ajax({
            type: "POST",
            url: "/GestorContenido/PropiedadesModulo",
            traditional: true,
            success: (response) => {
                if (response.success) {
                    let data = JSON.parse(response.data);
                    let r = data.r;
                    let g = data.g;
                    let b = data.b;
                    let img_url = data.img_url;
                    tablasStyle(r, g, b);
                } else {
                    console.log("Ocurrió un problema: " + response.msg);
                }
            }
        });
    }
    //Guardar tab activo en local storage
    $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
        localStorage.setItem('activeTabIngresoSalidaRS', $(e.target).attr('href'));
    });
    $("#ACR_CMRS").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorIngresoSalidaRS/AgregarACR_CMRS");
        FiltrarACR_CMRS(1);
    });
    $("#Motivo").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorIngresoSalidaRS/AgregarMotivo");
        FiltrarMotivo(1);
    });
    $("#ResiduosSolidos").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorIngresoSalidaRS/AgregarResiduosSolidos");
        FiltrarResiduosSolidos(1);
    });
    $("#Responsable").on('click', function (e) {
        $(this).tab('show');
        $("#btn_agregar").prop("href", "/GestorIngresoSalidaRS/AgregarResponsablesACR_CRMS");
        FiltrarResponsablesACR_CRMS(1);
    });

    function FiltrarACR_CMRS(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorIngresoSalidaRS/FiltrarACR_CMRS",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty();
                $('#tab_content').html(response.tabla);
                $('#paginado').html(response.paginador);
                dataModulo();
            }
        });
    }
    function FiltrarMotivo(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorIngresoSalidaRS/FiltrarMotivo",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty();
                $('#tab_content').html(response.tabla);
                $('#paginado').html(response.paginador);
                dataModulo();
            }
        });
    }
    function FiltrarResponsablesACR_CRMS(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorIngresoSalidaRS/FiltrarResponsablesACR_CRMS",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty();
                $('#tab_content').html(response.tabla);
                $('#paginado').html(response.paginador);
                dataModulo();
            }
        });
    }
    function FiltrarResiduosSolidos(pag) {
        $.ajax({
            type: "POST",
            url: "/GestorIngresoSalidaRS/FiltrarResiduosSolidos",
            data: {
                "pagina": pag,
                "rpp":10,
                "filtro": $('#filtro').val(),
            },
            traditional: true,
            success: (response) => {
                $('#tab_content').empty();
                $('#tab_content').html(response.tabla);
                $('#paginado').html(response.paginador);
                dataModulo();
            }
        });
    }
</script>
}