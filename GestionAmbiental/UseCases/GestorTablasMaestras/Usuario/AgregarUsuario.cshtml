@model GestionAmbiental.UseCases.GestorTablasMaestras.Usuario.UsuarioModel
@{
    ViewData["Title"] = "AgregarUsuario";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Nuevo Usuario</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorUsuarios" asp-action="AgregarUsuario">
                <input type="hidden" asp-for="IdUsuario">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label asp-for="Nombres"></label>
                        <span class="text-danger" asp-validation-for="Nombres"></span>
                        <input type="text" class="form-control" asp-for="Nombres">
                    </div>
                    <div class="row input_container">
                        <label asp-for="Apellidos"></label>
                        <span class="text-danger" asp-validation-for="Apellidos"></span>
                        <input type="text" class="form-control" asp-for="Apellidos">
                    </div>
                    <div class="row input_container">
                        <label asp-for="IdRol"></label>
                        <span class="text-danger" asp-validation-for="IdRol"></span>
                        <select class="form-control" asp-items="@ViewBag.Roles" asp-for="IdRol">
                        </select>
                    </div>
                    <div class="row input_container">
                        <label asp-for="UsuarioRed"></label>
                        <span class="text-danger" asp-validation-for="UsuarioRed"></span>
                        <input type="text" class="form-control" asp-for="UsuarioRed">
                    </div>
                    <div class="row input_container">
                        <label asp-for="Email"></label>
                        <span class="text-danger" asp-validation-for="Email"></span>
                        <input type="text" class="form-control" asp-for="Email">
                    </div>
                    <div class="row input_container">
                        <label asp-for="IdSuperior"></label>
                        <span class="text-danger" asp-validation-for="IdSuperior"></span>
                        <select class="form-control" asp-items="@ViewBag.Usuarios" asp-for="IdSuperior">
                        </select>
                    </div>
                    <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorUsuarios" asp-action="Usuarios" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="submit" class="btn btn-mc-success">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

