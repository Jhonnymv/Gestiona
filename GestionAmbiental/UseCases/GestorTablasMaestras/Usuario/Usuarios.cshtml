@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Usuarios</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <label>Buscar:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="text" class="form-control" id="filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)" tabindex="-1">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-end">
    <div class="col-lg-2 mt-1">
        <button class="btn btn-primary float-right" onclick="ActualizarUsuarios()">Actualizar Información desde AD</button>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-md">
        <table class="table" id="tabla_usuarios">
            <thead class="thead-mcolor">
                <tr>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Usuario de Red</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>
<!-- Modal Enviando Correo-->
<div class="modal fade" id="Modal_Usuarios_AD" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body" style="text-align:center;">
                <div id="modal_icon" class="spinner-border text-info" role="status">
                </div>
                <br>
                <label id="modal_msg">Conectandose al servidor</label>
            </div>
            <div class="modal-footer justify-content-center" id="btn_modal_aceptar" style="display:none">
                <button class="btn btn-primary" type="button" onclick="refresh()">Aceptar</button>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            filtrar(1);
        });
        function refresh() {
            location.reload(true);
        }
        function ActualizarUsuarios() {
            $('#Modal_Usuarios_AD').modal('show');
            console.log("Enviando ajax ...")
            $.ajax({
                type: "POST",
                url: "/GestorUsuarios/ActualizarInformacion",
                traditional: true,
                data: {},
                success: (response) => {
                    console.log(response)
                    if (response.success) {
                        $('#modal_msg').html(response.mensaje);
                    } else {
                        $('#modal_msg').html(response.mensaje);
                    }
                    $("#modal_icon").hide();
                    $("#btn_modal_aceptar").show();
                }
            });
        }

        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorUsuarios/Usuarios",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_usuarios tbody').empty();
                    $('#tabla_usuarios tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
    </script>
}