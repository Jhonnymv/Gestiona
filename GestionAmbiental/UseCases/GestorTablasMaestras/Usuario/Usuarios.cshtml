@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Tablas Maestras - Usuarios</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header">
            <div class="action-container tablas-color">
                <button class="btn btn-special-action-outline tablas-color" onclick="ActualizarUsuarios()">Actualizar Información desde AD</button>
            </div>
            <form autocomplete="off" class="custom-form">
                <div class="col-12 col-lg-9">
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label for="">Buscar</label>
                            <input type="text" class="form-control" placeholder="Introducir Texto" id="filtro">
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-3 row-center-center">
                    <button type="button" class="btn btn-mc" onclick="filtrar(1)">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="secondary-content col-12">
        <div class="table-responsive tablas-color">
            <table class="table" id="tabla_usuarios">
                <thead class="">
                    <tr>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Usuario de Red</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
        <div class="pagination-container tablas-color" id="paginado">
        </div>
    </div>
</div>
