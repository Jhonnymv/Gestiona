<!-- Modal Usuarios AD-->
<div class="modal fade mc-modal" id="Modal_Usuarios_AD" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="modal_msg" class="text-white">Conectandose al servidor</label>
                    </div>
                </div>
                <div class="modal-footer" id="btn_modal_aceptar" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-outline-white" type="button" onclick="refresh()">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

