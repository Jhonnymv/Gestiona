@section scripts{
    <script>
        $(document).ready(function () {
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function refresh() {
            location.reload(true);
        }
        function ActualizarUsuarios() {
            $('#Modal_Usuarios_AD').modal('show');
            console.log("Enviando ajax ...")
            $.ajax({
                type: "POST",
                url: "/GestorUsuarios/ActualizarInformacion",
                traditional: true,
                data: {},
                success: (response) => {
                    console.log(response)
                    if (response.success) {
                        $('#modal_msg').html(response.mensaje);
                    } else {
                        $('#modal_msg').html(response.mensaje);
                    }
                    $("#modal_icon").hide();
                    $("#btn_modal_aceptar").show();
                }
            });
        }

        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorUsuarios/Usuarios",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_usuarios tbody').empty();
                    $('#tabla_usuarios tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
    </script>
}