@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Usuarios</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <label>Buscar:</label>
        </div>
        <div class="col-lg-2 mt-1">
            <input type="text" class="form-control" id="filtro">
        </div>
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)" tabindex="-1">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-end">
    <div class="col-lg-2 mt-1">
        <a class="btn btn-primary float-right" asp-action="AgregarUsuario" asp-controller="GestorUsuarios">Nuevo Usuario</a>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-md">
        <table class="table" id="tabla_usuarios">
            <thead class="thead-mcolor">
                <tr>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Usuario de Red</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            filtrar(1);
        });
    function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorUsuarios/Usuarios",
                data: {
                    "pagina": pag,
                    "rpp":10,
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_usuarios tbody').empty();
                    $('#tabla_usuarios tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
    </script>
}