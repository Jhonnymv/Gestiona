@model GestionAmbiental.UseCases.GestorTablasMaestras.AvistamientoFauna.Model.ContactoEmergenciaModel
@{
    ViewData["Title"] = "AgregarContactoEmergencia";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Agregar Contacto de Emergencia</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorAvistamientoFauna" asp-action="AgregarContactoEmergencia">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Nombres"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Nombres"></span>
                    <input type="text" class="form-control" asp-for="Nombres">
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Apellidos"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Apellidos"></span>
                    <input type="text" class="form-control" asp-for="Apellidos">
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Telefono"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Telefono"></span>
                    <input type="text" class="form-control" asp-for="Telefono">
                </div>
                <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorAvistamientoFauna" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

