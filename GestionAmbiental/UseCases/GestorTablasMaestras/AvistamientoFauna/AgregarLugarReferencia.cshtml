@section Scripts{
    <script type="text/javascript">
        $("#convertir").on("click", function () {
            $("#modal_ubicacion").modal("show");
        });
        $("#zona,#este,#norte,#hemisferio").on("change", function () {
            var zona = $("#zona").val();
            var este = $("#este").val();
            var norte = $("#norte").val();
            var hemisferio = $("#hemisferio").val();

            console.log("zona", zona);
            console.log("este", este);
            console.log("norte", norte);
            console.log("hemisferio", hemisferio);

            if (zona != "" && este != "" && norte != "" && hemisferio != "") {
                $.ajax({
                    type: 'POST',
                    url: '/GestorAvistamientoFauna/UTMToLatLon',
                    data:
                    {
                        Easting: $("#este").val(),
                        Northing: $("#norte").val(),
                        Zone: $("#zona").val(),
                        Hemi: $("#hemisferio").val()
                    },
                    success: function (response) {
                        $("#lat").val(response.latitude);
                        $("#long").val(response.longitude);
                    },
                    error: function () {
                        console.log("No se ha podido convertir las coordenadas");
                    }
                });
            }
        });
        $("#bntUtilizarVal").on("click", function () {
            var lat = $("#lat").val();
            var long = $("#long").val();

            $("#Latitud").val(lat);
            $("#Longitud").val(long);

            $("#este").val("");
            $("#norte").val("");
            $("#lat").val("");
            $("#long").val("");

            $("#modal_ubicacion").modal("toggle");
        });
    </script>
}

