<!-- Modal Convertir Ubicación-->
<div class="modal fade" tabindex="-1" id="modal_ubicacion" aria-labelledby="titulo_modal_ubicacion" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-tablas">
            <div class="modal-content">
                <div class="tablas">
                    <div class="image-header-container"
                         style="background-image: url(&quot;/img/back-inspection.png&quot;);">
                        <div class="header-title tablas-opacity-color">
                            <h3>Convertir UTM a Latitud y Longitud</h3><img src="/img/logo-white.png" alt="Logo Marcobre">
                        </div><button type="button" class="btn-close" data-bs-dismiss="modal"
                                      aria-label="Close"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="container pt-4 pb-4">
                        <div class="custom-form details-container w-100">
                            <div class="message"></div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Hemisferio</label>
                                </div>
                                <div class="col-lg-8">
                                    <select class="form-control" id="hemisferio">
                                        <option value="S" selected>Sur</option>
                                        <option value="N">Norte</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Zona</label>
                                </div>
                                <div class="col-lg-8">
                                    <input id="zona" type="number" class="form-control" value="18">
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Este</label>
                                </div>
                                <div class="col-lg-8">
                                    <input id="este" type="number" class="form-control">
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Norte</label>
                                </div>
                                <div class="col-lg-8">
                                    <input id="norte" type="number" class="form-control">
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-12 titulo-pagina">
                                    <h2>Resultado</h2>
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Latitud</label>
                                </div>
                                <div class="col-lg-8">
                                    <input id="lat" type="number" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="col-lg-4">
                                    <label>Longitud</label>
                                </div>
                                <div class="col-lg-8">
                                    <input id="long" type="number" class="form-control" readonly>
                                </div>
                            </div>
                            <div class="row input_container w-100">
                                <div class="button-container">
                                    <div></div>
                                    <div id="bntsDetalle">
                                        <button type="button" class="btn btn-mc-outline-danger" data-dismiss="modal">Cerrar</button>
                                        <button id="bntUtilizarVal" type="button" class="btn btn-mc-success">Utilizar Valores</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
