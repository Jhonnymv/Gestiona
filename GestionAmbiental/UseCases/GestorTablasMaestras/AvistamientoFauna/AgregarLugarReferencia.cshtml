@model GestionAmbiental.UseCases.GestorTablasMaestras.AvistamientoFauna.Model.LugarReferenciaModel
@{
    ViewData["Title"] = "AgregarLugarReferencia";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Agregar Lugar de Referencia</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorAvistamientoFauna" asp-action="AgregarLugarReferencia">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label asp-for="Descripcion"></label>
                        <span class="text-danger" asp-validation-for="Descripcion"></span>
                        <input type="text" class="form-control" asp-for="Descripcion">
                    </div>
                    <div class="row input_container justify-content-center">
                        <div class="col-12 col-md-6 col-lg-6 text-center">
                            <button id="convertir" type="button" class="btn btn-mc-outline-success">Convertir UTM a Latitud y Longitud</button>
                        </div>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Latitud"></label>
                        <span class="text-danger" asp-validation-for="Latitud"></span>
                        <input type="text" class="form-control" asp-for="Latitud">
                    </div>
                    <div class="row input_container">
                        <label asp-for="Longitud"></label>
                        <span class="text-danger" asp-validation-for="Longitud"></span>
                        <input type="text" class="form-control" asp-for="Longitud">
                    </div>
                    <input type="hidden" class="form-control" asp-for="Estado" value="ACT">
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorAvistamientoFauna" asp-action="Resumen" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="submit" class="btn btn-mc-success">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
