@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabAvistamientoFauna');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarNombreComun(1);
                $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarNombreComun");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabAvistamientoFauna', $(e.target).attr('href'));
        });
        $("#btnenviar").on('click', function (e) {
            if ($("#TipoFauna").hasClass("active")) {
                FiltrarTipoFauna(1);
            }
            if ($("#NombreComun").hasClass("active")) {
                FiltrarNombreComun(1);
            }
            if ($("#EstadoFauna").hasClass("active")) {
                FiltrarEstadoFauna(1);
            }
            if ($("#TipoAvistamiento").hasClass("active")) {
                FiltrarTipoAvistamiento(1);
            }
            if ($("#ContactoEmergencia").hasClass("active")) {
                FiltrarContactoEmergencia(1);
            }
            if ($("#LugarReferencia").hasClass("active")) {
                FiltrarLugarReferencia(1);
            }
            if ($("#Usuarios").hasClass("active")) {
                FiltrarUsuario(1);
            }
        });
        $("#TipoFauna").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarTipoFauna");
            $("#opcion_editar_mensaje").hide();
            FiltrarTipoFauna(1);
        });
        $("#NombreComun").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarNombreComun");
            $("#opcion_editar_mensaje").hide();
            FiltrarNombreComun(1);
        });
        $("#EstadoFauna").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarEstadoFauna");
            $("#opcion_editar_mensaje").hide();
            FiltrarEstadoFauna(1);
        });
        $("#TipoAvistamiento").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarTipoAvistamiento");
            $("#opcion_editar_mensaje").hide();
            FiltrarTipoAvistamiento(1);
        });
        $("#ContactoEmergencia").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarContactoEmergencia");
            $("#opcion_editar_mensaje").show();
            FiltrarContactoEmergencia(1);
        });
        $("#LugarReferencia").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarLugarReferencia");
            $("#opcion_editar_mensaje").hide();
            FiltrarLugarReferencia(1);
        });
        $("#Usuarios").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarUsuario");
            $("#opcion_editar_mensaje").hide();
            FiltrarUsuario(1);
        });

        function FiltrarTipoFauna(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarTipoFauna",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarNombreComun(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarNombreComun",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarEstadoFauna(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarEstadoFauna",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarTipoAvistamiento(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarTipoAvistamiento",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarContactoEmergencia(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarContactoEmergencia",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarLugarReferencia(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarLugarReferencia",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarUsuario(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarUsuario",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
    </script>
}

