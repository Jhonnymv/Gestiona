
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Tablas Maestras - Avistamiento de Fauna</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>

        <div class="tabs-mc">
            <ul class="nav nav-pills mt-3 div-scroll-horizontal" id="listItems" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" type="button" id="TipoFauna" href="#TipoFauna" data-bs-toggle="pill" aria-selected="true">Tipo de Fauna</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="EstadoFauna" href="#EstadoFauna" data-bs-toggle="pill" aria-selected="false">Estado de Fauna</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" data-bs-toggle="pill" id="TipoAvistamiento" href="#TipoAvistamiento" aria-selected="false">Tipo de Avistamiento</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" data-bs-toggle="pill" id="ContactoEmergencia" href="#ContactoEmergencia" aria-selected="false">Contacto Emergencia</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" data-bs-toggle="pill" id="LugarReferencia" href="#LugarReferencia" aria-selected="false">Lugares de Referencia</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" data-bs-toggle="pill" id="Usuarios" href="#Usuarios" aria-selected="false">Usuarios a Notificar</a>
                </li>

            </ul>

            <div class="content-header">
                <div class="action-container tablas-color row-center-center">
                    <div class="w-100 row-center-center">
                        <a class="btn btn-special-action-outline tablas-color" id="btn_agregar">Agregar</a>
                    </div>
                    <div class="w-100 row-center-center">
                        <a class="btn btn-special-action-outline tablas-color" id="btn_editar_mensaje" asp-controller="GestorAvistamientoFauna" asp-action="DetalleMensajeContactoEmergencia">Editar Mensaje</a>
                    </div>
                </div>
                <form autocomplete="off" class="custom-form">
                    <div class="col-12 col-lg-9">
                        <div class="row input_container">
                            <div class="col-12 col-md-6 col-lg-6">
                                <label for="filtro_nombre">Buscar</label>
                                <input type="text" class="form-control" id="filtro">
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3 row-center-center">
                        <button type="button" class="btn btn-mc" id="btn_enviar">Buscar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="secondary-content col-12">
        <div class="table-responsive tablas-color" id="tab_content">

        </div>
        <div class="pagination-container tablas-color" id="paginado" aria-label="pagination">

        </div>
    </div>
</div>
