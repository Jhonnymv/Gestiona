
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="card text-center">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="listItems">
            <li class="nav-item">
                <a class="nav-link active" id="Nombre_Comun" href="#NombreComun">Nombre Común de Fauna</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Tipo_Fauna" href="#TipoFauna">Tipo de Fauna</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Estado_Fauna">Estado de Fauna</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Tipo_Avistamiento">Tipo de Avistamiento</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Contacto_Emergencia">Contacto Emergencia</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Lugar_Referencia">Lugares de Referencia</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Usuarios">Usuarios a Notificar</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="row mb-2 justify-content-center">
            <div class="col-4 col-sm-4 col-md-2 col-lg-2 mt-1">
                <label>Buscar:</label>
            </div>
            <div class="col-4 col-sm-4 col-md-3 col-lg-3 mt-1">
                <input type="text" class="form-control" id="filtro">
            </div>
            <div class="col-4 col-sm-4 col-md-2 col-lg-3 mt-1">
                <button class="btn btn-primary" id="btn_enviar">Buscar</button>
            </div>
        </div>
        <div class="row justify-content-start mt-2 mb-2">
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <a class="btn btn-danger" id="btn_agregar">Agregar</a>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" id="opcion_editar_mensaje" style="display:none;">
                <a class="btn btn-primary" id="btn_editar_mensaje" asp-controller="GestorAvistamientoFauna" asp-action="DetalleMensajeContactoEmergencia">Editar Mensaje</a>
            </div>
        </div>

        <div class="row" id="tab_content">
        </div>
        <div class="row justify-content-center" id="paginado">
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {           
            FiltrarNombreComun(1);
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarNombreComun");
        });

        $("#btn_enviar").on('click', function (e) {
            if ($("#Tipo_Fauna").hasClass("active")) {
                FiltrarTipoFauna(1);
            }
            if ($("#Nombre_Comun").hasClass("active")) {
                FiltrarNombreComun(1);
            }
            if ($("#Estado_Fauna").hasClass("active")) {
                FiltrarEstadoFauna(1);
            }
            if ($("#Tipo_Avistamiento").hasClass("active")) {
                FiltrarTipoAvistamiento(1);
            }
            if ($("#Contacto_Emergencia").hasClass("active")) {
                FiltrarContactoEmergencia(1);
            }
            if ($("#Lugar_Referencia").hasClass("active")) {
                FiltrarLugarReferencia(1);
            }
            if ($("#Usuarios").hasClass("active")) {
                FiltrarUsuario(1);
            }
        });
        $("#Tipo_Fauna").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarTipoFauna");
            $("#opcion_editar_mensaje").hide();
            FiltrarTipoFauna(1);
        });
        $("#Nombre_Comun").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarNombreComun");
            $("#opcion_editar_mensaje").hide();
            FiltrarNombreComun(1);
        });
        $("#Estado_Fauna").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarEstadoFauna");
            $("#opcion_editar_mensaje").hide();
            FiltrarEstadoFauna(1);
        });
        $("#Tipo_Avistamiento").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarTipoAvistamiento");
            $("#opcion_editar_mensaje").hide();
            FiltrarTipoAvistamiento(1);
        });
        $("#Contacto_Emergencia").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarContactoEmergencia");
            $("#opcion_editar_mensaje").show();
            FiltrarContactoEmergencia(1);
        });
        $("#Lugar_Referencia").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarLugarReferencia");
            $("#opcion_editar_mensaje").hide();
            FiltrarLugarReferencia(1);
        });
        $("#Usuarios").on('click', function (e) {
            $(this).tab('show');
            $("#btn_agregar").prop("href", "/GestorAvistamientoFauna/AgregarUsuario");
            $("#opcion_editar_mensaje").hide();
            FiltrarUsuario(1);
        });

        function FiltrarTipoFauna(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarTipoFauna",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarNombreComun(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarNombreComun",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarEstadoFauna(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarEstadoFauna",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarTipoAvistamiento(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarTipoAvistamiento",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarContactoEmergencia(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarContactoEmergencia",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarLugarReferencia(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarLugarReferencia",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarUsuario(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorAvistamientoFauna/FiltrarUsuario",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
    </script>
}

