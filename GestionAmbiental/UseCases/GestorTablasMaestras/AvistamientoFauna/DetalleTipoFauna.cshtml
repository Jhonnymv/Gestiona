@model GestionAmbiental.UseCases.GestorTablasMaestras.AvistamientoFauna.Model.TipoFaunaModel
@{
    ViewData["Title"] = "DetalleTipoFauna";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Información de Tipo de Fauna</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form details-container w-100" autocomplete="off" asp-controller="GestorAvistamientoFauna" asp-action="EditarTipoFauna"method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="IdTipoFauna" value="@Model.IdTipoFauna">
                <div class="detail-container col-12 col-xl-10 mb-4">
                    <div class="row input_container">
                        <label asp-for="Descripcion"></label>
                        <span class="text-danger" asp-validation-for="Descripcion"></span>
                        <input type="text" class="form-control" asp-for="Descripcion" disabled>
                    </div>
                    <div class="row input_container">
                        <label asp-for="RutaFoto"></label>
                        <input type="hidden" asp-for="RutaFoto" value="@Model.RutaFoto" />
                        <img src="@Model.RutaFoto" style="width:100%;height:auto" />
                    </div>
                    <div class="row input_container" id="seccion_foto" style="display:none;">
                        <label asp-for="Foto"></label>
                        <span class="text-danger field-validation-error" data-valmsg-for="Foto" data-valmsg-replace="true">
                            <span id="danger_evidencia" class=""></span>
                        </span>
                        <input type="file" class="form-control" asp-for="Foto" accept=".jpg,.jpeg,.png" onchange="preview_image(event)">
                    </div>
                    <div class="row input_container justify-content-center">
                        <div class="col-lg-8 text-center">
                            <img id="output_image" style="width:100%;height:auto" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <label asp-for="Estado"></label>
                        <span class="text-danger" asp-validation-for="Estado"></span>
                        <select class="form-control" asp-for="Estado" disabled>
                            <option value="">--SELECCIONE--</option>
                            <option value="ACT">ACT</option>
                            <option value="INA">INA</option>
                        </select>
                    </div>
                    <div class="row input_container">
                        <div class="button-container">
                            <div></div>
                            <div id="bntsEditar" style="display:none">
                                <button type="button" class="btn btn-mc-outline-danger mr-2" id="btnCancelar" disabled>Cancelar</button>
                                <button type="submit" class="btn btn-mc-success" id="btnGuardar" disabled>Guardar</button>
                            </div>
                            <div id="bntsDetalle">
                                <a asp-controller="GestorAvistamientoFauna" asp-action="Resumen" class="btn btn-mc-outline-danger mr-2" id="btnVolver">Volver</a>
                                <button type="button" class="btn btn-mc-success" id="btnEditar">Editar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
