@section scripts{
    <script>
        var r = 0;
        var g = 0;
        var b = 0;
        var img_url = "";
        $(document).ready(function () {
            dataModulo();
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        r = data.r;
                        g = data.g;
                        b = data.b;
                        img_url = data.img_url;
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorInfo_SGA/Info_SGA",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_info tbody').empty();
                    $('#tabla_info tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    tablasStyle(r, g, b);
                }
            });
        }
    </script>
}
