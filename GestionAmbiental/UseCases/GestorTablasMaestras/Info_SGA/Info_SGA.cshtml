
@{
    ViewData["Title"] = "Info_SGA";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
    <div class="row mb-2">
        <div class="col-12 titulo-pagina">
            <h2>Información del Sistema</h2>
        </div>
    </div>
    <form autocomplete="off">
        <div class="row mb-2 justify-content-center">
            <div class="col-lg-1 mt-1">
                <label>Buscar:</label>
            </div>
            <div class="col-lg-2 mt-1">
                <input type="text" class="form-control" id="filtro">
            </div>
            <div class="col-lg-1 mt-1">
                <button type="button" class="btn btn-primary" onclick="filtrar(1)" tabindex="-1">Filtrar</button>
            </div>
        </div>
    </form>
    <div class="row mb-2 justify-content-center">
        <div class="col-md">
            <table class="table" id="tabla_info" style="display:inline-table">
                <thead class="thead-mcolor">
                    <tr>
                        <th>Tipo de Información</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <nav id="paginado" aria-label="pagination">
        </nav>
    </div>
    @section scripts{
        <script>
        $(document).ready(function () {
            filtrar(1);
        });
    function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorInfo_SGA/Info_SGA",
                data: {
                    "pagina": pag,
                    "rpp":10,
                    "filtro": $('#filtro').val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_info tbody').empty();
                    $('#tabla_info tbody').html(response.data);
                    $('#paginado').html(response.paginador);
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
        </script>
    }
