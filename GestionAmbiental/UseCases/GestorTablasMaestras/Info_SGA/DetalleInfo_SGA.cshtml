@model GestionAmbiental.UseCases.GestorTablasMaestras.Info_SGA.Info_SGAModel
@{
    ViewData["Title"] = "DetalleInfo_SGA";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Información de Sistema</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form autocomplete="off" asp-controller="GestorInfo_SGA" asp-action="EditarInfo_SGA">
            <input type="hidden" asp-for="IdInfo">
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Tipo"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Tipo"></span>
                    <input type="text" class="form-control" asp-for="Tipo" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Info"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Info"></span>
                    <textarea  rows="4" cols="50" class="form-control" asp-for="Info" disabled></textarea>
                </div>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorInfo_SGA" asp-action="Info_SGA" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <script>
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            $("#Tipo").prop('disabled', true);
            $("#Info").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            $("#Tipo").prop('disabled', true);
            $("#Info").prop('disabled', true);
        });
        $("#btnGuardar").on('click', function () {            
            $("#Tipo").prop('disabled', false);
        });
    </script>
}
