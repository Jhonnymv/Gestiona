@model GestionAmbiental.UseCases.GestorTablasMaestras.Gestiona.TarjetaModel

@{
    ViewData["Title"] = "Detalle Tarjeta";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Detalle de Tarjeta</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form id="form_editar_tarjeta" autocomplete="off" asp-controller="GestorContenido" asp-action="EditarTarjeta" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" value="@Model.Id" />
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Orden"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Orden"></span>
                    <input type="text" class="form-control" asp-for="Orden" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Tipo"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Tipo"></span>
                    <select class="form-control" asp-for="Tipo" asp-items="@ViewBag.Tipos" disabled></select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Titulo"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Titulo"></span>
                    <input type="text" class="form-control" asp-for="Titulo" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Descripcion"></label>
                </div>
                <div class="col-lg-8" style="height: 400px;">
                    <span class="text-danger" asp-validation-for="Descripcion"></span>
                    <input type="hidden" class="form-control" asp-for="Descripcion" value="@Model.Descripcion">
                    <div id="editor" style="max-height:350px;">
                    </div>
                </div>
            </div><div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Imagen"></label>
                </div>
                <div class="col-lg-8" id="image_preview">
                    <input type="hidden" asp-for="Imagen" value="@Model.Imagen" />
                    <img src="@Model.Imagen" style="width:auto;height:auto; max-height:300px" />
                </div>
            </div>
            <div id="seccion_nueva_imagen" style="display:none;">
                <div class="row mb-2">
                    <div class="col-lg-4">
                        <label asp-for="ImagenNueva"></label>
                    </div>
                    <div class="col-lg-8">
                        <span class="text-danger field-validation-error" data-valmsg-for="ImagenNueva" data-valmsg-replace="true">
                            <span id="danger_imagen_nueva" class=""></span>
                        </span>
                        <label class="btn btn-primary" for="ImagenNueva">Seleccione</label>
                        <input type="file" style="visibility:hidden; display:none" asp-for="ImagenNueva" accept=".jpg,.jpeg,.png" onchange="preview_image(event)">
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-lg-4"></div>
                    <div class="col-lg-8">
                        <img id="output_image" style="width:auto;height:auto; max-height:300px" />
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="LugarImg"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="LugarImg"></span>
                    <select class="form-control" asp-for="LugarImg" asp-items="@ViewBag.Posiciones" disabled></select>
                </div>
            </div>
            <div id="seccion_ancho_imagen" class="row mb-2" style="display:none">
                <div class="col-lg-4">
                    <label asp-for="AnchoImg"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="AnchoImg"></span>
                    <select class="form-control" asp-for="AnchoImg" asp-items="@ViewBag.Anchos" disabled></select>
                </div>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorContenido" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <!-- Include the Quill library -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        var quill = new Quill('#editor', {
            theme: 'snow'
        });
        var descripcion = $("#Descripcion").val();       
        $(document).ready(function () {
            var lugarImagen = $("#LugarImg").val();
            if (lugarImagen == "izquierda" || lugarImagen == "derecha") {
                $("#seccion_ancho_imagen").show();
            }
            else {
                $("#seccion_ancho_imagen").hide();
                $("#AnchoImg").val(0);
            }
            $(".ql-editor").css("background-color", "#e4e7ea");
            $(".ql-toolbar").css("background-color", "#e4e7ea");
            $(".ql-editor").html(descripcion)
            quill.disable();
        });
        $("#LugarImg").on("change", function () {
            var lugarImagen = $("#LugarImg").val();
            if (lugarImagen == "izquierda" || lugarImagen == "derecha") {
                $("#seccion_ancho_imagen").show();
            } else {
                $("#seccion_ancho_imagen").hide();
                $("#AnchoImg").val(0);
            }
        });
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs       
            quill.enable();
            $(".ql-editor").css("background-color", "#ffffff");
            $(".ql-toolbar").css("background-color", "#ffffff");
            $("#Orden").prop('disabled', false);
            $("#Tipo").prop('disabled', false);
            $("#Titulo").prop('disabled', false);
            $("#Descripcion").prop('disabled', false);
            $("#seccion_nueva_imagen").show();
            $("#LugarImg").prop('disabled', false);
            $("#AnchoImg").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            quill.disable();
            $(".ql-editor").css("background-color", "#e4e7ea");
            $(".ql-toolbar").css("background-color", "#e4e7ea");
            $("#Orden").prop('disabled', true);
            $("#Tipo").prop('disabled', true);
            $("#Titulo").prop('disabled', true);
            $("#Descripcion").prop('disabled', true);
            $("#seccion_nueva_imagen").show();
            $("#LugarImg").prop('disabled', true);
            $("#AnchoImg").prop('disabled', true);
        });
        function preview_image(event) {
            var reader = new FileReader();
            reader.onload = function () {
                var output = document.getElementById('output_image');
                output.src = reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }
        $("#form_editar_tarjeta").submit(function () {
            var htmlText = $("#editor .ql-editor").html();
            quill.disable();
            $("#Descripcion").val(htmlText);
        });
    </script>
}


