@model GestionAmbiental.UseCases.GestorTablasMaestras.Gestiona.TarjetaModel

@{
    ViewData["Title"] = "Detalle Tarjeta";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

@section Styles{
    <link rel="stylesheet" href="~/css/articles_styles.css">
}

<div class="mc_container">
    <form id="form_editar_tarjeta" autocomplete="off" asp-controller="GestorContenido" asp-action="EditarTarjeta" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" value="@Model.Id" />
        <input type="hidden" class="form-control" asp-for="Tipo">
        <div class="menu_settings container first-div-tab-content mb-4">
            <span class="text-mc">Contenido</span>
            <div class="div-separator"></div>
            <div class="custom-form w-100 flex-column">
                <div class="row input_container col-12">
                    <div class="col-12 col-lg-6">
                        <label asp-for="Titulo">Título del Artículo</label>
                        <span class="text-danger" asp-validation-for="Titulo"></span>
                        <input type="text" class="form-control" asp-for="Titulo" readonly />
                    </div>
                    <div class="col-12 col-lg-6">
                        <label for="">Imagen del Artículo</label>
                        <input type="file" asp-for="ImagenNueva" accept=".jpg,.jpeg,.png" class="form-control" disabled />
                    </div>
                </div>
                <div class="row input_container col-12">
                    <div class="col-12 col-lg-6">
                        <label asp-for="Publicador">Publicador del Artículo</label>
                        <span class="text-danger" asp-validation-for="Publicador"></span>
                        <input type="text" class="form-control" asp-for="Publicador" readonly />
                    </div>
                    <div class="col-12 col-lg-6">
                        <label asp-for="Fecha">Fecha</label>
                        <span class="text-danger" asp-validation-for="Fecha"></span>
                        <input class="form-control" type="date" asp-for="Fecha" readonly />
                    </div>
                </div>
                <div class="input_container col-12">
                    <div class="col-12">
                        <label for="">Contenido del Artículo</label>
                        <span class="text-danger" asp-validation-for="Contenido"></span>
                        <input type="hidden" class="form-control" asp-for="Contenido">
                        <div id="editor" style="height:200px; max-height:350px;">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row-center-center col-12">
                <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                    <div style="margin-right: 1em; width:auto">
                        <button type="button" class="btn btn btn-mc-outline" id="btnCancelar" disabled>Cancelar</button>
                    </div>
                    <div style="width:auto">
                        <button type="button" class="btn btn-mc" id="btnGuardar" disabled>Guardar</button>
                    </div>
                </div>
                <div class="row mt-2 justify-content-center" id="bntsDetalle">
                    <div style="margin-right: 1em; width:auto">
                        <a asp-controller="GestorContenido" asp-action="ResumenTarjetas" class="btn btn-mc-outline" id="btnVolver">Volver</a>
                    </div>
                    <div style="width:auto">
                        <button type="button" class="btn btn-mc" id="btnEditar">Editar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="menu_settings container first-div-tab-content">
            <span class="text-mc">Previsualización</span>
            <div class="div-separator"></div>
            <ul class="nav nav-pills mb-3 d-flex justify-content-center" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-inspections-tab" data-bs-toggle="pill"
                            data-bs-target="#pills-inspections" type="button" role="tab"
                            aria-controls="pills-inspections" aria-selected="true">
                        Escritorio
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-rac-tab" data-bs-toggle="pill" data-bs-target="#pills-rac"
                            type="button" role="tab" aria-controls="pills-rac" aria-selected="false">
                        Móvil
                    </button>
                </li>
            </ul>
            <div class="tab-content" id="pills-tabContent">
                <div class="tab-pane fade show active" id="pills-inspections" role="tabpanel"
                     aria-labelledby="pills-inspections-tab">
                    <div class="first-div-tab-content mb-4">
                        <div class="col-12 custom-form">
                            <div class="row input_container col-12">
                                <div class="col-12 col-lg-6">
                                    <label asp-for="PosicionE">Posición del Contenido</label>
                                    <span class="text-danger" asp-validation-for="PosicionE"></span>
                                    <select class="form-control" asp-for="PosicionE" disabled>
                                        <option value="0">Seleccionar</option>
                                        <option value="1">Escritorio: Derecha</option>
                                        <option value="2">Escritorio: Izquierda</option>
                                    </select>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label asp-for="Tamanio">Tamaño de la Tarjeta (Escritorio)</label>
                                    <span class="text-danger" asp-validation-for="Tamanio"></span>
                                    <select class="form-control" asp-for="Tamanio" disabled>
                                        <option value="0">Seleccionar</option>
                                        <option value="1">Pequeña</option>
                                        <option value="2">Mediana</option>
                                        <option value="3">Grande</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="articles">
                        <div class="article-card medium-article" id="article-desktop">
                            <div class="article-content">
                                <div class="article-title">
                                    <h3 class="text-title-article">Título de Artículo</h3>
                                    <span>Fecha: <span class="text-date-article">01/01/2021</span></span>
                                </div>
                                <div class="article-body text-content-article">
                                    <p>
                                        Lorem ipsum dolor sit amet, consectetur
                                        adipisicing elit. Aspernatur atque, officia pariatur quae quia rerum tempore
                                        veniam, voluptatibus?
                                    </p>
                                </div>
                                <div class="article-footer">
                                    <span>Escrito por <span class="text-publisher-article">Marcobre</span></span>
                                </div>
                            </div>
                            <div class="article-image">
                                <img class="prev-image-article" src="@Model.Imagen" alt="">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="pills-rac" role="tabpanel" aria-labelledby="pills-rac-tab">
                    <div class="first-div-tab-content mb-4">
                        <div class="col-12 custom-form">
                            <div class="row input_container col-12">
                                <div class="col-12 col-lg-6">
                                    <label asp-for="PosicionM">Posición del Contenido</label>
                                    <select class="form-control" asp-for="PosicionM" disabled>
                                        <option value="">Seleccionar</option>
                                        <option value="1">Móvil: Arriba</option>
                                        <option value="2">Móvil: Abajo</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="articles articles-mobile d-flex justify-content-center">
                        <div class="article-card medium-article" id="article-mobile">
                            <div class="article-content">
                                <div class="article-title">
                                    <h3 class="text-title-article">Título de Artículo</h3>
                                    <span>Fecha: <span class="text-date-article">30/03/2021</span></span>
                                </div>
                                <div class="article-body text-content-article">
                                    <p>
                                        Lorem ipsum dolor sit amet, consectetur
                                        adipisicing elit. Aspernatur atque, officia pariatur quae quia rerum tempore
                                        veniam, voluptatibus?
                                    </p>
                                </div>
                                <div class="article-footer">
                                    <span>Escrito por <span class="text-publisher-article">Marcobre</span></span>
                                </div>
                            </div>
                            <div class="article-image">
                                <img class="prev-image-article" src="@Model.Imagen" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade mc-modal" id="guardarCambiosConfig" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="display:none" id="btnCerrarSettings"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px" id="guardandoCambios">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                        <div id="cambiosGuardados" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px"
                                 width="50" height="50"
                                 viewBox="0 0 226 226"
                                 style=" fill:#ffffff;">
                                <g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="normal" font-size="none" text-anchor="middle" style="mix-blend-mode: normal"><path d="M0,226v-226h226v226z" fill="none"></path><g fill="#ffffff"><path d="M204.67456,42.31063c-1.83417,0.05346 -3.57555,0.81861 -4.85547,2.13346l-122.13159,122.13159l-51.50659,-51.50659c-1.77141,-1.84495 -4.40181,-2.58812 -6.87677,-1.94291c-2.47496,0.64522 -4.40774,2.578 -5.05296,5.05296c-0.64522,2.47496 0.09796,5.10536 1.94291,6.87677l56.5,56.5c2.75812,2.75698 7.2287,2.75698 9.98682,0l127.125,-127.125c2.08533,-2.03093 2.71115,-5.13317 1.57629,-7.81372c-1.13486,-2.68055 -3.79796,-4.39036 -6.70764,-4.30656z"></path></g></g>
                            </svg>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label id="mensajeModalConfig" class="text-white"></label>
                    </div>
                </div>
                <div class="modal-footer" id="btnAceptarSettings" style="display:none">
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-mc-white m-0" type="button" data-bs-dismiss="modal" aria-label="Close">Aceptar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <!-- Include the Quill library -->
    <link href="~/lib/quill-editor/quill.snow.css" rel="stylesheet">
    <script src="~/lib/quill-editor/quill.min.js"></script>
    <script>
        var size_class;
        var position_class;
        var article_class;
        var quill = new Quill('#editor', {
            theme: 'snow'
        });
        var contenido = $("#Contenido").val();
        $(document).ready(function () {
            $('.text-title-article').html($('#Titulo').val());
            $('.text-date-article').html($('#Fecha').val());
            $('.text-publisher-article').html($('#Publicador').val());

            $('.text-content-article').html('');
            $('.text-content-article').append($("#Contenido").val());

            $('#article-desktop').removeClass();
            compSize();
            compPosition();
            compPositionM();
            article_class = 'article-card' + position_class + size_class;
            $('#article-desktop').addClass(article_class);

            var lugarImagen = $("#LugarImg").val();
            if (lugarImagen == "izquierda" || lugarImagen == "derecha") {
                $("#seccion_ancho_imagen").show();
            }
            else {
                $("#seccion_ancho_imagen").hide();
                $("#AnchoImg").val(0);
            }

            $(".ql-editor").css("background-color", "#e4e7ea");
            $(".ql-toolbar").css("background-color", "#e4e7ea");
            $(".ql-editor").html(contenido)
            quill.disable();
        });

        $("#LugarImg").on("change", function () {
            var lugarImagen = $("#LugarImg").val();
            if (lugarImagen == "izquierda" || lugarImagen == "derecha") {
                $("#seccion_ancho_imagen").show();
            } else {
                $("#seccion_ancho_imagen").hide();
                $("#AnchoImg").val(0);
            }
        });

        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            quill.enable();
            $(".ql-editor").css("background-color", "#ffffff");
            $(".ql-toolbar").css("background-color", "#ffffff");
            $("#Titulo").prop('readonly', false);
            $("#Contenido").prop('disabled', false);
            $("#Tipo").prop('disabled', false);
            $("#Publicador").prop('readonly', false);
            $("#Fecha").prop('readonly', false);
            $("#PosicionE").prop('disabled', false);
            $("#PosicionM").prop('disabled', false);
            $("#Tamanio").prop('disabled', false);
            $("#ImagenNueva").prop('disabled', false);
            $("#seccion_nueva_imagen").show();
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            quill.disable();
            $(".ql-editor").css("background-color", "#e4e7ea");
            $(".ql-toolbar").css("background-color", "#e4e7ea");
            $("#Titulo").prop('readonly', true);
            $("#Contenido").prop('disabled', true);
            $("#Tipo").prop('disabled', true);
            $("#Publicador").prop('readonly', false);
            $("#Fecha").prop('readonly', true);
            $("#PosicionE").prop('disabled', true);
            $("#PosicionM").prop('disabled', true);
            $("#Tamanio").prop('disabled', true);
            $("#ImagenNueva").prop('disabled', true);
            $("#seccion_nueva_imagen").show();
        });

        $("#btnGuardar").on('click', function () {
            if (Validar()) {
                $('#guardarCambiosConfig').modal('show');
                $('#mensajeModalConfig').text('Guardando Cambios');
                var htmlText = $("#editor .ql-editor").html();
                $("#Contenido").val(htmlText);
                $("#Tipo").val(article_class);
                var formData = new FormData();
                var files = document.getElementById("ImagenNueva").files;
                for (var i = 0; i != files.length; i++) {
                    formData.append("ImagenNueva", files[i]);
                }
                formData.append("Id", $("#Id").val());
                formData.append("Titulo", $("#Titulo").val());
                formData.append("Publicador", $("#Publicador").val());
                formData.append("Fecha", $("#Fecha").val());
                formData.append("Contenido", $("#Contenido").val());
                formData.append("PosicionE", $("#PosicionE").val());
                formData.append("Tamanio", $("#Tamanio").val());
                formData.append("Tipo", $("#Tipo").val());
                $.ajax({
                    url: "@Url.Action("EditarTarjeta", "GestorContenido")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = "@Url.Action("ResumenTarjetas", "GestorContenido")";
                        }
                        else {
                            console.log("Ocurrió un error: ", response.message);
                        }
                    }
                });
            }
        });

        $('#Tamanio').change(function () {
            $('#article-desktop').removeClass();
            compSize();
            compPosition();
            $('#article-desktop').addClass('article-card' + position_class + size_class);

            article_class = 'article-card' + position_class + size_class;
        });

        $('#PosicionE').change(function () {
            $('#article-desktop').removeClass();
            compSize();
            compPosition();
            $('#article-desktop').addClass('article-card' + position_class + size_class);

            article_class = 'article-card' + position_class + size_class;
        });

        $('#PosicionM').change(function () {
            $('#article-desktop').removeClass();
            compSize();
            compPosition();
            compPositionM();

            $('#article-desktop').addClass('article-card' + position_class + size_class);

            article_class = 'article-card' + position_class + size_class;
        });

        function compSize() {
            size_class = '';
            if ($('#Tamanio').val() === '1') {
                size_class += ' small-article';
            } else if ($('#Tamanio').val() === '2') {
                size_class += ' medium-article';
            } else if ($('#Tamanio').val() === '3') {
                size_class += ' large-article';
            } else {
                size_class += ' medium-article';
            }
        }

        function compPosition() {
            position_class = '';
            if ($('#PosicionE').val() === '1') {
                if ($('#PosicionM').val() === '1') {
                    position_class += ' article-right-top';
                } else if ($('#PosicionM').val() === '2') {
                    position_class += ' article-right-bottom';
                } else {
                    position_class += ' article-right-top';
                }
            } else if ($('#PosicionE').val() === '2') {
                if ($('#PosicionM').val() === '1') {
                    position_class += ' article-left-top';
                } else if ($('#PosicionM').val() === '2') {
                    position_class += ' article-left-bottom';
                } else {
                    position_class += ' article-left-top';
                }
            }
            else if ($('#PosicionE').val() === '') {
                if ($('#PosicionM').val() === '1') {
                    position_class += ' article-left-top';
                } else if ($('#PosicionM').val() === '2') {
                    position_class += ' article-left-bottom';
                } else {
                    position_class += ' article-left-top';
                }
            }
            else {
                position_class += ' article-left-top';
            }
        }

        function compPositionM() {
            $('#article-mobile').removeClass();
            if ($('#PosicionM').val() === '1') {
                $('#article-mobile').addClass('article-card');
                $('#article-mobile').addClass('article-content-top' + size_class);
            } else if ($('#PosicionM').val() === '2') {
                $('#article-mobile').addClass('article-card');
                $('#article-mobile').addClass('article-content-bottom' + size_class);
            } else {
                $('#article-mobile').addClass('article-card');
                $('#article-mobile').addClass('article-content-top' + size_class);
            }
        }

        $('#Titulo').keyup(function () {
            if ($(this).val() !== '') {
                $('.text-title-article').html($(this).val());
            } else {
                $('.text-title-article').html('Título de Artículo');
            }
        });

        $('#Fecha').change(function () {
            if ($(this).val() !== '') {
                $('.text-date-article').html($(this).val());
            } else {
                $('.text-date-article').html('01/01/2050');
            }
        });

        $('#Publicador').keyup(function () {
            if ($(this).val() !== '') {
                $('.text-publisher-article').html($(this).val());
            } else {
                $('.text-publisher-article').html('Marcobre');
            }
        });

        quill.on('text-change', function (delta, source) {
            let editor_content = quill.root.innerHTML;
            $('.text-content-article').html('');
            $('.text-content-article').append(editor_content);
        });

        function readURL(selector, input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $(selector).attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $('#ImagenNueva').change(function () {
            if ($(this).val() === "") {
                $('.prev-image-article').attr('src', '');
                $(this).css('border', '2px solid #FF4D4D');
            }
            else if ($('#ImagenNueva').val() !== "") {
                readURL('.prev-image-article', this);
                $(this).css('border', '2px solid #27C767');
            }
        });

        function ReiniciarMsgs() {
            $('span[data-valmsg-for="Titulo"]').text("");
            $('span[data-valmsg-for="Publicador"]').text("");
            $('span[data-valmsg-for="Fecha"]').text("");
            $('span[data-valmsg-for="Contenido"]').text("");
            $('span[data-valmsg-for="PosicionE"]').text("");
            $('span[data-valmsg-for="Tamanio"]').text("");
        }

        function Validar() {
            ReiniciarMsgs();
            var result = true;
            if ($("#Titulo").val() == "") {
                result = false; $('span[data-valmsg-for="Titulo"]').text("Debe ingresar un texto");
            }
            if ($("#Publicador").val() == "") {
                result = false; $('span[data-valmsg-for="Publicador"]').text("Debe ingresar un texto");
            }
            if ($("#Fecha").val() == "") {
                result = false; $('span[data-valmsg-for="Fecha"]').text("Debe seleccionar una fecha");
            }
            if ($("#editor .ql-editor").html() == "<p><br></p>") {
                result = false; $('span[data-valmsg-for="Contenido"]').text("Debe ingresar un texto");
            }
            if ($("#PosicionE").val() == "0") {
                result = false; $('span[data-valmsg-for="PosicionE"]').text("Debe seleccionar una opción");
            }
            if ($("#Tamanio").val() == "0") {
                result = false; $('span[data-valmsg-for="Tamanio"]').text("Debe seleccionar una opción");
            }
            return result;
        }
    </script>
}


