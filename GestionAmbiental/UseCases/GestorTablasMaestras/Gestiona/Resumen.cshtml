
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}


<div class="card text-center">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" id="listItems">
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" id="Tarjetas" href="#Tarjetas">Tarjetas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" id="Colores" href="#Colores">Colores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" id="Fuentes" href="#Fuentes">Fuentes</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="row mb-2 justify-content-center">
            <div class="col-4 col-sm-4 col-md-2 col-lg-2 mt-1">
                <label>Buscar:</label>
            </div>
            <div class="col-4 col-sm-4 col-md-3 col-lg-3 mt-1">
                <input type="text" class="form-control" id="filtro">
            </div>
            <div class="col-4 col-sm-4 col-md-2 col-lg-3 mt-1">
                <button class="btn btn-primary" id="btn_enviar">Buscar</button>
            </div>
        </div>
        <div class="row mt-2 mb-2">
            <div class="col-6 col-sm-6 col-md-6 col-lg-6 text-left">
                <a class="btn btn-danger" id="btn_agregar">Agregar</a>
            </div>
            <div class="col-6 col-sm-6 col-md-6  col-lg-6 text-right">
                <button type="button" class="btn btn-primary" id="btn_actualizar" onclick="ActualizarTarjetas()">Actualizar Datos</button>
            </div>
        </div>
        <div class="row" id="tab_content">
        </div>
        <div class="row justify-content-center" id="paginado">
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabGestorContenido');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-tabs a[href="' + activeTab + '"]').tab('show');
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarTarjetas(1);
                $("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
            }
        });
        //Guardar tab activo en local storage
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabGestorContenido', $(e.target).attr('href'));
            console.log($(e.target).attr('id'))
            switch ($(e.target).attr('id')) {
                case "Tarjetas":
                    FiltrarTarjetas(1);
                    $("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
                    break;
                case "Colores":
                    FiltrarColores(1);
                    $("#btn_agregar").hide();
                    break;
                case "Fuentes":
                    FiltrarFuentes(1);
                    $("#btn_agregar").hide();
                    break;
            }
        });

        $("#btn_enviar").on('click', function (e) {
            if ($("#Tarjetas").hasClass("active")) {
                FiltrarTarjetas(1);
            } if ($("#Colores").hasClass("active")) {
                FiltrarColores(1);
            } if ($("#Fuentes").hasClass("active")) {
                FiltrarFuentes(1);
            }
        });
        $("#Tarjetas").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
            $("#btn_actualizar").attr("onclick", "ActualizarTarjetas()");
            FiltrarTarjetas(1);
        });
        $("#Colores").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            $("#btn_actualizar").attr("onclick", "ActualizarColoresFuentes()");
            FiltrarColores(1);
        });
        $("#Fuentes").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            $("#btn_actualizar").attr("onclick", "ActualizarColoresFuentes()");
            FiltrarFuentes(1);
        });
        function FiltrarTarjetas(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarTarjetas",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarColores(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarColores",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function FiltrarFuentes(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarFuentes",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty()
                    $('#tab_content').html(response.tabla)
                    $('#paginado').html(response.paginador)
                }
            });
        }
        function EliminarTarjeta(id) {
            if (confirm('¿Esta seguro que desea eliminar la tarjeta?')) {
                $.ajax({
                    type: "POST",
                    url: "/GestorContenido/EliminarTarjeta",
                    data: {
                        IdTarjeta: id
                    },
                    success: (response) => {
                        if (response.result == "Ok") {
                            FiltrarTarjetas(1);
                        }
                        else {
                            console.log(response.message);
                        }
                    }
                });
            }
        }
        function ActualizarTarjetas() {
            $.ajax({
                type: "GET",
                url: "/GestorContenido/ActualizarTarjetas",
                success: (response) => {
                    window.location.reload();
                }
            })
        }
        function ActualizarColoresFuentes() {
            $.ajax({
                type: "GET",
                url: "/GestorContenido/ActualizarColoresFuentes",
                success: (response) => {
                    window.location.reload();
                }
            })
        }
    </script>
}




