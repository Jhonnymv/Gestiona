@model GestionAmbiental.UseCases.PropiedadModulos
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="tablas">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title tablas-opacity-color">
                <h3>Configuración de la Plataforma</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="tabs-mc">
            <ul class="nav nav-pills mt-3 div-scroll-horizontal" id="listItems" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" type="button" id="Inspecciones" href="#Inspecciones" data-bs-toggle="pill" aria-selected="true">Inspecciones</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="RAC" href="#RAC" data-bs-toggle="pill" aria-selected="false">Reporte de Acto y Condición Subestándar</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Residuos" href="#Residuos" data-bs-toggle="pill" aria-selected="false">Residuos Sólidos</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Incidentes" href="#Incidentes" data-bs-toggle="pill" aria-selected="false">Incidentes Ambientales</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Fauna" href="#Fauna" data-bs-toggle="pill" aria-selected="false">Avistamiento de Fauna</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Agua" href="#Agua" data-bs-toggle="pill" aria-selected="false">Consumo de Agua</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="SGA" href="#SGA" data-bs-toggle="pill" aria-selected="false">SGA</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Tablas" href="#Tablas" data-bs-toggle="pill" aria-selected="false">Tablas</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" type="button" id="Dashboard" href="#Dashboard" data-bs-toggle="pill" aria-selected="false">Dashboard</a>
                </li>
            </ul>            
        </div>
    </div>
    <div class="secondary-content col-12">
        <form id="form_propiedades" autocomplete="off"  method="post" enctype="multipart/form-data">
            <button type="button" onclick="GuardarColores()">Guardar Colores</button>
            <button type="button" onclick="GuardarPropiedad()">Guardar Propiedad</button>
            <div id="inspecciones-input">
                <label>inspection</label>
                <input type="color" id="inspection-colorPicker" class="mc_color_picker" style="width:100%">
                <input type="number" id="inspection-r"/>
                <input type="number" id="inspection-g"/>
                <input type="number" id="inspection-b"/>
                <img style="width:100px;height:auto;"id="inspection-img"/>
                <input type="file" id="inspection-nueva-img" accept=".jpg,.jpeg,.png"/>
            </div>
            <div id="rac-input">
                <label>rac</label>
                <input type="color" id="rac-colorPicker" class="mc_color_picker" style="width:100%">
                <input type="number" id="rac-r" />
                <input type="number" id="rac-g" />
                <input type="number" id="rac-b" />
                <img style="width:100px;height:auto;" id="rac-img" />
                <input type="file" id="rac-nueva-img" accept=".jpg,.jpeg,.png" />
            </div>
            <div id="residuos-input">
                <label>residuos</label>
                <input type="color" id="residuos-colorPicker" class="mc_color_picker" style="width:100%">
                <input type="number" id="residuos-r" />
                <input type="number" id="residuos-g" />
                <input type="number" id="residuos-b" />
                <img style="width:100px;height:auto;" id="residuos-img" />
                <input type="file" id="residuos-nueva-img" accept=".jpg,.jpeg,.png" />
            </div>
            <div id="incidentes-input">
                <label>incidentes</label>
                <input type="color" id="incidentes-colorPicker" class="mc_color_picker" style="width:100%">
