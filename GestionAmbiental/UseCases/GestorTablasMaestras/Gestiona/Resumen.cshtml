@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            
            //Buscar tab activo guardado en local storage
            var activeTab = localStorage.getItem('activeTabGestorContenido');
            //Si existe el objeto en local storage mostrar
            if (activeTab) {
                $('.nav-pills a[href="' + activeTab + '"]').click();
            }
            //Si no existe, mostrar primer tab
            else {
                FiltrarTarjetas(1);
                $("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
            }
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        tablasStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        //Guardar tab activo en local storage
        $('a[data-bs-toggle="pill"]').on('shown.bs.tab', function (e) {
            localStorage.setItem('activeTabGestorContenido', $(e.target).attr('href'));
        });
        $("#btn_enviar").on('click', function (e) {
            if ($("#Tarjetas").hasClass("active")) {
                FiltrarTarjetas(1);
            } if ($("#Colores").hasClass("active")) {
                FiltrarColores(1);
            } if ($("#Fuentes").hasClass("active")) {
                FiltrarFuentes(1);
            }
        });
        $("#Tarjetas").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").show();
            $("#btn_agregar").prop("href", "/GestorContenido/AgregarTarjeta");
            $("#btn_actualizar").attr("onclick", "ActualizarTarjetas()");
            FiltrarTarjetas(1);
        });
        $("#Colores").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            $("#btn_actualizar").attr("onclick", "ActualizarColoresFuentes()");
            FiltrarColores(1);
        });
        $("#Fuentes").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            $("#btn_actualizar").attr("onclick", "ActualizarColoresFuentes()");
            FiltrarFuentes(1);
        });
        $("#Propiedades").on('click', function (e) {
            $(this).tab('show');
            $('#filtro').val("");
            $("#btn_agregar").hide();
            $("#btn_actualizar").attr("onclick", "ActualizarColoresFuentes()");
            FiltrarPropiedades(1);
        });
        function FiltrarTarjetas(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarTarjetas",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarColores(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarColores",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }        
        function FiltrarFuentes(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarFuentes",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function FiltrarPropiedades(pag) {
            $.ajax({
                type: "POST",
                url: "/GestorContenido/FiltrarPropiedades",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "filtro": $('#filtro').val(),
                },
                traditional: true,
                success: (response) => {
                    $('#tab_content').empty();
                    $('#tab_content').html(response.tabla);
                    $('#paginado').html(response.paginador);
                    dataModulo();
                }
            });
        }
        function EliminarTarjeta(id) {
            if (confirm('¿Esta seguro que desea eliminar la tarjeta?')) {
                $.ajax({
                    type: "POST",
                    url: "/GestorContenido/EliminarTarjeta",
                    data: {
                        IdTarjeta: id
                    },
                    success: (response) => {
                        if (response.result == "Ok") {
                            FiltrarTarjetas(1);
                        }
                        else {
                            console.log(response.message);
                        }
                    }
                });
            }
        }
        function ActualizarTarjetas() {
            $.ajax({
                type: "GET",
                url: "/GestorContenido/ActualizarTarjetas",
                success: (response) => {
                    window.location.reload();
                }
            })
        }
        function ActualizarColoresFuentes() {
            $.ajax({
                type: "GET",
                url: "/GestorContenido/ActualizarColoresFuentes",
                success: (response) => {
                    window.location.reload();
                }
            })
        }
    </script>
}




