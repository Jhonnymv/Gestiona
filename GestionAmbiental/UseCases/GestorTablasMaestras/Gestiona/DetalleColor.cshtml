@model GestionAmbiental.UseCases.GestorTablasMaestras.Gestiona.ColoresModel

@{
    ViewData["Title"] = "DetalleColor";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Detalle de Color</h2>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <form id="form_editar_tarjeta" autocomplete="off" asp-controller="GestorContenido" asp-action="EditarColor" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" value="@Model.Id" />
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Descripcion"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Descripcion"></span>
                    <textarea class="form-control" asp-for="Descripcion" disabled></textarea>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Variable"></label>
                </div>
                <div class="col-lg-8">
                    <span class="text-danger" asp-validation-for="Variable"></span>
                    <input type="text" class="form-control" asp-for="Variable" disabled>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-lg-4">
                    <label asp-for="Valor"></label>
                </div>
                <div class="col-lg-8" style="height:100px;">
                    <span class="text-danger" asp-validation-for="Valor"></span>
                    <input type="hidden" class="form-control" asp-for="Valor" disabled>
                    <div id="basic">                         
                    </div>
                </div>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsEditar" style="display:none">
                <button type="button" class="btn btn-secondary mr-2" id="btnCancelar" disabled>Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Guardar</button>
            </div>
            <div class="row mt-2 justify-content-center" id="bntsDetalle">
                <a asp-controller="GestorContenido" asp-action="Resumen" class="btn btn-secondary mr-2" id="btnVolver">Volver</a>
                <button type="button" class="btn btn-primary" id="btnEditar">Editar</button>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <!-- One of the following themes -->
    <link rel="stylesheet" href="~/lib/pickr/themes/nano.min.css" /> 
    <!-- Modern or es5 bundle -->
    <script src="~/lib/pickr/pickr.min.js"></script>
    <script src="~/lib/pickr/pickr.es5.min.js"></script>
    <script>
        // Simple example, see optional options for more configuration.
        const pickr = Pickr.create({
            el: '#basic',
            theme: 'nano', // or 'monolith', or 'nano'
            default: '@Model.Valor',
            disabled: true,
            components: {

                // Main components
                preview: true,
                opacity: true,
                hue: true,

                // Input / output Options
                interaction: {
                    input: true,
                    clear: true,
                    save: true
                }
            }
        });
        pickr.on('init', instance => {
            $(".pickr").css("height", "100%");
            $(".pickr").css("width", "25%");
            $(".pickr button").css("height", "100%");
            $(".pickr button").css("width", "100%");
            $(".pickr").addClass("shadow");

        })
        pickr.on('save', (color, instance) => {
            console.log('Event: "save"', color.toHEXA().toString());
            pickr.hide();
            $("#Valor").val(color.toHEXA().toString());
        })
        $("#btnEditar").on('click', function () {
            $("#bntsEditar").show();
            $("#bntsDetalle").hide();
            $("#btnVolver").prop('disabled', true);
            $("#btnEditar").prop('disabled', true);
            $("#btnCancelar").prop('disabled', false);
            $("#btnGuardar").prop('disabled', false);
            //Habilitar inputs
            pickr.enable();
            $("#Variable").prop('disabled', false);
            $("#Descripcion").prop('disabled', false);
            $("#Valor").prop('disabled', false);
        });

        $("#btnCancelar").on('click', function () {
            $("#bntsEditar").hide();
            $("#bntsDetalle").show();
            $("#btnVolver").prop('disabled', false);
            $("#btnEditar").prop('disabled', false);
            $("#btnCancelar").prop('disabled', true);
            $("#btnGuardar").prop('disabled', true);
            //Deshabilitar inputs
            pickr.disable();
            $("#Variable").prop('disabled', true);
            $("#Descripcion").prop('disabled', true);
            $("#Valor").prop('disabled', true);
        });
    </script>
}




