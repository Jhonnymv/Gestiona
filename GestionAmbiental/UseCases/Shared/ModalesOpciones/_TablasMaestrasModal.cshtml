                                </svg>
                            </i>
                            <span>Gestor de Tablas Maestras</span>
                        </h3>
                    </div>
                </div>
                <div class="menu-modal-separator"></div>
                <div class="modal-body">
                    <div class="modal-menu-options">
                        @if (ViewBag.Rol == "Admin")
                        {
                            <a class="modal-menu-option" asp-controller="GestorContenido" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Configuración Plataforma</span>
                                </div>
                            </a>

                            <a class="modal-menu-option" asp-controller="GestorUsuarios" asp-action="Usuarios">
