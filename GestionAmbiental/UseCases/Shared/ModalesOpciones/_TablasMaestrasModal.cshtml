                            <a class="modal-menu-option" asp-controller="GestorConsumoAgua" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Consumo de Agua</span>
                                </div>
                            </a>

                            <a class="modal-menu-option" asp-controller="GestorSGADocumentos" asp-action="Resumen">
