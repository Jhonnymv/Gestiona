<div class="modal" id="modal_opciones_incidentes" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_opciones_incidentes"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: var(--modal-content-color);">
            <div class="modal-incidentes-header-capa1">
                <div class="modal-incidentes-header-capa2">
                    <div class="modal-header modal-incidentes-header-capa3" style="background-color:transparent;">
                        <h5 class="modal-title" id="titulo_modal_opciones_avistamiento">
                            <img class="mr-2" src="/img/iconos nuevos gestiona/incidentes-blanco.png" style="height:2rem;"><b>INCIDENTES AMBIENTALES</b>
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                </div>
            </div>            
            <div class="modal-body">
                <hr />
                <div class="row mb-2" style="height:50px;">
                </div>
                @if (ViewBag.Rol == "Inspector" || ViewBag.Rol == "AsesorSSO")
                {
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportePreliminar" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#ff0000;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reporte Preliminar</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="InvestigacionFinal" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#00ff90;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Informe Investigación Final</div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                @if (ViewBag.Rol == "AsesorMAP")
                {
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportePreliminar" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#ff0000;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reporte Preliminar</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportePreliminarMA" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#00ff90;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reporte Preliminar MA</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="InvestigacionFinal" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#ffd800;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Informe Investigación Final</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportesIncidentesReportePreliminar" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#00ffff;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reportes Estadísticos (Reporte Preliminar)</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportesIncidentesInvestigacion" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#4800ff;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reportes Estadísticos (Informe Investigación Final)</div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                @if (ViewBag.Rol == "Admin")
                {
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="ReportePreliminarMA" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#ff0000;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Reporte Preliminar</div>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:25px;">
                    </div>
                    <div class="row mb-2 justify-content-center" style="height:50px;">
                        <div class="col-10 opcion-modal-menu">
                            <a asp-controller="InvestigacionFinal" asp-action="Resumen">
                                <div class="d-flex align-items-center" style="height:100%;">
                                    <div class="rounded mr-4" style="width:40px;height:40px;background-color:#00ff90;"></div>
                                    <div class="align-self-center opcion-modal-menu-texto">Informe Investigación Final</div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                <div class="row mb-2" style="height:50px;">
                </div>
            </div>
        </div>
    </div>
</div>