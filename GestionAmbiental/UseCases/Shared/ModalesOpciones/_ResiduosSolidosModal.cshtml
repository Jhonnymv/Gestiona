<div class="modal" id="modal_opciones_residuos_solidos" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_opciones_residuos_solidos"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: var(--modal-content-color);">
