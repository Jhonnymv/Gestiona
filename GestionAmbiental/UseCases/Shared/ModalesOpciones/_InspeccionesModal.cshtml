<div class="modal fade" id="inspectionMenuModal" tabindex="-1" aria-labelledby="inspectionMenuModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-menu modal-menu-inspection">
            <div class="modal-content">
                <div class="modal-image-header-container">
                    <div class="modal-header">
                        <h3>
                            <i class="">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M2.46154 4.8H4.92308V8.4H17.2308V4.8H19.6923V10.8H22.1538V4.8C22.1538 3.48 21.0462 2.4 19.6923 2.4H14.5477C14.0308 1.008 12.6769 0 11.0769 0C9.47692 0 8.12308 1.008 7.60615 2.4H2.46154C1.10769 2.4 0 3.48 0 4.8V21.6C0 22.92 1.10769 24 2.46154 24H9.84615V21.6H2.46154V4.8ZM11.0769 2.4C11.7538 2.4 12.3077 2.94 12.3077 3.6C12.3077 4.26 11.7538 4.8 11.0769 4.8C10.4 4.8 9.84615 4.26 9.84615 3.6C9.84615 2.94 10.4 2.4 11.0769 2.4Z"
                                          fill="#FFBE0B" />
                                    <path d="M22.1539 12.6L15.397 19.2L11.6923 15.6L9.84619 17.4L15.397 22.8L24 14.4L22.1539 12.6Z"
                                          fill="#FFBE0B" />
                                </svg>
                            </i>
                            <span>Inspecciones</span>
                        </h3>
                    </div>
                </div>
                <div class="menu-modal-separator"></div>
                <div class="modal-body">
                    <div class="modal-menu-options">
                        <a class="modal-menu-option" asp-controller="Inspecciones" asp-action="Resumen">
                            <div class="icon-modal-menu-red">

                            </div>
                            <div class="text-modal-menu-option">
                                <span>Resumen</span>
                            </div>
                        </a>
                        @if (ViewBag.Rol != "Admin")
                        {
                            <a class="modal-menu-option" asp-controller="InspeccionesImplementacion" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Obs. Pendientes de Implementación</span>
                                </div>
                            </a>
                            @if (ViewBag.Rol == "AsesorSSO" || ViewBag.Rol == "AsesorMAP")
                            {
                                <a class="modal-menu-option" asp-controller="InspeccionesVerificacionMA" asp-action="Resumen">
                                    <div class="icon-modal-menu-yellow">

                                    </div>
                                    <div class="text-modal-menu-option">
                                        <span>Obs. Pendientes de Verificación</span>
                                    </div>
                                </a>
                                <a class="modal-menu-option" asp-controller="ReportesInspecciones" asp-action="Resumen">
                                    <div class="icon-modal-menu-bluesky">

                                    </div>
                                    <div class="text-modal-menu-option">
                                        <span>Reportes Estadísticos</span>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>