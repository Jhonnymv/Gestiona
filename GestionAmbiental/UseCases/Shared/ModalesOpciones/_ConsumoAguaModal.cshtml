                <div class="menu-modal-separator"></div>
                <div class="modal-body">
                    <div class="modal-menu-options">
                        @if (ViewBag.Rol == "AsesorMAP" || ViewBag.Rol == "OperadorAgua" || ViewBag.Rol == "Admin")
                        {
                            <a class="modal-menu-option" asp-controller="ConsumoAguaMar" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Agua de Mar</span>
                                </div>
                            </a>

                            <a class="modal-menu-option" asp-controller="ReportesConsumoAguaMar" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Reportes Estadísticos Agua de Mar</span>
                                </div>
                            </a>

                            <a class="modal-menu-option" asp-controller="ConsumoAguaSubterranea" asp-action="Resumen">
                                <div class="icon-modal-menu-green">

                                </div>
                                <div class="text-modal-menu-option">
                                    <span>Agua Subterránea</span>
                                </div>
                            </a>

                            <a class="modal-menu-option" asp-controller="ReportesConsumoAguaSubterranea" asp-action="Resumen">
