@Html.Partial("_Login.cshtml", new GestionAmbiental.UseCases.Autenticacion.SigninModel())

@section Scripts{
    <script type="text/javascript">
        var count = 1;
        $("#btnIniciarSesion").click(function () {
            var user = $("#User").val();
            var password = $("#Password").val();
        $.ajax({
            type: "POST",
            url: "@Url.Action("IniciarSesion", "Autenticacion")",
            data: {
                User: user,
                Password:password
            },
            success: function (result) {
                if (result.success) {
                    //window.location.reload();
                    console.log('Hola Mundo');
                    window.location = '@Url.Action("Modulos", "Home")';
                } else {
                    $('#mensaje_row').show();
                    $('#mensaje_row .text-danger').text(result.mensaje);
                }
            }
        });
    });
    </script>
}