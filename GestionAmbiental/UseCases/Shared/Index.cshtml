@using GestionAmbiental.UseCases.Home;

@model GestionAmbiental.UseCases.Home.HomeModel
@{
    ViewData["Title"] = "Bienvenido";
}
<div class="container">
    <div class="row">
        <div class="col-12 justify-content-end align-items-center m-2">
            <div id="carouselIndicators" class="carousel slide" data-ride="carousel">
                <ol class="carousel-indicators">
                    <li data-target="#carouselIndicators" data-slide-to="0" class="active"></li>
                    <li data-target="#carouselIndicators" data-slide-to="1"></li>
                    <li data-target="#carouselIndicators" data-slide-to="2"></li>
                    <li data-target="#carouselIndicators" data-slide-to="3"></li>
                    <li data-target="#carouselIndicators" data-slide-to="4"></li>
                    <li data-target="#carouselIndicators" data-slide-to="5"></li>
                    <li data-target="#carouselIndicators" data-slide-to="6"></li>
                    <li data-target="#carouselIndicators" data-slide-to="7"></li>
                    <li data-target="#carouselIndicators" data-slide-to="8"></li>
                    <li data-target="#carouselIndicators" data-slide-to="9"></li>
                    <li data-target="#carouselIndicators" data-slide-to="10"></li>
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img class="d-block img-fluid" src="~/img/sliders/slide1.jpg" alt="First slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide2.jpg" alt="Second slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide3.jpg" alt="Third slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide4.jpg" alt="Fourth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide5.jpg" alt="Fifth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide6.jpg" alt="Sixth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide7.jpg" alt="Seventh slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide8.jpg" alt="Eighth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide9.jpg" alt="Ninth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide10.jpg" alt="Tenth slide">
                    </div>
                    <div class="carousel-item">
                        <img class="d-block img-fluid" src="~/img/sliders/slide11.jpg" alt="Eleventh slide">
                    </div>
                </div>
                <a class="carousel-control-prev" href="#carouselIndicators" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselIndicators" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    @foreach (var tarjeta in Model.Tarjetas)
    {
        TamanioColumna colTipe = Model.Configuraciones.TiposTarjeta.Find(x => x.Nombre.Equals(tarjeta.Tipo)).Caracteristicas;
        <div class="col-sm-@colTipe.SM col-md-@colTipe.MD col-lg-@colTipe.LG col-xl-@colTipe.XL justify-content-end align-items-center mb-4">
            <div class="card shadow" style="height: 100%;">
                @if (tarjeta.LugarImg.Equals("arriba"))
                {
                    <img class="card-img-top rounded" src="@tarjeta.Imagen" alt="@tarjeta.Titulo" style="height:100%;">
                    <div class="card-body">
                        <div class="d-flex align-items-start" style="height:10%;">
                            <div>
                                <h5 class="card-title">@tarjeta.Titulo</h5>
                            </div>
                        </div>
                        <div class="d-flex align-items-center" style="height:90%;text-align:justify;">
                            <div>
                                @Html.Raw(tarjeta.Descripcion)
                            </div>
                        </div>
                    </div>
                }
                else if (tarjeta.LugarImg.Equals("abajo"))
                {
                    <div class="card-body">
                        <div class="d-flex align-items-start" style="height:10%;">
                            <div>
                                <h5 class="card-title">@tarjeta.Titulo</h5>
                            </div>
                        </div>
                        <div class="d-flex align-items-center" style="height:90%;text-align:justify;">
                            <div>
                                @Html.Raw(tarjeta.Descripcion)
                            </div>
                        </div>
                    </div>
                    <img class="card-img-bottom rounded" src="@tarjeta.Imagen" alt="@tarjeta.Titulo" style="height:100%;">
                }
                else if (tarjeta.LugarImg.Equals("derecha"))
                {
                    <div class="row"  style="height:100%;">
                        <div class="col" style="height:100%;">
                            <div class="card-body" style="height:100%;">
                                <div class="d-flex align-items-start" style="height:10%;">
                                    <div>
                                        <h5 class="card-title">@tarjeta.Titulo</h5>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center" style="height:90%; text-align:justify;">
                                    <div>
                                        @Html.Raw(tarjeta.Descripcion)
                                    </div>
                                </div>
                            </div>
                        </div><div class="col-@tarjeta.AnchoImg" style="height:100%; padding-right:0px; padding-left: 0px;">
                            <img class="card-img-top rounded" src="@tarjeta.Imagen" alt="@tarjeta.Titulo" style="height:100%;">
                        </div>
                    </div>
                }
                else
                {
                    <div class="row"  style="height:100%;">
                        <div class="col-@tarjeta.AnchoImg" style="height:100%; padding-right:0px; padding-left: 0px;">
                            <img class="card-img-top rounded" src="@tarjeta.Imagen" alt="@tarjeta.Titulo" style="height:100%;">
                        </div>
                        <div class="col" style="height:100%;">
                            <div class="card-body" style="height:100%;">
                                <div class="d-flex align-items-start" style="height:10%;">
                                    <div>
                                        <h5 class="card-title">@tarjeta.Titulo</h5>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center" style="height:90%;text-align:justify;">
                                    <div>
                                        @Html.Raw(tarjeta.Descripcion)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
@section Scripts{
    <script type="text/javascript">

    </script>
}