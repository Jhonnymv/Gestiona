@using GestionAmbiental.UseCases.Home;

@model GestionAmbiental.UseCases.Home.HomeModel
@{
    ViewData["Title"] = "Bienvenido";
    Layout = "~/UseCases/Shared/_HomeLayout.cshtml";
}
<div class="articles">
    @foreach (var article in Model.Tarjetas)
    {
        <div class="@article.Tipo">
            <div class="article-content">
                <div class="article-title">
                    <h3>@article.Titulo</h3>
                    <span>Fecha: @article.Fecha</span>
                </div>
                <div class="article-body">
                    <p>
                        @Html.Raw(article.Contenido)
                    </p>
                </div>
                <div class="article-footer">
                    <span>Escrito por @article.Publicador</span>
                </div>
            </div>
            <div class="article-image">
                <img src="@article.Imagen" alt="">
            </div>
        </div>
    }
</div>

@{
    await Html.RenderPartialAsync("_Login", new GestionAmbiental.UseCases.Autenticacion.SigninModel());
}

@section Scripts {
    <script type="text/javascript">
        $("#btnIniciarSesion").click(function () {
            $("#error_message").css('display', 'none');
            $("#error_message").text("");
            var user = $("#User").val();
            var password = $("#Password").val();
            const reCaptchaResponse = grecaptcha.getResponse();
            if (user != "" && password != "" && reCaptchaResponse) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("IniciarSesion", "Autenticacion")",
                    data: {
                        User: user,
                        Password: password,
                        userResponse: reCaptchaResponse
                    },
                    success: function (result) {
                        // console.log(result);
                        if (result.success) {
                            if (result.returnUrl != null)
                                window.location = result.returnUrl;
                            else
                                window.location = '@Url.Action("Modulos", "Home")';
                        }
                        else {
                            $("#error_message").css('display', 'block');
                            $('#error_message').text(result.mensaje);

                            console.log("Error: ",result)
                        }
                    }
                });
            }
            else {
                if (user == "") {
                    $("#error_message").css('display', 'block');
                    $('#error_message').text("Debe ingresar su nombre de usuario");
                }
                if (password == "") {
                    $("#error_message").css('display', 'block');
                    $('#error_message').text("Debe ingresar su contraseña");
                }
                if (!reCaptchaResponse) {
                    $("#error_message").css('display', 'block');
                    $('#error_message').text("Debe completar el CAPTCHA antes de continuar.");
                    alert("Debe completar el CAPTCHA antes de continuar.");
                }
            }
        });
    </script>
    <script type="text/javascript" src="https://www.google.com/recaptcha/api.js"></script>
}