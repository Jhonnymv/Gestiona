@using GestionAmbiental.UseCases.Home;

@model GestionAmbiental.UseCases.Home.HomeModel
@{
    ViewData["Title"] = "Bienvenido";
    Layout = "~/UseCases/Shared/_HomeLayout.cshtml";
}
<div class="articles">
    @foreach (var article in Model.Tarjetas)
    {
        <div class="@article.Tipo">
            <div class="article-content">
                <div class="article-title">
                    <h3>@article.Titulo</h3>
                    <span>Fecha: @article.Fecha</span>
                </div>
                <div class="article-body">
                    <p>
                        @Html.Raw(article.Contenido)
                    </p>
                </div>
                <div class="article-footer">
                    <span>Escrito por @article.Publicador</span>
                </div>
            </div>
            <div class="article-image">
                <img src="@article.Imagen" alt="">
            </div>
        </div>
    }
</div>

@Html.Partial("_Login.cshtml", new GestionAmbiental.UseCases.Autenticacion.SigninModel())

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            filtrar(1);
        });
        function dataModulo() {
            $.ajax({
                type: "POST",
                url: "/RegistroRAC/PropiedadesModulo",
                traditional: true,
                success: (response) => {
                    if (response.success) {
                        let data = JSON.parse(response.data);
                        let r = data.r;
                        let g = data.g;
                        let b = data.b;
                        let img_url = data.img_url;
                        racStyle(r, g, b);
                    } else {
                        console.log("Ocurrió un problema: " + response.msg);
                    }
                }
            });
        }
        $("#btnIniciarSesion").click(function () {
            $('#error_message').text("");
            var user = $("#User").val();
            var password = $("#Password").val();
            if (user != "" && password != "") {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("IniciarSesion", "Autenticacion")",
                    data: {
                        User: user,
                        Password: password
                    },
                    success: function (result) {
                        if (result.success) {
                            window.location = '@Url.Action("Modulos", "Home")';
                        } else {
                            $('#error_message').text(result.mensaje);
                        }
                    }
                });
            } else {
                if (user == "") {
                    $('#error_message').text("Debe ingresar su nombre de usuario");
                }
                if (password == "") {
                    $('#error_message').text("Debe ingresar su contraseña");
                }
            }
    });
    </script>
}