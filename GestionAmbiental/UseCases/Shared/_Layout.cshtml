<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - PLATAFORMA GESTIONA</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/bootstrap/css/bootstrap.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/sidebar_styles.css">
    <link rel="stylesheet" href="~/css/styles.css">
    <style id="antiClickjack">
        body {
            display: none !important;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- LEFT SIDEBAR -->
        <partial name="_SideBar" />
        <!-- END LEFT SIDEBAR -->
        <!-- MAIN CONTENT -->
        <div id="content">
            <!-- NAVBAR -->
            <partial name="_NavBar" />
            <!-- END NAVBAR -->
            @RenderBody()
        </div>
    </div>
    <!-- jQuery -->
    <script src="~/js/jquery-3.6.0.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/bootstrap/js/bootstrap.bundle.js"></script>
    <!-- Popper.JS -->
    <script type="text/javascript" src="~/js/popper.min.js"></script>
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js" integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ" crossorigin="anonymous"></script> *@
    <!-- Charts -->
    <script src="~/lib/charts/Chart.bundle.js"></script>
    <script src="~/lib/charts/Chart.bundle.min.js"></script>
    <script src="~/lib/charts/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/lib/charts/chartjs-plugin-annotation.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/sidebar_script.js"></script>
    <script src="~/js/template_script.js"></script>
    <script type="text/javascript">
        if (self === top) {
            var antiClickjack = document.getElementById("antiClickjack");
            antiClickjack.parentNode.removeChild(antiClickjack);
        } else {
            top.location = self.location;
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
