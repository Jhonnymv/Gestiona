@using GestionAmbiental.UseCases.Autenticacion
@model SigninModel

<div class="modal" id="modal_login" tabindex="-1" role="dialog" aria-labelledby="titulo_modal_login"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="background-color: rgba(43,103,147,0.9);">
            <div class="modal-header" style="border-bottom: 0px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form class="form-group" id="form_login" asp-controller="Autenticacion" asp-action="IniciarSesion" enctype="multipart/form-data" autocomplete="off">
                <div class="modal-body">
                    <div class="row mb-2" style="height:75px;">
                    </div>
                    <div class="row mb-2 justify-content-center">
                        <img src="~/img/logo-marcobre-blanco-blanco.png" style="width:70%" />
                    </div>
                    <div class="row mb-2" style="height:75px;">
                    </div>
                    <div class="row mb-2 align-items-center text-right">
                        <div class="col-sm-4 col-md-5 col-lg-4 m-2">
                            <label asp-for="User" class="text-white"></label>
                        </div>
                        <div class="col-sm-6 col-md-5 col-lg-6 m-2">
                            <input asp-for="User" type="text" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-2" style="height:50px;">
                    </div>
                    <div class="row mb-2 align-items-center text-right">
                        <div class="col-sm-4 col-md-5 col-lg-4 m-2">
                            <label asp-for="Password" class="text-white"></label>
                        </div>
                        <div class="col-sm-6 col-md-5 col-lg-6 m-2">
                            <input asp-for="Password" type="password" class="form-control" />
                        </div>
                    </div>
                    <div class="row mb-2 justify-content-center" id="mensaje_row" style="display:none;">
                        <span class="text-danger"></span>
                    </div>
                    <div class="row mb-2" style="height:50px;">
                    </div>
                    <div class="row mb-2 justify-content-center text-center">
                        <div class="col-sm-6 col-md-8 col-lg-10 m-2">
                            <button id="btnIniciarSesion" type="button" class="btn btn-primary border-white">Iniciar Sesión</button>
                        </div>
                    </div>
                    <div class="row mb-2 justify-content-center text-center">
                        <div class="col-sm-6 col-md-8 col-lg-10 m-2">
                            <a class="text-white" href="#">¿Olvidaste tu Contraseña?</a>
                        </div>
                    </div>
                    <div class="row mb-2" style="height:75px;">
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>