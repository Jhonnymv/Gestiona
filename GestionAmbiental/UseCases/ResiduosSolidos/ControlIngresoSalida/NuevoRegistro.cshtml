@section Scripts{
    <script src="~/js/stepper.js"></script>
    <script type="text/javascript">
        $("#Tipo_Residuo").on('change', function () {
            var selectedValue = $("#Tipo_Residuo").val();
            $(".Vacio").hide();
            $(".Vacio").prop('disabled', true);
            $(".Peligroso").hide();
            $(".Peligroso").prop('disabled', true);
            $(".No-Peligroso").hide();
            $(".No-Peligroso").prop('disabled', true);
            switch (selectedValue) {
                case "1":
                    $(".Peligroso").show();
                    $(".Peligroso").prop('disabled', false);
                    break;
                case "2":
                    $(".No-Peligroso").show();
                    $(".No-Peligroso").prop('disabled', false);
                    break;
                default:
                    $(".Peligroso").hide();
                    $(".Peligroso").prop('disabled', true);
                    $(".No-Peligroso").hide();
                    $(".No-Peligroso").prop('disabled', true);
                    $(".Vacio").show();
                    $(".Vacio").prop('disabled', false);
                    break;
            }
        });
        
        $("#btnGuardarEstado").on('click', function () {
            $("#opcion").val("GuardarEstado");
            $("#formIngresoSalida").submit();
        });
        
        $("#btnRegistrar").on('click', function () {
            $("#opcion").val("Registrar");
            $("#formIngresoSalida").submit();
        });
    </script>
}