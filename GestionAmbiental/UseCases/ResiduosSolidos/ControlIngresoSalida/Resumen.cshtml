
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Control de Ingreso y Salida de Residuos Sólidos del ACR o CMRS</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>ACR/CMRS:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_acr_cmrs" asp-items="ViewBag.ACR_CMRS"></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Ingreso o Salida:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_ing_sal" asp-items="ViewBag.IngresoSalida"></select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Tipo de Residuo:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_tipoResiduo" asp-items="ViewBag.TipoResiduo"></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Fecha de Ingreso o Salida:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <input type="date" class="form-control" id="filtro_fecha">
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-2 mt-1">
            <label>Empresa Genera o Retira el Residuo:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_empresa" asp-items="ViewBag.Empresa"></select>
        </div>
        <div class="col-lg-2 mt-1">
            <label>Gerencia de Marcobre que entrega o retira residuo:</label>
        </div>
        <div class="col-lg-3 mt-1">
            <select class="form-control" id="filtro_gerencia" asp-items="ViewBag.Gerencias"></select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-lg-1 mt-1">
            <button type="button" class="btn btn-primary" onclick="filtrar(1)">Filtrar</button>
        </div>
    </div>
</form>
<div class="row mb-2 justify-content-start">
    <div class="col-md mt-1">
        <a class="btn btn-danger float-left" asp-action="NuevoRegistro" asp-controller="IngresoSalidaRS"><img src="~/img/icons/edit-icon.png" style="vertical-align:sub"> Nuevo Registro</a>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <div class="col-md">
        <table class="table" id="tabla_resumen_inspecciones">
            <thead class="thead-mcolor">
                <tr>
                    <th>Item</th>
                    <th>ACR/CMRS</th>
                    <th>Responsable del ACR/CMRS que Recibe/Entrega el Residuo</th>
                    <th>Ingreso o Salida de Residuos</th>
                    <th>Motivo de Ingreso o Salida de Residuo</th>
                    <th>Fecha de Ingreso o Salida</th>
                    <th>Tipo de Residuo</th>
                    <th>Nombre del Residuo</th>
                    <th>Cantidad Ingresada o Retirada (kg)</th>
                    <th>Empresa que Generó/Retiró el Residuo</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
<div class="row mb-2 justify-content-center">
    <nav id="paginado" aria-label="pagination">
    </nav>
</div>
@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            filtrar(1);
        });
        function filtrar(pag) {
            $.ajax({
                type: "POST",
                url: "/IngresoSalidaRS/GetTablaResumenFiltrada",
                data: {
                    "pagina": pag,
                    "rpp": 10,
                    "acr_cmrs": $('#filtro_acr_cmrs').val(),
                    "ingreso_salida": $('#filtro_ing_sal').val(),
                    "tipo": $('#filtro_tipoResiduo').val(),
                    "fecha": $("#filtro_fecha").val(),
                    "empresa": $("#filtro_empresa").val(),
                    "gerencia":$("#filtro_gerencia").val()
                },
                traditional: true,
                success: (response) => {
                    $('#tabla_resumen_inspecciones tbody').empty()
                    $('#tabla_resumen_inspecciones tbody').html(response.data)
                    $('#paginado').html(response.paginador)
                    /*$('#nRegistros').html(response.nRegistros)*/
                }
            });
        }
    </script>
}