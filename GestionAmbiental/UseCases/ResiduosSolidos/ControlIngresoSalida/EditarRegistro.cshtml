@model GestionAmbiental.UseCases.ResiduosSolidos.ControlIngresoSalida.IngresoSalidaRSModel
@{
    ViewData["Title"] = "Editar Registro";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="residuos">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Editar Control de Ingreso o Salida de Residuos Sólidos del ACR o CMRS</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form class="custom-form w-100" id="formIngresoSalida" asp-action="EditarRegistro" asp-controller="IngresoSalidaRS" method="post" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" asp-for="Id_Ingreso_Salida_RS" />
                <input type="hidden" asp-for="opcion" />
                <div class="col-12 col-xl-8">
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="ACR_CMRS"></label>
                            <span class="text-danger" asp-validation-for="ACR_CMRS"></span>
                            <select class="form-control" asp-items="@ViewBag.ACR_CMRS" asp-for="ACR_CMRS" disabled></select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Ingreso_Salida"></label>
                            <span class="text-danger" asp-validation-for="Ingreso_Salida"></span>
                            <select class="form-control" asp-items="@ViewBag.IngresoSalida" asp-for="Ingreso_Salida" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Fecha"></label>
                            <span class="text-danger" asp-validation-for="Fecha"></span>
                            <input type="date" class="form-control" asp-for="Fecha" disabled>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Motivo"></label>
                            <span class="text-danger" asp-validation-for="Motivo"></span>
                            <select class="form-control" asp-items="@ViewBag.Motivo" asp-for="Motivo" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Tipo_Residuo"></label>
                            <span class="text-danger" asp-validation-for="Tipo_Residuo"></span>
                            <select class="form-control" asp-items="@ViewBag.TiposResiduo" asp-for="Tipo_Residuo" disabled></select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Residuo_Solido"></label>
                            <span class="text-danger" asp-validation-for="Residuo_Solido"></span>
                            <input type="hidden" asp-for="Residuo_Solido" />
                            <select class="form-control Vacio">
                                <option class="Vacio" value="">--SELECCIONE--</option>
                            </select>
                            <select class="form-control Peligroso" asp-items="@ViewBag.ResiduosSolidosPelig" style="display:none" disabled></select>
                            <select class="form-control No-Peligroso" asp-items="@ViewBag.ResiduosSolidosNoPelig" style="display:none" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Cantidad"></label>
                            <span class="text-danger" asp-validation-for="Cantidad"></span>
                            <input type="number" class="form-control" asp-for="Cantidad" min="0" max="999999" disabled />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Empresa"></label>
                            <span class="text-danger" asp-validation-for="Empresa"></span>
                            <select class="form-control" asp-items="@ViewBag.Empresa" asp-for="Empresa" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Gerencia"></label>
                            <span class="text-danger" asp-validation-for="Gerencia"></span>
                            <select class="form-control" asp-items="@ViewBag.Gerencias" asp-for="Gerencia" disabled></select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <label asp-for="Responsable_ACR_CMRS"></label>
                            <span class="text-danger" asp-validation-for="Responsable_ACR_CMRS"></span>
                            <select class="form-control" asp-items="@ViewBag.ResponsablesARC_CMRS" asp-for="Responsable_ACR_CMRS" disabled></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-sm-12 col-lg-12">
                            <label asp-for="Comentario"></label>
                            <span class="text-danger" asp-validation-for="Comentario"></span>
                            <textarea class="form-control" asp-for="Comentario" rows="3" disabled></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="button-container">
                            <div>

                            </div>
                            <div>
                                @if (Model.Estado.Equals("Pendiente") && Model.Permiso)
                                {
                                    <a class="btn btn-mc-outline-danger" asp-controller="IngresoSalidaRS" asp-action="Resumen">Cancelar</a>
                                    <button id="btnEliminar" type="button" class="btn btn-mc-danger">Eliminar</button>
                                    <button id="btnGuardarEstado" type="button" class="btn btn-mc-outline-success">Guardar Estado</button>
                                    <button id="btnRegistrar" type="button" class="btn btn-mc-success">Registrar</button>
                                }
                                else if (Model.Estado.Equals("Registrado") && (Model.PermisoAdmin || Model.PermisoMA))
                                {
                                    <a class="btn btn-mc-outline-danger" asp-controller="IngresoSalidaRS" asp-action="Resumen">Volver</a>
                                    <button id="btnEliminar" type="button" class="btn btn-mc-danger">Eliminar</button>
                                    <button id="btnGuardar" type="button" class="btn btn-mc-success">Guardar</button>
                                }
                                else
                                {
                                    <a class="btn btn-mc-outline-danger" asp-controller="IngresoSalidaRS" asp-action="Resumen">Volver</a>
                                }                                
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            CargarValorResiduoSolido();
            HabilitarInputs(@Model.Permiso.ToString().ToLower(),@Model.PermisoMA.ToString().ToLower(),@Model.PermisoAdmin.ToString().ToLower(), '@Model.Estado')
        });
        $("#Tipo_Residuo").on('change', function () {
            var selectedValue = $("#Tipo_Residuo").val();
            $(".Vacio").hide();
            $(".Vacio").prop('disabled', true);
            $(".Peligroso").hide();
            $(".Peligroso").prop('disabled', true);
            $(".No-Peligroso").hide();
            $(".No-Peligroso").prop('disabled', true);
            switch (selectedValue) {
                case "1":
                    $(".Peligroso").show();
                    $(".Peligroso").prop('disabled', false);
                    break;
                case "2":
                    $(".No-Peligroso").show();
                    $(".No-Peligroso").prop('disabled', false);
                    break;
                default:
                    $(".Peligroso").hide();
                    $(".Peligroso").prop('disabled', true);
                    $(".No-Peligroso").hide();
                    $(".No-Peligroso").prop('disabled', true);
                    $("#Residuo_Solido").val(0);
                    $(".Vacio").show();
                    $(".Vacio").prop('disabled', false);
                    break;
            }
        });
        $(".No-Peligroso").on('change', function () {
            $("#Residuo_Solido").val($(".No-Peligroso").val())
        });
        $(".Peligroso").on('change', function () {
            $("#Residuo_Solido").val($(".Peligroso").val())
        });
        $("#btnGuardarEstado").on('click', function () {
            $("#opcion").val("GuardarEstado");
            $("#formIngresoSalida").submit();
        });
        $("#btnRegistrar").on('click', function () {
            $("#opcion").val("Registrar");
            $("#formIngresoSalida").submit();
        });
        $("#btnGuardar").on('click', function () {
            $("#opcion").val("Guardar");
            $("#formIngresoSalida").submit();
        });
        $("#btnEliminar").on('click', function () {
            $("#opcion").val("Eliminar");
            HabilitarInputs(@Model.Permiso.ToString().ToLower())
            $("#formIngresoSalida").submit();
        });
        function CargarValorResiduoSolido() {
            var selectedValue = $("#Tipo_Residuo").val();

            $(".Vacio").hide();
            $(".Vacio").prop('disabled', true);
            $(".Peligroso").hide();
            $(".Peligroso").prop('disabled', true);
            $(".No-Peligroso").hide();
            $(".No-Peligroso").prop('disabled', true);
            switch (selectedValue) {
                case "1":
                    $(".Peligroso").show();
                    $('.Peligroso option').filter(function () {
                        return ($(this).val() == "@Model.Residuo_Solido"); //To select Blue
                    }).prop('selected', true);

                    $(".Peligroso").val("@Model.Residuo_Solido".toString());

                    $("#Residuo_Solido").val("@Model.Residuo_Solido".toString())
                    break;
                case "2":
                    $(".No-Peligroso").show();
                    $('.No-Peligroso option').filter(function () {
                        return ($(this).val() == "@Model.Residuo_Solido".toString()); //To select Blue
                    }).prop('selected', true)
                    $("#Residuo_Solido").val("@Model.Residuo_Solido".toString())
                    break;
                default:
                    $(".Peligroso").hide();
                    $(".Peligroso").prop('disabled', true);
                    $(".No-Peligroso").hide();
                    $(".No-Peligroso").prop('disabled', true);
                    $(".Vacio").show();
                    $(".Vacio").prop('disabled', false);
                    $("#Residuo_Solido").val("0")
                    break;
            }
        }
        function HabilitarInputs(permiso, permisoMA, permisoAdmin,estado) {

            if ((permiso && estado == "Pendiente") || permisoMA || permisoAdmin) {
                $("#ACR_CMRS").prop('disabled', false);
                $("#Responsable_ACR_CMRS").prop('disabled', false);
                $("#Ingreso_Salida").prop('disabled', false);
                $("#Motivo").prop('disabled', false);
                $("#Fecha").prop('disabled', false);
                $("#Tipo_Residuo").prop('disabled', false);
                $("#Residuo_Solido").prop('disabled', false);
                $("#Cantidad").prop('disabled', false);
                $("#Empresa").prop('disabled', false);
                $("#Gerencia").prop('disabled', false);
                $("#Comentario").prop('disabled', false);

                if ($(".Peligroso").val() != "0")
                    $(".Peligroso").prop('disabled', false);
                else if($(".No-Peligroso").val() != "0")
                    $(".No-Peligroso").prop('disabled', false);
            }
        }
    </script>
}