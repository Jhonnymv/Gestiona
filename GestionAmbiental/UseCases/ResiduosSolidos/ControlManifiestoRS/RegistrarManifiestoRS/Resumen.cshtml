    @section scripts{
        <script type="text/javascript">
            $(document).ready(function () {
                filtrar(1);
            });
            function dataModulo() {
                $.ajax({
                    type: "POST",
                    url: "/IngresoSalidaRS/PropiedadesModulo",
                    traditional: true,
                    success: (response) => {
                        if (response.success) {
                            let data = JSON.parse(response.data);
                            let r = data.r;
                            let g = data.g;
                            let b = data.b;
                            let img_url = data.img_url;
                            residuosStyle(r, g, b);
                        } else {
                            console.log("Ocurrió un problema: " + response.msg);
                        }
                    }
                });
            }
            function filtrar(pag) {
                $.ajax({
                    type: "POST",
                    url: "/ManifiestoRS/GetTablaResumenFiltrada",
                    data: {
                        "pagina": pag,
                        "rpp": 10,
                        "nManifiesto": $('#filtro_num_manifiesto').val(),
                        "fechaEmision": $('#filtro_fecha_emision').val(),
                        "observacion": $('#filtro_observacion').val(),
                        "residuoSolido": $("#filtro_residuos_solidos").val(),
                        "eors_salida": $("#filtro_eors_salida").val(),
                        "eors_llegada": $("#filtro_eors_llegada").val(),
                        //"asesorMAP": $("#filtro_asesores_ma").val()
                    },
                    traditional: true,
                    success: (response) => {
                        $('#tabla_resumen_manifiestos tbody').empty();
                        $('#tabla_resumen_manifiestos tbody').html(response.data);
                        $('#paginado').html(response.paginador);
                        dataModulo();
                    }
                });
            }
        </script>
    }
