
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="residuos">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Control de Manifiestos de Residuos Peligrosos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <div class="action-container residuos-color">
                <div class="w-100 row-center-center">
                    <a class="btn btn-special-action-outline residuos-color" asp-action="NuevoManifiesto" asp-controller="ManifiestoRS">NUEVO REGISTRO</a>
                </div>
            </div>
            <form autocomplete="off" class="custom-form">
                <div class="col-12 col-lg-9">
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label for="">N° Manifiesto</label>
                            <input type="text" class="form-control" id="filtro_num_manifiesto" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Fecha de Emisión</label>
                            <input type="date" class="form-control" id="filtro_fecha_emision" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label for="">Observación</label>
                            <select class="form-control" id="filtro_observacion">
                                <option value="">--SELECCIONE--</option>
                                <option value="Conforme">Conforme</option>
                                <option value="Anulado">Anulado</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Nombre de Residuo Sólido</label>
                            <select id="filtro_residuos_solidos" asp-items="ViewBag.ResiduosSolidos" class="form-control">
                            </select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label for="">Nombre de EO-RS (Recolección y Transporte)</label>
                            <select id="filtro_eors_salida" asp-items="ViewBag.EO_RS" class="form-control">
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="">Nombre de EO-RS (Destino Final y/o Comercialización)</label>
                            <select id="id="filtro_eors_llegada" asp-items="ViewBag.EO_RS" class="form-control">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-3 row-center-center">
                    <button type="button" class="btn btn-mc" onclick="filtrar(1)">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="secondary-content col-12">
        <div class="table-responsive residuos-color">
            <table class="table" id="tabla_resumen_manifiestos">
                <thead class="">
                    <tr>
                        <th>Item</th>
                        <th>Serie Manifiesto</th>
                        <th>Num Manifiesto</th>
                        <th>Fecha Emision_Manifiesto</th>
                        <th>Observacion Manifiesto</th>
                        <th>Residuo Solido</th>
                        <th>Cantidad de Residuos Sólidos Evacuado (t)</th>
                        <th>EO-RS Salida</th>
                        <th>EO-RS Llegada</th>
                    </tr>
                </thead>

                <tbody>
                </tbody>
            </table>

        </div>
        <div class="pagination-container residuos-color" id="paginado" aria-label="pagination">
        </div>
    </div>
</div>
