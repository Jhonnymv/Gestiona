                                    <span class="text-danger" asp-validation-for="Id_Vehiculo"></span>
                                    <select class="form-control" asp-items="ViewBag.Vehiculos" asp-for="Id_Vehiculo"></select>
                                </div>
                                <div class="col-12 col-sm-4 col-lg-4">
                                    <label asp-for="Capacidad_Vehiculo">Capacidad de Vehículo (t)</label>
                                    <span class="text-danger" asp-validation-for="Capacidad_Vehiculo"></span>
                                    <input class="form-control" type="number" asp-for="Capacidad_Vehiculo" min="0" max="999999" value="0" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="d-flex justify-content-between">
                                    <button type="button" class="btn btn-mc-outline back-btn">Atrás</button>
                                    <button type="button" class="btn btn-mc next-btn">Siguiente</button>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="pills-step4" role="tabpanel" aria-labelledby="pills-step4-tab">
                            <div class="d-flex justify-content-center mt-4 mb-5">
                                <span class="text-mc bold text-center">DATOS DE LA EO-RS: DESTINO FINAL Y/O COMERCIALIZACIÓN</span>
                            </div>
                            <div class="message"></div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Id_EO_RS_Llegada">Nombre de la EO-RS</label>
                                    <span class="text-danger" asp-validation-for="Id_EO_RS_Llegada"></span>
                                    <select class="form-control" asp-items="ViewBag.EO_RS" asp-for="Id_EO_RS_Llegada">
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Registro_EO_RS_Llegada">Registro de la EO-RS</label>
                                    <span class="text-danger" asp-validation-for="Registro_EO_RS_Llegada"></span>
                                    <input class="form-control" type="text" asp-for="Registro_EO_RS_Llegada" maxlength="25" />
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Fecha_Vencimiento_Registro_Llegada">Fecha de Vencimiento Registro EO-RS</label>
                                    <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro_Llegada"></span>
                                    <input class="form-control" type="date" asp-for="Fecha_Vencimiento_Registro_Llegada" maxlength="25" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Num_Autorizacion_Sanitaria_Llegada">N° Autorización Sanitaria</label>
                                    <span class="text-danger" asp-validation-for="Num_Autorizacion_Sanitaria_Llegada"></span>
                                    <input class="form-control" type="text" asp-for="Num_Autorizacion_Sanitaria_Llegada" maxlength="25" />
                                </div>
                            </div>
                            <div class="row input_container">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Num_Autorizacion_Municipal_Llegada">N° Autorización Municipal</label>
                                    <span class="text-danger" asp-validation-for="Num_Autorizacion_Municipal_Llegada"></span>
                                    <input class="form-control" type="text" asp-for="Num_Autorizacion_Municipal_Llegada" maxlength="25" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="button-container">
                                    <div>
                                        <button type="button" class="btn btn-mc-outline back-btn">Atrás</button>
                                    </div>
                                    <div>
                                        @*<a type="button" class="btn btn-mc-outline-danger" asp-controller="ManifiestoRS" asp-action="Resumen">Cancelar</a>*@
                                        <button class="btn btn-mc-outline-success" id="btnGuardarEstado" type="button">Guardar Estado</button>
                                        <button class="btn btn-mc-success" id="btnRegistrar" type="button">Registrar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            <div class="d-flex justify-content-end button-container pd-t-b-12-37 m-0">
                <a type="button" class="btn btn-mc-outline-danger" asp-controller="ManifiestoRS" asp-action="Resumen">Cancelar</a>
            </div>
        </div>
    </div>
</div>

