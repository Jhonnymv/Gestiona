@model GestionAmbiental.UseCases.ResiduosSolidos.ControlManifiestoRS.RegistrarManifiestoRS.ManifiestoRSModel
@{
    ViewData["Title"] = "NuevoManifiesto";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Nuevo Manifiesto de Residuos Sólidos Peligrosos</h2>
    </div>
</div>
<form id="formManifiestoRS" class="form-group" asp-action="EditarManifiesto" asp-controller="ManifiestoRS" method="post" enctype="multipart/form-data" autocomplete="off">
    <input type="hidden" asp-for="Id_Manifiesto_RS"/>
    <input type="hidden" asp-for="opcion" />
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">DATOS DEL MANIFIESTO</h5>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Serie_Manifiesto"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Serie_Manifiesto"></span>
            <input class="form-control" type="number" asp-for="Serie_Manifiesto" min="1" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Manifiesto"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Num_Manifiesto"></span>
            <input class="form-control" type="text" asp-for="Num_Manifiesto" maxlength="10" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Fecha_Emision_Manifiesto"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Fecha_Emision_Manifiesto"></span>
            <input class="form-control" type="date" asp-for="Fecha_Emision_Manifiesto" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Observacion_Manifiesto"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Observacion_Manifiesto"></span>
            <select class="form-control" asp-for="Observacion_Manifiesto" disabled>
                <option value="">--SELECCIONE--</option>
                <option value="Conforme">Conforme</option>
                <option value="Anulado">Anulado</option>
            </select>
        </div>
    </div>
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">DATOS DEL RESIDUO PELIGROSO</h5>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Id_Residuo_Solido"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Id_Residuo_Solido"></span>
            <select class="form-control" asp-items="ViewBag.ResiduosSolidos" asp-for="Id_Residuo_Solido" disabled>
            </select>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Cantidad_RS_Evacuado"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Cantidad_RS_Evacuado"></span>
            <input class="form-control" type="number" asp-for="Cantidad_RS_Evacuado" min="0" max="999999" disabled/>
        </div>
    </div>
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">DATOS DE LA EO-RS: RECOLECCIÓN Y TRANSPORTE</h5>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Id_EO_RS_Salida"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Id_EO_RS_Salida"></span>
            <select class="form-control" asp-items="ViewBag.EO_RS" asp-for="Id_EO_RS_Salida" disabled>
            </select>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Registro_EO_RS_Salida"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Registro_EO_RS_Salida"></span>
            <input class="form-control" type="text" asp-for="Registro_EO_RS_Salida" maxlength="25" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Fecha_Vencimiento_Registro_Salida"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro_Salida"></span>
            <input class="form-control" type="date" asp-for="Fecha_Vencimiento_Registro_Salida" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Autorizacion_Municipal_Salida"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Num_Autorizacion_Municipal_Salida"></span>
            <input class="form-control" type="text" asp-for="Num_Autorizacion_Municipal_Salida" maxlength="25" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Autorizacion_Hoja_Ruta"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Num_Autorizacion_Hoja_Ruta"></span>
            <input class="form-control" type="text" asp-for="Num_Autorizacion_Hoja_Ruta" maxlength="25" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Id_Conductor"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Id_Conductor"></span>
            <select class="form-control" asp-items="ViewBag.Conductores" asp-for="Id_Conductor" disabled>
            </select>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Licencia_Condutor"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-2">
            <span class="text-danger" asp-validation-for="Num_Licencia_Condutor"></span>
            <input class="form-control" type="text" asp-for="Num_Licencia_Condutor" maxlength="10" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Id_Vehiculo"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-2">
            <span class="text-danger" asp-validation-for="Id_Vehiculo"></span>
            <select class="form-control" asp-items="ViewBag.Vehiculos" asp-for="Id_Vehiculo" disabled>
            </select>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Capacidad_Vehiculo"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-2">
            <span class="text-danger" asp-validation-for="Capacidad_Vehiculo"></span>
            <input class="form-control" type="number" asp-for="Capacidad_Vehiculo" min="0" max="999999" disabled/>
        </div>
    </div>
    <div class="row mb-2" style="background-color:#2e6793">
        <div class="col-12" style="text-align:center">
            <h5 style="color:white;margin:4px;">DATOS DE LA EO-RS: DESTINO FINAL Y/O COMERCIALIZACIÓN</h5>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Id_EO_RS_Llegada"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Id_EO_RS_Llegada"></span>
            <select class="form-control" asp-items="ViewBag.EO_RS" asp-for="Id_EO_RS_Llegada" disabled>
            </select>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Registro_EO_RS_Llegada"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Registro_EO_RS_Llegada"></span>
            <input class="form-control" type="text" asp-for="Registro_EO_RS_Llegada" maxlength="25" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-center">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Fecha_Vencimiento_Registro_Llegada"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro_Llegada"></span>
            <input class="form-control" type="date" asp-for="Fecha_Vencimiento_Registro_Llegada" disabled/>
        </div>
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Autorizacion_Sanitaria_Llegada"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Num_Autorizacion_Sanitaria_Llegada"></span>
            <input class="form-control" type="text" asp-for="Num_Autorizacion_Sanitaria_Llegada" maxlength="25" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-start">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Num_Autorizacion_Municipal_Llegada"></label>
        </div>
        <div class="col-sm-12 col-md-4 col-lg-4">
            <span class="text-danger" asp-validation-for="Num_Autorizacion_Municipal_Llegada"></span>
            <input class="form-control" type="text" asp-for="Num_Autorizacion_Municipal_Llegada" maxlength="25" disabled/>
        </div>
    </div>
    <div class="row mb-2 justify-content-end">
        <div class="col-12">
            <div class="modal-footer">
                <a class="btn btn-secondary" style="color:white" asp-controller="ManifiestoRS" asp-action="Resumen">Cancelar</a>
                @if (Model.Estado.Equals("Pendiente") && Model.Permiso)
                {
                    <button id="btnGuardarEstado" type="button" class="btn btn-primary">Guardar Estado</button>
                    <button id="btnRegistrar" type="button" class="btn btn-primary">Registrar</button>
                    <button id="btnEliminar" type="button" class="btn btn-danger">Eliminar</button>
                }else if(Model.Permiso )
                {
                    <button id="btnEliminar" type="button" class="btn btn-danger">Eliminar</button>
                }
            </div>
        </div>
    </div>
</form>
@section Scripts{ 
<script type="text/javascript">
    $(document).ready(function () {
        var estado = @Model.Estado.Equals("Pendiente").ToString().ToLower();
        var permiso = @Model.Permiso.ToString().ToLower();
        if (estado && permiso) {
            $("#Serie_Manifiesto").prop('disabled', false);
            $("#Num_Manifiesto").prop('disabled', false);
            $("#Fecha_Emision_Manifiesto").prop('disabled', false);
            $("#Observacion_Manifiesto").prop('disabled', false);
            if ($("#Observacion_Manifiesto").val() == "Anulado") {
                $("#Id_Residuo_Solido").prop('disabled', true);
                $("#Cantidad_RS_Evacuado").prop('disabled', true);
                $("#Id_EO_RS_Salida").prop('disabled', true);
                $("#Registro_EO_RS_Salida").prop('disabled', true);
                $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', true);
                $("#Num_Autorizacion_Municipal_Salida").prop('disabled', true);
                $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', true);
                $("#Id_Conductor").prop('disabled', true);
                $("#Num_Licencia_Condutor").prop('disabled', true);
                $("#Id_Vehiculo").prop('disabled', true);
                $("#Capacidad_Vehiculo").prop('disabled', true);
                $("#Id_EO_RS_Llegada").prop('disabled', true);
                $("#Registro_EO_RS_Llegada").prop('disabled', true);
                $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', true);
                $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', true);
                $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', true);
            }
            else {            
                $("#Id_Residuo_Solido").prop('disabled', false);
                $("#Cantidad_RS_Evacuado").prop('disabled', false);
                $("#Id_EO_RS_Salida").prop('disabled', false);
                $("#Registro_EO_RS_Salida").prop('disabled', false);
                $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', false);
                $("#Num_Autorizacion_Municipal_Salida").prop('disabled', false);
                $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', false);
                $("#Id_Conductor").prop('disabled', false);
                $("#Num_Licencia_Condutor").prop('disabled', false);
                $("#Id_Vehiculo").prop('disabled', false);
                $("#Capacidad_Vehiculo").prop('disabled', false);
                $("#Id_EO_RS_Llegada").prop('disabled', false);
                $("#Registro_EO_RS_Llegada").prop('disabled', false);
                $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', false);
                $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', false);
                $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', false);
            }
        }
    });
    $("#Observacion_Manifiesto").on('change', function () {
        if ($("#Observacion_Manifiesto").val() == "Anulado") {
            $("#Id_Residuo_Solido").prop('disabled', true);
            $("#Cantidad_RS_Evacuado").prop('disabled', true);
            $("#Id_EO_RS_Salida").prop('disabled', true);
            $("#Registro_EO_RS_Salida").prop('disabled', true);
            $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', true);
            $("#Num_Autorizacion_Municipal_Salida").prop('disabled', true);
            $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', true);
            $("#Id_Conductor").prop('disabled', true);
            $("#Num_Licencia_Condutor").prop('disabled', true);
            $("#Id_Vehiculo").prop('disabled', true);
            $("#Capacidad_Vehiculo").prop('disabled', true);
            $("#Id_EO_RS_Llegada").prop('disabled', true);
            $("#Registro_EO_RS_Llegada").prop('disabled', true);
            $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', true);
            $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', true);
            $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', true);
        }
        else {            
            $("#Id_Residuo_Solido").prop('disabled', false);
            $("#Cantidad_RS_Evacuado").prop('disabled', false);
            $("#Id_EO_RS_Salida").prop('disabled', false);
            $("#Registro_EO_RS_Salida").prop('disabled', false);
            $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', false);
            $("#Num_Autorizacion_Municipal_Salida").prop('disabled', false);
            $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', false);
            $("#Id_Conductor").prop('disabled', false);
            $("#Num_Licencia_Condutor").prop('disabled', false);
            $("#Id_Vehiculo").prop('disabled', false);
            $("#Capacidad_Vehiculo").prop('disabled', false);
            $("#Id_EO_RS_Llegada").prop('disabled', false);
            $("#Registro_EO_RS_Llegada").prop('disabled', false);
            $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', false);
            $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', false);
            $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', false);
        }
    });
    $("#btnGuardarEstado").on('click', function () {
            $("#opcion").val("GuardarEstado");
            $("#formManifiestoRS").submit();
        });
    $("#btnRegistrar").on('click', function () {        
        resetValidationMessage();
        if ($("#Observacion_Manifiesto").val() != "Anulado") {
            if (checkValidationInputs()) {
                $("#opcion").val("Registrar");
                $("#formManifiestoRS").submit();
            }
        } else {
            if (checkValidationInputsAnulado()) {
                $("#opcion").val("Registrar");
                $("#formManifiestoRS").submit();
            }
        }
    });
     $("#btnEliminar").on('click', function () {
         $("#opcion").val("Eliminar");

         $("#Serie_Manifiesto").prop('disabled', false);
         $("#Num_Manifiesto").prop('disabled', false);
         $("#Fecha_Emision_Manifiesto").prop('disabled', false);
         $("#Observacion_Manifiesto").prop('disabled', false);
         $("#Id_Residuo_Solido").prop('disabled', false);
         $("#Cantidad_RS_Evacuado").prop('disabled', false);
         $("#Id_EO_RS_Salida").prop('disabled', false);
         $("#Registro_EO_RS_Salida").prop('disabled', false);
         $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', false);
         $("#Num_Autorizacion_Municipal_Salida").prop('disabled', false);
         $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', false);
         $("#Id_Conductor").prop('disabled', false);
         $("#Num_Licencia_Condutor").prop('disabled', false);
         $("#Id_Vehiculo").prop('disabled', false);
         $("#Capacidad_Vehiculo").prop('disabled', false);
         $("#Id_EO_RS_Llegada").prop('disabled', false);
         $("#Registro_EO_RS_Llegada").prop('disabled', false);
         $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', false);
         $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', false);
         $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', false);

         $("#formManifiestoRS").submit();
     });

    function checkValidationInputs() {
        if ($("#Serie_Manifiesto").val() == "") { $("[data-valmsg-for='Serie_Manifiesto']").html("Debe completar este campo"); return false; }
        if ($("#Num_Manifiesto").val() == "") { $("[data-valmsg-for='Num_Manifiesto']").html("Debe completar este campo"); return false; }
        if ($("#Fecha_Emision_Manifiesto").val() == "") { $("[data-valmsg-for='Fecha_Emision_Manifiesto']").html("Debe completar este campo"); return false; }
        if ($("#Observacion_Manifiesto").val() == "") { $("[data-valmsg-for='Observacion_Manifiesto']").html("Debe completar este campo"); return false; }
        if ($("#Id_Residuo_Solido").val() == 0) { $("[data-valmsg-for='Id_Residuo_Solido']").html("Debe seleccionar una opción"); return false; }
        if ($("#Cantidad_RS_Evacuado").val() == "") { $("[data-valmsg-for='Cantidad_RS_Evacuado']").html("Debe completar este campo"); return false; }
        if ($("#Id_EO_RS_Salida").val() == 0) { $("[data-valmsg-for='Id_EO_RS_Salida']").html("Debe seleccionar una opción"); return false; }
        if ($("#Registro_EO_RS_Salida").val() == "") { $("[data-valmsg-for='Registro_EO_RS_Salida']").html("Debe completar este campo"); return false; }
        if ($("#Fecha_Vencimiento_Registro_Salida").val() == "") { $("[data-valmsg-for='Fecha_Vencimiento_Registro_Salida']").html("Debe completar este campo"); return false; }
        if ($("#Num_Autorizacion_Municipal_Salida").val() == "") { $("[data-valmsg-for='Num_Autorizacion_Municipal_Salida']").html("Debe completar este campo"); return false; }
        if ($("#Num_Autorizacion_Hoja_Ruta").val() == "") { $("[data-valmsg-for='Num_Autorizacion_Hoja_Ruta']").html("Debe completar este campo"); return false; }
        if ($("#Id_Conductor").val() == 0) { $("[data-valmsg-for='Id_Conductor']").html("Debe seleccionar una opción"); return false; }
        if ($("#Num_Licencia_Condutor").val() == "") { $("[data-valmsg-for='Num_Licencia_Condutor']").html("Debe completar este campo"); return false; }
        if ($("#Id_Vehiculo").val() == 0) { $("[data-valmsg-for='Id_Vehiculo']").html("Debe seleccionar una opción"); return false; }
        if ($("#Capacidad_Vehiculo").val() == "") { $("[data-valmsg-for='Capacidad_Vehiculo']").html("Debe completar este campo"); return false; }
        if ($("#Id_EO_RS_Llegada").val() == 0) { $("[data-valmsg-for='Id_EO_RS_Llegada']").html("Debe seleccionar una opción"); return false; }
        if ($("#Registro_EO_RS_Llegada").val() == "") { $("[data-valmsg-for='Registro_EO_RS_Llegada']").html("Debe completar este campo"); return false; }
        if ($("#Fecha_Vencimiento_Registro_Llegada").val() == "") { $("[data-valmsg-for='Fecha_Vencimiento_Registro_Llegada']").html("Debe completar este campo"); return false; }
        if ($("#Num_Autorizacion_Sanitaria_Llegada").val() == "") { $("[data-valmsg-for='Num_Autorizacion_Sanitaria_Llegada']").html("Debe completar este campo"); return false; }
        if ($("#Num_Autorizacion_Municipal_Llegada").val() == "") { $("[data-valmsg-for='Num_Autorizacion_Municipal_Llegada']").html("Debe completar este campo"); return false; }
        return true;
    }
    function resetValidationMessage() {
        $("[data-valmsg-for='Serie_Manifiesto']").html("");
        $("[data-valmsg-for='Num_Manifiesto']").html("");
        $("[data-valmsg-for='Fecha_Emision_Manifiesto']").html("");
        $("[data-valmsg-for='Observacion_Manifiesto']").html("");
        $("[data-valmsg-for='Id_Residuo_Solido']").html("");
        $("[data-valmsg-for='Cantidad_RS_Evacuado']").html("");
        $("[data-valmsg-for='Id_EO_RS_Salida']").html("");
        $("[data-valmsg-for='Registro_EO_RS_Salida']").html("");
        $("[data-valmsg-for='Fecha_Vencimiento_Registro_Salida']").html("");
        $("[data-valmsg-for='Num_Autorizacion_Municipal_Salida']").html("");
        $("[data-valmsg-for='Num_Autorizacion_Hoja_Ruta']").html("");
        $("[data-valmsg-for='Id_Conductor']").html("");
        $("[data-valmsg-for='Num_Licencia_Condutor']").html("");
        $("[data-valmsg-for='Id_Vehiculo']").html("");
        $("[data-valmsg-for='Capacidad_Vehiculo']").html("");
        $("[data-valmsg-for='Id_EO_RS_Llegada']").html("");
