@model GestionAmbiental.UseCases.ResiduosSolidos.ControlManifiestoRS.CompletarManifiestoRS.CompletarManifiestoRSModel
@{
    ViewData["Title"] = "CompletarManifiesto";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="residuos">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Completar Manifiesto de Residuos Sólidos Peligrosos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="container pt-4 pb-4">
            <form id="formCompletarManifiesto" asp-action="CompletarManifiesto" asp-controller="CompletarManifiesto" method="post" enctype="multipart/form-data" autocomplete="off">
                <div class="custom-form details-container w-100">
                    <input type="hidden" asp-for="Id_Manifiesto_RS" />
                    <input type="hidden" asp-for="Id_Encriptado" />
                    <input type="hidden" asp-for="opcion" />
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL MANIFIESTO</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Serie_Manifiesto"></label>
                                <span class="text-danger" asp-validation-for="Serie_Manifiesto"></span>
                                <input class="form-control" type="number" asp-for="Serie_Manifiesto" min="1" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Num_Manifiesto"></label>
                                <span class="text-danger" asp-validation-for="Num_Manifiesto"></span>
                                <input class="form-control" type="text" asp-for="Num_Manifiesto" maxlength="25" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Emision_Manifiesto"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Emision_Manifiesto"></span>
                                <input class="form-control" type="date" asp-for="Fecha_Emision_Manifiesto" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Observacion_Manifiesto"></label>
                                <span class="text-danger" asp-validation-for="Observacion_Manifiesto"></span>
                                <select class="form-control" asp-for="Observacion_Manifiesto">
                                    <option value="">--SELECCIONE--</option>
                                    <option value="Conforme">Conforme</option>
                                    <option value="Anulado">Anulado</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DEL RESIDUO PELIGROSO</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Residuo_Solido"></label>
                                <span class="text-danger" asp-validation-for="Id_Residuo_Solido"></span>
                                <select class="form-control" asp-items="ViewBag.ResiduosSolidos" asp-for="Id_Residuo_Solido">
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Cantidad_RS_Evacuado"></label>
                                <span class="text-danger" asp-validation-for="Cantidad_RS_Evacuado"></span>
                                <input class="form-control" type="number" asp-for="Cantidad_RS_Evacuado" min="0" max="999999" />
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DE LA EO-RS: RECOLECCIÓN Y TRANSPORTE</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_EO_RS_Salida"></label>
                                <span class="text-danger" asp-validation-for="Id_EO_RS_Salida"></span>
                                <select class="form-control" asp-items="ViewBag.EO_RS" asp-for="Id_EO_RS_Salida">
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Registro_EO_RS_Salida"></label>
                                <span class="text-danger" asp-validation-for="Registro_EO_RS_Salida"></span>
                                <input class="form-control" type="text" asp-for="Registro_EO_RS_Salida" maxlength="25" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Vencimiento_Registro_Salida"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro_Salida"></span>
                                <input class="form-control" type="date" asp-for="Fecha_Vencimiento_Registro_Salida" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Num_Autorizacion_Municipal_Salida"></label>
                                <span class="text-danger" asp-validation-for="Num_Autorizacion_Municipal_Salida"></span>
                                <input class="form-control" type="text" asp-for="Num_Autorizacion_Municipal_Salida" maxlength="25" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Num_Autorizacion_Hoja_Ruta"></label>
                                <span class="text-danger" asp-validation-for="Num_Autorizacion_Hoja_Ruta"></span>
                                <input class="form-control" type="text" asp-for="Num_Autorizacion_Hoja_Ruta" maxlength="25" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Conductor"></label>
                                <span class="text-danger" asp-validation-for="Id_Conductor"></span>
                                <select class="form-control" asp-items="ViewBag.Conductores" asp-for="Id_Conductor">
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-4">
                                <label asp-for="Num_Licencia_Condutor"></label>
                                <span class="text-danger" asp-validation-for="Num_Licencia_Condutor"></span>
                                <input class="form-control" type="text" asp-for="Num_Licencia_Condutor" maxlength="10" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-4">
                                <label asp-for="Id_Vehiculo"></label>
                                <span class="text-danger" asp-validation-for="Id_Vehiculo"></span>
                                <select class="form-control" asp-items="ViewBag.Vehiculos" asp-for="Id_Vehiculo">
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-4">
                                <label asp-for="Capacidad_Vehiculo"></label>
                                <span class="text-danger" asp-validation-for="Capacidad_Vehiculo"></span>
                                <input class="form-control" type="number" asp-for="Capacidad_Vehiculo" min="0" max="999999" />
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="d-flex justify-content-center">
                            <span class="text-mc bold text-center">DATOS DE LA EO-RS: DESTINO FINAL Y/O COMERCIALIZACIÓN</span>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_EO_RS_Llegada"></label>
                                <span class="text-danger" asp-validation-for="Id_EO_RS_Llegada"></span>
                                <select class="form-control" asp-items="ViewBag.EO_RS" asp-for="Id_EO_RS_Llegada">
                                </select>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Registro_EO_RS_Llegada"></label>
                                <span class="text-danger" asp-validation-for="Registro_EO_RS_Llegada"></span>
                                <input class="form-control" type="text" asp-for="Registro_EO_RS_Llegada" maxlength="25" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Vencimiento_Registro_Llegada"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Vencimiento_Registro_Llegada"></span>
                                <input class="form-control" type="date" asp-for="Fecha_Vencimiento_Registro_Llegada" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Num_Autorizacion_Sanitaria_Llegada"></label>
                                <span class="text-danger" asp-validation-for="Num_Autorizacion_Sanitaria_Llegada"></span>
                                <input class="form-control" type="text" asp-for="Num_Autorizacion_Sanitaria_Llegada" maxlength="25" />
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Num_Autorizacion_Municipal_Llegada"></label>
                                <span class="text-danger" asp-validation-for="Num_Autorizacion_Municipal_Llegada"></span>
                                <input class="form-control" type="text" asp-for="Num_Autorizacion_Municipal_Llegada" maxlength="25" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Id_Asesor"></label>
                                <span class="text-danger" asp-validation-for="Id_Asesor"></span>
                                <select class="form-control" asp-items="ViewBag.AsesoresMAP" asp-for="Id_Asesor">
                                </select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Fecha_Devolucion"></label>
                                <span class="text-danger" asp-validation-for="Fecha_Devolucion"></span>
                                <input class="form-control" type="date" asp-for="Fecha_Devolucion" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Cantidad_RS_Dispuesto"></label>
                                <span class="text-danger" asp-validation-for="Cantidad_RS_Dispuesto"></span>
                                <input class="form-control" type="number" asp-for="Cantidad_RS_Dispuesto" min="0" max="999999" />
                            </div>
                        </div>
                        @if (Model.Observacion_Manifiesto != "Anulado")
                        {
                            <div class="row input_container align-items-start">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Certificado"></label>
                                    <span class="text-danger field-validation-error" data-valmsg-for="Certificado" data-valmsg-replace="true">
                                        <span id="danger_certificado" class=""></span>
                                    </span>
                                    <input type="file" asp-for="Certificado" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                    <input type="hidden" asp-for="@Model.Certificado_Lleno" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6" id="Certificado_Lleno_Lista">
                                </div>
                            </div>
                            <div class="row input_container align-items-start">
                                <div class="col-12 col-sm-6 col-lg-6">
                                    <label asp-for="Informe_Transporte"></label>
                                    <span class="text-danger field-validation-error" data-valmsg-for="Informe_Transporte" data-valmsg-replace="true">
                                        <span id="danger_informe" class=""></span>
                                    </span>
                                    <input type="file" asp-for="Informe_Transporte" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                    <input type="hidden" asp-for="@Model.Informe_Transporte_Lleno" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-6" id="Informe_Transporte_Lleno_Lista">
                                </div>
                            </div>
                        }
                        <div class="row input_container align-items-start">
                            <div class="col-12 col-sm-6 col-lg-6">
                                <label asp-for="Manifiesto_Doc"></label>
                                <span class="text-danger field-validation-error" data-valmsg-for="Manifiesto_Doc" data-valmsg-replace="true">
                                    <span id="danger_manifiesto" class=""></span>
                                </span>
                                <input type="file" asp-for="Manifiesto_Doc" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx" data-max-size="8971520" multiple>
                                <input type="hidden" asp-for="@Model.Manifiesto_Doc_Lleno" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-6" id="Manifiesto_Doc_Lleno_Lista">
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-sm-12 col-lg-12">
                                <span class="text-danger field-validation-error" data-valmsg-replace="true">
                                    <span id="danger_archivos"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="detail-container col-12 col-xl-10 mb-4 w-100">
                        <div class="row">
                            <div class="button-container">
                                <a class="btn btn-mc-outline-danger" asp-controller="CompletarManifiesto" asp-action="Resumen">Cancelar</a>
                                @if (Model.Estado.Equals("Registrado") && Model.PermisoAsesor)
                                {
                                    <button id="btnEliminar" type="button" class="btn btn-mc-danger">Eliminar</button>
                                    <button id="btnGuardar" type="button" class="btn btn-mc-outline-success">Guardar Estado</button>
                                    <button id="btnCompletar" type="button" class="btn btn-mc-success">Completar</button>
                                }
                                else if (Model.PermisoAdmin)
                                {
                                    <button id="btnEliminar" type="button" class="btn btn-mc-danger">Eliminar</button>
                                    <button id="btnGuardarCambios" type="button" class="btn btn-mc-success">Guardar Cambios</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Modal Guardando Estado-->
<div class="modal fade mc-modal" id="Modal_Cargando_Archivos" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered justify-content-center">
        <div class="mc-modal-image-background col-12">
            <div class="modal-content">
                <div class="modal-body">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="col-12 d-flex justify-content-center">
                        <div style="width: 150px; height: 35px">
                            <div class="spinner">
                                <div class="rect1"></div>
                                <div class="rect2"></div>
                                <div class="rect3"></div>
                                <div class="rect4"></div>
                                <div class="rect5"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-center mt-4">
                        <label class="text-white">Guardando Cambios</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            var certificado = '@Model.Certificado_Lleno';
            var informe = '@Model.Informe_Transporte_Lleno';
            var manifiesto = '@Model.Manifiesto_Doc_Lleno';

            if (certificado.length > 0) {
                var certificado_valores = JSON.parse(certificado.replace(/&quot;/g, '"'));
                var html_certificado = "";
                for (var i = 0; i < certificado_valores.length; i++) {
                    html_certificado += "<p>";
