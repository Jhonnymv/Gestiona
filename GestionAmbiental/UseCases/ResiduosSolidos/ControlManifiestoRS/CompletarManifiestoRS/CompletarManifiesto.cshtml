        $("#btnEliminar").click(function () {
            if (confirm("¿Esta seguro que desea eliminar este manifiesto?")) {
                var formData = new FormData();
                formData.append("IdManifiesto", $("#Id_Encriptado").val());
                $.ajax({
                    url: "@Url.Action("EliminarManifiesto", "CompletarManifiesto")",
                    method: "post",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            window.location.href = "/CompletarManifiesto/Resumen/";
                        }
                        else {
                            console.log("Ocurrió un error: " + response.message)
                        }
                    }
                });
            }
