</form>*@

<!-- Modal Cargando Archivos-->
<div class="modal fade" id="Modal_Cargando_Archivos" tabindex="-1" role="dialog"
     aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <br/>
                    <label>  Guardando Cambios</label>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            var certificado = '@Model.Certificado_Lleno';
            var informe = '@Model.Informe_Transporte_Lleno';
            var manifiesto = '@Model.Manifiesto_Doc_Lleno';

            if (certificado.length > 0) {
                var certificado_valores = JSON.parse(certificado.replace(/&quot;/g, '"'));
                var html_certificado = "";
                for (var i = 0; i < certificado_valores.length; i++)
                    html_certificado += "<a class=\"btn btn-mc-outline me-2\" href=\"/CompletarManifiesto/Download?fileName=" + certificado_valores[i] + "&tipo=cert\">Descargar Certificado "+(i+1)+"</a>";

                $("#Certificado_Lleno_Lista").html(html_certificado);
                $("#Certificado_Lleno").val(certificado_valores);
            }
            if (informe.length > 0) {
                var informe_valores = JSON.parse(informe.replace(/&quot;/g, '"'));
                var html_informe = "";
                for (var i = 0; i < informe_valores.length; i++)
                    html_informe += "<a class=\"btn btn-mc-outline me-2\" href=\"/CompletarManifiesto/Download?fileName=" + informe_valores[i] + "&tipo=inf\">Descargar Informe de Transporte " + (i + 1) +"</a>";

                $("#Informe_Transporte_Lleno_Lista").html(html_informe);
                $("#Informe_Transporte_Lleno").val(informe_valores);
            }
            if (manifiesto.length > 0) {
                var manifiesto_valores = JSON.parse(manifiesto.replace(/&quot;/g, '"'));
                var html_manifiesto = "";
                for (var i = 0; i < manifiesto_valores.length; i++)
                    html_manifiesto += "<a class=\"btn btn-mc-outline me-2\" href=\"/CompletarManifiesto/Download?fileName=" + manifiesto_valores[i] + "&tipo=man\">Descargar Manifiesto " + (i + 1) +"</a>";

                $("#Manifiesto_Doc_Lleno_Lista").html(html_manifiesto);
                $("#Manifiesto_Doc_Lleno").val(manifiesto_valores);
            }

            if ("@Model.Observacion_Manifiesto" == "Anulado") {
                changeAvailableInputs(true);
            }
        });
        $("#Certificado").change(function () {
            console.log($("#Certificado").val())

            $("#danger_certificado").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Certificado").data('max-size');
            var archivos = $("#Certificado").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_certificado").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#archivos_certificado").text(filesname);
                            $("#danger_certificado").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#archivos_certificado").html(filesName) : null;
            }
        });
        $("#Informe_Transporte").change(function () {
            $("#danger_informe").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Informe_Transporte").data('max-size');
            var archivos = $("#Informe_Transporte").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_informe").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#archivos_informe").text(filesname);
                            $("#danger_informe").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#archivos_informe").html(filesName) : null;
            }
        });
        $("#Manifiesto_Doc").change(function () {
            $("#danger_manifiesto").html("");
            //Validacion del tamaño del archivo
            var maxSize = $("#Manifiesto_Doc").data('max-size');
            var archivos = $("#Manifiesto_Doc").get(0).files;

            if (archivos.length > 0) {
                var fileSize = 0
                for (var i = 0; i < archivos.length; i++) {
                    fileSize += archivos[i].size;
                }
                if (fileSize > maxSize) {
                    this.value = '';
                    var filesname = this.files.length + " Archivos";
                    $("#danger_manifiesto").html("El  archivo supera el límite permitido de 8MB<br/>");
                    return;
                }
                var filesName = "";
                for (var i = 0; i < archivos.length; i++) {
                    switch (this.value.match(/\.([^\.]+)$/)[1]) {
                        case 'jpg':
                        case 'JPG':
                        case 'jpeg':
                        case 'JPEG':
                        case 'png':
                        case 'PNG':
                        case 'xls':
                        case 'xlsx':
                        case 'doc':
                        case 'docx':
                        case 'pdf':
                            filesName += archivos[i].name + "<br/>";
                            break;
                        default:
                            this.value = '';
                            var filesname = this.files.length + " Archivos";
                            $("#archivos_manifiesto").text(filesname);
                            $("#danger_manifiesto").html("No se admiten este tipo de archivos<br/>");
                            return;
                    }
                }
                filesName.length > 0 ? $("#archivos_manifiesto").html(filesName) : null;
            }
        });
        function getExt(fileName) {
            return (fileName.lastIndexOf('.') < 1) ? null : fileName.split('.').slice(-1);
        }
        $("#btnGuardar").click(function () {
            resetValidationMessage();
            $("#opcion").val("Pendiente");
            changeAvailableInputs(false);
            $("#Modal_Cargando_Archivos").modal('show');
            $("#formCompletarManifiesto").submit();
        });
        $("#btnCompletar").click(function () {
            var certificado = false;
            var informe = false;
            var manifiesto = false;

            if ($("#Certificado").val() != "" || $("#Certificado_Lleno").val() != "")
                    certificado = true;
                if ($("#Informe_Transporte").val() != "" || $("#Informe_Transporte_Lleno").val() != "")
                    informe = true;
                if ($("#Manifiesto_Doc").val() != "" || $("#Manifiesto_Doc_Lleno").val() != "")
                    manifiesto = true;

            resetValidationMessage();
            if ($("#Observacion_Manifiesto").val() != "Anulado") {
                if (certificado && informe && manifiesto && checkValidationInputs()) {
                    $("#opcion").val("Completar");
                    changeAvailableInputs(false);
                    $("#Modal_Cargando_Archivos").modal('show');
                    $("#formCompletarManifiesto").submit();
                } else {
                    $("#danger_archivos").html("Debe cargar todos los archivos requeridos")
                }
            } else {
                if (checkValidationInputsAnulado() && manifiesto) {
                    $("#opcion").val("Completar");
                    changeAvailableInputs(false);
                    $("#Modal_Cargando_Archivos").modal('show');
                    $("#formCompletarManifiesto").submit();
                }
                else {
                    $("#danger_archivos").html("Debe cargar todos los archivos requeridos")
                }             
            }
        });
        function changeAvailableInputs(estado) {
            $("#Serie_Manifiesto").prop('disabled', estado);
            $("#Num_Manifiesto").prop('disabled', estado);
            $("#Fecha_Emision_Manifiesto").prop('disabled', estado);
            $("#Observacion_Manifiesto").prop('disabled', estado);
            $("#Id_Residuo_Solido").prop('disabled', estado);
            $("#Cantidad_RS_Evacuado").prop('disabled', estado);
            $("#Id_EO_RS_Salida").prop('disabled', estado);
            $("#Registro_EO_RS_Salida").prop('disabled', estado);
            $("#Fecha_Vencimiento_Registro_Salida").prop('disabled', estado);
            $("#Num_Autorizacion_Municipal_Salida").prop('disabled', estado);
            $("#Num_Autorizacion_Hoja_Ruta").prop('disabled', estado);
            $("#Id_Conductor").prop('disabled', estado);
            $("#Num_Licencia_Condutor").prop('disabled', estado);
            $("#Id_Vehiculo").prop('disabled', estado);
            $("#Capacidad_Vehiculo").prop('disabled', estado);
            $("#Id_EO_RS_Llegada").prop('disabled', estado);
            $("#Registro_EO_RS_Llegada").prop('disabled', estado);
            $("#Fecha_Vencimiento_Registro_Llegada").prop('disabled', estado);
            $("#Num_Autorizacion_Sanitaria_Llegada").prop('disabled', estado);
            $("#Num_Autorizacion_Municipal_Llegada").prop('disabled', estado);
            //$("#Id_Asesor").prop('disabled', estado);
            $("#Fecha_Devolucion").prop('disabled', estado);
            $("#Cantidad_RS_Dispuesto").prop('disabled', estado);
        }
        function checkValidationInputs() {
            if ($("#Id_Asesor").val() == 0) { $("[data-valmsg-for='Id_Asesor']").html("Debe seleccionar una opción"); return false; }
            if ($("#Fecha_Devolucion").val() == "") { $("[data-valmsg-for='Fecha_Devolucion']").html("Debe completar este campo"); return false; }
            if ($("#Cantidad_RS_Dispuesto").val() == "") { $("[data-valmsg-for='Cantidad_RS_Dispuesto']").html("Debe completar este campo"); return false; }
            return true;
        }
        function resetValidationMessage() {
            $("[data-valmsg-for='Id_Asesor']").html("");
            $("[data-valmsg-for='Fecha_Devolucion']").html("");
            $("[data-valmsg-for='Cantidad_RS_Dispuesto']").html("");
            $("#danger_archivos").html("");
        }
        
        function checkValidationInputsAnulado() {
            if ($("#Id_Asesor").val() == 0) { $("[data-valmsg-for='Id_Asesor']").html("Debe seleccionar una opción"); return false; }            
            return true;
        }
    </script>
}