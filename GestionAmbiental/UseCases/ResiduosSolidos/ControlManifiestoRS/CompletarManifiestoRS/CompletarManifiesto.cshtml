                    html_certificado += "<a class=\"btn btn-mc-outline-success me-2\" href=\"/CompletarManifiesto/Download?fileName=" + certificado_valores[i] + "&tipo=cert\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">" +
