            filesName.length > 0 ? $("#archivos_informe").html(filesName) : null;
        }
    });
    $("#Manifiesto_Doc").change(function () {
        $("#danger_manifiesto").html("");
        //Validacion del tamaño del archivo
        var maxSize = $("#Manifiesto_Doc").data('max-size');
