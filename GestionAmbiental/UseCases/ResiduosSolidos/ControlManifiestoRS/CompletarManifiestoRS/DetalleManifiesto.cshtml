    <div class="row mb-2 justify-content-start">
        <div class="col-sm-12 col-md-2 col-lg-2">
            <label asp-for="Certificado"></label>
        </div>
        <div class="col-sm-12 col-md-6 col-lg-6">
            @foreach(var item in Model.Certificado)
            {
                <p><a asp-controller="CompletarManifiesto" asp-action="Download" asp-route-fileName="@item" asp-route-tipo="cert">Certificado</a></p>
