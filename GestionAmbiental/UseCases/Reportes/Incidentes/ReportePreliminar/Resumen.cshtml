@section Scripts{

    <script src="~/js/UseCases/Reportes/ReportesIncidentesRPScript.js" type="text/javascript"></script>
    <script type="text/javascript">
        $("#frecuencia").on("change", function () {
            ActualizarRerpotesPreliminaresFechas();
        });
    </script>

}
