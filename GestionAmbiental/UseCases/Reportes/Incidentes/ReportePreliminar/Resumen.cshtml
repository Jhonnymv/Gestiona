@model GestionAmbiental.UseCases.Reportes.Incidentes.ReportePreliminar.FiltroReportesIncidentesReportePreliminarModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Dashboard de Reportes Preliminares Incidentes</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="container-fluid">
        <div class="row mb-2 justify-content-center">
            <div class="col-lg-10 col-md-10 col-sm-12 border rounded" style="border-color:#2e6793 !important">
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="TipoIncidente"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="TipoIncidente" asp-items="@ViewBag.FiltroTiposIncidente"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="NivelIncidente"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="NivelIncidente" asp-items="@ViewBag.FiltroNiveles"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="Gerencia"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="Gerencia" asp-items="@ViewBag.FiltroGerencias"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="Supervisor"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="Supervisor" asp-items="@ViewBag.FiltroSupervisores"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FInicio"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FFin"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <button type="button" class="btn btn-primary" onclick="Filtrar()">Filtrar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<!--Cantidad de RP por fecha-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Reportes Preliminares Registrados </h6>
                    </div>
                    <div class="col-2">
                        <select id="frecuencia" class="form-control">
                            <option value="Diario" selected>Diario</option>
                            <option value="Semanal">Semanal</option>
                            <option value="Mensual">Mensual</option>s
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <div class="chartjs-size-monitor">
                        <div class="chartjs-size-monitor-expand">
                            <div class="">
                            </div>
                        </div>
                        <div class="chartjs-size-monitor-shrink">
                            <div class="">
                            </div>
                        </div>
                    </div>
                    <canvas id="chart_rep_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!--NRegistros Tipo Incidente-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Reportes Preliminares Registrados vs Tipo de Incidente</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_rp_tipo_incidente" style="display: block; height: 500px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nivel Incidente -->
<div class="row mb-2">
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Nivel de Incidente</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_nivel_incidente" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Comparativo Ingreso vs Salida</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="chart-area">
                                <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                                <canvas id="chart_gerencia_incidente" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>
<!--NRegistros Causa Incidente-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Reportes Preliminares Registrados vs Causa de Incidente</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_rp_causa_incidente" style="display: block; height: 500px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src="~/js/UseCases/Reportes/ReportesIncidentesRPScript.js" type="text/javascript"></script>
    <script type="text/javascript">
        /*
        function Descargar() {
            var fInicio = $("#FInicio").val();
            var fFin = $("#FFin").val();
            if (fInicio < fFin || (fInicio == "" && fFin == "")) {
                window.location.assign("/DescargaIngresoSalida/DescargarIngresoSalida?fechaInicio=" + fInicio + "&fechaFin=" + fFin)
            }
        }
        */
        $("#frecuencia").on("change", function () {
            ActualizarReportesFecha();
        });
    </script>

}