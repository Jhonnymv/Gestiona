@model GestionAmbiental.UseCases.Reportes.Incidentes.FiltroReportesIncidentesModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="incidentes mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title incidentes-opacity-color">
                <h3>Dashboard de Incidentes</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form class="custom-form w-100" autocomplete="off">
                <div class="col-12 col-lg-9">
                    <div class="row">
                        <h5 class="text-mc text-center">Filtros</h5>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="TipoIncidente"></label>
                            <select class="form-control" asp-for="TipoIncidente" asp-items="@ViewBag.FiltroTiposIncidente"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NivelIncidente"></label>
                            <select class="form-control" asp-for="NivelIncidente" asp-items="@ViewBag.FiltroNiveles"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="Gerencia"></label>
                            <select class="form-control" asp-for="Gerencia" asp-items="@ViewBag.FiltroGerencias"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Supervisor"></label>
                            <select class="form-control" asp-for="Supervisor" asp-items="@ViewBag.FiltroSupervisores"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="FInicio"></label>
                            <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FFin"></label>
                            <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-1">
                </div>
                <div class="col-12 col-lg-2">
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc w-100" onclick="Filtrar()">Filtrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!--Investigaciones Registradas por fecha-->
<div class="container">
    <div class="row">
        <div class="dashboard-section col-12">
            <div class="dashboard-header">
                <h5>Investigaciones Registradas</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-6">
                            <select id="frecuencia" class="form-control">
                                <option value="Diario" selected>Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <div class="dashboard-item incidentes">
                                <div class="image-header-container">
                                    <div class="dashboard-item-title incidentes-opacity-color">
                                        <h6>Incidentes Hasta la Fecha</h6>
                                        <h3 id="IncTotal"></h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_inc_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Investigaciones por Tipo de Incidente-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Investigaciones por Tipo de Incidente</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_tipo_incidente" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Nivel de Incidente-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Nivel de Incidente</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_nivel_incidente" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Investigaciones por Gerencia Responsable-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Investigaciones por Gerencia Responsable</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12" style="cursor:pointer">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_gerencia_incidente" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
