@model GestionAmbiental.UseCases.Reportes.RAC.FiltroReportesRACModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="rac mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title rac-opacity-color">
                <h3>Dashboard de RAC</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form class="custom-form w-100" autocomplete="off">
                <div class="col-12 col-lg-8">
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="IdGerencia"></label>
                            <select class="form-control" asp-for="IdGerencia" asp-items="@ViewBag.ItemsGerencia"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="IdEmpresa"></label>
                            <select class="form-control" asp-for="IdEmpresa" asp-items="@ViewBag.ItemsEmpresa"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="IdUsuario"></label>
                            <select class="form-control" asp-for="IdUsuario" asp-items="@ViewBag.ItemsUsuario"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="FInicio"></label>
                            <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FFin"></label>
                            <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4 row-center-center">
                    <button type="button" class="btn btn-mc" onclick="Filtrar()">Filtrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container">
    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Contadores</h5>
        </div>
        <div class="wrap-scroll-horizontal">
            <div class="dashboard-item rac">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Cantidad de RAC hasta la fecha</h6>
                        <h3 id="NTotalRAC"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Cantidad de RAC encontrados</h6>
                        <h3 id="NFiltroRAC"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Registrado')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Pendientes de Implementación</h6>
                        <h3 id="ObsRegistrado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Implementado')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Pendientes de Verificación</h6>
                        <h3 id="ObsImplementado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Aprobado')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Aprobadas</h6>
                        <h3 id="ObsAprobado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Rechazado')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Rechazadas</h6>
                        <h3 id="ObsRechazado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Vencido')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Vencidas</h6>
                        <h3 id="ObsVencido"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item rac" onclick="ReporteDetalleEstado('Ampliado')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title rac-opacity-color">
                        <h6>Observaciones Ampliadas</h6>
                        <h3 id="ObsAmpliado"></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section col-12">
        <div class="dashboard-header">
            <h5>Cantidad de Reportes de Acto y Condición Subestándar Registrados</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12">
                <div class="secondary-content">
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_rac_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section col-12">
        <div class="dashboard-header">
            <h5>Reportes de Acto y Condición Subestándar MA</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6" onclick="ActualizarDatosGraficoMA_NR_Tipo()" style="cursor:pointer">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">
                            #Reportes de Acto y Condición Subestándar MA por Nivel de Riesgo
                        </h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_MA_Nivel_Riesgo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center"># Reportes de Acto y Condición Subestándar</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_MA_Clasificacion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section col-12">
        <div class="dashboard-header">
            <h5>Reportes de Acto y Condición Subestándar SSO</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6" onclick="ActualizarDatosGraficoSSO_NR_Tipo()" style="cursor:pointer">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">
                            #Reportes de Acto y Condición Subestándar SSO por Nivel de Riesgo
                        </h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_SSO_Nivel_Riesgo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Reportes de Acto y Condición Subestándar</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_MA_Clasificacion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

