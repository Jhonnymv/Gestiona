@section Scripts{
    @*Script de la página*@
    <script type="text/javascript">
        var gerencia = $("#IdGerencia").val();
        var empresa = $("#IdEmpresa").val();
        var usuario = $("#IdUsuario").val();
        var fechaInicio = "";
        var fechaFin = "";

        //Variables gráfico RAC Fecha
        var data_rac_fechas = [];
        var graph_rac_fechas;
        //Variables gráfico MA nivel de riesgo
        var data_rac_ma_nr = [];
        var graph_rac_ma_nr;
        //Variables gráfico SSO nivel de riesgo
        var data_rac_sso_nr = [];
        var graph_rac_sso_nr;
        //Variables gráfico MA tipo condición
        var data_rac_ma_c = [];
        var graph_rac_ma_c;
        //Variables gráfico SSO tipo condición
        var data_rac_sso_c = [];
        var graph_rac_sso_c;

        $(document).ready(function () {
            Filtrar();
            //ActualizarDatosGraficoMA_NR_Tipo();
            //ActualizarDatosGraficoSSO_NR_Tipo();
        });

        function Filtrar() {
            gerencia = $("#IdGerencia").val();
            empresa = $("#IdEmpresa").val();
            usuario = $("#IdUsuario").val();
            fechaInicio = $("#FInicio").val();
            fechaFin = $("#FFin").val();
            if (fechaInicio < fechaFin || (fechaInicio == "" && fechaFin == "")) {
                $.ajax({
                    type: "POST",
                    url: "/ReportesRAC/Filtrar",
                    data: {
                        "IdGerencia": $("#IdGerencia").val(),
                        "IdEmpresa": $("#IdEmpresa").val(),
                        "IdUsuario": $("#IdUsuario").val(),
                        "FechaInicio": $("#FInicio").val(),
                        "FechaFin": $("#FFin").val()
                    },
                    traditional: true,
                    success: (response) => {
                        //Actualizar contador
                        var nObs = response.nObservaciones;
                        ActualizarContadorRxE(nObs[0].valor, nObs[1].valor, nObs[2].valor, nObs[3].valor, nObs[4].valor, nObs[5].valor,nObs[6].valor);
                        //Actualizar input fechas
                        fechaInicio = $("#FInicio").val();
                        fechaFin = $("#FFin").val();
                        //Actualizar gráfico de rac de fechas
                        ActualizarContadorRxFecha();
                        //Actualizar gráfico de ma por nivel de riesgo
                        ActualizarDatosGraficoMA_NR();
                        //Actualizar gráfico de sso por nivel de riesgo
                        ActualizarDatosGraficoSSO_NR();
                        //Actualizar gráfico de ma por clasificación
                        ActualizarDatosGraficoMA_Clas();
                        //Actualizar gráfico de sso por clasificación
                        ActualizarDatosGraficoSSO_Clas();
                    }
                });
            } else {
                alert("La fecha de fin debe ser mayor a la fecha de inicio");
            }
        }
        //Para Contador de reportes por estado
        function ActualizarContadorRxE(reg, imp, apr, rec, ven, amp, total) {
            //Reiniciar valores
            $("#ObsRegistrado").html(0);
            $("#ObsImplementado").html(0);
            $("#ObsAprobado").html(0);
            $("#ObsRechazado").html(0);
            $("#ObsVencido").html(0);
            $("#ObsAmpliado").html(0);
            $("#NTotalRAC").html(0);
            $("#NFiltroRAC").html(0);
            //Nuevo valores
            $("#ObsRegistrado").html(reg);
            $("#ObsImplementado").html(imp);
            $("#ObsAprobado").html(apr);
            $("#ObsRechazado").html(rec);
            $("#ObsVencido").html(ven);
            $("#ObsAmpliado").html(amp);
            $("#NTotalRAC").html(total);
            $("#NFiltroRAC").html(reg + imp + apr + rec + ven + amp);
        }
        //Para gráfico RAC Fecha
        function ActualizarContadorRxFecha() {
            $.ajax({
                type: "POST",
                url: "/ReportesRAC/GetNReportesEntreFechas",
                data: {
                    "IdGerencia": $("#IdGerencia").val(),
                    "IdEmpresa": $("#IdEmpresa").val(),
                    "IdUsuario": $("#IdUsuario").val(),
                    "FechaInicio": fechaInicio,
                    "FechaFin": fechaFin
                },
                traditional: true,
                success: (response) => {
                    if (data_rac_fechas.length > 0) {
