                        var data = [];
                        for (var i = 0; i < data_rac_fechas.length; i++) {
                            labels.push(data_rac_fechas[i].nombre);
                            data.push(data_rac_fechas[i].valor);
                        }
                        //Actualizar gráfica
                        graph_rac_fechas.data.labels = labels;
                        graph_rac_fechas.data.datasets[0].data = data;
                        graph_rac_fechas.options.scales.yAxes[0].ticks.stepSize = Math.max(data) / 10;
                        graph_rac_fechas.update();
