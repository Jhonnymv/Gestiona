@model GestionAmbiental.UseCases.Reportes.ResiduosSolidos.ControlIngresoSalida.FiltroIngresoSalidaModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Dashboard de Ingreso/Salida de Residuos Sólidos</h2>
    </div>
</div>
<form autocomplete="off">
    <div class="container-fluid">
        <div class="row mb-2 justify-content-center">
            <div class="col-lg-10 col-md-10 col-sm-12 border rounded" style="border-color:#2e6793 !important">
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="ACR_CMRS"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="ACR_CMRS" asp-items="@ViewBag.ACR_CMRS"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="IngresoSalida"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="IngresoSalida" asp-items="@ViewBag.IngresoSalida"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">

                    <div class="col-lg-2 mt-1">
                        <label asp-for="TipoResiduo"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="TipoResiduo" asp-items="@ViewBag.TipoResiduo"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="Motivo"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="Motivo" asp-items="@ViewBag.Motivo"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FInicio"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FFin"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="Gerencia"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="Gerencia" asp-items="@ViewBag.Gerencias"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="Empresa"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="Empresa" asp-items="@ViewBag.Empresa"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <button type="button" class="btn btn-primary" onclick="Filtrar()">Filtrar</button>
                </div>
            </div>
        </div>
    </div>
</form>
<!--Cantidad de RS por fecha-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Cantidad de Residuos Sólido Ingresado/Retirado </h6>
                    </div>
                    <div class="col-2">
                        <select id="frecuencia" class="form-control">
                            <option value="Diario" selected>Diario</option>
                            <option value="Semanal">Semanal</option>
                            <option value="Mensual">Mensual</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <div class="chartjs-size-monitor">
                        <div class="chartjs-size-monitor-expand">
                            <div class="">
                            </div>
                        </div>
                        <div class="chartjs-size-monitor-shrink">
                            <div class="">
                            </div>
                        </div>
                    </div>
                    <canvas id="chart_cant_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Cantidad de RS por ACR_CMRS - Ingreso Salida-->
<div class="row mb-2">
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Comparativo ACR vs CMRS</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_acr_cmrs" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Comparativo Ingreso vs Salida</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_ing_sal" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Cantidad de RS por Tipo Residuo - Motivo-->
<div class="row mb-2">
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Comparativo Tipo de Residuo Sólido</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_tipo_residuo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Comparativo Motivo de Ingreso/Salida de Residuo Sólido</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="chart-area">
                            <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                            <canvas id="chart_motivo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    @*Script de la página*@
    <script src="~/js/UseCases/Reportes/ReportesResiduosSolidosScript.js" type="text/javascript"></script>
}
