@model GestionAmbiental.UseCases.Reportes.ResiduosSolidos.ControlIngresoSalida.FiltroIngresoSalidaModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="~/selectpicker/css/bootstrap-select.css">
}
<div class="residuos mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Dashboard de Ingreso/Salida de Residuos Sólidos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form class="custom-form w-100" autocomplete="off">
                <div class="col-12 col-lg-9">
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="ACR_CMRS"></label>
                            <select class="form-control" asp-for="ACR_CMRS" asp-items="@ViewBag.ACR_CMRS"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="IngresoSalida"></label>
                            <select class="form-control" asp-for="IngresoSalida" asp-items="@ViewBag.IngresoSalida"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="TipoResiduo"></label>
                            <select class="form-control" asp-for="TipoResiduo" asp-items="@ViewBag.TipoResiduo"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Motivo"></label>
                            <select class="form-control" asp-for="Motivo" asp-items="@ViewBag.Motivo"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="FInicio"></label>
                            <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FFin"></label>
                            <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="Gerencia"></label>
                            <select class="form-control" asp-for="Gerencia" asp-items="@ViewBag.Gerencias"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Empresa"></label>
                            <select class="form-control" asp-for="Empresa" asp-items="@ViewBag.Empresa"></select>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-1">
                </div>
                <div class="col-12 col-lg-2">
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc-outline-success w-100 mr-2" onclick="Descargar()">Descargar</button>
                    </div>
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc w-100" onclick="Filtrar()">Filtrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!--Cantidad de RS por fecha-->
<div class="container">
    <div class="row">
        <div class="dashboard-section col-12">
            <div class="dashboard-header">
                <h5>Cantidad de Registros</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="frecuencia" class="form-control">
                                <option value="Diario" selected>Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_cant_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Cantidad de RS por ACR_CMRS - Ingreso Salida-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo ACR vs CMRS</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_acr_cmrs" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Cantidad de RS por ingreso vs salida - Ingreso Salida-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo Ingreso vs Salida</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_ing_sal" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Comparativo Tipo de Residuo Sólido-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo Tipo de Residuo Sólido</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_tipo_residuo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Comparativo Motivo de Ingreso/Salida de Residuo Sólido-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo Motivo de Ingreso/Salida de Residuo Sólido</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12" style="cursor:pointer">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_motivo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Cantidad de RS no peligrosos-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Cantidad de Residuos Sólido No Peligroso</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="residuo_no_peligroso" class="selectpicker form-control" asp-items="ViewBag.ResiduosNoPeligrosos" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_rs_no_peligrosos" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Cantidad de RS peligrosos-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Cantidad de Residuos Sólido Peligroso</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="residuo_peligroso" class="selectpicker form-control" asp-items="ViewBag.ResiduosPeligrosos" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_rs_peligrosos" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/selectpicker/js/bootstrap-select.js"></script>
    <script src="~/js/UseCases/Reportes/ReportesResiduosSolidosScript.js" type="text/javascript"></script>
    <script type="text/javascript">
        function Descargar() {
            var fInicio = $("#FInicio").val();
            var fFin = $("#FFin").val();
            if (fInicio < fFin || (fInicio == "" && fFin == "")) {
                window.location.assign("/DescargaIngresoSalida/DescargarIngresoSalida?fechaInicio=" + fInicio + "&fechaFin=" + fFin)
            }
        }
        $("#frecuencia").on("change", function () {
            ActualizarContadorxFecha();
        });
        $("#residuo_no_peligroso").on("change", function () {
            ActualizarDatosGraficoResiduoNoPeligroso();
        });
        $("#residuo_peligroso").on("change", function () {
            ActualizarDatosGraficoResiduoPeligroso();
        });
    </script>
}
