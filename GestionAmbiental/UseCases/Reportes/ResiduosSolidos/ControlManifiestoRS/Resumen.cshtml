@model GestionAmbiental.UseCases.Reportes.ResiduosSolidos.ControlManifiestoRS.FiltroManifiestoRSModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
@section styles {
    <link rel="stylesheet" href="~/selectpicker/css/bootstrap-select.css">
}
<div class="residuos mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title residuos-opacity-color">
                <h3>Dashboard de Manifiestos de Residuos Sólidos Peligrosos</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form class="custom-form w-100" autocomplete="off">
                <div class="col-12 col-lg-9">
                    <div class="row">
                        <h5 class="text-mc text-center">Filtros</h5>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="Observacion"></label>
                            <select class="form-control" asp-for="Observacion">
                                <option value="">--SELECCIONE--</option>
                                <option value="Conforme">Conforme</option>
                                <option value="Anulado">Anulado</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Residuo_Solido"></label>
                            <select class="form-control" asp-for="Residuo_Solido" asp-items="@ViewBag.ResiduoSolido"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="EO_RS_Salida"></label>
                            <select class="form-control" asp-for="EO_RS_Salida" asp-items="@ViewBag.EORS"></select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="EO_RS_Llegada"></label>
                            <select class="form-control" asp-for="EO_RS_Llegada" asp-items="@ViewBag.EORS"></select>
                        </div>
                    </div>
                    <div class="row input_container">
                        <div class="col-12 col-md-6">
                            <label asp-for="FInicio"></label>
                            <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FFin"></label>
                            <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-1">
                </div>
                <div class="col-12 col-lg-2">
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc-success w-100" onclick="Descargar()">Descargar</button>
                    </div>
                    <div class="w-100 row-center-center">
                        <button type="button" class="btn btn-mc w-100" onclick="Filtrar()">Filtrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<!--Cantidad de RS por fecha-->
<div class="container">
    <div class="row">
        <div class="dashboard-section col-12">
            <div class="dashboard-header">
                <h5>Cantidad de Manifiestos Registrados</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="frecuencia" class="form-control">
                                <option value="Diario" selected>Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_man_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Comparativo Estado Manifiesto-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo Estado Manifiesto</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_observacion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--Comparativo Transporte R.S. Peligroso por Camion-->
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Comparativo Transporte R.S. Peligroso por Camion</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_camion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Comparativo Tipo de Residuo Salida-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Comparativo Tipo de Residuo Salida</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_tipo_salida" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Comparativo Tipo de Residuo Llegada-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Comparativo Tipo de Residuo Llegada</h5>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12" style="cursor:pointer">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_tipo_llegada" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <!--Cantidad de RS peligrosos-->
        <div class="dashboard-section col-12 col-lg-12">
            <div class="dashboard-header">
                <h5>Cantidad de Residuos Sólidos Mensual</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="selectResiduoSolido" class="selectpicker form-control" asp-items="@ViewBag.ResiduoSolidoMensual" title="No se ha seleccionado ninguna opción" multiple>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_rs_mensual" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

