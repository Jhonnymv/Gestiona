@section Scripts{
    <script src="~/js/UseCases/Reportes/ReportesInspeccionesScript.js" type="text/javascript"></script>
    <script type="text/javascript">
        function ReporteDetalleEstado(estado) {
            
            var gerencia = $("#IdGerencia").val();
            var empresa = $("#IdEmpresa").val();
            var asesor = $("#IdAsesor").val();
            var respLevObs = $("#IdRespLev").val();
            var fechaInicio = $("#FInicio").val();
            var fechaFin = $("#FFin").val();
            window.location.assign("@Url.Action("DetalleObservacionEstado","ReportesInspecciones")" + "?empresa=" + empresa + "&gerencia=" + gerencia + "&respLevObs=" + respLevObs + "&asesor=" + asesor + "&FechaInicio=" + fechaInicio + "&FechaFin=" + fechaFin + "&estado=" + estado);
        }
    </script>
}