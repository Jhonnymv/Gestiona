    <script>
        function ObservacionsMAPXTipoCondicion() {
            $.ajax({
                type: "POST",
                url: "/ReportesInspecciones/GetObservacionesMAPXTipoCondicion",
                traditional: true,
                success: (response) => {
                    var Xtolerables = response.data[0].map(a => a.nombre);
                    var Ytolerables = response.data[0].map(a => a.valor);
                    console.log(Xtolerables);
                    console.log(Ytolerables);
                    //chart_MAP_Nivel_Riesgo_Tolerable
                    fillchart_MAP_Nivel_Riesgo(Xtolerables, Ytolerables, "chart_MAP_Nivel_Riesgo_Tolerable");


                    var Xalertas = response.data[1].map(a => a.nombre);
                    var Yalertas = response.data[1].map(a => a.valor);

                    fillchart_MAP_Nivel_Riesgo(Xalertas, Yalertas, "chart_MAP_Nivel_Riesgo_Alerta");

                    var Xno_aceptables = response.data[2].map(a => a.nombre);
                    var Yno_aceptables = response.data[2].map(a => a.valor);

                    fillchart_MAP_Nivel_Riesgo(Xno_aceptables, Yno_aceptables, "chart_MAP_Nivel_Riesgo_No_Aceptable");

                    $("#Modal_Nivel_Riesgo_MAP").modal("show");
                }
            });
        }
        function fillchart_MAP_Nivel_Riesgo(X, Y, nchart) {
            new Chart(document.getElementById(nchart),
                {
                    "type": "horizontalBar",
                    "data": {
                        "labels": X,
                        "datasets": [{
                            "label": "#Observaciones",
                            "data": Y,
