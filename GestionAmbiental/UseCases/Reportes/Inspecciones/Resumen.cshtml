@using System.Linq;
@model List<GestionAmbiental.UseCases.Reportes.Inspecciones.ReportesModel>

@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";

    var Xinspecciones_diarias = Newtonsoft.Json.JsonConvert.SerializeObject(Model[0].data.Select(x => x.Nombre).ToList());
    var Yinspecciones_diarias = Newtonsoft.Json.JsonConvert.SerializeObject(Model[0].data.Select(x => x.Valor).ToList());

    var Xmap_vs_sso = Newtonsoft.Json.JsonConvert.SerializeObject(Model[1].data.Select(x => x.Nombre).ToList());
    var Ymap_vs_sso = Newtonsoft.Json.JsonConvert.SerializeObject(Model[1].data.Select(x => x.Valor).ToList());

    var Xobs_x_nivel_riesgoMAP = Newtonsoft.Json.JsonConvert.SerializeObject(Model[2].data.Select(x => x.Nombre).ToList());
    var Yobs_x_nivel_riesgoMAP = Newtonsoft.Json.JsonConvert.SerializeObject(Model[2].data.Select(x => x.Valor).ToList());

    var Xobs_x_nivel_riesgoSSO = Newtonsoft.Json.JsonConvert.SerializeObject(Model[3].data.Select(x => x.Nombre).ToList());
    var Yobs_x_nivel_riesgoSSO = Newtonsoft.Json.JsonConvert.SerializeObject(Model[3].data.Select(x => x.Valor).ToList());
    
    var Xobs_x_tipo_SSO = Newtonsoft.Json.JsonConvert.SerializeObject(Model[4].data.Select(x => x.Nombre).ToList());
    var Yobs_x_tipo_SSO = Newtonsoft.Json.JsonConvert.SerializeObject(Model[4].data.Select(x => x.Valor).ToList());
    
    var Xobs_x_tipo_MAP = Newtonsoft.Json.JsonConvert.SerializeObject(Model[5].data.Select(x => x.Nombre).ToList());
    var Yobs_x_tipo_MAP = Newtonsoft.Json.JsonConvert.SerializeObject(Model[5].data.Select(x => x.Valor).ToList());
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Reporte Inspecciones</h2>
    </div>
</div>
@*Pendientes - Implementados - Aprobados - Rechazados - Vencidos - Totales*@
<div class="row mb-2">
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-pendiente shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-pendiente text-uppercase mb-1">Observaciones Pendientes</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[0]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-implementado shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-implementado text-uppercase mb-1">Observaciones Implementadas</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[1]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-aprobado shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-aprobado text-uppercase mb-1">Observaciones Aprobadas</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[4]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-rechazado shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-rechazado text-uppercase mb-1">Observaciones Rechazadas</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[5]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-vencido shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-vencido text-uppercase mb-1">Observaciones Vencidas</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[2]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
        <div class="card border-left-total shadow h-100">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-total text-uppercase mb-1">Observaciones Ampliadas</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.nObservaciones[3]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
