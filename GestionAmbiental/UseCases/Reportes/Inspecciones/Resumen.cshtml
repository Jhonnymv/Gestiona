@model GestionAmbiental.UseCases.Reportes.Inspecciones.FiltroReportesInspeccionesModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}

<div class="inspection mb-4">
    <div class="primary-content col-12">
        <div class="image-header-container">
            <div class="header-title inspection-opacity-color">
                <h3>Dashboard de Inspecciones</h3>
                <img src="~/img/logo-white.png" alt="Logo Marcobre">
            </div>
        </div>
        <div class="content-header container">
            <form autocomplete="off" class="custom-form w-100">
                <div class="col-12 col-lg-9">
                    <div class="col-12 mb-4">
                        <div class="row">
                            <h5 class="text-mc text-center">Filtros para Inspecciones</h5>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label asp-for="IdGerencia"></label>
                                <select class="form-control" asp-for="IdGerencia" asp-items="@ViewBag.FiltroGerencias"></select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="IdEmpresa"></label>
                                <select class="form-control" asp-for="IdEmpresa" asp-items="@ViewBag.FiltroEmpresas"></select>
                            </div>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label asp-for="FInicio"></label>
                                <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="FFin"></label>
                                <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row">
                            <h5 class="text-mc text-center">Filtro para Observaciones</h5>
                        </div>
                        <div class="row input_container">
                            <div class="col-12 col-md-6">
                                <label asp-for="IdAsesor"></label>
                                <select class="form-control" asp-for="IdAsesor" asp-items="@ViewBag.FiltroAsesor"></select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="IdRespLev"></label>
                                <select class="form-control" asp-for="IdRespLev" asp-items="@ViewBag.FiltroRespLevObs"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-1 row-center-center">
                </div>
                <div class="col-12 col-lg-2 row-center-center">
                    <button type="button" class="btn btn-mc w-100" onclick="Filtrar()">Filtrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container">
    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Cantidad de Inspecciones</h5>
        </div>
        <div class="wrap-scroll-horizontal">
            <div class="dashboard-item inspection">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Inspecciones Hasta la Fecha</h6>
                        <h3 id="InsTotal"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Hasta la Fecha </h6>
                        <h3 id="ObsTotal"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Inspecciones Encontradas</h6>
                        <h3 id="InsEncont"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Encontradas</h6>
                        <h3 id="ObsEncont"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Buenas Prácticas Encontradas</h6>
                        <h3 id="BPEncont"></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Cantidad de Inspecciones Registradas</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="sel_frec_insp_fecha" class="form-control">
                                <option value="Diario" selected>Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_insp_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-section col-12 col-lg-6">
            <div class="dashboard-header">
                <h5>Cantidad de Observaciones Registradas</h5>
            </div>
            <div class="row">
                <div class="custom-form justify-content-start w-100 p-0">
                    <div class="row input_container col-12 col-lg-6">
                        <div class="col-12">
                            <select id="sel_frec_obs_estado" class="form-control">
                                <option value="Tod" selected>TODOS</option>
                                <option value="Reg">Registrado</option>
                                <option value="Imp">Implementado</option>
                                <option value="Ven">Vencido</option>
                                <option value="Apr">Aprobado</option>
                                <option value="Rec">Rechazado</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="secondary-dashboard-item col-12">
                    <div class="secondary-content">
                        <div class="col-12">
                            <div class="chart-area">
                                <canvas id="chart_obs_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Cantidad de Observaciones</h5>
        </div>
        <div class="wrap-scroll-horizontal">            
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Reg')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Pendientes de Implementación</h6>
                        <h3 id="ObsRegistrado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Imp')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Pendientes de Verificación</h6>
                        <h3 id="ObsImplementado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Apr')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Aprobadas</h6>
                        <h3 id="ObsAprobado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Rec')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Rechazadas</h6>
                        <h3 id="ObsRechazado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Ven')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Vencidas</h6>
                        <h3 id="ObsVencido"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('Amp')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Observaciones Ampliadas</h6>
                        <h3 id="ObsAmpliado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('BImplementadas')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Buenas Prácticas Pendientes de Verificación</h6>
                        <h3 id="BImplementadas"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('BAprobadas')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Buenas Prácticas Aprobadas</h6>
                        <h3 id="BPAprobado"></h3>
                    </div>
                </div>
            </div>
            <div class="dashboard-item inspection" onclick="ReporteDetalleEstado('BRechazadas')" style="cursor: pointer">
                <div class="image-header-container">
                    <div class="dashboard-item-title inspection-opacity-color">
                        <h6>Buenas Prácticas Rechazadas</h6>
                        <h3 id="BPRechazado"></h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Comparativo Observaciones MAP vs SSO</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones MAP vs SSO</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_MAP_vs_SSO" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones MAP vs SSO X Estado</h6>
                    </div>
                    <div class="col-12">
                        <canvas id="chart_MA_vs_SSO_Estado" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Comparativo Buenas Prácticas MAP vs SSO</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Buenas Prácticas MAP vs SSO</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_BP_MAP_vs_SSO" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Buenas Prácticas MAP vs SSO X Estado</h6>
                    </div>
                    <div class="col-12">
                        <canvas id="chart_BP_MA_vs_SSO_Estado" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Observaciones MA</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6" onclick="ActualizarDatosGraficoMA_NR_Tipo()" style="cursor: pointer">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones MA por Nivel de Riesgo</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_MA_Nivel_Riesgo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones</h6>
                    </div>
                    <div class="col-12">
                        <canvas id="chart_MA_Clasificacion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="dashboard-header">
            <h5>Observaciones SSO</h5>
        </div>
        <div class="row">
            <div class="secondary-dashboard-item col-12 col-lg-6" onclick="ActualizarDatosGraficoSSO_NR_Tipo()" style="cursor:pointer">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones SSO por Nivel de Riesgo</h6>
                    </div>
                    <div class="col-12">
                        <div class="chart-area">
                            <canvas id="chart_SSO_Nivel_Riesgo" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="secondary-dashboard-item col-12 col-lg-6">
                <div class="secondary-content">
                    <div>
                        <h6 class="text-center">#Observaciones</h6>
                    </div>
                    <div class="col-12">
                        <canvas id="chart_SSO_Clasificacion" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Detalles MAP-->
<div class="modal fade" id="Modal_Nivel_Riesgo_MAP" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-inspection">
            <div class="modal-content">
                <div class="inspection">
                    <div class="image-header-container">
                        <div class="header-title inspection-opacity-color">
                            <h4 class="modal-title" id="Modal_Nivel_Riesgo_MAP_Title">Clasificación de Observaciones MA según Nivel de Riesgo</h4>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipos de Condición de Nivel de Riesgo Tolerable</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_MAP_Nivel_Riesgo_Tolerable" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipos de Condición del Nivel del Riesgo Alerta</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_MAP_Nivel_Riesgo_Alerta" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipos de Condición de Nivel del Riesgo No Aceptable</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_MAP_Nivel_Riesgo_No_Aceptable" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipos de Condición de Nivel del Riesgo No Aplica</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_MAP_Nivel_Riesgo_No_Aplica" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Detalles SSO-->
<div class="modal fade" id="Modal_Nivel_Riesgo_SSO" tabindex="-1" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-inspection">
            <div class="modal-content">
                <div class="inspection">
                    <div class="image-header-container">
                        <div class="header-title inspection-opacity-color">
                            <h4 class="modal-title" id="Modal_Nivel_Riesgo_SSO_Title">Clasificación de Observaciones SSO según Nivel de Riesgo</h4>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipo de Condición del Nivel de Riesgo Bajo</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_SSO_Nivel_Riesgo_Bajo" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="dashboard-header">
                                    <h5>#Observaciones por Tipo de Condición del Nivel de Riesgo Medio</h5>
                                </div>
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_SSO_Nivel_Riesgo_Medio" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="dashboard-header">
                                    <h5>#Observaciones por Tipo de Condición del Nivel de Riesgo Alto</h5>
                                </div>
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_SSO_Nivel_Riesgo_Alto" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dashboard-section">
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="dashboard-header">
                                    <h5>#Observaciones por Tipo de Condición del Nivel de Riesgo No Aplica</h5>
                                </div>
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_SSO_Nivel_Riesgo_No_Aplica" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/UseCases/Reportes/ReportesInspeccionesScript.js" type="text/javascript"></script>
    <script type="text/javascript">
        function ReporteDetalleEstado(estado) {
            
            var gerencia = $("#IdGerencia").val();
            var empresa = $("#IdEmpresa").val();
            var asesor = $("#IdAsesor").val();
            var respLevObs = $("#IdRespLev").val();
            var fechaInicio = $("#FInicio").val();
            var fechaFin = $("#FFin").val();
            window.location.assign("@Url.Action("DetalleObservacionEstado","ReportesInspecciones")" + "?empresa=" + empresa + "&gerencia=" + gerencia + "&respLevObs=" + respLevObs + "&asesor=" + asesor + "&FechaInicio=" + fechaInicio + "&FechaFin=" + fechaFin + "&estado=" + estado);
        }
    </script>
}