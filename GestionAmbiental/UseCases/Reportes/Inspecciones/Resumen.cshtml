    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-menu modal-inspection">
            <div class="modal-content">
                <div class="inspection">
                    <div class="image-header-container">
                        <div class="header-title inspection-opacity-color">
                            <h4 class="modal-title" id="Modal_Nivel_Riesgo_MAP_Title">Clasificación de Observaciones MA según Nivel de Riesgo</h4>
                            <img src="/img/logo-white.png" alt="Logo Marcobre">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="dashboard-section">
                        <div class="dashboard-header">
                            <h5>#Observaciones por Tipos de Condición de Nivel de Riesgo Tolerable</h5>
                        </div>
                        <div class="row">
                            <div class="secondary-dashboard-item col-12">
                                <div class="secondary-content">
                                    <div class="col-12">
                                        <div class="chart-area">
                                            <canvas id="chart_MAP_Nivel_Riesgo_Tolerable" style="display: block; height: 450px; width: 100%;" class="chartjs-render-monitor"></canvas>
                                        </div>
                                    </div>
                                </div>
