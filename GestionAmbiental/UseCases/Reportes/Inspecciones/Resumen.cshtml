@section scripts{
    <script type="text/javascript">
        new Chart(
            document.getElementById("chart_inspecciones_30_dias"),
            {
                "type": "bar",
                "data": {
                    "labels": @Html.Raw(Xinspecciones_diarias),
                    "datasets": [{
                        "label": "# Inspecciones Registradas",
                        "data": @Html.Raw(Yinspecciones_diarias),
                        "fill": false,
                        "backgroundColor":"rgb(46, 103, 147)",
                        "borderColor": "rgb(46, 103, 147)",
                        "lineTension": 0.1
                    }]
                },
                "options": {
                    "legend": {
                        "labels": {
                            // This more specific font property overrides the global property
                            fontColor: 'black'
                        }
                    },
                    "plugins": {
                        datalabels: {
                            color: 'white',
                            defaultFontSize: 15
                        }
                    }
                }
            });

        new Chart(
            document.getElementById("chart_MAP_Nivel_Riesgo"),
