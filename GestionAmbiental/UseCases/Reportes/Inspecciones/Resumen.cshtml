                    console.log(Xtolerables);
                    console.log(Ytolerables);
                    //chart_SSO_Nivel_Riesgo_Tolerable
                    fillchart_SSO_Nivel_Riesgo(Xtolerables, Ytolerables, "chart_SSO_Nivel_Riesgo_Tolerable");


                    var Xalertas = response.data[1].map(a => a.nombre);
                    var Yalertas = response.data[1].map(a => a.valor);

                    fillchart_SSO_Nivel_Riesgo(Xalertas, Yalertas, "chart_SSO_Nivel_Riesgo_Alerta");

                    var Xno_aceptables = response.data[2].map(a => a.nombre);
