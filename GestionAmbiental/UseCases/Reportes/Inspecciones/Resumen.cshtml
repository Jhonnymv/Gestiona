                    fillchart_SSO_Nivel_Riesgo(Xno_aceptables, Yno_aceptables, "chart_SSO_Nivel_Riesgo_No_Aceptable");

                    $("#Modal_Nivel_Riesgo_SSO").modal("show");
                }
            });
