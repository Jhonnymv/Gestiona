        function ObservacionsMAPXTipoCondicion() {
            $.ajax({
                type: "POST",
                url: "/ReportesInspecciones/GetObservacionesMAPXTipoCondicion",
                traditional: true,
                success: (response) => {
                    var Xtolerables = response.data[0].map(a => a.nombre);
                    var Ytolerables = response.data[0].map(a => a.valor);
                    console.log(Xtolerables);
                    console.log(Ytolerables);
