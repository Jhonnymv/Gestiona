@model GestionAmbiental.UseCases.Reportes.Inspecciones.FiltroReportesInspeccionesModel
@{
    ViewData["Title"] = "Resumen";
    Layout = "~/UseCases/Shared/_Layout.cshtml";
}
<div class="row mb-2">
    <div class="col-12 titulo-pagina">
        <h2>Dashboard de Inspecciones</h2>
    </div>
</div>
<!--Filtros-->
<form autocomplete="off">
    <div class="container-fluid">
        <!-- Filtro de Inspecciones -->
        <div class="row mb-2 justify-content-center">
            <div class="col-lg-10 col-md-12 col-sm-12 border rounded" style="border-color:#2e6793 !important">
                <div class="row mb-2 justify-content-center">
                    <h3>Filtro para Inspecciones</h3>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="IdGerencia"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="IdGerencia" asp-items="@ViewBag.FiltroGerencias"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="IdEmpresa"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="IdEmpresa" asp-items="@ViewBag.FiltroEmpresas"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FInicio"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FInicio" value="@ViewBag.FechaInicio" />
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="FFin"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <input type="date" class="form-control" asp-for="FFin" value="@ViewBag.FechaFin" />
                    </div>
                </div>

                <!-- Filtro de Observaciones -->
                <div class="row mb-2 justify-content-center">
                    <h3>Filtro para Observaciones</h3>
                </div>
                <div class="row mb-2 justify-content-center">
                    <div class="col-lg-2 mt-1">
                        <label asp-for="IdAsesor"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="IdAsesor" asp-items="@ViewBag.FiltroAsesor"></select>
                    </div>
                    <div class="col-lg-2 mt-1">
                        <label asp-for="IdRespLev"></label>
                    </div>
                    <div class="col-lg-4 mt-1">
                        <select class="form-control" asp-for="IdRespLev" asp-items="@ViewBag.FiltroRespLevObs"></select>
                    </div>
                </div>
                <div class="row mb-2 justify-content-center">
                    <button type="button" class="btn btn-primary" onclick="Filtrar()">Filtrar</button>
                </div>
            </div>
        </div>
    </div>
</form>
<!--Contador de Inspecciones x Estado-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Cantidad de Inspecciones</h6>
            </div>
            <div class="card-body">
                <div class="row justify-content-center">
                    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
                        <div class="card border-left-pendiente shadow h-100">
                            <div class="card-body click-option" onclick="InspeccionDetalleEstado('Pendiente')">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-pendiente text-uppercase mb-1">Pendientes (TBD)</div>
                                        <div id="InsPendiente" class="h5 mb-0 font-weight-bold text-gray-800"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
                        <div class="card border-left-pendiente shadow h-100">
                            <div class="card-body click-option" onclick="InspeccionDetalleEstado('Registrado')">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-pendiente text-uppercase mb-1">Registradas</div>
                                        <div id="InsRegistrado" class="h5 mb-0 font-weight-bold text-gray-800"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4 mb-2">
                        <div class="card border-left-pendiente shadow h-100">
                            <div class="card-body click-option" onclick="inspeccionDetalleEstado('Eliminado')">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-pendiente text-uppercase mb-1">Eliminadas</div>
                                        <div id="InsEliminado" class="h5 mb-0 font-weight-bold text-gray-800"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Contador de inspecciones por fecha-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Cantidad de Inspecciones Registrados</h6>
                    </div>
                    <div class="col-2">
                        <select id="sel_frec_insp_fecha" class="form-control">
                            <option value="Diario" selected>Diario</option>
                            <option value="Semanal">Semanal</option>
                            <option value="Mensual">Mensual</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <div class="chartjs-size-monitor">
                        <div class="chartjs-size-monitor-expand">
                            <div class="">
                            </div>
                        </div>
                        <div class="chartjs-size-monitor-shrink">
                            <div class="">
                            </div>
                        </div>
                    </div>
                    <canvas id="chart_insp_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Contador de observacioens por fecha-->
<div class="row mb-2">
    <div class="col-xl-12 col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-8">
                        <h6 class="m-0 font-weight-bold text-pendiente" style="text-align:center">Cantidad de Inspecciones Registrados</h6>
                    </div>
                    <div class="col-2">
                        <select id="sel_frec_obs_estado" class="form-control">
                            <option value="Tod" selected>TODOS</option>
                            <option value="Reg">Registrado</option>
                            <option value="Imp">Implementado</option>
                            <option value="Ven">Vencido</option>
                            <option value="Apr">Aprobado</option>
                            <option value="Rec">Rechazado</option>
                            <option value="Eli">Eliminado</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <div class="chartjs-size-monitor">
                        <div class="chartjs-size-monitor-expand">
                            <div class="">
                            </div>
                        </div>
                        <div class="chartjs-size-monitor-shrink">
                            <div class="">
                            </div>
                        </div>
                    </div>
                    <canvas id="chart_obs_fechas" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="text/javascript">
        var gerencia = $("#IdGerencia").val();
        var empresa = $("#IdEmpresa").val();
        var asesor = $("#IdAsesor").val();
        var respLev = $("#IdRespLev").val();
        var fechaInicio = "";
        var fechaFin = "";

        //Variables gráfico Inspecciones X Fecha
        var data_insp_fechas = [];
        var graph_insp_fechas;

        $(document).ready(function () {
            Filtrar();
        });


        function Filtrar() {
            gerencia = $("#IdGerencia").val();
            empresa = $("#IdEmpresa").val();
            asesor = $("#IdAsesor").val();
            respLev = $("#IdRespLev").val();
            fechaInicio = $("#FInicio").val();
            fechaFin = $("#FFin").val();
            if (fechaInicio < fechaFin || (fechaInicio == "" && fechaFin == "")) {
                $.ajax({
                    type: "POST",
                    url: "/ReportesInspecciones/ActualizarContadorInspecciones",
                    data: {
                        "gerencia": $("#IdGerencia").val(),
                        "empresa": $("#IdEmpresa").val(),
                        "asesor": $("#IdAsesor").val(),
                        "respLevObs": $("#IdRespLev").val(),
                        "FechaInicio": $("#FInicio").val(),
                        "FechaFin": $("#FFin").val()
                    },
                    success: (response) => {
                        var nObs = response.nInspecciones;
                        ActualizarContadorInsXEst(nObs[0].valor, nObs[1].valor, nObs[2].valor);

                        ActualizarContadorRxFecha();
                        ActualizarContadorOxFecha();
                        /*
                        //Actualizar contador
                        var nObs = response.nObservaciones;
                        ActualizarContadorRxE(nObs[0].valor, nObs[1].valor, nObs[2].valor, nObs[3].valor, nObs[4].valor, nObs[5].valor,nObs[6].valor);
                        //Actualizar input fechas
                        fechaInicio = $("#FInicio").val();
                        fechaFin = $("#FFin").val();
                        //Actualizar gráfico de rac de fechas
                        ActualizarContadorRxFecha();
                        //Actualizar gráfico de ma por nivel de riesgo
                        ActualizarDatosGraficoMA_NR();
                        //Actualizar gráfico de sso por nivel de riesgo
                        ActualizarDatosGraficoSSO_NR();
                        //Actualizar gráfico de ma por clasificación
                        ActualizarDatosGraficoMA_Clas();
                        //Actualizar gráfico de sso por clasificación
                        ActualizarDatosGraficoSSO_Clas();
                        */
                    }
                });
            } else {
                alert("La fecha de fin debe ser mayor a la fecha de inicio");
            }
        }
        //Para contador de inspecciones x estado
        function ActualizarContadorInsXEst(pend, reg, elim) {
            $("#InsPendiente").html(pend);
            $("#InsRegistrado").html(reg);
            $("#InsEliminado").html(elim);
        }
        //Para contador de inspecciones x fecha
        $("#sel_frec_insp_fecha").on('change', function () {
            ActualizarContadorRxFecha();
        });
        function ActualizarContadorRxFecha() {
            $.ajax({
                type: "POST",
                url: "/ReportesInspecciones/ActualizarInspeccionesXFecha",
                data: {
                    "gerencia": $("#IdGerencia").val(),
                    "empresa": $("#IdEmpresa").val(),
                    "asesor": $("#IdAsesor").val(),
                    "respLevObs": $("#IdRespLev").val(),
                    "FechaInicio": $("#FInicio").val(),
                    "FechaFin": $("#FFin").val(),
                    "frecuencia": $("#sel_frec_insp_fecha").val()
                },
                traditional: true,
                success: (response) => {
                    if (data_insp_fechas.length > 0) {
                        //Actualizar contador
                        data_insp_fechas = response.inspeccionesXFecha;

                        var labels = [];
                        var data = [];
                        for (var i = 0; i < data_insp_fechas.length; i++) {
                            labels.push(data_insp_fechas[i].nombre);
                            data.push(data_insp_fechas[i].valor);
                        }
                        //Actualizar gráfica
                        graph_insp_fechas.data.labels = labels;
                        graph_insp_fechas.data.datasets[0].data = data;
                        graph_insp_fechas.options.scales.yAxes[0].ticks.stepSize = Math.max(data) / 10;
                        graph_insp_fechas.update();
                    } else {
                        //Actualizar contador
                        data_insp_fechas = response.inspeccionesXFecha;

                        var labels = [];
                        var data = [];
                        for (var i = 0; i < data_insp_fechas.length; i++) {
                            labels.push(data_insp_fechas[i].nombre);
                            data.push(data_insp_fechas[i].valor);
                        }
                        //Crear gráfica
                        CrearGraficaContardorIxFecha(labels, data, Math.max(data) / 10);
                    }
                }
            });
        }
        function CrearGraficaContardorIxFecha(labels, data, stepSize) {
            graph_insp_fechas = new Chart(
                document.getElementById("chart_insp_fechas"),
                {
                    "type": "bar",
                    "data": {
                        "labels": labels,
                        "datasets": [{
                            "label": "# Inspecciones Registradas",
                            "data": data,
                            "fill": false,
                            "backgroundColor": "rgb(46, 103, 147)",
                            "borderColor": "rgb(46, 103, 147)",
                            "lineTension": 0.1
                        }]
                    },
                    "options": {
                        "scales": {
                            'yAxes': [{
                                'ticks': {
                                    'stepSize': stepSize,
                                    'beginAtZero': true
                                }
                            }]
                        },
                        "legend": {
                            "labels": {
                                // This more specific font property overrides the global property
                                fontColor: 'black'
                            }
                        },
                        "plugins": {
                            datalabels: {
                                color: 'white',
                                defaultFontSize: 15
                            }
                        }
                    }
                });
        }
        //Para contador de observaciones x fecha
        $("#sel_frec_obs_estado").on('change', function () {
            ActualizarContadorOxFecha();
        });
        function ActualizarContadorOxFecha() {
            $.ajax({
