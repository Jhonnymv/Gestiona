            </div>
            <div class="card-body">
                <div class="chart-area">
                    <div class="chartjs-size-monitor"><div class="chartjs-size-monitor-expand"><div class=""></div></div><div class="chartjs-size-monitor-shrink"><div class=""></div></div></div>
                    <canvas id="chart" style="display: block; height: 350px; width: 100%;" class="chartjs-render-monitor"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <a class="nav-link text-dark" asp-controller="Reportes" asp-action="MAPvsSSO">MAPvsSSO</a>
    <br />
    <a class="nav-link text-dark" asp-controller="Reportes" asp-action="ObservacionesXUsuario">ObservacionesXUsuario</a>
    <br />
    <a class="nav-link text-dark" asp-controller="Reportes" asp-action="ObservacionesXEstado">ObservacionesXEstado</a>
    <br />
    <a class="nav-link text-dark" asp-controller="Reportes" asp-action="DetalleObservacionesXUsuario">DetalleObservacionesXUsuario</a>
</div>
